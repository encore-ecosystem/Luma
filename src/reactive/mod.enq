//! Fine-grained values used by retained components.

import core::vec::Vec
import refrain::widget::Widget

/// A heap-owned reactive value. Reading with `read_for` records a component
/// dependency; writes advance a monotonic revision used by reconciliation.
pub struct Signal[T] {
    value: T
    revision: u64
    components: Vec[str]
}

impl[T] for Signal[T] {
    pub fn new(value: T) -> Signal[T] < H > {
        ret Signal[T] < H > {
            value, 1_u64, Vec[str]::new()
        }
    }

    pub fn get(self: Self &) -> T {
        ret self.value
    }

    pub fn read_for(self: Self &, component: str) -> T {
        if component != "" && !contains_component(self.components, component) {
            self.components.push(component)
        }
        ret self.value
    }

    pub fn set(self: Self &, value: T) ->() {
        self.value = value
        self.revision += 1_u64
        ret()
    }

    pub fn revision(self: Self &) -> u64 {
        ret self.revision
    }
    pub fn components(self: Self &) -> Vec[str] {
        ret self.components
    }
}

/// Cached exact-property value for hot bindings. The caller refreshes it only
/// when the source revision changes, avoiding a component rebuild.
pub struct Computed[T] {
    value: T
    source_revision: u64
}

impl[T] for Computed[T] {
    pub fn new(value: T, source_revision: u64) -> Computed[T] < H > {
        ret Computed[T] < H > {
            value, source_revision
        }
    }
    pub fn get(self: Self &) -> T {
        ret self.value
    }
    pub fn source_revision(self: Self &) -> u64 {
        ret self.source_revision
    }
    pub fn refresh(self: Self &, value: T, source_revision: u64) -> bool {
        if self.source_revision == source_revision {
            ret false
        }
        self.value = value
        self.source_revision = source_revision
        ret true
    }
}

/// A retained component supplies one stable reconciliation boundary.
pub trait Component {
    fn component_id(self: Self) -> str
    fn view(self: Self) -> Widget
}

fn contains_component(components: Vec[str], expected: str) -> bool {
    for component in components {
        if component == expected {
            ret true
        }
    }
    ret false
}
