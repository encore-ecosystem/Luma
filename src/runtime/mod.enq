        } elif interval == 0_u32 {
            next_tick = after_wait
        }
        if event.kind() == event_close() {
            close_pending = true
            current = current.runtime_update(AppEvent::close_event())
            model_updated = true
            ui = runtime_update_model(window, ui, window.stylesheet(),
                current.runtime_view(), hovered, active, interaction.focused(),)
            if current.runtime_can_close() {
                break
            }
            continue
        }
        let edit = runtime_text_edit(window, interaction.focused(),
            ui.find_widget(interaction.focused()), event,)
        match edit {
            Option::Some(intent) => {
                let target = intent.target()
                let _input_default = ui.dispatch_event(target,
                    UiEvent::input(target, intent.text()),)
                current = current.runtime_update(AppEvent::edit_event(intent))
                model_updated = true
                ui = runtime_patch_application_target[M](window, ui, window.stylesheet(),
                    current, target, hovered, active,
                    interaction.focused(),)
            }
            Option::None => {
            }
        }
        if edit.is_some() {
        } elif event.kind() == event_focus_lost() {
            let _relative_released = window.set_relative_mouse_mode(false)
            current = current.runtime_update(AppEvent::focus_lost_event())
            model_updated = true
            let previous_hovered = hovered
            let previous_active = active
            let mut committed_control = false
            if runtime_starts_with(previous_active, "splitter-") {
                current = current.runtime_update(AppEvent::pointer_event(
                        8_u32, previous_active, event.x(), event.y(),))
                model_updated = true
            }
            match runtime_current_control_commit(ui, previous_active,
                range_thumb,) {
                Some(change) => {
                    current = current.runtime_update(change)
                    current = current.runtime_update(
                        AppEvent::action_event(previous_active),)
                    model_updated = true
                    committed_control = true
                }
                None => {
                }
            }
            hovered = ""
            active = ""
            scrollbar_drag = ""
            interaction = interaction.pointer_cancel()
            range_thumb = 0_u32
            ui = if committed_control {
                runtime_update_model(window, ui, window.stylesheet(),
                    current.runtime_view(), hovered, active,
                    interaction.focused(),)
            } else {
                runtime_update_model(window, ui, window.stylesheet(),
                    ui.declarative_root(), hovered, active,
                    interaction.focused(),)
            }
        } elif event.kind() == event_resize() {
            let width = window.width()
            let height = window.height()
            let density = window.pixel_density()
            if width != last_width || height != last_height || density != last_density {
                last_width = width
                last_height = height
                last_density = density
                current = current.runtime_update(AppEvent::resized(width as f32, height as f32))
                ui = window.stage_resized_reactive(ui, current.runtime_view(),
                    window.stylesheet(), hovered, active, interaction.focused(),
                    perf_counter_ms(),)
            }
        } elif event.kind() == event_pointer_up() && event.key() == 1_u32 && scrollbar_drag != "" {
            scrollbar_drag = ""
        } elif event.kind() == event_scroll() ||
        (event.kind() == event_pointer_move() && scrollbar_drag != "") ||
        (event.kind() == event_pointer_down() && event.key() == 1_u32 &&
            runtime_scrollbar_hit(ui.layout(), event.x(), event.y()) != "") {
            let wheel = event.kind() == event_scroll()
            let target = if wheel {
                ui.hit(event.x(), event.y())
            } else {
                scrollbar_drag
            }
            let mut container = if wheel {
                ui.scrollable_ancestor(target)
            } else {
                scrollbar_drag
            }
            if event.kind() == event_pointer_down() {
                container = runtime_scrollbar_hit(ui.layout(), event.x(), event.y())
                scrollbar_drag = container
                ui.set_keyboard_focus(false)
                match ui.find_layout(container) {
                    Some(layout) => {
                        let thumb = layout.scrollbar_thumb()
                        scrollbar_grab = if event.y() >= thumb.y() && event.y() < thumb.bottom() {
                            event.y() - thumb.y()
                        } else {
                            thumb.height() / 2.0_f32
                        }
                    }
                    None => {
                    }
                }
            }
            let allowed = if wheel {
                ui.dispatch_event(target, UiEvent::pointer(ui_event_scroll(), target,
                        event.x(), event.y(), event.wheel_x(), event.wheel_y(),))
            } else {
                true
            }
            if allowed {
                match ui.find_layout(container) {
                    Some(layout) => {
                        let previous = layout.widget().style().layout().scroll()
                        let raw = if wheel {
                            previous.y() - event.wheel_y() * 48.0_f32
                        } else {
                            layout.scrollbar_offset_at(event.y(), scrollbar_grab)
                        }
                        let maximum = layout.scroll_max_y()
                        let offset = if raw < 0.0_f32 {
                            0.0_f32
                        } elif raw > maximum {
                            maximum
                        } else {
                            raw
                        }
                        if wheel && !options.reduced_motion() && event.wheel_y() != 0.0_f32 {
                            scroll_motion = scroll_motion.wheel(container, previous.y(),
                                - event.wheel_y() * 48.0_f32, maximum, perf_counter_ms(),)
                        } elif offset != previous.y() {
                            let event_target = if wheel {
                                target
                            } else {
                                container
                            }
                            current = current.runtime_update(AppEvent::scroll_event(event_target,
                                    event.wheel_x(), event.wheel_y(), offset, layout.bounds().height(),))
                            model_updated = true
                            // Retain the destination BEFORE reconciling. Layout now computes
                            // the virtual window and its translation in a single transaction.
                            ui.set_scroll_offset(container, previous.x(), offset)
                            ui = runtime_update_model(window, ui, window.stylesheet(),
                                current.runtime_view(), hovered, active, interaction.focused(),)
                        }
                    }
                    None => {
                        // Custom canvases consume wheel input without a managed scroller.
                        if wheel {
                            current = current.runtime_update(AppEvent::scroll_event(target,
                                    event.wheel_x(), event.wheel_y(), 0.0_f32, 0.0_f32,))
