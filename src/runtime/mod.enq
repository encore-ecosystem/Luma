extern fn encore_str_from_codepoint(value: usize) -> str

/// Defines an application model rendered by Luma's managed runtime.
///
/// `view` is pure from Luma's perspective. `update` returns the next model
/// after an actionable widget is activated.
pub trait Application {
    fn view(self: Self) -> Widget
    fn update(self: Self, event: AppEvent) -> Self
    /// Returns the requested background-update interval in milliseconds.
    ///
    /// Return zero while no background service needs observation. The runtime
    /// then blocks for native events and performs no periodic redraws.
    fn background_interval_ms(self: Self) -> u32
    /// Monotonic token for observable background state. A tick is delivered
    /// to the model on schedule, but the retained UI is reconciled only when
    /// this token changes.
    fn background_revision(self: Self) -> u64
    /// Returns whether a native close request may terminate the application.
    ///
    /// The runtime first delivers `AppEvent::is_close_requested`; models may
    /// update confirmation or dirty-document state before this is queried.
    fn can_close(self: Self) -> bool
}

/// An application that can render one updated retained widget or one directly
/// dependent widget without rebuilding its complete view. The returned widget
/// must keep a stable ID already present in the retained tree. Return `None`
/// when no dependent patch is required.
pub trait IncrementalApplication {
    fn view(self: Self) -> Widget
    fn view_target(self: Self, target: str) -> Option[Widget]
    fn update(self: Self, event: AppEvent) -> Self
    fn background_interval_ms(self: Self) -> u32
    fn background_revision(self: Self) -> u64
    fn can_close(self: Self) -> bool
}

/// An incremental application with one zero-copy surface recorded directly
/// into Luma's active Vulkan frame. Luma remains the sole owner of layout,
/// composition, submission and presentation.
pub trait DirectRenderApplication {
    fn view(self: Self) -> Widget
    fn view_target(self: Self, target: str) -> Option[Widget]
    fn update(self: Self, event: AppEvent) -> Self
    fn background_interval_ms(self: Self) -> u32
    fn background_revision(self: Self) -> u64
    fn can_close(self: Self) -> bool
    fn render_surface_id(self: Self) -> str
    fn render_overlay_ids(self: Self) -> Vec[str]
    /// Records uploads and compute work before Luma begins composition.
    fn prepare_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool
    /// Records the surface graphics pass after Luma begins composition.
    fn record_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool
}

trait RuntimeApplication {
    fn runtime_view(self: Self) -> Widget
    fn runtime_view_target(self: Self, target: str) -> Option[Widget]
    fn runtime_update(self: Self, event: AppEvent) -> Self
    fn runtime_background_interval_ms(self: Self) -> u32
    fn runtime_background_revision(self: Self) -> u64
    fn runtime_can_close(self: Self) -> bool
    fn runtime_render_surface_id(self: Self) -> str
    fn runtime_render_overlay_ids(self: Self) -> Vec[str]
    fn runtime_prepare_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool
    fn runtime_record_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool
}

struct ApplicationAdapter[A] {
    value: A
}

impl[A: Application] RuntimeApplication for ApplicationAdapter[A] {
    fn runtime_view(self: Self) -> Widget {
        ret self.value.view()
    }
    fn runtime_view_target(self: Self, target: str) -> Option[Widget] {
        ret Option[Widget]::None
    }
    fn runtime_update(self: Self, event: AppEvent) -> Self {
        ret Self {
            self.value.update(event)
        }
    }
    fn runtime_background_interval_ms(self: Self) -> u32 {
        ret self.value.background_interval_ms()
    }
    fn runtime_background_revision(self: Self) -> u64 {
        ret self.value.background_revision()
    }
    fn runtime_can_close(self: Self) -> bool {
        ret self.value.can_close()
    }
    fn runtime_render_surface_id(self: Self) -> str {
        ret ""
    }
    fn runtime_render_overlay_ids(self: Self) -> Vec[str] {
        ret Vec[str]::new()
    }
    fn runtime_prepare_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool {
        ret false
    }
    fn runtime_record_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool {
        ret false
    }
}

