fn scrollable_ancestor_prefers_the_nearest_declared_container() -> bool {
    let root = Widget::panel("root")
    .with_attribute("data-luma-scrollable", "true")
    .with_child(Widget::panel("list")
        .with_attribute("data-luma-scrollable", "true")
        .with_child(Widget::button("row", "Row")))
    let mut ui = ReactiveUi::new(layout_widget(root, Rect::new(0_f32, 0_f32, 400_f32, 300_f32)))
    ret runtime_scrollable_ancestor(root, "row") == "list" && ui.scrollable_ancestor("row") == "list" &&
    runtime_scrollable_ancestor(root, "missing") == "" && ui.scrollable_ancestor("missing") == "" &&
    ui.scrollable_ancestor("list") == "list"
}

