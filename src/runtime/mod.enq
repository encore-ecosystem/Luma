                current = current.runtime_update(AppEvent::pointer_event(
                        6_u32, target, event.x(), event.y(),))
                model_updated = true
                ui = runtime_update_model(window, ui, window.stylesheet(),
                    current.runtime_view(), hovered, active, interaction.focused(),)
            }
            match runtime_pointer_edit(window, ui, target,
                event.x(), event.y(), false,) {
                Option::Some(intent) => {
                    let edit_target = intent.target()
                    current = current.runtime_update(AppEvent::edit_event(intent))
                    model_updated = true
                    ui = runtime_patch_application_target[M](window, ui,
                        window.stylesheet(), current, edit_target, hovered,
                        active, interaction.focused(),)
                }
                Option::None => {
                }
            }
            // `target` is the authoritative hit result for this press. Keep
            // pointer capture in the runtime's scalar state so subsequent
            // motion cannot lose it through an aggregate state round-trip.
            ui = runtime_update_model(window, ui, window.stylesheet(),
                ui.declarative_root(), hovered, active,
                interaction.focused(),)
        } elif event.kind() == event_pointer_up() {
            let target = ui.hit(event.x(), event.y())
            if runtime_starts_with(interaction.active(), "splitter-") {
                current = current.runtime_update(AppEvent::pointer_event(
                        8_u32, interaction.active(), event.x(), event.y(),))
                model_updated = true
                ui = runtime_update_model(window, ui, window.stylesheet(),
                    current.runtime_view(), hovered, active, interaction.focused(),)
            }
            let previous_active = active
            if pending_selection != "" {
                match runtime_pointer_edit(window, ui, pending_selection, event.x(), event.y(), true) {
                    Some(intent) => {
                        current = current.runtime_update(AppEvent::edit_event(intent)) model_updated = true
                        ui = runtime_patch_application_target[M](window, ui, window.stylesheet(), current, pending_selection, hovered, active, interaction.focused())
                    }
                    None => {
                    }
                }
                pending_selection = ""
            }
            if runtime_raw_input_target(ui, previous_active) {
                current = current.runtime_update(
                    AppEvent::raw_pointer_event(8_u32, previous_active, event),)
                model_updated = true
