struct ReactiveApplicationAdapter[A] {
    value: A<H>
    bindings: UiBindings<H>
    root: NodeId
    mounted: Widget
}

impl[A: ReactiveApplication] RuntimeApplication for ReactiveApplicationAdapter[A] {
    fn runtime_view(self: Self) -> Widget {
        ret self.bindings.authored_view().unwrap_or(self.mounted)
    }
    fn runtime_view_target(self: Self, target: str) -> Option[Widget] {
        ret Option[Widget]::None
    }
    fn runtime_update(self: mut Self, event: AppEvent) -> Self {
        self.value.update(self.bindings, event)
        ret self
    }
    fn runtime_background_interval_ms(self: Self) -> u32 {
        ret self.value.background_interval_ms()
    }
    fn runtime_background_revision(self: Self) -> u64 {
        ret self.value.background_revision()
    }
    fn runtime_can_close(self: Self) -> bool {
        ret self.value.can_close()
    }
    fn runtime_render_surface_id(self: Self) -> str {
        ret ""
    }
    fn runtime_render_overlay_ids(self: Self) -> Vec[str] {
        ret Vec[str]::new()
    }
    fn runtime_prepare_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool {
        ret false
    }
    fn runtime_record_direct_frame(self: Self, frame: VulkanFrameInterop,
        surface: SurfaceSlot, elapsed_ms: u64,) -> bool {
        ret false
    }
}

/// High-level event delivered to managed application state. A value object is
/// used instead of a closed enum so future runtime events remain source
/// compatible for applications.
pub struct AppEvent {
    kind: u32
    action: str
    elapsed_ms: u64
    edit: TextEditIntent
    key: u32
    shift: bool
    control: bool
    target: str
    x: f32
    y: f32
    dx: f32
    dy: f32
    buttons: u32
    modifiers: u32
    timestamp_ns: u64
}

/// A normalized, model-owned edit requested by Luma's managed runtime.
///
/// Applications may apply it to `TextEditor` or translate it to an external
/// document engine. Luma never takes ownership of the document contents.
pub struct TextEditIntent {
    kind: u32
    target: str
    text: str
    extend: bool
    position: usize
}

impl for TextEditIntent {
    fn new(kind: u32, target: str, text: str, extend: bool, position: usize) -> Self {
        ret Self {
            kind, target, text, extend, position
        }
    }
    pub fn none() -> Self {
        ret Self::new(0_u32, "", "", false, 0_usize)
    }
    pub fn insert(target: str, text: str) -> Self {
        ret Self::new(1_u32, target, text, false, 0_usize)
    }
    pub fn backspace(target: str) -> Self {
        ret Self::new(2_u32, target, "", false, 0_usize)
    }
    pub fn delete(target: str) -> Self {
        ret Self::new(3_u32, target, "", false, 0_usize)
    }
    pub fn move_left(target: str, extend: bool) -> Self {
        ret Self::new(4_u32, target, "", extend, 0_usize)
    }
    pub fn move_right(target: str, extend: bool) -> Self {
        ret Self::new(5_u32, target, "", extend, 0_usize)
    }
    pub fn move_home(target: str, extend: bool) -> Self {
        ret Self::new(6_u32, target, "", extend, 0_usize)
    }
    pub fn move_end(target: str, extend: bool) -> Self {
        ret Self::new(7_u32, target, "", extend, 0_usize)
    }
    pub fn move_up(target: str, extend: bool) -> Self {
        ret Self::new(8_u32, target, "", extend, 0_usize)
    }
    pub fn move_down(target: str, extend: bool) -> Self {
        ret Self::new(9_u32, target, "", extend, 0_usize)
    }
    pub fn select_all(target: str) -> Self {
        ret Self::new(10_u32, target, "", false, 0_usize)
    }
    pub fn copy(target: str) -> Self {
        ret Self::new(11_u32, target, "", false, 0_usize)
    }
    pub fn cut(target: str) -> Self {
        ret Self::new(12_u32, target, "", false, 0_usize)
    }
    pub fn paste(target: str, text: str) -> Self {
        ret Self::new(13_u32, target, text, false, 0_usize)
    }
    pub fn place_cursor(target: str, position: usize) -> Self {
        ret Self::new(14_u32, target, "", false, position)
    }
    pub fn extend_to(target: str, position: usize) -> Self {
        ret Self::new(15_u32, target, "", true, position)
    }
    pub fn target(self: Self) -> str {
        ret self.target
    }
    pub fn text(self: Self) -> str {
        ret self.text
    }
    pub fn extend_selection(self: Self) -> bool {
        ret self.extend
    }
    pub fn is_insert(self: Self) -> bool {
        ret self.kind == 1_u32
    }
    pub fn is_backspace(self: Self) -> bool {
        ret self.kind == 2_u32
    }
    pub fn is_delete(self: Self) -> bool {
        ret self.kind == 3_u32
    }
    pub fn is_move(self: Self) -> bool {
        ret self.kind >= 4_u32 && self.kind <= 9_u32
    }
    pub fn is_move_left(self: Self) -> bool {
        ret self.kind == 4_u32
    }
    pub fn is_move_right(self: Self) -> bool {
        ret self.kind == 5_u32
    }
    pub fn is_move_home(self: Self) -> bool {
        ret self.kind == 6_u32
    }
    pub fn is_move_end(self: Self) -> bool {
        ret self.kind == 7_u32
    }
    pub fn is_move_up(self: Self) -> bool {
        ret self.kind == 8_u32
    }
    pub fn is_move_down(self: Self) -> bool {
        ret self.kind == 9_u32
    }
    pub fn is_select_all(self: Self) -> bool {
        ret self.kind == 10_u32
    }
    pub fn is_copy(self: Self) -> bool {
        ret self.kind == 11_u32
    }
    pub fn is_cut(self: Self) -> bool {
        ret self.kind == 12_u32
    }
    pub fn is_paste(self: Self) -> bool {
        ret self.kind == 13_u32
    }
    pub fn is_pointer_selection(self: Self) -> bool {
        ret self.kind == 14_u32 || self.kind == 15_u32
    }
    pub fn position(self: Self) -> usize {
        ret self.position
    }
    pub fn apply(self: Self, editor: TextEditor) -> TextEditor {
        if self.kind == 1_u32 {
            ret editor.insert(self.text)
        }
        if self.kind == 2_u32 {
            ret editor.backspace()
        }
        if self.kind == 3_u32 {
            ret editor.delete()
        }
        if self.kind == 4_u32 {
            ret editor.move_left(self.extend)
        }
        if self.kind == 5_u32 {
            ret editor.move_right(self.extend)
        }
        if self.kind == 6_u32 {
            ret editor.move_line_home(self.extend)
        }
        if self.kind == 7_u32 {
            ret editor.move_line_end(self.extend)
        }
        if self.kind == 8_u32 {
            ret editor.move_up(self.extend)
        }
        if self.kind == 9_u32 {
            ret editor.move_down(self.extend)
        }
        if self.kind == 10_u32 {
            ret editor.select_all()
        }
        if self.kind == 12_u32 {
            ret editor.cut()
        }
        if self.kind == 13_u32 {
            ret editor.paste(self.text)
        }
        if self.kind == 14_u32 {
            ret editor.with_cursor(self.position)
        }
        if self.kind == 15_u32 {
            ret editor.with_selection(editor.selection_anchor(), self.position)
        }
        ret editor
    }
}

impl for AppEvent {
    pub fn action_event(action: str) -> Self {
        ret Self {
            1_u32, action, 0_u64, TextEditIntent::none(), 0_u32, false, false,
            "", 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn tick_event(elapsed_ms: u64) -> Self {
        ret Self {
            2_u32, "", elapsed_ms, TextEditIntent::none(), 0_u32, false, false,
            "", 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn edit_event(edit: TextEditIntent) -> Self {
        ret Self {
            3_u32, "", 0_u64, edit, 0_u32, false, false,
            "", 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn key_event(key: u32, shift: bool, control: bool, modifiers: u32,
        target: str,) -> Self {
        ret Self {
            4_u32, "", 0_u64, TextEditIntent::none(), key, shift, control,
            target, 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32,
            modifiers, 0_u64
        }
    }
    pub fn close_event() -> Self {
        ret Self {
            5_u32, "", 0_u64, TextEditIntent::none(), 0_u32, false, false,
            "", 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn pointer_event(kind: u32, target: str, x: f32, y: f32) -> Self {
        ret Self {
            kind, "", 0_u64, TextEditIntent::none(), 0_u32, false, false,
            target, x, y, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn scroll_event(target: str, x: f32, y: f32, offset: f32, viewport_height: f32) -> Self {
        ret Self {
            9_u32, "", 0_u64, TextEditIntent::none(), 0_u32, false, false,
            target, x, y, offset, viewport_height, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn control_event(target: str, value: f32) -> Self {
        ret Self {
            10_u32, "", 0_u64, TextEditIntent::none(), 0_u32, false, false,
            target, value, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn range_event(target: str, start: f32, end: f32) -> Self {
        ret Self {
            10_u32, "", 0_u64, TextEditIntent::none(), 0_u32, false, false,
            target, start, end, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn raw_pointer_event(kind: u32, target: str, event: Event) -> Self {
        ret Self {
            kind, "", 0_u64, TextEditIntent::none(), event.key(),
            event.shift(), event.control(), target, event.x(), event.y(),
            event.dx(), event.dy(), event.buttons(), event.modifiers(),
            event.timestamp_ns()
        }
    }
    pub fn raw_pointer_sample(kind: u32, target: str, x: f32, y: f32,
        dx: f32, dy: f32, buttons: u32, modifiers: u32,
        timestamp_ns: u64,) -> Self {
        ret Self {
            kind, "", 0_u64, TextEditIntent::none(), 0_u32,
            (modifiers & 3_u32) != 0_u32,(modifiers & 192_u32) != 0_u32,
            target, x, y, dx, dy, buttons, modifiers, timestamp_ns
        }
    }
    pub fn key_up_event(key: u32, shift: bool, control: bool, modifiers: u32,
        target: str,) -> Self {
        ret Self {
            11_u32, "", 0_u64, TextEditIntent::none(), key, shift, control,
            target, 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32,
            modifiers, 0_u64
        }
    }
    pub fn focus_lost_event() -> Self {
        ret Self {
            12_u32, "", 0_u64, TextEditIntent::none(), 0_u32, false, false,
            "", 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0_u64
        }
    }
    pub fn pointer_down(target: str, x: f32, y: f32) -> Self {
        ret Self::pointer_event(6_u32, target, x, y)
    }
    pub fn pointer_move(target: str, x: f32, y: f32) -> Self {
        ret Self::pointer_event(7_u32, target, x, y)
    }
    pub fn pointer_up(target: str, x: f32, y: f32) -> Self {
        ret Self::pointer_event(8_u32, target, x, y)
    }
    pub fn pointer_button_down(target: str, x: f32, y: f32,
        button: u32, modifiers: u32,) -> Self {
        ret Self {
            6_u32, "", 0_u64, TextEditIntent::none(), button,
            (modifiers & 3_u32) != 0_u32,(modifiers & 192_u32) != 0_u32,
            target, x, y, 0.0_f32, 0.0_f32, 0_u32, modifiers, 0_u64
        }
    }
    pub fn pointer_motion(target: str, x: f32, y: f32, dx: f32, dy: f32,
        buttons: u32, modifiers: u32, timestamp_ns: u64,) -> Self {
        ret Self::raw_pointer_sample(7_u32, target, x, y, dx, dy, buttons,
            modifiers, timestamp_ns,)
    }
    pub fn pointer_button_up(target: str, x: f32, y: f32,
        button: u32, modifiers: u32,) -> Self {
        ret Self {
            8_u32, "", 0_u64, TextEditIntent::none(), button,
            (modifiers & 3_u32) != 0_u32,(modifiers & 192_u32) != 0_u32,
            target, x, y, 0.0_f32, 0.0_f32, 0_u32, modifiers, 0_u64
        }
    }
    /// Constructs a managed key press for embedders and deterministic tests.
    pub fn key_down(key: u32, modifiers: u32, target: str) -> Self {
        ret Self::key_event(key,(modifiers & 3_u32) != 0_u32,
            (modifiers & 192_u32) != 0_u32, modifiers, target,)
    }
    /// Constructs a managed key release for embedders and deterministic tests.
    pub fn key_up(key: u32, modifiers: u32, target: str) -> Self {
        ret Self::key_up_event(key,(modifiers & 3_u32) != 0_u32,
            (modifiers & 192_u32) != 0_u32, modifiers, target,)
    }
    /// Constructs the cancellation delivered when the native window loses focus.
    pub fn focus_lost() -> Self {
        ret Self::focus_lost_event()
    }
    pub fn is_action(self: Self) -> bool {
        ret self.kind == 1_u32
    }
    pub fn is_tick(self: Self) -> bool {
        ret self.kind == 2_u32
    }
    pub fn is_text_edit(self: Self) -> bool {
        ret self.kind == 3_u32
    }
    pub fn is_key(self: Self) -> bool {
        ret self.kind == 4_u32
    }
    pub fn is_key_down(self: Self) -> bool {
        ret self.kind == 4_u32
    }
    pub fn is_key_up(self: Self) -> bool {
        ret self.kind == 11_u32
    }
    pub fn is_focus_lost(self: Self) -> bool {
        ret self.kind == 12_u32
    }
    pub fn is_close_requested(self: Self) -> bool {
        ret self.kind == 5_u32
    }
    pub fn is_pointer_down(self: Self) -> bool {
        ret self.kind == 6_u32
    }
    pub fn is_pointer_move(self: Self) -> bool {
        ret self.kind == 7_u32
    }
    pub fn is_pointer_up(self: Self) -> bool {
        ret self.kind == 8_u32
    }
    pub fn is_scroll(self: Self) -> bool {
        ret self.kind == 9_u32
    }
    /// The clamped destination in the nearest scroll viewport.
    pub fn scroll_offset(self: Self) -> f32 {
        ret self.dx
    }
    pub fn scroll_viewport_height(self: Self) -> f32 {
        ret self.dy
    }
    pub fn resized(width: f32, height: f32) -> Self {
        ret Self::pointer_event(13_u32, "", width, height)
    }
    pub fn is_resize(self: Self) -> bool {
        ret self.kind == 13_u32
    }
    /// A checkbox, radio, switch, or range control changed through native
    /// pointer/keyboard interaction.
    pub fn is_control_change(self: Self) -> bool {
        ret self.kind == 10_u32
    }
    pub fn action(self: Self) -> str {
        ret self.action
    }
    pub fn elapsed_ms(self: Self) -> u64 {
        ret self.elapsed_ms
    }
    pub fn text_edit(self: Self) -> TextEditIntent {
        ret self.edit
    }
    pub fn key(self: Self) -> u32 {
        ret self.key
    }
    pub fn shift(self: Self) -> bool {
        ret self.shift
    }
    pub fn control(self: Self) -> bool {
        ret self.control
    }
    pub fn target(self: Self) -> str {
        ret self.target
    }
    pub fn x(self: Self) -> f32 {
        ret self.x
    }
    pub fn y(self: Self) -> f32 {
        ret self.y
    }
    pub fn dx(self: Self) -> f32 {
        ret self.dx
    }
    pub fn dy(self: Self) -> f32 {
        ret self.dy
    }
    pub fn buttons(self: Self) -> u32 {
        ret self.buttons
    }
    pub fn pointer_button(self: Self) -> u32 {
        ret self.key
    }
    pub fn modifiers(self: Self) -> u32 {
        ret self.modifiers
    }
    pub fn timestamp_ns(self: Self) -> u64 {
        ret self.timestamp_ns
    }
    pub fn value(self: Self) -> f32 {
        ret self.x
    }
    pub fn range_start(self: Self) -> f32 {
        ret self.x
    }
    pub fn range_end(self: Self) -> f32 {
        ret self.y
    }
    pub fn checked(self: Self) -> bool {
        ret self.x >= 0.5_f32
    }
}

fn runtime_pointer_sample_is_current(timestamp_ns: u64,
    newest_timestamp_ns: u64,) -> bool {
    // Tests and embedders may synthesize events without a platform timestamp.
    // Native samples are monotonic and may therefore reject stale queued data.
    ret timestamp_ns == 0_u64 || timestamp_ns >= newest_timestamp_ns
}

fn runtime_pending_interaction_timeout(now_ms: u64,
    deadline_ms: u64,) -> u32 {
    ret if now_ms >= deadline_ms {
        0_u32
    } else {
        (deadline_ms - now_ms) as u32
    }
}

fn runtime_background_deadline(previous: u64, now: u64, interval: u32) -> u64 {
    let deadline = now + interval as u64
    ret if interval == 0_u32 || previous > deadline {
        deadline
    } else {
        previous
    }
}

#attr(test)
fn background_deadline_is_not_postponed_by_continuous_input() -> bool {
    let mut deadline = 50_u64
    for time in 1_usize..50_usize {
        deadline = runtime_background_deadline(deadline, time as u64, 50_u32)
    }
    ret deadline == 50_u64 && runtime_background_deadline(50_u64, 20_u64, 8_u32) == 28_u64 &&
    runtime_background_deadline(50_u64, 20_u64, 0_u32) == 20_u64
}

fn runtime_input_precedes_background(kind: u32) -> bool {
    // A command that arrived at the same deadline as a model transition owns
    // the state the user can still see. Defer the background transition to
    // the next loop; the command will either cancel it or reschedule it from
    // the model's remaining time.
    ret kind == event_pointer_up() || kind == event_key_down() ||
    kind == event_key_up() || kind == event_focus_lost()
}

fn runtime_view_captures_application_key(ui: mut ReactiveUi, key: u32) -> bool {
    ret ui.layout().widget().attribute(
        "data-luma-application-key-" + Debug::fmt(key),).is_some()
}

fn runtime_model_captures_application_key(root: Widget, key: u32) -> bool {
    ret root.attribute("data-luma-application-key-" + Debug::fmt(key)).is_some()
}

fn runtime_model_application_key_target(root: Widget, key: u32) -> str {
    ret root.attribute(
        "data-luma-application-key-" + Debug::fmt(key),).unwrap_or("")
}

fn runtime_scrollable_ancestor(root: Widget, target: str) -> str {
    if target == "" || root.find(target).is_none() {
        ret ""
    }
    for child in root.children() {
        let found = runtime_scrollable_ancestor(child, target)
        if found != "" {
            ret found
        }
    }
    ret if root.id() != "" &&
    root.attribute("data-luma-scrollable").unwrap_or("") == "true" {
        root.id()
    } else {
        ""
    }
}

fn runtime_scrollbar_hit(layout: WidgetLayout, x: f32, y: f32) -> str {
    let bounds = layout.bounds()
    if !layout.widget().style().visible() || !layout.widget().style().pointer_events() {
        ret ""
    }
    if x < bounds.x() || x >= bounds.right() || y < bounds.y() || y >= bounds.bottom() {
        ret ""
    }
    let thumb = layout.scrollbar_thumb()
    if thumb.height() > 0.0_f32 && x >= bounds.right() - 12.0_f32 {
        ret layout.widget().id()
    }
    for child in layout.children() {
        let found = runtime_scrollbar_hit(child, x, y)
        if found != "" {
            ret found
        }
    }
    ret ""
}

// Scroll position and thumb use the same short, time-based animation. There
// is no extra render loop while idle and no smoothing of captured dragging.
struct ScrollMotion {
    container: str
    origin: f32
    destination: f32
    started: u64
}

impl for ScrollMotion {
    pub fn idle() -> Self {
        ret Self {
            "", 0.0_f32, 0.0_f32, 0_u64
        }
    }
    pub fn sample(self: Self, now: u64) -> f32 {
        if now <= self.started {
            ret self.origin
        }
        if now - self.started >= 140_u64 {
            ret self.destination
        }
        let remaining = 1.0_f32 -(now - self.started) as f32 / 140.0_f32
        ret self.origin +(self.destination - self.origin) *(1.0_f32 - remaining * remaining)
    }
    pub fn wheel(self: Self, container: str, displayed: f32, delta: f32,
        maximum: f32, now: u64,) -> Self {
        // Accumulate a burst, but reverse immediately from the displayed
        // position instead of first finishing movement in the old direction.
        let base = if self.container == container &&
        (self.destination - displayed) * delta > 0.0_f32 {
            self.destination
        } else {
            displayed
        }
        let raw = base + delta
        let destination = if raw < 0.0_f32 {
            0.0_f32
        } elif raw > maximum {
            maximum
        } else {
            raw
        }
        ret Self {
            container, displayed, destination, now
        }
    }
}

#attr(test)
fn smooth_scroll_retargets_clamps_and_finishes() -> bool {
    let first = ScrollMotion::idle().wheel("list", 0.0_f32, 48.0_f32, 100.0_f32, 1000_u64)
    let middle = first.sample(1070_u64)
    let burst = first.wheel("list", middle, 48.0_f32, 100.0_f32, 1070_u64)
    let reverse = burst.wheel("list", middle, - 48.0_f32, 100.0_f32, 1070_u64)
    let clamped = burst.wheel("list", middle, 200.0_f32, 100.0_f32, 1070_u64)
    let other = burst.wheel("other", 0.0_f32, 48.0_f32, 100.0_f32, 1070_u64)
    ret first.sample(1000_u64) == 0.0_f32 && middle == 36.0_f32 &&
    first.sample(1140_u64) == 48.0_f32 && first.sample(900_u64) == 0.0_f32 &&
    burst.sample(1070_u64) == middle && burst.destination == 96.0_f32 &&
    reverse.destination == 0.0_f32 && clamped.destination == 100.0_f32 &&
    other.destination == 48.0_f32 && clamped.sample(5000_u64) == 100.0_f32
}

fn runtime_control_change(ui: mut ReactiveUi, target: str, pointer_x: f32,
    activate: bool, range_thumb: u32,) -> Option[AppEvent] {
    let widget = match ui.find_widget(target) {
        Some(value) => value
        None => {
            ret Option[AppEvent]::None
        }
    }
    if widget.disabled() {
        ret Option[AppEvent]::None
    }
    if widget.kind() == widget_checkbox() || widget.kind() == widget_switch() {
        if activate {
            ret Option[AppEvent]::Some(AppEvent::control_event(target,
                    if widget.checked() {
                        0.0_f32
                    } else {
                        1.0_f32
                    }
                    ,))
        }
        ret Option[AppEvent]::None
    }
    if widget.kind() == widget_radio() {
        if activate {
            ret Option[AppEvent]::Some(AppEvent::control_event(target, 1.0_f32))
        }
        ret Option[AppEvent]::None
    }
    if widget.kind() == widget_slider() {
        match ui.layout().find_bounds(target) {
            Some(bounds) => {
                let track = slider_track_bounds(bounds, widget.style())
                let raw = if track.width() > 0.0_f32 {
                    (pointer_x - track.x()) / track.width()
                } else {
                    0.0_f32
                }
                let value = if raw < 0.0_f32 {
                    0.0_f32
                } elif raw > 1.0_f32 {
                    1.0_f32
                } else {
                    raw
                }
                ret Option[AppEvent]::Some(AppEvent::control_event(target, value))
            }
            None => {
            }
        }
    }
    if widget.kind() == widget_range_slider() {
        match ui.layout().find_bounds(target) {
            Some(bounds) => {
                let usable = bounds.width() - 18.0_f32
                let raw = if usable > 0.0_f32 {
                    (pointer_x - bounds.x() - 9.0_f32) / usable
                } else {
                    0.0_f32
                }
                let unclamped = if raw < 0.0_f32 {
                    0.0_f32
                } elif raw > 1.0_f32 {
                    1.0_f32
                } else {
                    raw
                }
                let value = runtime_range_snap(widget, unclamped, activate)
                let lower = widget.range_start()
                let upper = widget.range_end()
                ret if range_thumb == 1_u32 {
                    Option[AppEvent]::Some(AppEvent::range_event(target,
                            if value > upper {
                                upper
                            } else {
                                value
                            }
                            , upper,))
                } elif range_thumb == 2_u32 {
                    Option[AppEvent]::Some(AppEvent::range_event(target, lower,
                            if value < lower {
                                lower
                            } else {
                                value
                            }
                            ,))
                } else {
                    // A collapsed range defers thumb selection until the
                    // first directional motion. Pointer-down itself must not
                    // move either endpoint based on sub-pixel rounding.
                    Option[AppEvent]::Some(AppEvent::range_event(target,
                            lower, upper,))
                }
            }
            None => {
            }
        }
    }
    ret Option[AppEvent]::None
}

fn runtime_range_snap(widget: Widget, value: f32, commit: bool) -> f32 {
    let ticks = widget.range_ticks()
    if ticks < 2_usize {
        ret value
    }
    let intervals = ticks - 1_usize
    let scaled = value * intervals as f32
    let nearest_index =(scaled + 0.5_f32) as usize
    let nearest = nearest_index as f32 / intervals as f32
    if commit {
        ret nearest
    }
    // A ruler remains continuous while dragging, but softly attracts the
    // thumb near a mark. This avoids step-to-step teleportation while making
    // each discrete value easy to acquire.
    let distance = if value > nearest {
        value - nearest
    } else {
        nearest - value
    }
    let radius = 0.35_f32 / intervals as f32
    if distance >= radius || radius <= 0.0_f32 {
        ret value
    }
    let attraction = 1.0_f32 - distance / radius
    ret value +(nearest - value) * attraction * attraction
}

fn runtime_update_live_control(ui: mut ReactiveUi, target: str,
    value: f32, range_start: f32, range_end: f32,) -> ReactiveUi {
    ui.cancel_range_transition(target)
    let _painted = match ui.find_widget(target) {
        Some(control) => {
            if control.kind() == widget_slider() {
                ui.patch_value(target, value)
            } elif control.kind() == widget_range_slider() {
                ui.patch_range(target, range_start, range_end)
            } else {
                false
            }
        }
        None => {
            false
        }
    }
    ret ui
}

fn runtime_range_thumb(ui: mut ReactiveUi, target: str, pointer_x: f32) -> u32 {
    let widget = match ui.find_widget(target) {
        Some(value) => value
        None => {
            ret 0_u32
        }
    }
    if widget.kind() != widget_range_slider() {
        ret 0_u32
    }
    match ui.layout().find_bounds(target) {
        Some(bounds) => {
            let usable = bounds.width() - 18.0_f32
            let raw = if usable > 0.0_f32 {
                (pointer_x - bounds.x() - 9.0_f32) / usable
            } else {
                0.0_f32
            }
            let lower_distance = if raw > widget.range_start() {
                raw - widget.range_start()
            } else {
                widget.range_start() - raw
            }
            let upper_distance = if raw > widget.range_end() {
                raw - widget.range_end()
            } else {
                widget.range_end() - raw
            }
            // Equal endpoints must not trap the lower thumb forever. The
            // pointer side disambiguates a collapsed range: press at or left
            // of the shared thumb to move the lower endpoint, and right of it
            // to move the upper endpoint.
            if widget.range_start() == widget.range_end() {
                let distance = if raw > widget.range_start() {
                    raw - widget.range_start()
                } else {
                    widget.range_start() - raw
                }
                let overlap_radius = if usable > 0.0_f32 {
                    9.0_f32 / usable
                } else {
                    1.0_f32
                }
                if distance <= overlap_radius {
                    ret 3_u32
                }
                ret if raw < widget.range_start() {
                    1_u32
                } else {
                    2_u32
                }
            }
            ret if lower_distance <= upper_distance {
                1_u32
            } else {
                2_u32
            }
        }
        None => {
        }
    }
    ret 0_u32
}

fn runtime_slider_control(widget: Widget) -> bool {
    ret widget.kind() == widget_slider() ||
    widget.kind() == widget_range_slider()
}

fn runtime_release_action(ui: mut ReactiveUi, active: str, hit: str) -> str {
    if active == "" {
        ret ""
    }
    match ui.find_widget(active) {
        Some(widget) => {
            if runtime_slider_control(widget) {
                ret active
            }
        }
        None => {
        }
    }
    ret if hit == active {
        active
    } else {
        ""
    }
}

fn runtime_current_control_commit(ui: mut ReactiveUi, target: str,
    range_thumb: u32,) -> Option[AppEvent] {
    let widget = match ui.find_widget(target) {
        Some(value) => value
        None => {
            ret Option[AppEvent]::None
        }
    }
    if widget.disabled() || !runtime_slider_control(widget) {
        ret Option[AppEvent]::None
    }
    if widget.kind() == widget_slider() {
        ret Option[AppEvent]::Some(AppEvent::control_event(target,
                widget.value(),))
    }
    let lower = widget.range_start()
    let upper = widget.range_end()
    let committed_lower = if range_thumb == 1_u32 {
        runtime_range_snap(widget, lower, true)
    } else {
        lower
    }
    let committed_upper = if range_thumb == 2_u32 {
        runtime_range_snap(widget, upper, true)
    } else {
        upper
    }
    ret Option[AppEvent]::Some(AppEvent::range_event(target,
            if committed_lower > committed_upper {
                committed_upper
            } else {
                committed_lower
            }
            , if committed_upper < committed_lower {
                committed_lower
            } else {
                committed_upper
            }
            ,))
}

fn runtime_keyboard_control_change(ui: mut ReactiveUi, target: str,
    event: Event,) -> Option[AppEvent] {
    if event.kind() != event_key_down() ||
    (event.key() != key_left() && event.key() != key_right() &&
        event.key() != key_home() && event.key() != key_end()) {
        ret Option[AppEvent]::None
    }
    let widget = match ui.find_widget(target) {
        Some(value) => value
        None => {
            ret Option[AppEvent]::None
        }
    }
    if widget.disabled() || !runtime_slider_control(widget) {
        ret Option[AppEvent]::None
    }
    let step = if widget.kind() == widget_range_slider() &&
    widget.range_ticks() >= 2_usize {
        1.0_f32 /(widget.range_ticks() - 1_usize) as f32
    } else {
        0.01_f32
    }
    if widget.kind() == widget_slider() {
        let current = widget.value()
        let raw = if event.key() == key_home() {
            0.0_f32
        } elif event.key() == key_end() {
            1.0_f32
        } elif event.key() == key_left() {
            current - step
        } else {
            current + step
        }
        let value = if raw < 0.0_f32 {
            0.0_f32
        } elif raw > 1.0_f32 {
            1.0_f32
        } else {
            raw
        }
        if value == current {
            ret Option[AppEvent]::None
        }
        ret Option[AppEvent]::Some(AppEvent::control_event(target, value))
    }
    let lower = widget.range_start()
    let upper = widget.range_end()
    if event.shift() {
        let raw = if event.key() == key_home() {
            lower
        } elif event.key() == key_end() {
            1.0_f32
        } elif event.key() == key_left() {
            upper - step
        } else {
            upper + step
        }
        let next = if raw < lower {
            lower
        } elif raw > 1.0_f32 {
            1.0_f32
        } else {
            raw
        }
        if next == upper {
            ret Option[AppEvent]::None
        }
        ret Option[AppEvent]::Some(AppEvent::range_event(target, lower, next))
    }
    let raw = if event.key() == key_home() {
        0.0_f32
    } elif event.key() == key_end() {
        upper
    } elif event.key() == key_left() {
        lower - step
    } else {
        lower + step
    }
    let next = if raw < 0.0_f32 {
        0.0_f32
    } elif raw > upper {
        upper
    } else {
        raw
    }
    if next == lower {
        ret Option[AppEvent]::None
    }
    ret Option[AppEvent]::Some(AppEvent::range_event(target, next, upper))
}

fn runtime_keyboard_control_target(ui: mut ReactiveUi, target: str,
    event: Event,) -> bool {
    if event.kind() != event_key_down() ||
    (event.key() != key_left() && event.key() != key_right() &&
        event.key() != key_home() && event.key() != key_end()) {
        ret false
    }
    match ui.find_widget(target) {
        Some(widget) => {
            ret !widget.disabled() && runtime_slider_control(widget)
        }
        None => {
        }
    }
    ret false
}

fn editable_widget(widget: Widget) -> bool {
    ret !widget.disabled() &&(widget.kind() == widget_input() ||
        widget.kind() == widget_textarea() || widget.kind() == widget_terminal())
}

// Printable key-down is followed by the platform's committed text event.
// Reserving it here prevents the generic command path from rebuilding the
// application once before the actual TextEditIntent is delivered.
fn runtime_editor_reserves_printable_key(widget: Option[Widget], event: Event) -> bool {
    if event.kind() != event_key_down() || event.control() ||
    event.key() < 32_u32 || event.key() > 126_u32 {
        ret false
    }
    match widget {
        Some(field) => {
            ret editable_widget(field)
        }
        None => {
        }
    }
    ret false
}

fn runtime_activation_falls_back_to_application_key(action: str, event: Event,
    key_default: bool,) -> bool {
    ret action == "" && key_default && event.kind() == event_key_down() &&
    event.key() == key_enter()
}

fn selected_widget_text(widget: Widget) -> str {
    let selection = widget.selection()
    let start = selection.start()
    let finish = selection.end()
    ret widget.text().slice(start, finish - start)
}

fn runtime_terminal_owns_key(widget: Widget, event: Event) -> bool {
    ret event.kind() == event_key_down() && widget.kind() == widget_terminal() &&
    widget.attribute("terminal-input").is_some() &&
    !(event.control() && event.key() == 118_u32)
}

fn runtime_text_edit(window: Window, focused: str, widget: Option[Widget],
    event: Event,) -> Option[TextEditIntent] {
    if focused == "" {
        ret Option[TextEditIntent]::None
    }
    match widget {
        Option::Some(field) => {
            if !editable_widget(field) {
                ret Option[TextEditIntent]::None
            }
            if event.kind() == event_text_input() && event.text() != "" {
                ret Option[TextEditIntent]::Some(TextEditIntent::insert(focused, event.text()))
            }
            if event.kind() != event_key_down() {
                ret Option[TextEditIntent]::None
            }
            // Terminal applications own control keys; committed text and paste
            // still use the normal platform text-input path.
            if runtime_terminal_owns_key(field, event) {
                ret Option[TextEditIntent]::None
            }
            if event.control() && event.key() == 97_u32 {
                ret Option[TextEditIntent]::Some(TextEditIntent::select_all(focused))
            }
            if event.control() && event.key() == 99_u32 {
                let _copied = window.set_clipboard(selected_widget_text(field))
                ret Option[TextEditIntent]::Some(TextEditIntent::copy(focused))
            }
            if event.control() && event.key() == 120_u32 {
                let _copied = window.set_clipboard(selected_widget_text(field))
                ret Option[TextEditIntent]::Some(TextEditIntent::cut(focused))
            }
            if event.control() && event.key() == 118_u32 {
                ret Option[TextEditIntent]::Some(TextEditIntent::paste(focused, window.clipboard_text()))
            }
            if event.key() == key_backspace() {
                ret Option[TextEditIntent]::Some(TextEditIntent::backspace(focused))
            }
            if event.key() == key_delete() {
                ret Option[TextEditIntent]::Some(TextEditIntent::delete(focused))
            }
            if event.key() == key_left() {
                ret Option[TextEditIntent]::Some(TextEditIntent::move_left(focused, event.shift()))
            }
            if event.key() == key_right() {
                ret Option[TextEditIntent]::Some(TextEditIntent::move_right(focused, event.shift()))
            }
            if event.key() == key_home() {
                ret Option[TextEditIntent]::Some(TextEditIntent::move_home(focused, event.shift()))
            }
            if event.key() == key_end() {
                ret Option[TextEditIntent]::Some(TextEditIntent::move_end(focused, event.shift()))
            }
            if event.key() == key_up() {
                ret Option[TextEditIntent]::Some(TextEditIntent::move_up(focused, event.shift()))
            }
            if event.key() == key_down() {
                ret Option[TextEditIntent]::Some(TextEditIntent::move_down(focused, event.shift()))
            }
            if event.key() == key_enter() &&
            (field.kind() == widget_textarea() || field.kind() == widget_terminal()) {
                ret Option[TextEditIntent]::Some(TextEditIntent::insert(focused, "\n"))
            }
        }
        Option::None => {
        }
    }
    ret Option[TextEditIntent]::None
}

fn runtime_pointer_edit(window: Window, ui: mut ReactiveUi, target: str,
    x: f32, y: f32, extend: bool,) -> Option[TextEditIntent] {
    if target == "" {
        ret Option[TextEditIntent]::None
    }
    let field = match ui.find_widget(target) {
        Option::Some(value) => value
        Option::None => {
            ret Option[TextEditIntent]::None
        }
    }
    if !editable_widget(field) {
        ret Option[TextEditIntent]::None
    }
    match ui.layout().find_bounds(target) {
        Option::Some(bounds) => {
            let position = if field.kind() == widget_textarea() {
                window.textarea_text_index(field, bounds, x, y)
            } else {
                window.text_index(field.text(), x - bounds.x() - 10.0_f32)
            }
            ret Option[TextEditIntent]::Some(if extend {
                    TextEditIntent::extend_to(target, position)
                } else {
                    TextEditIntent::place_cursor(target, position)
                }
            )
        }
        Option::None => {
        }
    }
    ret Option[TextEditIntent]::None
}

/// Scheduler policy for managed applications.
pub struct ApplicationOptions {
    frame_interval_ms: u32
    interaction_interval_ms: u32
    reduced_motion: bool
    application_key: u32
    exit_key: u32
}

impl for ApplicationOptions {
    /// Event-driven UI without periodic frames.
    pub fn event_driven() -> Self {
        ret Self {
            0_u32, 4_u32, false, 0_u32, 0_u32
        }
    }
    /// Requests animation ticks at up to `frames_per_second`.
    pub fn animated(frames_per_second: u32) -> Self {
        let fps = if frames_per_second == 0_u32 {
            60_u32
        } else {
            frames_per_second
        }
        ret Self {
            if fps >= 1000_u32 {
                1_u32
            } else {
                1000_u32 / fps
            }
            , 4_u32, false, 0_u32, 0_u32
        }
    }
    pub fn frame_interval_ms(self: Self) -> u32 {
        ret self.frame_interval_ms
    }
    /// Minimum interval between coalesced interaction samples. This does not
    /// generate idle frames or delay ordered press/release/text events.
    pub fn with_interaction_interval_ms(self: mut Self, interval: u32) -> Self {
        self.interaction_interval_ms = if interval == 0 {
            1_u32
        } else {
            interval
        }
        ret self
    }
    pub fn interaction_interval_ms(self: Self) -> u32 {
        ret self.interaction_interval_ms
    }
    /// Disables interpolation while preserving final styles and input state.
    pub fn with_reduced_motion(self: mut Self, reduced: bool) -> Self {
        self.reduced_motion = reduced
        ret self
    }
    pub fn reduced_motion(self: Self) -> bool {
        ret self.reduced_motion
    }
    /// Routes one global command key to `Application::update` before focused
    /// control activation. Zero disables global key capture.
    pub fn with_application_key(self: mut Self, key: u32) -> Self {
        self.application_key = key
        ret self
    }
    pub fn captures_application_key(self: Self, key: u32) -> bool {
        ret self.application_key != 0_u32 && self.application_key == key
    }
    /// Requests a graceful application close when `key` is pressed and the
    /// current view has not captured that key for a local interaction.
    pub fn with_exit_key(self: mut Self, key: u32) -> Self {
        self.exit_key = key
        ret self
    }
    pub fn requests_exit_key(self: Self, key: u32) -> bool {
        ret self.exit_key != 0_u32 && self.exit_key == key
    }
}

fn runtime_widget_has_attribute(ui: mut ReactiveUi, target: str,
    name: str,) -> bool {
    if target == "" {
        ret false
    }
    match ui.find_widget(target) {
        Some(widget) => {
            ret widget.attribute(name).is_some()
        }
        None => {
            ret false
        }
    }
}

fn runtime_raw_input_target(ui: mut ReactiveUi, target: str) -> bool {
    ret runtime_widget_has_attribute(ui, target, "data-luma-raw-input")
}

fn runtime_secondary_pointer_lock_target(ui: mut ReactiveUi,
    target: str,) -> bool {
    ret runtime_widget_has_attribute(ui, target,
        "data-luma-secondary-pointer-lock",)
}

fn runtime_keyboard_activation_action(ui: mut ReactiveUi, action: str) -> str {
    if action == "" {
        ret ""
    }
    match ui.find_widget(action) {
        Some(widget) => {
            if runtime_slider_control(widget) {
                ret ""
            }
        }
        None => {
        }
    }
    ret action
}

fn runtime_starts_with(value: str, prefix: str) -> bool {
    ret value.len() >= prefix.len() &&
    value.slice(0_usize, prefix.len()) == prefix
}

fn runtime_cursor_for_target(ui: mut ReactiveUi, target: str) -> u32 {
    match ui.find_widget(target) {
        Some(widget) => {
            if widget.style().pointer_cursor() != cursor_default() {
                ret widget.style().pointer_cursor()
            }
        }
        None => {
        }
    }
    if target == "splitter-explorer" || target == "splitter-assistant" {
        ret cursor_resize_horizontal()
    }
    if target == "splitter-terminal" {
        ret cursor_resize_vertical()
    }
    if target == "code-editor" {
        ret cursor_text()
    }
    ret cursor_default()
}

fn declared_focus(widget: Widget) -> str {
    if widget.focused() && editable_widget(widget) && widget.id() != "" {
        ret widget.id()
    }
    for child in widget.children() {
        let found = declared_focus(child)
        if found != "" {
            ret found
        }
    }
    ret ""
}

fn reconcile_declared_focus(window: Window, ui: mut ReactiveUi,
    interaction: InteractionState,) -> InteractionState {
    // Bound models apply changed hints once at the model-update boundary.
    // Reapplying a persistent hint on release would steal pointer focus.
    if window.bound_declared_focus().is_some() {
        ret interaction
    }
    let desired = declared_focus(ui.layout().retained_widget())
    if desired == "" || desired == interaction.focused() {
        ret interaction
    }
    ret interaction.with_focus(desired)
}

#attr(test)
fn model_focus_hint_preserves_pointer_focus_on_release() -> bool {
    let root = Widget::panel("focus-root").with_child(Widget::input("first-field", "").with_focus(true))
    .with_child(Widget::input("second-field", ""))
    let mut bindings = UiBindings::new(UiContext::new())
    let mounted = bindings.mount(root)
    bindings.declare_focus(mounted, "first-field")
    let window = Window::create_with_renderer("Bound focus", 320, 160, RendererKind::Software).with_bindings(bindings, mounted)
    if !window.available() {
        ret false
    }
    let mut ui = window.reactive(root)
    let pointer = InteractionState::new().with_focus("second-field")
    let retained = reconcile_declared_focus(window, ui, pointer)
    let valid = retained.focused() == "second-field" && window.bound_declared_focus().unwrap_or("") == "first-field"
    window.destroy() ret valid
}

fn runtime_styled_view(sheet: StyleSheet, root: Widget, hovered: str, active: str,
    focused: str,) -> Widget {
    // Keep computed CSS eligible for later pseudo-class updates. Turning it
    // into an explicit style here disabled hover/active in the managed loop.
    ret sheet.apply(root, hovered, active, focused)
}

fn runtime_update_model_widget(window: Window, ui: mut ReactiveUi,
    sheet: StyleSheet, raw: Widget, target: str, hovered: str, active: str,
    focused: str,) -> ReactiveUi {
    let replacement = if raw.id() == "" {
        raw.with_id(target)
    } else {
        raw
    }
    let next = runtime_replace_retained_fragment(ui.declarative_root(), target, replacement)
    ret runtime_update_model(window, ui, sheet, next, hovered, active, focused)
}

fn runtime_patch_model_widget(window: Window, ui: mut ReactiveUi,
    sheet: StyleSheet, raw: Widget, target: str, hovered: str, active: str,
    focused: str,) -> ReactiveUi {
    ui = runtime_update_model_widget(window, ui, sheet, raw, target,
        hovered, active, focused,)
    ret ui
}

fn runtime_patch_model_fragment(window: Window, ui: mut ReactiveUi,
    sheet: StyleSheet, raw: Widget, hovered: str, active: str,
    focused: str,) -> ReactiveUi {
    let fragment_target = raw.id()
    if fragment_target == "" {
        ret ui
    }
    let next = runtime_replace_retained_fragment(
        ui.declarative_root(), fragment_target, raw,)
    ret runtime_update_model(window, ui, sheet, next, hovered, active, focused)
}

fn runtime_replace_retained_fragment(root: Widget, target: str,
    replacement: Widget,) -> Widget {
    if root.id() == target {
        ret replacement
    }
    let mut children = Vec[Widget]::new()
    for child in root.children() {
        children.push(runtime_replace_retained_fragment(
                child, target, replacement,))
    }
    ret root.with_children(children)
}

fn runtime_patch_application_target[M: RuntimeApplication](window: Window,
    ui: mut ReactiveUi, sheet: StyleSheet, current: M, target: str,
    hovered: str, active: str, focused: str,) -> ReactiveUi {
    match current.runtime_view_target(target) {
        Some(raw) => {
            let patch_target = if raw.id() == "" {
                target
            } else {
                raw.id()
            }
            if raw.children().len() > 0_usize {
                ret runtime_patch_model_fragment(window, ui, sheet, raw,
                    hovered, active, focused,)
            }
            ret runtime_patch_model_widget(window, ui, sheet, raw, patch_target,
                hovered, active, focused,)
        }
        None => {
        }
    }
    // A plain Application can change siblings (for example search results)
    // when an input changes. Only an explicit view_target limits that update.
    ret runtime_update_model(window, ui, sheet, current.runtime_view(),
        hovered, active, focused,)
}

fn runtime_update_retained_live_control(ui: mut ReactiveUi, target: str,
    value: f32, range_start: f32, range_end: f32, _active: str,) -> ReactiveUi {
    ui = runtime_update_live_control(ui, target, value, range_start, range_end)
    match ui.declarative_root().find(target) {
        Some(source) => {
            let updated = if source.kind() == widget_range_slider() {
                source.with_value(range_start)
                .with_attribute("data-luma-range-end", Debug::fmt(range_end))
            } else {
                source.with_value(value)
            }
            ui.set_declarative_root(runtime_replace_retained_fragment(
                    ui.declarative_root(), target, updated,))
        }
        None => {
        }
    }

    ret ui
}

fn runtime_update_application_live_control[M: RuntimeApplication](window: Window,
    ui: mut ReactiveUi, sheet: StyleSheet, current: M, target: str,
    value: f32, range_start: f32, range_end: f32, hovered: str,
    active: str, focused: str,) -> ReactiveUi {
    match current.runtime_view_target(target) {
        Some(raw) => {
            let contains_control = raw.id() == target || match raw.find(target) {
                Some(_) => true
                None => false
            }
            if !contains_control {
                ui = runtime_update_retained_live_control(ui, target, value,
                    range_start, range_end, active,)
            }
            ui = runtime_update_model_widget(window, ui, sheet, raw,
                if raw.id() == "" {
                    target
                } else {
                    raw.id()
                }
                , hovered, active, focused,)
        }
        None => {
            // Ordinary applications have no fragment hint. Their model may
            // update labels or other siblings on every input sample too.
            ui = runtime_update_model(window, ui, sheet, current.runtime_view(),
                hovered, active, focused,)
        }
    }
    ret ui
}

fn runtime_update_model(window: Window, ui: mut ReactiveUi,
    sheet: StyleSheet, root: Widget, hovered: str, active: str,
    focused: str,) -> ReactiveUi {
    if window.has_bindings() {
        ret window.stage_binding_frame(ui, hovered, active, focused, perf_counter_ms())
    }
    // Authored data, computed targets and displayed animation values have
    // independent lifetimes. Never reset pseudo classes to reconcile data.
    ui.set_declarative_root(root)
    let trace_start = perf_counter_ms()
    let styled = window.resolve_styles(sheet, root, hovered, active, focused, ui.keyboard_focus())
    let trace_css = perf_counter_ms()
    let result = window.stage_animated_reactive(ui, styled, trace_css)
    if env("LUMA_TRACE_LATENCY").unwrap_or("") == "1" {
        eprintln(f"LUMA_STYLE css={trace_css - trace_start} stage={perf_counter_ms() - trace_css}")
    }
    ret result
}

#attr(test)
fn scroll_viewport_event_preserves_wheel_and_destination() -> bool {
    let event = AppEvent::scroll_event("grid", 0.0_f32, - 1.0_f32, 48.0_f32, 600.0_f32)
    let resized = AppEvent::resized(800.0_f32, 700.0_f32)
    ret event.is_scroll() && event.y() == - 1.0_f32 &&
    event.scroll_offset() == 48.0_f32 && event.scroll_viewport_height() == 600.0_f32 &&
    resized.is_resize() && !resized.is_scroll() && resized.y() == 700.0_f32
}

#attr(test)
fn runtime_hover_is_stable_declarative_state() -> bool {
    let button = Widget::button("hover-target", "Hover")
    let sheet = StyleSheet::default()
    let first = runtime_styled_view(sheet, button, "hover-target", "", "")
    let second = runtime_styled_view(sheet, button, "hover-target", "", "")
    let normal = runtime_styled_view(sheet, button, "", "", "")
    let hovered = sheet.style(normal, true, false, false)
    ret !normal.has_explicit_style() &&
    hovered.background().packed() != normal.style().background().packed() &&
    first.style().background().packed() ==
    second.style().background().packed()
    && first.style().background().packed() !=
    button.style().background().packed()
}

/// Runs an application with retained rendering, automatic input state,
/// blocking idle waits and redraws only after observable state changes.
pub fn run_reactive_application[A: ReactiveApplication](window: Window, model: mut A<H>) -> A<H> {
    let mut bindings = UiBindings::new(UiContext::new())
    let root = model.mount(bindings)
    let tree = bindings.tree()
    let mounted = tree.snapshot(root).unwrap_or(Widget::panel(""))
    bindings.commit_authored_view(mounted)
    let _initial = tree.take_changes()
    let finished = run_runtime_application[ReactiveApplicationAdapter[A]](window.with_bindings(bindings, root),
        ReactiveApplicationAdapter[A] { model, bindings, root, mounted }, ApplicationOptions::event_driven(),)
    ret finished.value
}

pub fn run_application[A: Application](window: Window, model: A) -> A {
    ret run_application_with_options(
        window, model, ApplicationOptions::event_driven(),)
}

/// Runs with an explicit animation scheduler. No ticks are generated for the
/// default event-driven policy.
pub fn run_application_with_options[A: Application](window: Window, model: A,
    options: ApplicationOptions,) -> A {
    let finished = run_runtime_application[ApplicationAdapter[A]](window,
        ApplicationAdapter[A] {
            model
        }
        , options,)
    ret finished.value
}

/// Runs an application that can supply exact widget patches for hot updates.
/// Hover, focus, input and other stable-node changes stay on the retained fast
/// path while structural events transparently use the complete view.
pub fn run_incremental_application[A: IncrementalApplication](window: Window,
    model: A,) -> A {
    ret run_incremental_application_with_options(window, model,
        ApplicationOptions::event_driven(),)
}

pub fn run_incremental_application_with_options[A: IncrementalApplication](
    window: Window, model: A, options: ApplicationOptions,) -> A {
    let finished = run_runtime_application[IncrementalApplicationAdapter[A]](window,
        IncrementalApplicationAdapter[A] {
            model
        }
        , options,)
    ret finished.value
}

/// Runs an incremental application whose render-surface pixels are recorded
/// into Luma's active Vulkan command buffer without an intermediate texture.
pub fn run_direct_render_application[A: DirectRenderApplication](window: Window,
    model: A,) -> A {
    let finished = run_runtime_application[DirectRenderApplicationAdapter[A]](
        window, DirectRenderApplicationAdapter[A] {
            model
        }
        ,
        ApplicationOptions::event_driven(),)
    ret finished.value
}

fn runtime_present[M: RuntimeApplication](window: Window, ui: mut ReactiveUi,
    current: M, elapsed_ms: u64, rebuild_retained_cache: bool,) -> ReactiveUi {
    let surface_id = current.runtime_render_surface_id()
    if surface_id == "" {
        ret window.draw_reactive(ui)
    }
    let overlay_ids = current.runtime_render_overlay_ids()
    let mut overlay_layouts = Vec[WidgetLayout]::new()
    if rebuild_retained_cache {
        for overlay_id in overlay_ids {
            match ui.find_layout(overlay_id) {
                Some(layout) => overlay_layouts.push(layout)
                None => {
                }
            }
        }
    }
    let prepared = window.prepare_frame(ui.layout(), true)
    // The prepared transaction needs overlay IDs only so the retained
    // base excludes those subtrees. Keep the actual layouts for the
    // independent transparent overlay cache instead of passing one owned
    // Vec through two native-facing calls.
    .with_overlays(current.runtime_render_overlay_ids(),
        Vec[WidgetLayout]::new(), true,)
    let surface = match prepared.surface(surface_id) {
        Some(value) => value
        None => {
            ret ui
        }
    }
    if rebuild_retained_cache {
        if !window.cache_prepared_frame(prepared) ||
        !window.cache_overlay_layouts(overlay_layouts) {
            ret ui
        }
        ui.commit_prepared()
    }
    let borrowed = window.prepare_cached_vulkan_frame(
        Vec[WidgetLayout]::new(), true,)
    if !borrowed.valid() ||
    !current.runtime_prepare_direct_frame(borrowed, surface, elapsed_ms) ||
    !window.begin_vulkan_composition(borrowed) ||
    !current.runtime_record_direct_frame(borrowed, surface, elapsed_ms) ||
    !window.present_vulkan_frame(borrowed) {
        ret ui
    }
    ui.commit_rendered()
    ret ui
}

fn run_runtime_application[M: RuntimeApplication](window: Window, model: M,
    options: ApplicationOptions,) -> M {
    if !window.available() {
        ret model
    }
    let trace_latency = env("LUMA_TRACE_LATENCY").unwrap_or("") == "1"
    let mut profiler = FrameProfiler::new()
    let fonts = FontManager::system_default()
    let _registered_fonts = fonts.register_all(window)
    let _active_font = fonts.activate_default(window, 14.0_f32, 400_u32)
    let mut current = model
    let mut interaction = InteractionState::new()
    let mut hovered = ""
    let mut active = ""
    let mut scrollbar_drag = ""
    let mut scrollbar_grab = 0.0_f32
    let mut scroll_motion = ScrollMotion::idle()
    let mut last_width = window.width()
    let mut last_height = window.height()
    let mut last_density = window.pixel_density()
    let mut ui = window.reactive(current.runtime_view())
    ui = ui.with_reduced_motion(options.reduced_motion())
    let _initial_cursor = window.set_cursor(cursor_default())
    interaction = interaction.with_focus(
        declared_focus(ui.layout().retained_widget()),)
    let mut last_declared_focus = declared_focus(ui.declarative_root())
    let started = perf_counter_ms()
    let interaction_frame_ms = options.interaction_interval_ms() as u64
    let mut next_interaction_frame = started
    let mut model_interval = current.runtime_background_interval_ms()
    let mut next_tick = started + if model_interval > 0_u32 {
        model_interval as u64
    } else {
        options.frame_interval_ms() as u64
    }
    let mut model_updated = false
    let mut close_pending = false
    let mut direct_frame_pending = current.runtime_render_surface_id() != ""
    let mut next_present_attempt = 0_u64
    let mut range_thumb = 0_u32
    // Pointer motion is sampled at native speed but reduced to one preview
    // update per displayed frame. These scalar slots deliberately avoid an
    // allocated event queue on the interactive hot path.
    let mut pending_motion_target = ""
    let mut pending_motion_x = 0.0_f32
    let mut pending_motion_y = 0.0_f32
    let mut pending_motion_dx = 0.0_f32
    let mut pending_motion_dy = 0.0_f32
    let mut pending_motion_timestamp_ns = 0_u64
    let mut pending_motion_buttons = 0_u32
    let mut pending_motion_modifiers = 0_u32
    let mut pending_selection = ""
    let mut pending_selection_x = 0_f32
    let mut pending_selection_y = 0_f32
    let mut pending_control_target = ""
    let mut pending_control_value = 0.0_f32
    let mut pending_control_start = 0.0_f32
    let mut pending_control_end = 0.0_f32
    let mut pending_control_range = false

    while window.is_open() {
        let now = perf_counter_ms()
        let interval = if model_interval > 0_u32 {
            model_interval
        } else {
            options.frame_interval_ms()
        }
        let timeout = if ui.is_dirty() || window.has_pending_bindings() || direct_frame_pending {
            if window.frame_status() == 3 {
                1000_u32
            } elif now < next_present_attempt {
                (next_present_attempt - now) as u32
            } else {
                0_u32
            }
        } elif pending_control_target != "" || pending_motion_target != "" || pending_selection != "" {
            // A final motion sample can arrive just before the frame boundary
            // and then be followed by complete pointer stillness. Wake at the
            // boundary ourselves; never wait for release, focus, or another
            // motion event to make that sample visible.
            runtime_pending_interaction_timeout(now, next_interaction_frame)
        } elif ui.has_active_transitions() || scroll_motion.container != "" {
            runtime_pending_interaction_timeout(now, next_interaction_frame)
        } elif interval == 0_u32 {
            1000_u32
        } elif now >= next_tick {
            0_u32
        } else {
            (next_tick - now) as u32
        }
        let event = window.wait(timeout)
        let profile_start = if profiler.enabled() {
            perf_counter_ns()
        } else {
            0_u64
        }
        if event.kind() == event_pointer_down() || event.kind() == event_key_down() ||
        event.kind() == event_focus_lost() || event.kind() == event_resize() {
            scroll_motion = ScrollMotion::idle()
        }
        let modality_changed = if event.kind() == event_pointer_down() {
            ui.set_keyboard_focus(false)
        } elif event.kind() == event_key_down() &&
        (event.modifiers() & 4032_u32) == 0_u32 &&
        (event.key() < 1073742048_u32 || event.key() > 1073742055_u32) {
            // Ctrl/Alt/GUI shortcuts and modifier-only presses do not change
            // modality. Pointer motion does not erase keyboard navigation.
            ui.set_keyboard_focus(true)
        } else {
            false
        }
        if modality_changed {
            ui = runtime_update_model(window, ui, window.stylesheet(),
                ui.declarative_root(), hovered, active, interaction.focused(),)
        }
        let after_wait = perf_counter_ms()
        let background_deferred = interval > 0_u32 && after_wait >= next_tick && runtime_input_precedes_background(event.kind())
        if pending_selection != "" && event.kind() != event_pointer_move() && event.kind() != event_pointer_up() &&
        (after_wait >= next_interaction_frame || event.kind() != event_none()) {
            match runtime_pointer_edit(window, ui, pending_selection, pending_selection_x, pending_selection_y, true) {
                Some(intent) => {
                    current = current.runtime_update(AppEvent::edit_event(intent)) model_updated = true
                    ui = runtime_patch_application_target[M](window, ui, window.stylesheet(), current, pending_selection, hovered, active, interaction.focused())
                }
                None => {
                }
            }
            pending_selection = ""
        }
        if ui.has_active_transitions() && after_wait >= next_interaction_frame {
            let _advanced = ui.advance_transitions(after_wait)
        }
        // A release commits its final coordinate directly, so an unpainted
        // preview from the same batch must not rebuild the application first.
        // Other order-sensitive events observe one reduced preview before
        // they run. Pointer callbacks follow the same once-per-frame rule.
        if event.kind() == event_pointer_up() {
            if pending_motion_target != "" {
                let _pointer_move_default = ui.dispatch_event(
                    pending_motion_target,
                    UiEvent::pointer(ui_event_pointer_move(),
                        pending_motion_target, pending_motion_x,
                        pending_motion_y, pending_motion_dx,
                        pending_motion_dy,),)
                if runtime_raw_input_target(ui, pending_motion_target) {
                    current = current.runtime_update(AppEvent::raw_pointer_sample(
                            7_u32, pending_motion_target, pending_motion_x,
                            pending_motion_y, pending_motion_dx, pending_motion_dy,
                            pending_motion_buttons, pending_motion_modifiers,
                            pending_motion_timestamp_ns,))
                    model_updated = true
                }
            }
            pending_motion_target = ""
            pending_motion_dx = 0.0_f32
            pending_motion_dy = 0.0_f32
            pending_motion_timestamp_ns = 0_u64
            pending_motion_buttons = 0_u32
            pending_motion_modifiers = 0_u32
            pending_control_target = ""
        } elif event.kind() != event_pointer_move() {
            if pending_control_target != "" {
                let preview = if pending_control_range {
                    AppEvent::range_event(pending_control_target,
                        pending_control_start, pending_control_end,)
                } else {
                    AppEvent::control_event(pending_control_target,
                        pending_control_value,)
                }
                current = current.runtime_update(preview)
                model_updated = true
                ui = runtime_update_application_live_control[M](window, ui,
                    window.stylesheet(), current, pending_control_target,
                    pending_control_value, pending_control_start,
                    pending_control_end, hovered, active,
                    interaction.focused(),)
            }
            if pending_motion_target != "" {
                let _pointer_move_default = ui.dispatch_event(
                    pending_motion_target,
                    UiEvent::pointer(ui_event_pointer_move(),
                        pending_motion_target, pending_motion_x,
                        pending_motion_y, pending_motion_dx,
                        pending_motion_dy,),)
                if runtime_raw_input_target(ui, pending_motion_target) {
                    current = current.runtime_update(AppEvent::raw_pointer_sample(
                            7_u32, pending_motion_target, pending_motion_x,
                            pending_motion_y, pending_motion_dx, pending_motion_dy,
                            pending_motion_buttons, pending_motion_modifiers,
                            pending_motion_timestamp_ns,))
                    model_updated = true
                }
            }
            pending_motion_target = ""
            pending_motion_dx = 0.0_f32
            pending_motion_dy = 0.0_f32
            pending_motion_timestamp_ns = 0_u64
            pending_motion_buttons = 0_u32
            pending_motion_modifiers = 0_u32
            pending_control_target = ""
        }
        if interval > 0_u32 && after_wait >= next_tick &&
        !runtime_input_precedes_background(event.kind()) {
            let trace_tick_start = perf_counter_ms()
            let before_revision = current.runtime_background_revision()
            current = current.runtime_update(AppEvent::tick_event(after_wait - started))
            let trace_tick_updated = perf_counter_ms()
            model_updated = true
            if current.runtime_background_revision() != before_revision {
                // Incremental applications may expose the fragment affected
                // by a scheduled model transition. Non-incremental adapters
                // return None and retain the full reconciliation path.
                match current.runtime_view_target("__luma_background__") {
                    Some(raw) => {
                        let trace_tick_view = perf_counter_ms()
                        let target = raw.id()
                        ui = if target == "" {
                            runtime_update_model(window, ui,
                                window.stylesheet(), current.runtime_view(),
                                hovered, active, interaction.focused(),)
                        } elif raw.children().len() > 0_usize {
                            runtime_patch_model_fragment(window, ui,
                                window.stylesheet(), raw, hovered, active,
                                interaction.focused(),)
                        } else {
                            runtime_patch_model_widget(window, ui,
                                window.stylesheet(), raw, target, hovered,
                                active, interaction.focused(),)
                        }
                        if trace_latency {
                            eprintln("LUMA_TRACE tick update=" + Debug::fmt(trace_tick_updated - trace_tick_start) +
                                " view=" + Debug::fmt(trace_tick_view - trace_tick_updated) +
                                " patch=" + Debug::fmt(perf_counter_ms() - trace_tick_view))
                        }
                    }
                    None => {
                        ui = runtime_update_model(window, ui,
                            window.stylesheet(), current.runtime_view(),
                            hovered, active, interaction.focused(),)
                    }
                }
            }
