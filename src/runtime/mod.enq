            interaction.focused(), event,) {
            let target = interaction.focused()
            let key_default = ui.dispatch_event(target,
                UiEvent::keyboard(ui_event_key_down(), target,
                    event.key(), event.modifiers(),),)
            if key_default {
                match runtime_keyboard_control_change(ui, target, event) {
                    Some(change) => {
                        current = current.runtime_update(change)
                        current = current.runtime_update(
                            AppEvent::action_event(target),)
                        model_updated = true
                        ui = runtime_update_model(window, ui,
                            window.stylesheet(), current.runtime_view(),
                            hovered, active, interaction.focused(),)
                    }
                    None => {
                    }
                }
            }
        } elif event.kind() == event_key_down() &&
        (event.key() == key_enter() || event.key() == 32_u32) {
            let key_default = ui.dispatch_event(interaction.focused(),
                UiEvent::keyboard(ui_event_key_down(), interaction.focused(), event.key(), event.modifiers()),)
            let action = runtime_keyboard_activation_action(ui,
                interaction.focused_action(ui.layout().retained_widget()),)
            if action != "" && key_default {
                let _click_default = ui.dispatch_event(action,
                    UiEvent::new(ui_event_click(), action),)
                match runtime_control_change(ui, action, 0.0_f32, true, 0_u32) {
                    Some(change) => {
                        current = current.runtime_update(change)
                        model_updated = true
                    }
                    None => {
                    }
                }
                current = current.runtime_update(AppEvent::action_event(action))
                model_updated = true
                ui = runtime_update_model(window, ui, window.stylesheet(),
                    current.runtime_view(), hovered, active, interaction.focused(),)
            } elif runtime_activation_falls_back_to_application_key(action,
                event, key_default,) {
                // Enter in a text field is not a control activation. Preserve
                // it as an application command so address bars and dialogs
                // can commit their current editor value.
                current = current.runtime_update(AppEvent::key_event(
                        event.key(), event.shift(), event.control(), event.modifiers(),
                        interaction.focused(),))
                model_updated = true
                ui = runtime_update_model(window, ui, window.stylesheet(),
                    current.runtime_view(), hovered, active,
                    interaction.focused(),)
            }
        } elif runtime_editor_reserves_printable_key(
            ui.find_widget(interaction.focused()), event,) {
            let _key_default = ui.dispatch_event(interaction.focused(),
                UiEvent::keyboard(ui_event_key_down(), interaction.focused(),
                    event.key(), event.modifiers(),),)
            // Committed text comes only from the native text-input event.
        } elif event.kind() == event_key_down() {
            let key_default = ui.dispatch_event(interaction.focused(),
                UiEvent::keyboard(ui_event_key_down(), interaction.focused(), event.key(), event.modifiers()),)
            if key_default {
                current = current.runtime_update(AppEvent::key_event(
                        event.key(), event.shift(), event.control(), event.modifiers(),
                        interaction.focused(),))
                model_updated = true
            }
            ui = runtime_update_model(window, ui, window.stylesheet(),
                current.runtime_view(), hovered, active, interaction.focused(),)
        } elif event.kind() == event_key_up() {
            let _key_up_default = ui.dispatch_event(interaction.focused(),
                UiEvent::keyboard(ui_event_key_up(), interaction.focused(), event.key(), event.modifiers()),)
            if runtime_raw_input_target(ui, interaction.focused()) ||
            runtime_view_captures_application_key(ui, event.key()) ||
            options.captures_application_key(event.key()) {
                current = current.runtime_update(AppEvent::key_up_event(
                        event.key(), event.shift(), event.control(),
                        event.modifiers(), interaction.focused(),))
                model_updated = true
            }
        }
        // A command-key update can open a dialog just like a pointer action.
        // Apply a changed authored focus request once, so subsequent typing in
        // another field does not pull focus back to the dialog's first input.
        if model_updated {
            let desired_focus = match window.bound_declared_focus() {
                Some(target) => target None => declared_focus(ui.declarative_root())
            }
            if desired_focus != last_declared_focus {
                last_declared_focus = desired_focus
                if desired_focus != "" && desired_focus != interaction.focused() {
                    interaction = interaction.with_focus(desired_focus)
                    ui = runtime_update_model(window, ui, window.stylesheet(),
                        ui.declarative_root(), hovered, active, interaction.focused(),)
                }
            }
        }
        // Continuous pointer traffic may keep the native queue non-empty for
        // longer than a frame. Flush exactly the newest sample at a bounded
        // cadence instead of waiting for EVENT_NONE (which would starve the
        // screen) or presenting every native event (which creates backlog).
        let interaction_due =
        (event.kind() == event_pointer_move() ||
            event.kind() == event_pointer_down()) &&
        (pending_control_target != "" || pending_motion_target != "") &&
        perf_counter_ms() >= next_interaction_frame
        if interaction_due {
            if pending_control_target != "" {
                let preview = if pending_control_range {
                    AppEvent::range_event(pending_control_target,
                        pending_control_start, pending_control_end,)
                } else {
                    AppEvent::control_event(pending_control_target,
                        pending_control_value,)
                }
                current = current.runtime_update(preview)
                model_updated = true
                ui = runtime_update_application_live_control[M](window, ui,
                    window.stylesheet(), current, pending_control_target,
                    pending_control_value, pending_control_start,
                    pending_control_end, hovered, active,
                    interaction.focused(),)
            }
            if pending_motion_target != "" {
                let _pointer_move_default = ui.dispatch_event(
                    pending_motion_target,
                    UiEvent::pointer(ui_event_pointer_move(),
                        pending_motion_target, pending_motion_x,
                        pending_motion_y, pending_motion_dx,
                        pending_motion_dy,),)
                if runtime_raw_input_target(ui, pending_motion_target) {
                    current = current.runtime_update(AppEvent::raw_pointer_sample(
                            7_u32, pending_motion_target, pending_motion_x,
                            pending_motion_y, pending_motion_dx, pending_motion_dy,
                            pending_motion_buttons, pending_motion_modifiers,
                            pending_motion_timestamp_ns,))
                    model_updated = true
                }
            }
            pending_motion_target = ""
            pending_motion_dx = 0.0_f32
            pending_motion_dy = 0.0_f32
            pending_motion_timestamp_ns = 0_u64
            pending_motion_buttons = 0_u32
            pending_motion_modifiers = 0_u32
            pending_control_target = ""
        }
        if scroll_motion.container != "" && perf_counter_ms() >= next_interaction_frame {
            let sampled_at = perf_counter_ms()
            let container = scroll_motion.container
            match ui.find_layout(container) {
                Some(layout) => {
                    let scroll = layout.widget().style().layout().scroll()
                    let maximum = layout.scroll_max_y()
                    let sample = scroll_motion.sample(sampled_at)
                    let offset = if sample > maximum {
                        maximum
                    } else {
                        sample
                    }
                    if offset != scroll.y() {
                        current = current.runtime_update(AppEvent::scroll_event(container,
                                0.0_f32, 0.0_f32, offset, layout.bounds().height(),))
                        model_updated = true
                        ui.set_scroll_offset(container, scroll.x(), offset)
                        ui = runtime_update_model(window, ui, window.stylesheet(),
                            current.runtime_view(), hovered, active, interaction.focused(),)
                    }
                    if sampled_at >= scroll_motion.started + 140_u64 || offset == scroll_motion.destination ||
                    sample > maximum {
                        scroll_motion = ScrollMotion::idle()
                    }
                }
                None => {
                    scroll_motion = ScrollMotion::idle()
                }
            }
            next_interaction_frame = sampled_at + interaction_frame_ms
        }
        if background_deferred {
            let revision = current.runtime_background_revision()
            current = current.runtime_update(AppEvent::tick_event(perf_counter_ms() - started))
            model_updated = true
            if current.runtime_background_revision() != revision {
                ui = runtime_update_model(window, ui, window.stylesheet(), current.runtime_view(), hovered, active, interaction.focused())
            }
            next_tick = perf_counter_ms() + interval as u64
        }
        ui = window.stage_bindings(ui)
        if model_updated {
            if current.runtime_render_surface_id() != "" {
                direct_frame_pending = true
            }
            model_interval = current.runtime_background_interval_ms()
            let scheduled = if model_interval > 0_u32 {
                model_interval
            } else {
                options.frame_interval_ms()
            }
            // Input must not postpone an already scheduled background deadline.
            next_tick = runtime_background_deadline(next_tick, perf_counter_ms(), scheduled)
            model_updated = false
        }
        if close_pending && current.runtime_can_close() {
            break
        }
        let trace_handled = if trace_latency {
            perf_counter_ms()
        } else {
            0_u64
        }
        let trace_frames_before = if trace_latency {
            window.presented_frames()
        } else {
            0_u64
        }
        let profile_prepared = if profiler.enabled() {
            perf_counter_ns()
        } else {
            0_u64
        }
        let profile_wait = if profiler.enabled() {
            window.presentation_ns()
        } else {
            0_u64
        }
        let profile_upload = if profiler.enabled() {
            window.geometry_upload_bytes()
        } else {
            0_u64
        }
        let profile_frames = if profiler.enabled() {
            window.presented_frames()
        } else {
            0_u64
        }
        if (ui.is_dirty() || direct_frame_pending) && window.frame_status() != 3 &&
        perf_counter_ms() >= next_present_attempt {
            let rebuild_retained_cache = ui.needs_preparation()
            let frames_before = window.presented_frames()
            ui = runtime_present[M](window, ui, current,
                perf_counter_ms() - started, rebuild_retained_cache,)
            if window.presented_frames() > frames_before {
                direct_frame_pending = false
                next_present_attempt = 0
            } elif window.frame_status() == 2 {
                next_present_attempt = perf_counter_ms() + 1
            } elif window.frame_status() == 0 {
                eprintln("Luma presentation failed: " + backend_error())
                break
            }
            // The frame budget includes preparation and submission. Waiting
            // another full interval after rendering adds input latency and
            // reduces throughput as scenes become more expensive.
            next_interaction_frame = after_wait + interaction_frame_ms
        }
        if profiler.enabled() {
            profiler = profiler.record(profile_prepared - profile_start, perf_counter_ns() - profile_prepared,
                window.presentation_ns() - profile_wait, window.geometry_upload_bytes() - profile_upload,
                window.presented_frames() > profile_frames,)
        }
        if trace_latency &&(event.kind() != event_none() || window.presented_frames() > trace_frames_before) {
            eprintln("LUMA_LATENCY event=" + Debug::fmt(event.kind()) +
                " timestamp_ns=" + Debug::fmt(event.timestamp_ns()) +
                " handle_ms=" + Debug::fmt(trace_handled - after_wait) +
                " submit_ms=" + Debug::fmt(perf_counter_ms() - trace_handled) +
                " frames=" + Debug::fmt(window.presented_frames() - trace_frames_before))
        }
    }
    profiler.finish()
    let _destroyed = window.destroy()
    ret current
}

#attr(test)
fn textarea_pointer_uses_its_font_after_other_widgets() -> bool {
    let window = Window::create_with_renderer("Textarea pointer test", 640, 480, RendererKind::Software)
    if !window.available() {
        eprintln("textarea pointer test: window unavailable")
        ret false
    }
    let registered = window.register_font("Editor", "assets/fonts/RobotoMono/RobotoMono-VariableFont_wght.ttf") &&
    window.register_font("Status", "assets/fonts/Inter/Inter-VariableFont_opsz,wght.ttf")
    if !registered || !window.select_font("Editor", 14_f32, 400_u32) {
        eprintln("textarea pointer test: fonts unavailable")
        window.destroy()
        ret false
    }
    let line_height = window.text_height("Mg") + 2_f32
    let column_x =(window.text_width("abc") + window.text_width("abcd")) / 2_f32
    let mut text = ""
    for row in 0_usize..30_usize {
        text = text + "abcdЖ😀\n"
    }
    let sheet = StyleSheet::parse("textarea { font-family: Editor; font-size: 14px; }")
    let field = sheet.apply(Widget::textarea("editor", text).with_text_wrap(false).with_attribute("wrap", "none"), "", "", "")
    let mut ui = ReactiveUi::new(layout_widget(field, Rect::new(50_f32, 40_f32, 560_f32, 420_f32)))
    let bounds = ui.layout().find_bounds("editor").unwrap_or(Rect::new(0, 0, 0, 0))
    let mut valid = true
    for row in vec![0_usize, 5_usize, 15_usize] {
        // Rendering the status bar leaves a smaller, proportional font active.
        let _status_font = window.select_font("Status", 11_f32, 600_u32)
        let intent = runtime_pointer_edit(window, ui, "editor", bounds.x() + 10_f32 + column_x,
            bounds.y() + 10_f32 +(row as f32 + 0.5_f32) * line_height, row > 0_usize,)
        valid = valid && intent.unwrap_or(TextEditIntent::none()).position() == row * 7_usize + 3_usize
    }
    let scrolled = field.with_attribute("line-numbers", "true").with_style(field.style().with_scroll(column_x, 4_f32 * line_height))
    ui = ReactiveUi::new(layout_widget(scrolled, bounds))
    let _status_font = window.select_font("Status", 11_f32, 600_u32)
    let dragged = runtime_pointer_edit(window, ui, "editor", bounds.x() + 62_f32,
        bounds.y() + 10_f32 + 11.5_f32 * line_height, true,)
    valid = valid && dragged.unwrap_or(TextEditIntent::none()).position() == 108_usize &&
    dragged.unwrap_or(TextEditIntent::none()).extend_selection()
    window.destroy()
    ret valid
}

