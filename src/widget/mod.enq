//! Declarative widgets, retained layout trees, hit testing, and reactive updates.

import color::{Color, black}
import core::fmt::Debug
import core::option::Option
import core::vec::Vec
import geometry::{Insets, Rect, Size}
import refrain::animation::{apply_easing, easing_in, easing_in_out, easing_linear, easing_out, interpolate_style}
import refrain::event::{UiEvent, UiEventHandler, UiEventHandlers, ui_event_change, ui_event_click, ui_event_input, ui_event_key_down, ui_event_key_up, ui_event_pointer_down, ui_event_pointer_move, ui_event_pointer_up, ui_event_scroll, ui_event_transition_cancel, ui_event_transition_end, ui_event_transition_run, ui_event_transition_start, ui_phase_bubble, ui_phase_capture, ui_phase_target}
import refrain::layout::{FlexItem, align_center, align_end, flex_layout_directional, flex_wrap_layout, grid_layout_gaps, grid_layout_intrinsic_placed, horizontal, vertical}
import refrain::style::{GridPlacement, Style, text_center}
import refrain::svg::SvgDocument

pub fn widget_panel() -> usize {
    ret 0_usize
}
pub fn widget_label() -> usize {
    ret 1_usize
}
pub fn widget_button() -> usize {
    ret 2_usize
}
pub fn widget_spacer() -> usize {
    ret 3_usize
}
pub fn widget_input() -> usize {
    ret 4_usize
}
pub fn widget_textarea() -> usize {
    ret 5_usize
}
pub fn widget_checkbox() -> usize {
    ret 6_usize
}
pub fn widget_radio() -> usize {
    ret 7_usize
}
pub fn widget_switch() -> usize {
    ret 8_usize
}
pub fn widget_select() -> usize {
    ret 9_usize
}
pub fn widget_slider() -> usize {
    ret 10_usize
}
pub fn widget_progress() -> usize {
    ret 11_usize
}
pub fn widget_separator() -> usize {
    ret 12_usize
}
pub fn widget_heading() -> usize {
    ret 13_usize
}
pub fn widget_link() -> usize {
    ret 14_usize
}
pub fn widget_color_picker() -> usize {
    ret 15_usize
}
pub fn widget_color_swatch() -> usize {
    ret 16_usize
}
pub fn widget_color_channel() -> usize {
    ret 17_usize
}
pub fn widget_icon() -> usize {
    ret 18_usize
}
pub fn widget_icon_button() -> usize {
    ret 19_usize
}
pub fn widget_icon_card() -> usize {
    ret 20_usize
}
/// A layout-owned slot whose pixels are supplied by an external renderer.
/// The widget is intentionally a lightweight value; renderer resources live
/// outside the declarative tree and are addressed by this widget's stable ID.
pub fn widget_render_surface() -> usize {
    ret 21_usize
}
/// A VT-compatible terminal cell surface backed by ANSI output.
pub fn widget_terminal() -> usize {
    ret 22_usize
}
/// A retained RGBA image. Its payload contains a little-endian width and
/// height followed by tightly packed RGBA8 pixels.
pub fn widget_image() -> usize {
    ret 23_usize
}
/// A two-thumb normalized range control.
pub fn widget_range_slider() -> usize {
    ret 24_usize
}
/// One shaped inline text run whose direct span children may override color.
pub fn widget_rich_text() -> usize {
    ret 25_usize
}

pub struct TextSelection {
    start: usize
    end: usize
}

pub struct WidgetAttribute {
    name: str
    value: str
}

impl for WidgetAttribute {
    pub fn new(name: str, value: str) -> WidgetAttribute {
        ret WidgetAttribute {
            name, value
        }
    }
    pub fn name(self: Self) -> str {
        ret self.name
    }
    pub fn value(self: Self) -> str {
        ret self.value
    }
}

impl for TextSelection {
    pub fn caret(value: usize) -> TextSelection {
        ret TextSelection {
            value, value
        }
    }
    pub fn range(start: usize, end: usize, length: usize) -> TextSelection {
        let a = if start > length {
            length
        } else {
            start
        }
        let b = if end > length {
            length
        } else {
            end
        }
        ret if a < b {
            TextSelection {
                a, b
            }
        } else {
            TextSelection {
                b, a
            }
        }
    }
    pub fn start(self: Self) -> usize {
        ret self.start
    }
    pub fn end(self: Self) -> usize {
        ret self.end
    }
}

pub struct Widget {
    kind: usize
    id: str
    classes: str
    attributes: Vec[WidgetAttribute]
    text: str
    cursor: usize
    selection: TextSelection
    style: Style
    direction: usize
    basis: f32
    grow: f32
    checked: bool
    focused: bool
    disabled: bool
    value: f32
    children: Vec[Widget]
    svg: SvgDocument
    tag: str
    style_explicit: bool
    handlers: UiEventHandlers < H >
}

impl for Widget {
    pub fn panel(id: str) -> Widget {
        ret widget_value(widget_panel(), id, "", Style::panel(), vertical(), 0.0_f32, 1.0_f32, false,
            0.0_f32,)
    }
    pub fn label(text: str) -> Widget {
        ret widget_value(widget_label(), "", text, Style::default(), horizontal(), 24.0_f32, 0.0_f32,
            false, 0.0_f32,)
    }
    pub fn rich_text(id: str) -> Widget {
        ret widget_value(widget_rich_text(), id, "", Style::default(), horizontal(),
            24.0_f32, 0.0_f32, false, 0.0_f32,).with_tag("span")
    }
    pub fn button(id: str, text: str) -> Widget {
        ret widget_value(widget_button(), id, text, Style::panel().with_overflow_hidden(true).with_text_align(text_center()),
            horizontal(), 36.0_f32, 0.0_f32, false, 0.0_f32,)
    }
    pub fn spacer(grow: f32) -> Widget {
        ret widget_value(widget_spacer(), "", "", Style::default(), horizontal(), 0.0_f32, grow, false,
            0.0_f32,)
    }
    pub fn input(id: str, value: str) -> Widget {
        ret widget_value(widget_input(), id, value, control_style(), horizontal(), 38.0_f32, 0.0_f32,
            false, 0.0_f32,).with_attribute("type", "text")
    }
    pub fn textarea(id: str, value: str) -> Widget {
        ret widget_value(widget_textarea(), id, value, control_style(), vertical(), 82.0_f32, 0.0_f32,
            false, 0.0_f32,).with_attribute("type", "textarea")
    }
    /// Creates a terminal surface. `value` is the bounded raw PTY byte stream.
    pub fn terminal(id: str, value: str) -> Widget {
        ret widget_value(widget_terminal(), id, value,
            control_style().with_overflow_hidden(true), vertical(),
            120.0_f32, 1.0_f32, false, 0.0_f32,)
        .with_attribute("role", "terminal")
    }
    pub fn image(id: str, rgba_payload: str) -> Widget {
        ret widget_value(widget_image(), id, rgba_payload,
            Style::default().with_overflow_hidden(true), vertical(),
            180.0_f32, 0.0_f32, false, 0.0_f32,).with_tag("img")
    }
    pub fn checkbox(id: str, text: str, checked: bool) -> Widget {
        ret widget_value(widget_checkbox(), id, text, Style::default(), horizontal(), 32.0_f32, 0.0_f32,
            checked, 0.0_f32,).with_attribute("type", "checkbox")
    }
    pub fn radio(id: str, text: str, checked: bool) -> Widget {
        ret widget_value(widget_radio(), id, text, Style::default(), horizontal(), 32.0_f32, 0.0_f32,
            checked, 0.0_f32,).with_attribute("type", "radio")
    }
    pub fn toggle(id: str, text: str, checked: bool) -> Widget {
        ret widget_value(widget_switch(), id, text, Style::default(), horizontal(), 32.0_f32, 0.0_f32,
            checked, 0.0_f32,)
    }
    pub fn select(id: str, value: str) -> Widget {
        ret widget_value(widget_select(), id, value, control_style(), horizontal(), 38.0_f32, 0.0_f32,
            false, 0.0_f32,)
    }
    pub fn slider(id: str, value: f32) -> Widget {
        ret widget_value(widget_slider(), id, "", Style::default(), horizontal(), 32.0_f32, 0.0_f32,
            false, clamp_unit(value),).with_attribute("type", "range")
    }
    pub fn range_slider(id: str, start: f32, end: f32) -> Widget {
        let lower = clamp_unit(if start < end {
                start
            } else {
                end
            }
        )
        let upper = clamp_unit(if start < end {
                end
            } else {
                start
            }
        )
        ret widget_value(widget_range_slider(), id, "", Style::default(), horizontal(),
            40.0_f32, 0.0_f32, false, lower,)
        .with_attribute("type", "range")
        .with_attribute("data-luma-range-end", Debug::fmt(upper))
    }
    pub fn progress(value: f32) -> Widget {
        ret widget_value(widget_progress(), "", "", Style::default(), horizontal(), 18.0_f32, 0.0_f32,
            false, clamp_unit(value),)
    }
    /// A progress value that animates from one to zero for `duration_ms`.
    /// Changing `cycle` restarts the retained paint-only countdown.
    pub fn countdown(id: str, duration_ms: u64, cycle: u64) -> Widget {
        ret widget_value(widget_progress(), id, "", Style::default(), horizontal(),
            8.0_f32, 0.0_f32, false, 0.0_f32,)
        .with_attribute("data-luma-countdown-duration", Debug::fmt(duration_ms))
        .with_attribute("data-luma-countdown-cycle", Debug::fmt(cycle))
    }
    pub fn separator() -> Widget {
        ret widget_value(widget_separator(), "", "", Style::default(), horizontal(), 1.0_f32, 0.0_f32,
            false, 0.0_f32,)
    }
    pub fn heading(text: str) -> Widget {
        ret widget_value(widget_heading(), "", text, Style::default().with_font_size(22.0_f32), horizontal(),
            34.0_f32, 0.0_f32, false, 0.0_f32,)
    }
    pub fn link(id: str, text: str) -> Widget {
        ret widget_value(widget_link(), id, text, Style::default(), horizontal(), 28.0_f32, 0.0_f32,
            false, 0.0_f32,)
    }
    pub fn color_picker(id: str, text: str, color: Color) -> Widget {
        ret widget_value(widget_color_picker(), id, text,
            control_style().with_border(3.0_f32, color), horizontal(), 40.0_f32, 0.0_f32, false, 0.0_f32,).with_attribute("type",
            "color",)
    }
    pub fn color_swatch(id: str, color: Color, selected: bool) -> Widget {
        ret widget_value(widget_color_swatch(), id, "",
            Style::default().with_background(color).with_border(if selected {
                    3.0_f32
                } else {
                    1.0_f32
                }
                ,
                if selected {
                    black()
                } else {
                    color
                }
                ,), horizontal(), 32.0_f32, 0.0_f32, selected, 0.0_f32,)
    }
    pub fn color_channel(id: str, color: Color, value: f32, channel: str) -> Widget {
        ret widget_value(widget_color_channel(), id, "", Style::default().with_background(color),
            horizontal(), 26.0_f32, 0.0_f32, channel == "alpha", clamp_unit(value),)
        .with_attribute("type", "range").with_attribute("channel", channel)
    }
    pub fn icon(id: str, document: SvgDocument) -> Widget {
        let mut widget = widget_value(widget_icon(), id, "", Style::default(),
            horizontal(), 24.0_f32, 0.0_f32, false, 0.0_f32,)
        widget.svg = document
        ret widget
    }
    pub fn icon_button(id: str, text: str, document: SvgDocument) -> Widget {
        let mut widget = widget_value(widget_icon_button(), id, text,
            Style::panel().with_overflow_hidden(true), horizontal(),
            38.0_f32, 0.0_f32, false, 0.0_f32,)
        widget.svg = document
        ret widget
    }
    pub fn icon_card(id: str, text: str, document: SvgDocument) -> Widget {
        let mut widget = widget_value(widget_icon_card(), id, text,
            Style::panel().with_overflow_hidden(true).with_text_align(text_center()), vertical(), 88.0_f32,
            0.0_f32, false, 0.0_f32,)
        widget.svg = document
        ret widget
    }
    pub fn render_surface(id: str) -> Widget {
        ret widget_value(widget_render_surface(), id, "", Style::default(),
            horizontal(), 0.0_f32, 1.0_f32, false, 0.0_f32,)
    }
    pub fn with_style(self: Self, value: Style) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            value, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            self.value, self.children, self.svg, self.tag, true, self.handlers
        }
    }
    /// Stores a cascade result without turning it into an inline override.
    /// CSS and inheritance use this; application-authored `with_style` remains
    /// the highest-priority explicit layer.
    pub fn with_computed_style(self: Self, value: Style) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            value, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            self.value, self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_id(self: Self, value: str) -> Widget {
        ret Widget {
            self.kind, value, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            self.value, self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_direction(self: Self, value: usize) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, value, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value,
            self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_flex(self: Self, basis: f32, grow: f32) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, basis, grow, self.checked, self.focused, self.disabled, self.value,
            self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_focus(self: Self, value: bool) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, value, self.disabled, self.value,
            self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_classes(self: Self, value: str) -> Widget {
        ret Widget {
            self.kind, self.id, value, self.attributes, self.text, self.cursor, self.selection, self.style,
            self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value,
            self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_attribute(self: Self, name: str, value: str) -> Widget {
        let mut attributes = self.attributes
        let mut index = 0_usize
        while index < attributes.len() {
            match attributes.get(index) {
                Option[WidgetAttribute]::Some(attribute) => {
                    if attribute.name() == name {
                        attributes.set(index, WidgetAttribute::new(name, value))
                        ret Widget {
                            self.kind, self.id, self.classes, attributes, self.text, self.cursor, self.selection,
                            self.style, self.direction, self.basis, self.grow, self.checked, self.focused,
                            self.disabled, self.value, self.children, self.svg, self.tag,
                            self.style_explicit, self.handlers
                        }
                    }
                }
                Option[WidgetAttribute]::None => {
                }
            }
            index = index + 1_usize
        }
        attributes.push(WidgetAttribute::new(name, value))
        ret Widget {
            self.kind, self.id, self.classes, attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            self.value, self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    /// Enables word wrapping for text painted inside this widget's bounds.
    pub fn with_text_wrap(self: Self, value: bool) -> Widget {
        ret self.with_attribute("data-luma-text-wrap", if value {
                "true"
            } else {
                "false"
            }
            ,
        )
    }
    /// Centers a shaped rich-text run on one direct child while preserving
    /// the kerning and advances of the complete string.
    pub fn with_text_anchor_child(self: Self, child_id: str) -> Widget {
        ret self.with_attribute("data-luma-text-anchor", child_id)
    }
    /// Lets a managed application claim one key before a focused control's
    /// default keyboard behavior. Declare it on the retained root only while
    /// the corresponding application mode is active.
    pub fn with_application_key_capture(self: Self, key: u32) -> Widget {
        ret self.with_attribute("data-luma-application-key-" + Debug::fmt(key), "true")
    }
    /// Captures an application key and identifies the smallest retained
    /// fragment whose model can change in response. Incremental runtimes can
    /// then avoid reconciling and laying out the complete application tree.
    pub fn with_application_key_capture_target(self: Self, key: u32,
        target: str,) -> Widget {
        ret self.with_attribute("data-luma-application-key-" + Debug::fmt(key), target)
    }
    /// Routes unconsumed native pointer and keyboard samples for this widget
    /// to the managed application model. Intended for canvases, editors and
    /// externally rendered surfaces that implement their own interaction.
    pub fn with_raw_input(self: Self) -> Widget {
        ret self.with_attribute("data-luma-raw-input", "true")
    }
    /// Captures relative pointer motion while the secondary button is held on
    /// this widget. The runtime always releases capture on button-up or focus
    /// loss, including when the pointer leaves the widget.
    pub fn with_secondary_pointer_lock(self: Self) -> Widget {
        ret self.with_raw_input()
        .with_attribute("data-luma-secondary-pointer-lock", "true")
    }
    /// Adds evenly spaced ruler marks to a range slider. Values below two
    /// disable the marks.
    pub fn with_range_ticks(self: Self, count: usize) -> Widget {
        ret self.with_attribute("data-luma-range-ticks", Debug::fmt(count))
    }
    pub fn text_wrap(self: Self) -> bool {
        match self.attribute("data-luma-text-wrap") {
            Option[str]::Some(value) => {
                ret value == "true"
            }
            Option[str]::None => {
            }
        }
        ret false
    }
    pub fn text_anchor_child(self: Self) -> str {
        ret self.attribute("data-luma-text-anchor").unwrap_or("")
    }
    pub fn with_children(self: Self, value: Vec[Widget]) -> Widget {
        let text = if self.kind == widget_rich_text() {
            concatenated_widget_text(value)
        } else {
            self.text
        }
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            self.value, value, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_disabled(self: Self, value: bool) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis,
            self.grow, self.checked, self.focused, value, self.value, self.children, self.svg,
            self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_value(self: Self, value: f32) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            clamp_unit(value), self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_text(self: Self, value: str) -> Widget {
        let cursor = if self.cursor > value.char_len() {
            value.char_len()
        } else {
            self.cursor
        }
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, value, cursor,
            TextSelection::caret(cursor), self.style, self.direction, self.basis, self.grow,
            self.checked, self.focused, self.disabled, self.value, self.children, self.svg,
            self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_checked(self: Self, value: bool) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, value, self.focused, self.disabled,
            self.value, self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_value(self: Self, value: f32) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            clamp_unit(value), self.children, self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_cursor(self: Self, value: usize) -> Widget {
        let cursor = if value > self.text.char_len() {
            self.text.char_len()
        } else {
            value
        }
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, cursor, TextSelection::caret(cursor),
            self.style, self.direction, self.basis,
            self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg,
            self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_selection(self: Self, start: usize, end: usize) -> Widget {
        let selection = TextSelection::range(start, end, self.text.char_len())
        let cursor = if end > self.text.char_len() {
            self.text.char_len()
        } else {
            end
        }
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, cursor, selection, self.style,
            self.direction,
            self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children,
            self.svg, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_svg(self: Self, value: SvgDocument) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction,
            self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children,
            value, self.tag, self.style_explicit, self.handlers
        }
    }
    pub fn with_tag(self: Self, value: str) -> Widget {
        ret Widget {
            self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled,
            self.value, self.children, self.svg, value, self.style_explicit, self.handlers
        }
    }
    pub fn with_child(self: Self, child: Widget) -> Widget {
        let mut children = self.children
        children.push(child)
        ret self.with_children(children)
    }
    pub fn with_on(self: Self, kind: u32, handler: dyn UiEventHandler) -> Widget {
        self.handlers.add(kind, false, handler)
        ret self
    }
    pub fn with_on_capture(self: Self, kind: u32, handler: dyn UiEventHandler) -> Widget {
        self.handlers.add(kind, true, handler)
        ret self
    }
    pub fn with_on_click(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_click(), handler)
    }
    pub fn with_on_pointer_down(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_pointer_down(), handler)
    }
    pub fn with_on_pointer_move(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_pointer_move(), handler)
    }
    pub fn with_on_pointer_up(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_pointer_up(), handler)
    }
    pub fn with_on_scroll(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_scroll(), handler)
    }
    pub fn with_on_key_down(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_key_down(), handler)
    }
    pub fn with_on_key_up(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_key_up(), handler)
    }
    pub fn with_on_input(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_input(), handler)
    }
    pub fn with_on_change(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_change(), handler)
    }
    pub fn with_on_transition_run(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_transition_run(), handler)
    }
    pub fn with_on_transition_start(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_transition_start(), handler)
    }
    pub fn with_on_transition_cancel(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_transition_cancel(), handler)
    }
    pub fn with_on_transition_end(self: Self, handler: dyn UiEventHandler) -> Widget {
        ret self.with_on(ui_event_transition_end(), handler)
    }
    pub fn push(self: mut Self, child: Widget) ->() {
        self.children.push(child) ret()
    }
    pub fn kind(self: Self) -> usize {
        ret self.kind
    }
    pub fn tag(self: Self) -> str {
        ret self.tag
    }
    /// Stable selector input used by the stylesheet cache. It intentionally
    /// excludes text and children because neither participates in CSS selector
    /// matching, while including every authored attribute and state flag.
    pub fn selector_signature(self: Self) -> str {
        let mut signature = self.tag + "|" + Debug::fmt(self.kind) + "|" + self.id + "|" +
        self.classes + "|" + Debug::fmt(self.checked) + "|" + Debug::fmt(self.focused) + "|" +
        Debug::fmt(self.disabled)
        for attribute in self.attributes {
            signature = signature + "|@" + attribute.name() + "=" + attribute.value()
        }
        ret signature
    }
    pub fn has_explicit_style(self: Self) -> bool {
        ret self.style_explicit
    }
    pub fn handlers(self: Self) -> UiEventHandlers < H > {
        ret self.handlers
    }
    pub fn id(self: Self) -> str {
        ret self.id
    }
    pub fn classes(self: Self) -> str {
        ret self.classes
    }
    pub fn attribute(self: Self, name: str) -> Option[str] {
        let mut index = 0_usize
        while index < self.attributes.len() {
            match self.attributes.get(index) {
                Option[WidgetAttribute]::Some(attribute) => {
                    if attribute.name() == name {
                        ret Option[str]::Some(attribute.value())
                    }
                }
                Option[WidgetAttribute]::None => {
                }
            }
            index = index + 1_usize
        }
        ret Option[str]::None
    }
    pub fn text(self: Self) -> str {
        ret self.text
    }
    pub fn cursor(self: Self) -> usize {
        ret self.cursor
    }
    pub fn selection(self: Self) -> TextSelection {
        ret self.selection
    }
    pub fn style(self: Self) -> Style {
        ret self.style
    }
    pub fn direction(self: Self) -> usize {
        ret self.direction
    }
    pub fn basis(self: Self) -> f32 {
        ret self.basis
    }
    pub fn grow(self: Self) -> f32 {
        ret self.grow
    }
    pub fn checked(self: Self) -> bool {
        ret self.checked
    }
    pub fn focused(self: Self) -> bool {
        ret self.focused
    }
    pub fn disabled(self: Self) -> bool {
        ret self.disabled
    }
    pub fn value(self: Self) -> f32 {
        ret self.value
    }
    pub fn range_start(self: Self) -> f32 {
        ret self.value
    }
    pub fn range_end(self: Self) -> f32 {
        ret parse_widget_f32(self.attribute("data-luma-range-end").unwrap_or("1"), 1.0_f32)
    }
    pub fn range_ticks(self: Self) -> usize {
        ret parse_widget_u64(self.attribute("data-luma-range-ticks").unwrap_or("0"), 0_u64) as usize
    }
    pub fn countdown_duration_ms(self: Self) -> u64 {
        ret parse_widget_u64(self.attribute("data-luma-countdown-duration").unwrap_or("0"), 0_u64)
    }
    pub fn countdown_cycle(self: Self) -> u64 {
        ret parse_widget_u64(self.attribute("data-luma-countdown-cycle").unwrap_or("0"), 0_u64)
    }
    pub fn children(self: Self) -> Vec[Widget] {
        ret self.children
    }
    /// Finds a declarative subtree by stable identity. This is used at the
    /// reconciliation boundary to extract only explicitly invalidated
    /// components from a newly rendered view.
    pub fn find(self: Self, expected: str) -> Option[Widget] {
        if expected != "" && self.id == expected {
            ret Option[Widget]::Some(self)
        }
        for child in self.children {
            match child.find(expected) {
                Option::Some(found) => {
                    ret Option[Widget]::Some(found)
                }
                Option::None => {
                }
            }
        }
        ret Option[Widget]::None
    }
    /// Resolves several stable identities in one declarative-tree traversal.
    /// Results preserve paint order; duplicate requested IDs are returned once.
    pub fn find_many(self: Self, expected: Vec[str]) -> Vec[Widget] {
        let mut unique = Vec[str]::new()
        for id in expected {
            if id != "" {
                let mut duplicate = false
                for current in unique {
                    if current == id {
                        duplicate = true
                    }
                }
                if !duplicate {
                    unique.push(id)
                }
            }
        }
        let mut found = Vec[Widget]::new()
        let _complete = collect_widgets(self, unique, found)
        ret found
    }
    pub fn svg(self: Self) -> SvgDocument {
        ret self.svg
    }
    pub fn preferred_size(self: Self) -> Size {
        if self.kind == widget_label() || self.kind == widget_rich_text() {
            ret Size::new((self.text.len() as f32) * 8.0_f32, self.basis)
        }
        if self.kind == widget_button() {
            ret Size::new((self.text.len() as f32) * 8.0_f32 + 24.0_f32, self.basis)
        }
        ret Size::new(self.basis, self.basis)
    }
    pub fn min_content_size(self: Self) -> Size {
        ret intrinsic_widget_size(self, false)
    }
    pub fn max_content_size(self: Self) -> Size {
        ret intrinsic_widget_size(self, true)
    }
}

fn intrinsic_widget_size(widget: Widget, maximum: bool) -> Size {
    let children = widget.children()
    let style = widget.style()
    let padding = style.padding()
    let chrome_width = padding.left() + padding.right() + style.border_width() * 2.0_f32
    let chrome_height = padding.top() + padding.bottom() + style.border_width() * 2.0_f32
    if children.len() > 0_usize && widget.kind() != widget_rich_text() {
        let mut width = 0.0_f32
        let mut height = 0.0_f32
        let mut index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    let size = if maximum {
                        child.max_content_size()
                    } else {
                        child.min_content_size()
                    }
                    if widget.direction() == horizontal() {
                        width = width + size.width()
                        if size.height() > height {
                            height = size.height()
                        }
                    } else {
                        height = height + size.height()
                        if size.width() > width {
                            width = size.width()
                        }
                    }
                }
                Option[Widget]::None => {
                }
            }
            index = index + 1_usize
        }
        if children.len() > 1_usize {
            if widget.direction() == horizontal() {
                width = width + style.gap() *((children.len() - 1_usize) as f32)
            } else {
                height = height + style.gap() *((children.len() - 1_usize) as f32)
            }
        }
        ret Size::new(width + chrome_width, height + chrome_height)
    }
    if widget.text() != "" {
        let characters = if maximum {
            widget.text().char_len()
        } else {
            longest_text_word(widget.text())
        }
        let width =(characters as f32) * style.font_size() * 0.56_f32
        ret Size::new(width + chrome_width, style.font_size() * 1.35_f32 + chrome_height)
    }
    let preferred = widget.preferred_size()
    ret Size::new(preferred.width() + chrome_width, preferred.height() + chrome_height)
}

fn concatenated_widget_text(children: Vec[Widget]) -> str {
    let mut text = ""
    for child in children {
        text = text + child.text()
    }
    ret text
}

fn longest_text_word(value: str) -> usize {
    let mut longest = 0_usize
    let mut current = 0_usize
    let length = value.len()
    let mut index = 0_usize
    while index < length {
        match value.get_byte(index) {
            Option[u8]::Some(byte) => {
                if byte == 32_u8 || byte == 9_u8 || byte == 10_u8 || byte == 13_u8 {
                    if current > longest {
                        longest = current
                    }
                    current = 0_usize
                } elif byte < 128_u8 || byte >= 192_u8 {
                    current = current + 1_usize
                }
            }
            Option[u8]::None => {
            }
        }
        index = index + 1_usize
    }
    ret if current > longest {
        current
    } else {
        longest
    }
}

fn widget_value(kind: usize, id: str, text: str, style: Style, direction: usize, basis: f32, grow: f32,
    checked: bool, value: f32,) -> Widget {
    ret Widget {
        kind, id, "", Vec[WidgetAttribute]::new(), text, text.char_len(), TextSelection::caret(text.char_len()),
        style,
        direction, basis, grow, checked, false, false, value, Vec[Widget]::new(), SvgDocument::empty(),
        default_widget_tag(kind), false, UiEventHandlers::new()
    }
}

fn default_widget_tag(kind: usize) -> str {
    if kind == widget_panel() {
        ret "div"
    }
    if kind == widget_label() {
        ret "label"
    }
    if kind == widget_button() || kind == widget_icon_button() || kind == widget_icon_card() {
        ret "button"
    }
    if kind == widget_input() || kind == widget_checkbox() || kind == widget_radio() ||
    kind == widget_slider() || kind == widget_range_slider() || kind == widget_color_picker() ||
    kind == widget_color_channel() {
        ret "input"
    }
    if kind == widget_textarea() {
        ret "textarea"
    }
    if kind == widget_select() {
        ret "select"
    }
    if kind == widget_progress() {
        ret "progress"
    }
    if kind == widget_separator() {
        ret "hr"
    }
    if kind == widget_heading() {
        ret "h1"
    }
    if kind == widget_link() {
        ret "a"
    }
    if kind == widget_icon() {
        ret "svg"
    }
    if kind == widget_terminal() {
        ret "terminal"
    }
    if kind == widget_image() {
        ret "img"
    }
    if kind == widget_rich_text() {
        ret "span"
    }
    ret "widget"
}

fn parse_widget_u64(value: str, fallback: u64) -> u64 {
    if value == "" {
        ret fallback
    }
    let mut parsed = 0_u64
    let mut index = 0_usize
    while index < value.char_len() {
        let byte = value.slice(index, 1_usize).byte_at(0_usize)
        if byte < 48_u8 || byte > 57_u8 {
            ret fallback
        }
        parsed = parsed * 10_u64 +(byte - 48_u8) as u64
        index += 1_usize
    }
    ret parsed
}

fn parse_widget_f32(value: str, fallback: f32) -> f32 {
    if value == "" {
        ret fallback
    }
    let mut result = 0.0_f32
    let mut fraction = 0.1_f32
    let mut decimal = false
    let mut index = 0_usize
    while index < value.char_len() {
        let byte = value.slice(index, 1_usize).byte_at(0_usize)
        if byte == 46_u8 {
            if decimal {
                ret fallback
            }
            decimal = true
        } elif byte >= 48_u8 && byte <= 57_u8 {
            let digit =(byte - 48_u8) as f32
            if decimal {
                result = result + digit * fraction
                fraction = fraction * 0.1_f32
            } else {
                result = result * 10.0_f32 + digit
            }
        } else {
            ret fallback
        }
        index += 1_usize
    }
    ret result
}

/// Dispatches capture, target and bubble listeners along the retained widget
/// ancestry. Returns false when a listener prevented the default action.
pub fn dispatch_widget_event(root: Widget, target: str, event: UiEvent < H >) -> bool {
    let mut path = Vec[Widget]::new()
    if !collect_widget_event_path(root, target, path) {
        ret true
    }
    ret dispatch_widget_event_path(path, event)
}

fn dispatch_widget_event_path(path: Vec[Widget], event: UiEvent < H >) -> bool {
    let kind = event.kind()
    let mut index = 0_usize
    while index < path.len() {
        if event.propagation_stopped() {
            ret !event.default_prevented()
        }
        match path.get(index) {
            Some(widget) => {
                let phase = if index + 1_usize == path.len() {
                    ui_phase_target()
                } else {
                    ui_phase_capture()
                }
                event.enter(widget.id(), phase)
                widget.handlers().dispatch(kind, true, event)
            }
            None => {
            }
        }
        index += 1_usize
    }
    if path.len() > 0_usize && !event.propagation_stopped() {
        match path.get(path.len() - 1_usize) {
            Some(widget) => {
                event.enter(widget.id(), ui_phase_target())
                widget.handlers().dispatch(kind, false, event)
            }
            None => {
            }
        }
    }
    if path.len() > 1_usize {
        index = path.len() - 1_usize
        while index > 0_usize {
            index -= 1_usize
            if event.propagation_stopped() {
                ret !event.default_prevented()
            }
            match path.get(index) {
                Some(widget) => {
                    event.enter(widget.id(), ui_phase_bubble())
                    widget.handlers().dispatch(kind, false, event)
                }
                None => {
                }
            }
        }
    }
    ret !event.default_prevented()
}

fn collect_layout_event_path(layout: WidgetLayout, indices: Vec[usize], depth: usize,
    path: mut Vec[Widget],) -> bool {
    path.push(layout.widget())
    if depth >= indices.len() {
        ret true
    }
    let child_index = indices.get(depth).unwrap_or(layout.children().len())
    match layout.children().get(child_index) {
        Some(child) => {
            if collect_layout_event_path(child, indices, depth + 1_usize, path) {
                ret true
            }
        }
        None => {
        }
    }
    path.pop()
    ret false
}

fn collect_widget_event_path(widget: Widget, target: str, path: mut Vec[Widget]) -> bool {
    path.push(widget)
    if widget.id() == target {
        ret true
    }
    for child in widget.children() {
        if collect_widget_event_path(child, target, path) {
            ret true
        }
    }
    path.pop()
    ret false
}

fn control_style() -> Style {
    ret Style::panel().with_padding(Insets::symmetric(8.0_f32, 10.0_f32)).with_radius(4.0_f32).with_overflow_hidden(true)
}

fn clamp_unit(value: f32) -> f32 {
    if value < 0.0_f32 {
        ret 0.0_f32
    }
    if value > 1.0_f32 {
        ret 1.0_f32
    }
    ret value
}

pub struct WidgetLayout {
    widget: Widget
    bounds: Rect
    children: Vec[WidgetLayout]
    paint_bounds: Rect
}

struct WidgetPath {
    id: str
    indices: Vec[usize]
    bounds: Rect
    clip: Option[Rect]
    widget: Widget
    disabled: bool
    visible: bool
    pointer_events: bool
    generation: usize
}

fn collect_widgets(widget: Widget, expected: Vec[str],
    found: mut Vec[Widget],) -> bool {
    if expected.len() == 0_usize || found.len() >= expected.len() {
        ret true
    }
    if widget.id() != "" {
        let mut requested = false
        for id in expected {
            if id == widget.id() {
                requested = true
            }
        }
        if requested {
            let mut duplicate = false
            for current in found {
                if current.id() == widget.id() {
                    duplicate = true
                }
            }
            if !duplicate {
                found.push(widget)
                if found.len() >= expected.len() {
                    ret true
                }
            }
        }
    }
    for child in widget.children() {
        if collect_widgets(child, expected, found) {
            ret true
        }
    }
    ret false
}

fn collect_widget_paths(layout: WidgetLayout, indices: Vec[usize],
    inherited_clip: Option[Rect], generation: usize,
    paths: mut Vec[WidgetPath],) ->() {
    let bounds = layout.bounds()
    let clip = if layout.widget().style().layout().overflow_hidden() {
        intersect_clip(inherited_clip, bounds)
    } else {
        inherited_clip
    }
    let id = layout.widget().id()
    if id != "" {
        let widget = layout.widget()
        paths.push(WidgetPath {
                id, indices, bounds, clip, widget, widget.disabled(),
                widget.style().visible(), widget.style().pointer_events(),
                generation
            }
            ,
        )
    }
    let children = layout.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option::Some(child) => {
                // `Vec` is a graph reference: assigning it creates another
                // owner of the same storage node. A path needs a private
                // sequence before appending the child index, otherwise the
                // parent and every previously retained sibling path mutate.
                let mut child_indices = Vec[usize]::new()
                child_indices.extend(indices)
                child_indices.push(index)
                collect_widget_paths(child, child_indices, clip, generation,
                    paths,)
            }
            Option::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn widget_paths(layout: WidgetLayout, generation: usize) -> Vec[WidgetPath] {
    let mut paths = Vec[WidgetPath]::new()
    collect_widget_paths(layout, Vec[usize]::new(), Option[Rect]::None,
        generation, paths,)
    ret paths
}

fn path_has_prefix(path: Vec[usize], prefix: Vec[usize]) -> bool {
    if path.len() < prefix.len() {
        ret false
    }
    let mut index = 0_usize
    while index < prefix.len() {
        if path.get(index).unwrap_or(path.len()) !=
        prefix.get(index).unwrap_or(prefix.len()) {
            ret false
        }
        index = index + 1_usize
    }
    ret true
}

fn inherited_clip_at_path(layout: WidgetLayout, indices: Vec[usize],
    depth: usize, inherited: Option[Rect],) -> Option[Rect] {
    if depth >= indices.len() {
        ret inherited
    }
    let bounds = layout.bounds()
    let clip = if layout.widget().style().layout().overflow_hidden() {
        intersect_clip(inherited, bounds)
    } else {
        inherited
    }
    let index = indices.get(depth).unwrap_or(layout.children().len())
    match layout.children().get(index) {
        Option::Some(child) => {
            ret inherited_clip_at_path(child, indices, depth + 1_usize,
                clip,)
        }
        Option::None => {
        }
    }
    ret inherited
}

fn intersect_clip(inherited: Option[Rect], bounds: Rect) -> Option[Rect] {
    match inherited {
        Option::Some(parent) => {
            let left = if parent.x() > bounds.x() {
                parent.x()
            } else {
                bounds.x()
            }
            let top = if parent.y() > bounds.y() {
                parent.y()
            } else {
                bounds.y()
            }
            let right = if parent.right() < bounds.right() {
                parent.right()
            } else {
                bounds.right()
            }
            let bottom = if parent.bottom() < bounds.bottom() {
                parent.bottom()
            } else {
                bounds.bottom()
            }
            ret Option[Rect]::Some(Rect::new(left, top,
                    if right > left {
                        right - left
                    } else {
                        0.0_f32
                    }
                    ,
                    if bottom > top {
                        bottom - top
                    } else {
                        0.0_f32
                    }
                    ,))
        }
        Option::None => {
            ret Option[Rect]::Some(bounds)
        }
    }
    ret Option[Rect]::None
}

fn point_inside_clip(clip: Option[Rect], x: f32, y: f32) -> bool {
    match clip {
        Option::Some(bounds) => {
            ret x >= bounds.x() && y >= bounds.y() &&
            x < bounds.right() && y < bounds.bottom()
        }
        Option::None => {
            ret true
        }
    }
    ret true
}

fn widget_paint_bounds(widget: Widget, bounds: Rect,
    children: Vec[WidgetLayout],) -> Rect {
    let outline = widget.style().outline()
    let outline_extent = outline.width() +
    if outline.offset() > 0.0_f32 {
        outline.offset()
    } else {
        0.0_f32
    }
    let shadow = widget.style().shadow()
    let shadow_extent = if shadow.inset() {
        0.0_f32
    } else {
        shadow.blur() + if shadow.spread() > 0.0_f32 {
            shadow.spread()
        } else {
            0.0_f32
        }
    }
    let left = outline_extent +
    if shadow_extent - shadow.x() > 0.0_f32 {
        shadow_extent - shadow.x()
    } else {
        0.0_f32
    }
    let right = outline_extent +
    if shadow_extent + shadow.x() > 0.0_f32 {
        shadow_extent + shadow.x()
    } else {
        0.0_f32
    }
    let top = outline_extent +
    if shadow_extent - shadow.y() > 0.0_f32 {
        shadow_extent - shadow.y()
    } else {
        0.0_f32
    }
    let bottom = outline_extent +
    if shadow_extent + shadow.y() > 0.0_f32 {
        shadow_extent + shadow.y()
    } else {
        0.0_f32
    }
    let mut result = Rect::new(bounds.x() - left, bounds.y() - top,
        bounds.width() + left + right, bounds.height() + top + bottom,)
    for child in children {
        let child_bounds = if widget.style().layout().overflow_hidden() {
            intersect_rect(child.paint_bounds(), bounds)
        } else {
            child.paint_bounds()
        }
        result = union_rect(result, child_bounds)
    }
    ret result
}

fn intersect_rect(left: Rect, right: Rect) -> Rect {
    let x = if left.x() > right.x() {
        left.x()
    } else {
        right.x()
    }
    let y = if left.y() > right.y() {
        left.y()
    } else {
        right.y()
    }
    let edge_x = if left.right() < right.right() {
        left.right()
    } else {
        right.right()
    }
    let edge_y = if left.bottom() < right.bottom() {
        left.bottom()
    } else {
        right.bottom()
    }
    ret Rect::new(x, y,
        if edge_x > x {
            edge_x - x
        } else {
            0.0_f32
        }
        ,
        if edge_y > y {
            edge_y - y
        } else {
            0.0_f32
        }
        ,)
}

fn union_rect(left: Rect, right: Rect) -> Rect {
    if right.width() <= 0.0_f32 || right.height() <= 0.0_f32 {
        ret left
    }
    let x = if left.x() < right.x() {
        left.x()
    } else {
        right.x()
    }
    let y = if left.y() < right.y() {
        left.y()
    } else {
        right.y()
    }
    let edge_x = if left.right() > right.right() {
        left.right()
    } else {
        right.right()
    }
    let edge_y = if left.bottom() > right.bottom() {
        left.bottom()
    } else {
        right.bottom()
    }
    ret Rect::new(x, y, edge_x - x, edge_y - y)
}

fn widget_attributes_equal(lhs: Vec[WidgetAttribute],
    rhs: Vec[WidgetAttribute],) -> bool {
    if lhs.len() != rhs.len() {
        ret false
    }
    let mut index = 0_usize
    while index < lhs.len() {
        let left = lhs.get(index).unwrap_or(WidgetAttribute::new("", ""))
        let right = rhs.get(index).unwrap_or(WidgetAttribute::new("", ""))
        if left.name() != right.name() || left.value() != right.value() {
            ret false
        }
        index += 1_usize
    }
    ret true
}

// 0 = unchanged, 1 = paint, 2 = layout, 3 = structure.
fn collect_widget_changes(previous: Widget, next: Widget,
    targets: mut Vec[str],) -> u32 {
    if previous.kind() != next.kind() || previous.id() != next.id() || previous.tag() != next.tag() {
        ret 3_u32
    }
    let previous_children = previous.children()
    let next_children = next.children()
    if previous_children.len() != next_children.len() {
        ret 3_u32
    }
    let mut change = 0_u32
    if previous.direction() != next.direction() ||
    previous.basis() != next.basis() || previous.grow() != next.grow() ||
    previous.has_explicit_style() != next.has_explicit_style() ||
    !previous.style().layout_equivalent(next.style()) {
        change = 2_u32
    }
    let content_changed = previous.text() != next.text() ||
    previous.cursor() != next.cursor() ||
    previous.selection().start() != next.selection().start() ||
    previous.selection().end() != next.selection().end() ||
    previous.checked() != next.checked() ||
    previous.focused() != next.focused() ||
    previous.disabled() != next.disabled() ||
    previous.value() != next.value() ||
    !previous.svg().equivalent(next.svg()) ||
    previous.classes() != next.classes() ||
    !widget_attributes_equal(previous.attributes, next.attributes) ||
    !previous.style().equivalent(next.style())
    if content_changed && change < 1_u32 {
        if next.id() == "" {
            change = 2_u32
        } else {
            change = 1_u32
            targets.push(next.id())
        }
    }
    let mut index = 0_usize
    while index < previous_children.len() {
        let previous_child = previous_children.get(index).unwrap_or(
            Widget::spacer(0.0_f32),)
        let next_child = next_children.get(index).unwrap_or(
            Widget::spacer(0.0_f32),)
        let child_change = collect_widget_changes(previous_child, next_child,
            targets,)
        if child_change > change {
            change = child_change
        }
        if change == 3_u32 {
            ret change
        }
        index += 1_usize
    }
    ret change
}

impl for WidgetLayout {
    pub fn widget(self: Self) -> Widget {
        ret self.widget
    }
    pub fn bounds(self: Self) -> Rect {
        ret self.bounds
    }
    pub fn paint_bounds(self: Self) -> Rect {
        ret self.paint_bounds
    }
    pub fn children(self: Self) -> Vec[WidgetLayout] {
        ret self.children
    }
    pub fn hit(self: Self, x: f32, y: f32) -> str {
        let inside = x >= self.bounds.x() && y >= self.bounds.y() &&
        x < self.bounds.right() && y < self.bounds.bottom()
        if self.widget.style().layout().overflow_hidden() && !inside {
            ret ""
        }
        let mut index = self.children.len()
        while index > 0_usize {
            index = index - 1_usize
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let found = child.hit(x, y)
                    if found != "" {
                        ret found
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
        }
        if inside {
            if self.widget.disabled() || !self.widget.style().visible() || !self.widget.style().pointer_events()
            {
                ret ""
            }
            ret self.widget.id()
        }
        ret ""
    }
    pub fn find_bounds(self: Self, id: str) -> Option[Rect] {
        if self.widget.id() == id {
            ret Option[Rect]::Some(self.bounds)
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    match child.find_bounds(id) {
                        Option[Rect]::Some(bounds) => {
                            ret Option[Rect]::Some(bounds)
                        }
                        Option[Rect]::None => {
                        }
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret Option[Rect]::None
    }
    pub fn find_widget(self: Self, id: str) -> Option[Widget] {
        if self.widget.id() == id {
            ret Option[Widget]::Some(self.widget)
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    match child.find_widget(id) {
                        Option[Widget]::Some(widget) => {
                            ret Option[Widget]::Some(widget)
                        }
                        Option[Widget]::None => {
                        }
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret Option[Widget]::None
    }

    fn widget_at_path(self: Self, indices: Vec[usize], depth: usize) ->
    Option[Widget] {
        if depth >= indices.len() {
            ret Option[Widget]::Some(self.widget)
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                ret child.widget_at_path(indices, depth + 1_usize)
            }
            Option::None => {
            }
        }
        ret Option[Widget]::None
    }

    fn layout_at_path(self: Self, indices: Vec[usize], depth: usize) ->
    Option[WidgetLayout] {
        if depth >= indices.len() {
            ret Option[WidgetLayout]::Some(self)
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                ret child.layout_at_path(indices, depth + 1_usize)
            }
            Option::None => {
            }
        }
        ret Option[WidgetLayout]::None
    }

    fn patch_widget_at_path(self: mut Self, indices: Vec[usize], depth: usize,
        replacement: Widget,) -> bool {
        if depth >= indices.len() {
            self.widget = replacement.with_children(self.widget.children())
            self.paint_bounds = widget_paint_bounds(
                self.widget, self.bounds, self.children,)
            ret true
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                let mut updated = child
                if updated.patch_widget_at_path(indices, depth + 1_usize,
                    replacement,) {
                    self.children.set(index, updated)
                    self.paint_bounds = widget_paint_bounds(
                        self.widget, self.bounds, self.children,)
                    ret true
                }
            }
            Option::None => {
            }
        }
        ret false
    }

    fn replace_subtree_at_path(self: mut Self, indices: Vec[usize],
        depth: usize, replacement: Widget,) -> bool {
        if depth >= indices.len() {
            let updated = layout_widget(replacement, self.bounds)
            self.widget = updated.widget
            self.children = updated.children
            self.paint_bounds = updated.paint_bounds
            ret true
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                let mut updated = child
                if updated.replace_subtree_at_path(indices, depth + 1_usize,
                    replacement,) {
                    self.children.set(index, updated)
                    self.paint_bounds = widget_paint_bounds(
                        self.widget, self.bounds, self.children,)
                    ret true
                }
            }
            Option::None => {
            }
        }
        ret false
    }

    /// Reconstructs the current retained widget tree from layout nodes. Unlike
    /// the original root widget, this includes every subtree replacement made
    /// since the last full layout.
    pub fn retained_widget(self: Self) -> Widget {
        let mut retained_children = Vec[Widget]::new()
        for child in self.children {
            retained_children.push(child.retained_widget())
        }
        ret self.widget.with_children(retained_children)
    }

    // Replaces paint-only widget state while preserving the geometry of the
    // existing tree. This is intended for hover/focus changes whose styles do
    // not alter layout. Absolute overlays are laid out again because their
    // pointer-relative position may have changed.
    pub fn restyle(self: Self, widget: Widget) -> WidgetLayout {
        ret restyle_widget_layout(self, widget)
    }

    /// Replaces one retained widget without rebuilding or laying out the tree.
    /// This is the paint-only fast path; callers must use a normal layout pass
    /// when the replacement changes geometry or child structure.
    pub fn patch_widget(self: mut Self, id: str, replacement: Widget) -> bool {
        if self.widget.id() == id {
            self.widget = replacement.with_children(self.widget.children())
            self.paint_bounds = widget_paint_bounds(
                self.widget, self.bounds, self.children,)
            ret true
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let mut updated = child
                    if updated.patch_widget(id, replacement) {
                        self.children.set(index, updated)
                        self.paint_bounds = widget_paint_bounds(
                            self.widget, self.bounds, self.children,)
                        ret true
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }

    pub fn patch_text(self: mut Self, id: str, value: str) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_text(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_style(self: mut Self, id: str, value: Style) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_style(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_focus(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_focus(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_disabled(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_disabled(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_checked(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_checked(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_value(self: mut Self, id: str, value: f32) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_value(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    /// Recomputes only the named subtree inside its existing outer bounds.
    /// Parent and sibling geometry stays intact.
    pub fn relayout_subtree(self: mut Self, id: str) -> bool {
        if self.widget.id() == id {
            let updated = layout_widget(self.widget, self.bounds)
            self.widget = updated.widget
            self.children = updated.children
            self.paint_bounds = updated.paint_bounds
            ret true
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let mut updated = child
                    if updated.relayout_subtree(id) {
                        self.children.set(index, updated)
                        self.paint_bounds = widget_paint_bounds(
                            self.widget, self.bounds, self.children,)
                        ret true
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }

    /// Replaces and lays out one structural component inside its current
    /// bounds. Unrelated ancestors, siblings, and their layout results are
    /// retained.
    pub fn replace_subtree(self: mut Self, id: str, replacement: Widget) -> bool {
        if self.widget.id() == id {
            let updated = layout_widget(replacement, self.bounds)
            self.widget = updated.widget
            self.children = updated.children
            self.paint_bounds = updated.paint_bounds
            ret true
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let mut updated = child
                    if updated.replace_subtree(id, replacement) {
                        self.children.set(index, updated)
                        self.paint_bounds = widget_paint_bounds(
                            self.widget, self.bounds, self.children,)
                        ret true
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
}

fn restyle_widget_layout(previous: WidgetLayout, widget: Widget) -> WidgetLayout {
    let previous_children = previous.children()
    let source_children = widget.children()
    let content = previous.bounds().inset(widget.style().padding())
    let scroll = widget.style().layout().scroll()
    let positioned_content = Rect::new(content.x() - scroll.x(), content.y() - scroll.y(), content.width(),
        content.height(),)
    let mut flow = Vec[Widget]::new()
    let mut positioned = Vec[Widget]::new()
    let mut index = 0_usize
    while index < source_children.len() {
        match source_children.get(index) {
            Option[Widget]::Some(child) => {
                if child.style().layout().flex().displayed() {
                    if child.style().layout().position().absolute() {
                        positioned.push(child)
                    } else {
                        flow.push(child)
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    flow = ordered_widgets(flow)
    let mut layouts = Vec[WidgetLayout]::new()
    let mut previous_index = 0_usize
    index = 0_usize
    while index < flow.len() {
        match flow.get(index) {
            Option[Widget]::Some(child) => {
                match previous_children.get(previous_index) {
                    Option[WidgetLayout]::Some(old_child) => {
                        layouts.push(restyle_widget_layout(old_child, child))
                    }
                    Option[WidgetLayout]::None => {
                        // A structural change is outside the fast-path contract,
                        // but laying out the new subtree keeps the result valid.
                        layouts.push(layout_widget(child, previous.bounds()))
                    }
                }
                previous_index = previous_index + 1_usize
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    index = 0_usize
    while index < positioned.len() {
        match positioned.get(index) {
            Option[Widget]::Some(child) => {
                layouts.push(layout_widget(child, absolute_child_rect(child, positioned_content)))
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    let stacked = stacked_layouts(layouts)
    ret WidgetLayout {
        widget, previous.bounds(), stacked,
        widget_paint_bounds(widget, previous.bounds(), stacked)
    }
}

/// Owns a persistent layout and records the smallest class of work required
/// after state changes. Paint-only patches keep geometry and child structure
/// intact; callers explicitly invalidate layout or structure when necessary.
pub struct ReactiveUi {
    layout: WidgetLayout
    paths: Vec[WidgetPath]
    paint_targets: Vec[str]
    layout_targets: Vec[str]
    interaction_bases: Vec[Widget]
    transitions: Vec[StyleTransition]
    range_transitions: Vec[RangeTransition]
    reduced_motion: bool
    structure_dirty: bool
    generation: usize
}

struct StyleTransition {
    id: str
    from: Style
    to: Style
    from_value: f32
    to_value: f32
    started_at: u64
    duration_ms: u64
    delay_ms: u64
    elapsed_offset_ms: u64
    easing: usize
    properties: str
    started: bool
    layout: bool
    value: bool
}

struct RangeTransition {
    id: str
    from_start: f32
    from_end: f32
    to_start: f32
    to_end: f32
    started_at: u64
    duration_ms: u64
}

impl for ReactiveUi {
    pub fn new(layout: WidgetLayout) -> Self {
        ret Self {
            layout, widget_paths(layout, 1_usize), Vec[str]::new(),
            Vec[str]::new(), Vec[Widget]::new(), Vec[StyleTransition]::new(),
            Vec[RangeTransition]::new(), false, false, 1_usize
        }
    }

    /// Enables the accessibility mode in which CSS transitions commit their
    /// final state immediately while retaining normal transition semantics.
    pub fn with_reduced_motion(self: mut Self, reduced: bool) -> Self {
        self.reduced_motion = reduced
        ret self
    }

    pub fn has_active_transitions(self: mut Self) -> bool {
        ret self.transitions.len() > 0_usize || self.range_transitions.len() > 0_usize
    }

    /// Animates a range control from its retained visual position to committed
    /// model endpoints without delaying pointer input or layout.
    pub fn transition_range(self: mut Self, id: str, start: f32, end: f32,
        now_ms: u64, duration_ms: u64,) -> bool {
        let current = match self.find_widget(id) {
            Some(value) => value
            None => {
                ret false
            }
        }
        self.cancel_range_transition(id)
        if self.reduced_motion || duration_ms == 0_u64 {
            ret self.patch_range(id, start, end)
        }
        self.range_transitions.push(RangeTransition {
                id, current.range_start(), current.range_end(), start, end,
                now_ms, duration_ms
            }
            ,)
        ret true
    }

    pub fn cancel_range_transition(self: mut Self, id: str) ->() {
        let mut retained = Vec[RangeTransition]::new()
        for transition in self.range_transitions {
            if transition.id != id {
                retained.push(transition)
            }
        }
        self.range_transitions = retained
        ret()
    }

    /// Starts a retained CSS transition from the currently displayed style.
    pub fn transition_widget(self: mut Self, id: str, replacement: Widget,
        now_ms: u64,) -> bool {
        let current = match self.find_widget(id) {
            Some(value) => value
            None => {
                ret false
            }
        }
        self.cancel_transition(id, now_ms)
        let transition = replacement.style().transition()
        let countdown = replacement.countdown_duration_ms() > 0_u64 &&
        replacement.countdown_cycle() != current.countdown_cycle()
        let properties = if countdown {
            "value"
        } else {
            transition.properties()
        }
        let duration = if self.reduced_motion {
            0_u64
        } elif countdown {
            replacement.countdown_duration_ms()
        } else {
            transition_duration_ms(transition.durations())
        }
        // Ordinary control values are authoritative model state and must be
        // committed immediately. Only an explicit countdown owns a retained,
        // paint-only value animation.
        let value_changed = countdown
        if properties == "none" || duration == 0_u64 ||
        (current.style().equivalent(replacement.style()) && !value_changed)
        {
            ret self.patch_widget(id, replacement)
        }
        let signed_delay = transition_delay_ms(transition.delays())
        let delay = if signed_delay > 0_i64 {
            signed_delay as u64
        } else {
            0_u64
        }
        let offset = if signed_delay < 0_i64 {
            ( - signed_delay) as u64
        } else {
            0_u64
        }
        let layout_changed = !current.style().layout_equivalent(replacement.style())
        let from_value = if countdown {
            1.0_f32
        } else {
            current.value()
        }
        let staged = replacement.with_style(current.style()).with_value(from_value)
        if !self.patch_widget(id, staged) {
            ret false
        }
        self.transitions.push(StyleTransition {
                id, current.style(), replacement.style(), from_value, replacement.value(),
                now_ms, duration, delay,
                if offset > duration {
                    duration
                } else {
                    offset
                }
                ,
                if countdown {
                    easing_linear()
                } else {
                    transition_easing(transition.easings())
                }
                ,
                properties, false, layout_changed, value_changed
            }
            ,)
        dispatch_transition_properties(self, id, ui_event_transition_run(), properties, 0.0_f32)
        ret true
    }

    /// Advances active CSS transitions and patches only their retained nodes.
    pub fn advance_transitions(self: mut Self, now_ms: u64) -> bool {
        if self.transitions.len() == 0_usize && self.range_transitions.len() == 0_usize {
            ret false
        }
        let mut retained = Vec[StyleTransition]::new()
        let mut changed = false
        for transition in self.transitions {
            let begin = transition.started_at + transition.delay_ms
            if now_ms < begin {
                retained.push(transition)
            } else {
                if !transition.started {
                    dispatch_transition_properties(self, transition.id, ui_event_transition_start(),
                        transition.properties, transition.elapsed_offset_ms as f32 / 1000.0_f32,)
                }
                let elapsed = now_ms - begin + transition.elapsed_offset_ms
                let amount = if elapsed >= transition.duration_ms {
                    1.0_f32
                } else {
                    elapsed as f32 / transition.duration_ms as f32
                }
                let eased = apply_easing(amount, transition.easing)
                match self.find_widget(transition.id) {
                    Some(widget) => {
                        let interpolated_value = transition.from_value +
                        (transition.to_value - transition.from_value) * eased
                        let next = widget.with_style(interpolate_style(transition.from, transition.to,
                                eased,)).with_value(if transition.value {
                                interpolated_value
                            } else {
                                widget.value()
                            }
                        )
                        if self.patch_widget(transition.id, next) {
                            if transition.layout {
                                self.invalidate_layout(self.layout.widget().id())
                            }
                            changed = true
                        }
                    }
                    None => {
                    }
                }
                if amount >= 1.0_f32 {
                    match self.find_widget(transition.id) {
                        Some(widget) => {
                            let committed = widget.with_style(transition.to)
                            .with_value(if transition.value {
                                    transition.to_value
                                } else {
                                    widget.value()
                                }
                            )
                            let _committed = self.patch_widget(transition.id, committed)
                        }
                        None => {
                        }
                    }
                    dispatch_transition_properties(self, transition.id, ui_event_transition_end(),
                        transition.properties, transition.duration_ms as f32 / 1000.0_f32,)
                } else {
                    retained.push(StyleTransition {
                            transition.id, transition.from, transition.to,
                            transition.from_value, transition.to_value, transition.started_at,
                            transition.duration_ms, transition.delay_ms, transition.elapsed_offset_ms,
                            transition.easing, transition.properties, true, transition.layout,
                            transition.value
                        }
                        ,)
                }
            }
        }
        self.transitions = retained
        let mut retained_ranges = Vec[RangeTransition]::new()
        for transition in self.range_transitions {
            let elapsed = if now_ms > transition.started_at {
                now_ms - transition.started_at
            } else {
                0_u64
            }
            let amount = if elapsed >= transition.duration_ms {
                1.0_f32
            } else {
                elapsed as f32 / transition.duration_ms as f32
            }
            let eased = apply_easing(amount, easing_out())
            let start = transition.from_start +
            (transition.to_start - transition.from_start) * eased
            let end = transition.from_end +
            (transition.to_end - transition.from_end) * eased
            if self.patch_range(transition.id, start, end) {
                changed = true
            }
            if amount < 1.0_f32 {
                retained_ranges.push(transition)
            }
        }
        self.range_transitions = retained_ranges
        ret changed
    }

    fn cancel_transition(self: mut Self, id: str, now_ms: u64) ->() {
        let mut retained = Vec[StyleTransition]::new()
        for transition in self.transitions {
            if transition.id == id {
                let begin = transition.started_at + transition.delay_ms
                let elapsed = if now_ms > begin {
                    now_ms - begin
                } else {
                    0_u64
                }
                dispatch_transition_properties(self, id, ui_event_transition_cancel(),
                    transition.properties, elapsed as f32 / 1000.0_f32,)
            } else {
                retained.push(transition)
            }
        }
        self.transitions = retained
        ret()
    }

    pub fn layout(self: mut Self) -> WidgetLayout {
        ret self.layout
    }
    pub fn paint_targets(self: mut Self) -> Vec[str] {
        ret self.paint_targets
    }
    pub fn needs_layout(self: mut Self) -> bool {
        ret self.layout_targets.len() > 0_usize || self.structure_dirty
    }
    pub fn needs_structure(self: mut Self) -> bool {
        ret self.structure_dirty
    }
    pub fn is_dirty(self: mut Self) -> bool {
        ret self.paint_targets.len() > 0_usize || self.layout_targets.len() > 0_usize || self.structure_dirty
    }
    pub fn segment_generation(self: mut Self, id: str) -> usize {
        for entry in self.paths {
            if entry.id == id {
                ret entry.generation
            }
        }
        ret 0_usize
    }

    /// Reconciles a newly rendered tree against retained state. Stable
    /// structure and geometry become paint patches; geometry changes request
    /// layout, and identity/order changes request a structural rebuild.
    pub fn reconcile(self: mut Self, root: Widget) -> u32 {
        let next = self.preserve_range_transition_values(
            inherit_widget_styles(root),)
        let mut targets = Vec[str]::new()
        let change = collect_widget_changes(
            self.layout.retained_widget(), next, targets,)
        if change == 0_u32 {
            // Event closures may capture a new graph even when no pixels
            // changed. Refresh retained widget values and hit-path entries
            // without invalidating layout or paint.
            self.layout = self.layout.restyle(next)
            self.paths = widget_paths(self.layout, self.generation)
        } elif change == 1_u32 {
            self.layout = self.layout.restyle(next)
            self.generation = self.generation + 1_usize
            self.paths = widget_paths(self.layout, self.generation)
            for target in targets {
                self.mark_paint(target)
            }
        } elif change == 2_u32 {
            self.invalidate_layout(self.layout.widget().id())
        } elif change == 3_u32 {
            self.invalidate_structure()
        }
        ret change
    }

    fn preserve_range_transition_values(self: mut Self, root: Widget) -> Widget {
        let mut children = Vec[Widget]::new()
        for child in root.children() {
            children.push(self.preserve_range_transition_values(child))
        }
        let mut rebuilt = root.with_children(children)
        for transition in self.range_transitions {
            if transition.id == rebuilt.id() {
                match self.find_widget(rebuilt.id()) {
                    Some(current) => {
                        rebuilt = rebuilt.with_value(current.range_start())
                        .with_attribute("data-luma-range-end",
                            Debug::fmt(current.range_end()),)
                    }
                    None => {
                    }
                }
            }
        }
        ret rebuilt
    }

    fn path(self: mut Self, id: str) -> Option[Vec[usize]] {
        for entry in self.paths {
            if entry.id == id {
                ret Option[Vec[usize]]::Some(entry.indices)
            }
        }
        ret Option[Vec[usize]]::None
    }

    pub fn find_widget(self: mut Self, id: str) -> Option[Widget] {
        for entry in self.paths {
            if entry.id == id {
                ret Option[Widget]::Some(entry.widget)
            }
        }
        ret Option[Widget]::None
    }

    /// Dispatches through the retained path index in O(tree depth), avoiding
    /// reconstruction and recursive search of the complete widget tree for
    /// every pointer/key event.
    pub fn dispatch_event(self: mut Self, id: str, event: UiEvent < H >) -> bool {
        match self.path(id) {
            Some(indices) => {
                let mut ancestry = Vec[Widget]::new()
                if collect_layout_event_path(self.layout, indices, 0_usize, ancestry) {
                    ret dispatch_widget_event_path(ancestry, event)
                }
            }
            None => {
            }
        }
        ret true
    }

    /// Returns the immutable declarative widget underneath transient
    /// hover/active/focus styling, capturing it on first use.
    pub fn interaction_base(self: mut Self, id: str) -> Option[Widget] {
        for widget in self.interaction_bases {
            if widget.id() == id {
                ret Option[Widget]::Some(widget)
            }
        }
        match self.find_widget(id) {
            Option::Some(widget) => {
                self.interaction_bases.push(widget)
                ret Option[Widget]::Some(widget)
            }
            Option::None => {
                ret Option[Widget]::None
            }
        }
    }

    pub fn release_interaction_base(self: mut Self, id: str) ->() {
        let mut retained = Vec[Widget]::new()
        for widget in self.interaction_bases {
            if widget.id() != id {
                retained.push(widget)
            }
        }
        self.interaction_bases = retained
        ret()
    }

    /// Replaces the declarative snapshot restored when a transient
    /// hover/active/focus state ends. Incremental parent-fragment updates use
    /// this to keep a captured child tied to the newest model value.
    pub fn set_interaction_base(self: mut Self, widget: Widget) ->() {
        let id = widget.id()
        if id == "" {
            ret()
        }
        self.release_interaction_base(id)
        self.interaction_bases.push(widget)
        ret()
    }

    /// Drops transient pseudo-state snapshots before reconciling a new
    /// declarative model tree. The runtime reapplies current interaction
    /// states after the model update, so a stale hover/focus snapshot can
    /// never restore pre-update content.
    pub fn clear_interaction_bases(self: mut Self) ->() {
        self.interaction_bases.clear()
        ret()
    }

    /// Hit-tests the retained flat paint-order index. This avoids recursively
    /// copying the complete layout tree on every pointer-move event.
    pub fn hit(self: mut Self, x: f32, y: f32) -> str {
        let mut index = self.paths.len()
        while index > 0_usize {
            index -= 1_usize
            match self.paths.get(index) {
                Option::Some(entry) => {
                    let inside = x >= entry.bounds.x() && y >= entry.bounds.y() &&
                    x < entry.bounds.right() && y < entry.bounds.bottom()
                    if inside && !entry.disabled && entry.visible &&
                    entry.pointer_events && point_inside_clip(entry.clip, x, y) {
                        ret entry.id
                    }
                }
                Option::None => {
                }
            }
        }
        ret ""
    }

    pub fn find_layout(self: mut Self, id: str) -> Option[WidgetLayout] {
        match self.path(id) {
            Option::Some(indices) => {
                ret self.layout.layout_at_path(indices, 0_usize)
            }
            Option::None => {
            }
        }
        ret Option[WidgetLayout]::None
    }

    pub fn clip_for(self: mut Self, id: str) -> Option[Rect] {
        for entry in self.paths {
            if entry.id == id {
                ret entry.clip
            }
        }
        ret Option[Rect]::None
    }

    pub fn patch_widget(self: mut Self, id: str, replacement: Widget) -> bool {
        match self.path(id) {
            Option::Some(indices) => {
                if !self.layout.patch_widget_at_path(indices, 0_usize, replacement) {
                    ret false
                }
            }
            Option::None => {
                ret false
            }
        }
        let mut index = 0_usize
        while index < self.paths.len() {
            match self.paths.get(index) {
                Option::Some(entry) => {
                    if entry.id == id {
                        self.paths.set(index, WidgetPath {
                                entry.id, entry.indices, entry.bounds, entry.clip,
                                replacement, replacement.disabled(), replacement.style().visible(),
                                replacement.style().pointer_events(),
                                self.generation + 1_usize
                            }
                            ,)
                        self.generation = self.generation + 1_usize
                        break
                    }
                }
                Option::None => {
                }
            }
            index += 1_usize
        }
        self.mark_paint(id)
        ret true
    }
    /// Restores a widget and marks it for repaint. This is required when the
    /// previous reactive state has already been committed to the retained cache.
    pub fn restore_widget(self: mut Self, id: str, replacement: Widget) -> bool {
        ret self.patch_widget(id, replacement)
    }
    pub fn patch_text(self: mut Self, id: str, value: str) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_text(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_style(self: mut Self, id: str, value: Style) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_style(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_focus(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_focus(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_disabled(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_disabled(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_checked(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_checked(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_value(self: mut Self, id: str, value: f32) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_value(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_range(self: mut Self, id: str, start: f32, end: f32) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_value(start)
                    .with_attribute("data-luma-range-end", Debug::fmt(clamp_unit(end))),)
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn replace_subtree(self: mut Self, id: str, replacement: Widget) -> bool {
        match self.path(id) {
            Option::Some(indices) => {
                let inherited_clip = inherited_clip_at_path(
                    self.layout, indices, 0_usize, Option[Rect]::None,)
                if !self.layout.replace_subtree_at_path(indices, 0_usize,
                    replacement,) {
                    ret false
                }
                self.generation = self.generation + 1_usize
                let replacement_generation = self.generation
                let mut replacement_paths = Vec[WidgetPath]::new()
                match self.layout.layout_at_path(indices, 0_usize) {
                    Option::Some(updated) => {
                        collect_widget_paths(updated, indices, inherited_clip,
                            replacement_generation, replacement_paths,)
                    }
                    Option::None => {
                        ret false
                    }
                }
                // A retained animation normally replaces a subtree with the
                // same shape. Its entries are contiguous in preorder, so
                // overwrite that range without allocating and copying the
                // complete window hit index.
                let mut first = self.paths.len()
                let mut former_count = 0_usize
                let mut path_index = 0_usize
                while path_index < self.paths.len() {
                    match self.paths.get(path_index) {
                        Option::Some(entry) => {
                            if path_has_prefix(entry.indices, indices) {
                                if first == self.paths.len() {
                                    first = path_index
                                }
                                former_count = former_count + 1_usize
                            }
                        }
                        Option::None => {
                        }
                    }
                    path_index = path_index + 1_usize
                }
                if first < self.paths.len() &&
                former_count == replacement_paths.len() {
                    let mut replacement_index = 0_usize
                    while replacement_index < replacement_paths.len() {
                        match replacement_paths.get(replacement_index) {
                            Option::Some(entry) => {
                                self.paths.set(first + replacement_index, entry)
                            }
                            Option::None => {
                            }
                        }
                        replacement_index = replacement_index + 1_usize
                    }
                } else {
                    let mut next_paths = Vec[WidgetPath]::new()
                    let mut inserted = false
                    for entry in self.paths {
                        if path_has_prefix(entry.indices, indices) {
                            if !inserted {
                                for replacement_path in replacement_paths {
                                    next_paths.push(replacement_path)
                                }
                                inserted = true
                            }
                        } else {
                            next_paths.push(entry)
                        }
                    }
                    if !inserted {
                        for replacement_path in replacement_paths {
                            next_paths.push(replacement_path)
                        }
                    }
                    self.paths = next_paths
                }
            }
            Option::None => {
                ret false
            }
        }
        // A component background must be restored before any already-dirty
        // descendants are painted on top of it.
        let already_first = match self.paint_targets.get(0_usize) {
            Option::Some(target) => {
                target == id
            }
            Option::None => {
                false
            }
        }
        if !already_first {
            let mut ordered = Vec[str]::new()
            if id != "" {
                ordered.push(id)
            }
            for target in self.paint_targets {
                if target != id {
                    ordered.push(target)
                }
            }
            self.paint_targets = ordered
        }
        self.interaction_bases.clear()
        ret true
    }
    pub fn invalidate_layout(self: mut Self, id: str) ->() {
        self.mark_paint(id)
        if id != "" {
            let mut found = false
            for target in self.layout_targets {
                if target == id {
                    found = true
                }
            }
            if !found {
                self.layout_targets.push(id)
            }
        }
        ret()
    }
    /// Marks a stable widget subtree for repaint without changing its layout.
    pub fn invalidate_paint(self: mut Self, id: str) ->() {
        self.mark_paint(id)
        ret()
    }
    pub fn invalidate_structure(self: mut Self) ->() {
        self.structure_dirty = true
        ret()
    }
    pub fn flush_layout(self: mut Self) -> bool {
        if self.structure_dirty {
            ret false
        }
        for target in self.layout_targets {
            if !self.layout.relayout_subtree(target) {
                ret false
            }
        }
        self.layout_targets.clear()
        self.generation = self.generation + 1_usize
        self.paths = widget_paths(self.layout, self.generation)
        ret true
    }
    pub fn replace_layout(self: mut Self, value: WidgetLayout) ->() {
        self.layout = value
        self.generation = self.generation + 1_usize
        self.paths = widget_paths(value, self.generation)
        self.paint_targets.clear()
        self.layout_targets.clear()
        self.structure_dirty = false
        self.interaction_bases.clear()
        ret()
    }
    pub fn clear_paint(self: mut Self) ->() {
        self.paint_targets.clear()
        ret()
    }
    /// Marks the current retained layout as committed by a renderer that owns
    /// presentation outside `Window.draw_reactive`.
    pub fn commit_rendered(self: mut Self) ->() {
        self.paint_targets.clear()
        self.layout_targets.clear()
        self.structure_dirty = false
        ret()
    }
    /// Clears committed targets while retaining caller-owned transient layers.
    pub fn retain_paint(self: mut Self, targets: Vec[str]) ->() {
        let mut retained = Vec[str]::new()
        for target in self.paint_targets {
            let mut keep = false
            for retained_target in targets {
                if target == retained_target {
                    keep = true
                }
            }
            if keep {
                retained.push(target)
            }
        }
        self.paint_targets = retained
        ret()
    }

    fn mark_paint(self: mut Self, id: str) ->() {
        if id == "" {
            ret()
        }
        for target in self.paint_targets {
            if target == id {
                ret()
            }
        }
        self.paint_targets.push(id)
        ret()
    }
}

pub fn layout_widget(widget: Widget, bounds: Rect) -> WidgetLayout {
    let content = bounds.inset(widget.style().padding())
    let scroll = widget.style().layout().scroll()
    let scrolled_content = Rect::new(content.x() - scroll.x(), content.y() - scroll.y(), content.width(),
        content.height(),)
    let widget_flex = widget.style().layout().flex()
    let direction = if widget_flex.direction_set() {
        widget_flex.direction()
    } else {
        widget.direction()
    }
    let all_children = if widget.kind() == widget_rich_text() {
        Vec[Widget]::new()
    } else {
        widget.children()
    }
    let mut children = Vec[Widget]::new()
    let mut positioned = Vec[Widget]::new()
    let mut child_index = 0_usize
    while child_index < all_children.len() {
        match all_children.get(child_index) {
            Option[Widget]::Some(child) => {
                if child.style().layout().flex().displayed() {
                    if child.style().layout().position().absolute() {
                        positioned.push(child)
                    } else {
                        children.push(child)
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        child_index = child_index + 1_usize
    }
    children = ordered_widgets(children)
    let mut flex_items = Vec[FlexItem]::new()
    let mut cross_extents = Vec[f32]::new()
    let mut grid_placements = Vec[GridPlacement]::new()
    let mut grid_minimum_content = Vec[Size]::new()
    let mut grid_maximum_content = Vec[Size]::new()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                let layout = child.style().layout()
                let flex = layout.flex()
                let margin = layout.margin()
                let horizontal_parent = direction == horizontal()
                let explicit = if horizontal_parent {
                    resolved_width(child, scrolled_content.width())
                } else {
                    resolved_height(child, scrolled_content.height())
                }
                let minimum = if horizontal_parent {
                    resolved_min_width(child)
                } else {
                    resolved_min_height(child)
                }
                let maximum = if horizontal_parent {
                    resolved_max_width(child)
                } else {
                    resolved_max_height(child)
                }
                let margin_size = if horizontal_parent {
                    margin.left() + margin.right()
                } else {
                    margin.top() + margin.bottom()
                }
                let default_basis = if flex.basis() >= 0.0_f32 {
                    flex.basis()
                } else {
                    child.basis()
                }
                let basis =(if explicit >= 0.0_f32 {
                        explicit
                    } else {
                        default_basis
                    }
                ) + margin_size
                let grow = if flex.grow() >= 0.0_f32 {
                    flex.grow()
                } else {
                    child.grow()
                }
                let shrink = if flex.shrink() >= 0.0_f32 {
                    flex.shrink()
                } else {
                    1.0_f32
                }
                flex_items.push(FlexItem::sized(basis, grow, shrink, minimum + margin_size, maximum +
                        margin_size,))
                let cross_explicit = if horizontal_parent {
                    resolved_height(child, scrolled_content.height())
                } else {
                    resolved_width(child, scrolled_content.width())
                }
                let cross_default = if horizontal_parent {
                    child.preferred_size().height()
                } else {
                    child.preferred_size().width()
                }
                let cross_margin = if horizontal_parent {
                    margin.top() + margin.bottom()
                } else {
                    margin.left() + margin.right()
                }
                cross_extents.push((if cross_explicit >= 0.0_f32 {
                            cross_explicit
                        } else {
                            cross_default
                        }
                    ) + cross_margin)
                grid_placements.push(layout.grid_placement())
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    let intrinsic_grid = widget_flex.grid() &&
    (widget_flex.column_template() != "" || widget_flex.auto_column_template() != "" ||
        widget_flex.auto_row_template() != "" || has_grid_placement(grid_placements))
    if intrinsic_grid {
        index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    grid_minimum_content.push(child.min_content_size())
                    grid_maximum_content.push(child.max_content_size())
                }
                Option[Widget]::None => {
                }
            }
            index = index + 1_usize
        }
    }
    let row_gap = if widget_flex.row_gap() >= 0.0_f32 {
        widget_flex.row_gap()
    } else {
        widget.style().gap()
    }
    let column_gap = if widget_flex.column_gap() >= 0.0_f32 {
        widget_flex.column_gap()
    } else {
        widget.style().gap()
    }
    let main_gap = if direction == horizontal() {
        column_gap
    } else {
        row_gap
    }
    let cross_gap = if direction == horizontal() {
        row_gap
    } else {
        column_gap
    }
    let rects = if widget_flex.grid() {
        if intrinsic_grid {
            grid_layout_intrinsic_placed(scrolled_content, widget_flex.column_template(), widget_flex.row_template(),
                widget_flex.auto_column_template(), widget_flex.auto_row_template(), row_gap, column_gap,
                grid_placements,
                grid_minimum_content, grid_maximum_content, widget_flex.auto_flow_column(), widget_flex.auto_flow_dense(),)
        } else {
            grid_layout_gaps(scrolled_content, widget_flex.columns(), row_gap, column_gap, children.len())
        }
    } elif widget_flex.wrap() {
        flex_wrap_layout(scrolled_content, direction, main_gap, cross_gap, widget_flex.justify(), flex_items,
            cross_extents, widget_flex.direction_reverse(), widget_flex.wrap_reverse(), widget_flex.align_content(),)
    } else {
        flex_layout_directional(scrolled_content, direction, main_gap, widget_flex.justify(), flex_items,
            widget_flex.direction_reverse(),)
    }
    let mut layouts = Vec[WidgetLayout]::new()
    index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                match rects.get(index) {
                    Option[Rect]::Some(rect) => {
                        let self_align = child.style().layout().flex().self_align()
                        let effective_align = if self_align >= 0_i32 {
                            self_align as usize
                        } else {
                            widget_flex.align()
                        }
                        let child_bounds = if widget_flex.grid() {
                            styled_grid_rect(child, rect, effective_align)
                        } else {
                            styled_child_rect(child, rect, direction, effective_align)
                        }
                        layouts.push(layout_widget(child, child_bounds))
                    }
                    Option[Rect]::None => {
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    index = 0_usize
    while index < positioned.len() {
        match positioned.get(index) {
            Option[Widget]::Some(child) => {
                layouts.push(layout_widget(child, absolute_child_rect(child, scrolled_content)))
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    layouts = stacked_layouts(layouts)
    ret WidgetLayout {
        widget, bounds, layouts, widget_paint_bounds(widget, bounds, layouts)
    }
}

fn has_grid_placement(values: Vec[GridPlacement]) -> bool {
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[GridPlacement]::Some(value) => {
                if value.column() > 0_usize || value.row() > 0_usize || value.column_span() > 1_usize
                || value.row_span() > 1_usize {
                    ret true
                }
            }
            Option[GridPlacement]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn stacked_layouts(source: Vec[WidgetLayout]) -> Vec[WidgetLayout] {
    let mut ordered = true
    let mut previous_z = - 2147483648_i32
    let mut ordered_index = 0_usize
    while ordered_index < source.len() {
        match source.get(ordered_index) {
            Option[WidgetLayout]::Some(layout) => {
                let z = layout.widget().style().layout().position().z_index()
                if z < previous_z {
                    ordered = false
                }
                previous_z = z
            }
            Option[WidgetLayout]::None => {
            }
        }
        ordered_index = ordered_index + 1_usize
    }
    if ordered {
        ret source
    }
    let mut result = Vec[WidgetLayout]::new()
    let mut used = Vec[bool]::new()
    let mut index = 0_usize
    while index < source.len() {
        used.push(false) index = index + 1_usize
    }
    while result.len() < source.len() {
        let mut best = source.len()
        let mut best_z = 2147483647_i32
        index = 0_usize
        while index < source.len() {
            match used.get(index) {
                Option[bool]::Some(is_used) => {
                    if !is_used {
                        match source.get(index) {
                            Option[WidgetLayout]::Some(layout) => {
                                let z = layout.widget().style().layout().position().z_index()
                                if best == source.len() || z < best_z {
                                    best = index best_z = z
                                }
                            }
                            Option[WidgetLayout]::None => {
                            }
                        }
                    }
                }
                Option[bool]::None => {
                }
            }
            index = index + 1_usize
        }
        if best == source.len() {
            break
        }
        match source.get(best) {
            Option[WidgetLayout]::Some(layout) => {
                result.push(layout) used.set(best, true)
            }
            Option[WidgetLayout]::None => {
                break
            }
        }
    }
    ret result
}

fn ordered_widgets(source: Vec[Widget]) -> Vec[Widget] {
    let mut ordered = true
    let mut previous_order = - 2147483648_i32
    let mut ordered_index = 0_usize
    while ordered_index < source.len() {
        match source.get(ordered_index) {
            Option[Widget]::Some(widget) => {
                let order = widget.style().layout().flex().order()
                if order < previous_order {
                    ordered = false
                }
                previous_order = order
            }
            Option[Widget]::None => {
            }
        }
        ordered_index = ordered_index + 1_usize
    }
    if ordered {
        ret source
    }
    let mut result = Vec[Widget]::new()
    let mut used = Vec[bool]::new()
    let mut index = 0_usize
    while index < source.len() {
        used.push(false) index = index + 1_usize
    }
    while result.len() < source.len() {
        let mut best = source.len()
        let mut best_order = 2147483647_i32
        index = 0_usize
        while index < source.len() {
            match used.get(index) {
                Option[bool]::Some(is_used) => {
                    if !is_used {
                        match source.get(index) {
                            Option[Widget]::Some(widget) => {
                                let order = widget.style().layout().flex().order()
                                if best == source.len() || order < best_order {
                                    best = index best_order = order
                                }
                            }
                            Option[Widget]::None => {
                            }
                        }
                    }
                }
                Option[bool]::None => {
                }
            }
            index = index + 1_usize
        }
        if best == source.len() {
            break
        }
        match source.get(best) {
            Option[Widget]::Some(widget) => {
                result.push(widget) used.set(best, true)
            }
            Option[Widget]::None => {
                break
            }
        }
    }
    ret result
}

pub fn inherit_widget_styles(root: Widget) -> Widget {
    ret inherit_widget_node(root, Option[Style]::None)
}

fn inherit_widget_node(widget: Widget, parent: Option[Style]) -> Widget {
    let styled = match parent {
        Option[Style]::Some(parent_style) => {
            widget.with_computed_style(widget.style().inherit_text(parent_style))
        }
        Option[Style]::None => {
            widget
        }
    }
    let source = styled.children()
    let mut children = Vec[Widget]::new()
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[Widget]::Some(child) => {
                children.push(inherit_widget_node(child, Option[Style]::Some(styled.style())))
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    ret styled.with_children(children)
}

fn absolute_child_rect(widget: Widget, containing: Rect) -> Rect {
    let layout = widget.style().layout()
    let position = layout.position()
    let margin = layout.margin()
    let available_width = containing.width() - margin.left() - margin.right()
    let available_height = containing.height() - margin.top() - margin.bottom()
    let explicit_width = resolved_width(widget, available_width)
    let explicit_height = resolved_height(widget, available_height)
    let automatic_width = if position.left_set() && position.right_set() {
        available_width - position.left() - position.right()
    } else {
        widget.preferred_size().width()
    }
    let automatic_height = if position.top_set() && position.bottom_set() {
        available_height - position.top() - position.bottom()
    } else {
        widget.basis()
    }
    let width = clamp_dimension(if explicit_width >= 0.0_f32 {
            explicit_width
        } else {
            automatic_width
        }
        ,
        resolved_min_width(widget), resolved_max_width(widget), available_width,)
    let height = clamp_dimension(if explicit_height >= 0.0_f32 {
            explicit_height
        } else {
            automatic_height
        }
        ,
        resolved_min_height(widget), resolved_max_height(widget), available_height,)
    let x = if position.left_set() {
        containing.x() + position.left() + margin.left()
    } elif position.right_set() {
        containing.right() - position.right() - margin.right() - width
    } else {
        containing.x() + margin.left()
    }
    let y = if position.top_set() {
        containing.y() + position.top() + margin.top()
    } elif position.bottom_set() {
        containing.bottom() - position.bottom() - margin.bottom() - height
    } else {
        containing.y() + margin.top()
    }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn styled_child_rect(widget: Widget, allocated: Rect, parent_direction: usize, align: usize) -> Rect
{
    let layout = widget.style().layout()
    let inner = allocated.inset(layout.margin())
    let explicit_width = if parent_direction == horizontal() {
        - 1.0_f32
    } else {
        resolved_width(widget, inner.width())
    }
    let explicit_height = if parent_direction == vertical() {
        - 1.0_f32
    } else {
        resolved_height(widget, inner.height())
    }
    let requested_width = if explicit_width >= 0.0_f32 {
        explicit_width
    } else {
        inner.width()
    }
    let requested_height = if explicit_height >= 0.0_f32 {
        explicit_height
    } else {
        inner.height()
    }
    let width = clamp_dimension(requested_width, resolved_min_width(widget), resolved_max_width(widget),
        inner.width(),)
    let height = clamp_dimension(requested_height, resolved_min_height(widget), resolved_max_height(widget),
        inner.height(),)
    let x = if parent_direction == vertical() && align == align_center() {
        inner.x() +(inner.width() - width) / 2.0_f32
    } elif parent_direction == vertical() && align == align_end() {
        inner.right() - width
    } else {
        inner.x()
    }
    let y = if parent_direction == horizontal() && align == align_center() {
        inner.y() +(inner.height() - height) / 2.0_f32
    } elif parent_direction == horizontal() && align == align_end() {
        inner.bottom() - height
    } else {
        inner.y()
    }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn relative_child_rect(widget: Widget, bounds: Rect) -> Rect {
    let position = widget.style().layout().position()
    if !position.relative() {
        ret bounds
    }
    let x = bounds.x() + if position.left_set() {
        position.left()
    } elif position.right_set() {
        - position.right()
    } else {
        0.0_f32
    }
    let y = bounds.y() + if position.top_set() {
        position.top()
    } elif position.bottom_set() {
        - position.bottom()
    } else {
        0.0_f32
    }
    ret Rect::new(x, y, bounds.width(), bounds.height())
}

fn styled_grid_rect(widget: Widget, allocated: Rect, align: usize) -> Rect {
    let layout = widget.style().layout()
    let inner = allocated.inset(layout.margin())
    let explicit_width = resolved_width(widget, inner.width())
    let explicit_height = resolved_height(widget, inner.height())
    let width = clamp_dimension(if explicit_width >= 0.0_f32 {
            explicit_width
        } else {
            inner.width()
        }
        ,
        resolved_min_width(widget), resolved_max_width(widget), inner.width(),)
    let height = clamp_dimension(if explicit_height >= 0.0_f32 {
            explicit_height
        } else {
            inner.height()
        }
        ,
        resolved_min_height(widget), resolved_max_height(widget), inner.height(),)
    let x = if align == align_center() {
        inner.x() +(inner.width() - width) / 2.0_f32
    } elif align == align_end() {
        inner.right() - width
    } else {
        inner.x()
    }
    let y = if align == align_center() {
        inner.y() +(inner.height() - height) / 2.0_f32
    } elif align == align_end() {
        inner.bottom() - height
    } else {
        inner.y()
    }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn resolved_width(widget: Widget, available: f32) -> f32 {
    let layout = widget.style().layout()
    let value = if layout.relative().width() >= 0.0_f32 {
        available * layout.relative().width()
    } else {
        layout.width()
    }
    ret if value >= 0.0_f32 && layout.content_box() {
        value + box_width_extra(widget)
    } else {
        value
    }
}

fn resolved_height(widget: Widget, available: f32) -> f32 {
    let layout = widget.style().layout()
    let value = if layout.relative().height() >= 0.0_f32 {
        available * layout.relative().height()
    } else {
        layout.height()
    }
    ret if value >= 0.0_f32 && layout.content_box() {
        value + box_height_extra(widget)
    } else {
        value
    }
}

fn box_width_extra(widget: Widget) -> f32 {
    let style = widget.style()
    ret style.padding().left() + style.padding().right() + style.border_width() * 2.0_f32
}

fn box_height_extra(widget: Widget) -> f32 {
    let style = widget.style()
    ret style.padding().top() + style.padding().bottom() + style.border_width() * 2.0_f32
}

fn resolved_min_width(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() {
        box_width_extra(widget)
    } else {
        0.0_f32
    }
    ret widget.style().layout().min_width() + extra
}
fn resolved_min_height(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() {
        box_height_extra(widget)
    } else {
        0.0_f32
    }
    ret widget.style().layout().min_height() + extra
}
fn resolved_max_width(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() {
        box_width_extra(widget)
    } else {
        0.0_f32
    }
    ret widget.style().layout().max_width() + extra
}
fn resolved_max_height(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() {
        box_height_extra(widget)
    } else {
        0.0_f32
    }
    ret widget.style().layout().max_height() + extra
}

fn clamp_dimension(value: f32, minimum: f32, maximum: f32, available: f32) -> f32 {
    let mut result = value
    if result < minimum {
        result = minimum
    }
    if result > maximum {
        result = maximum
    }
    if result > available {
        result = available
    }
    if result < 0.0_f32 {
        ret 0.0_f32
    }
    ret result
}

fn dispatch_transition_properties(ui: mut ReactiveUi, id: str, kind: u32,
    properties: str, elapsed: f32,) ->() {
    let mut remaining = transition_trim(properties)
    while remaining != "" {
        let comma = transition_find(remaining, ",")
        let property = transition_trim(if comma < remaining.char_len() {
                remaining.slice(0_usize, comma)
            } else {
                remaining
            }
        )
        if property != "" && property != "none" {
            let _dispatched = ui.dispatch_event(id, UiEvent::transition(kind, id, property, elapsed))
        }
        if comma == remaining.char_len() {
            break
        }
        remaining = transition_trim(remaining.slice(comma + 1_usize,
                remaining.char_len() - comma - 1_usize,))
    }
    ret()
}

fn transition_duration_ms(values: str) -> u64 {
    let mut maximum = 0_i64
    let mut remaining = transition_trim(values)
    while remaining != "" {
        let comma = transition_find(remaining, ",")
        let value = transition_time_ms(transition_trim(if comma < remaining.char_len() {
                    remaining.slice(0_usize, comma)
                } else {
                    remaining
                }
            ))
        if value > maximum {
            maximum = value
        }
        if comma == remaining.char_len() {
            break
        }
        remaining = transition_trim(remaining.slice(comma + 1_usize,
                remaining.char_len() - comma - 1_usize,))
    }
    ret if maximum > 0_i64 {
        maximum as u64
    } else {
        0_u64
    }
}

fn transition_delay_ms(values: str) -> i64 {
    let comma = transition_find(values, ",")
    ret transition_time_ms(transition_trim(if comma < values.char_len() {
                values.slice(0_usize, comma)
            } else {
                values
            }
        ))
}

fn transition_easing(values: str) -> usize {
    let comma = transition_find(values, ",")
    let value = transition_trim(if comma < values.char_len() {
            values.slice(0_usize, comma)
        } else {
            values
        }
    )
    if value == "linear" {
        ret easing_linear()
    }
    if value == "ease-in" {
        ret easing_in()
    }
    if value == "ease-out" {
        ret easing_out()
    }
    if value == "ease-in-out" || value == "ease" {
        ret easing_in_out()
    }
    ret easing_in_out()
}

fn transition_time_ms(value: str) -> i64 {
    let input = transition_trim(value)
    let seconds = transition_ends_with(input, "s") && !transition_ends_with(input, "ms")
    let suffix = if seconds {
        1_usize
    } else {
        2_usize
    }
    if input.char_len() < suffix {
        ret 0_i64
    }
    let number = input.slice(0_usize, input.char_len() - suffix)
    let mut negative = false
    let mut result = 0.0_f32
    let mut fraction = 0.1_f32
    let mut decimal = false
    let mut index = 0_usize
    while index < number.char_len() {
        let character = number.slice(index, 1_usize)
        if character == "-" && index == 0_usize {
            negative = true
        } elif character == "." {
            decimal = true
        } else {
            let digit = transition_digit(character)
            if digit < 0_i32 {
                ret 0_i64
            }
            if decimal {
                result = result +(digit as f32) * fraction
                fraction = fraction * 0.1_f32
            } else {
                result = result * 10.0_f32 + digit as f32
            }
        }
        index += 1_usize
    }
    if seconds {
        result = result * 1000.0_f32
    }
    ret if negative {
        -(result as i64)
    } else {
        result as i64
    }
}

fn transition_digit(value: str) -> i32 {
    if value == "0" {
        ret 0_i32
    }
    if value == "1" {
        ret 1_i32
    }
    if value == "2" {
        ret 2_i32
    }
    if value == "3" {
        ret 3_i32
    }
    if value == "4" {
        ret 4_i32
    }
    if value == "5" {
        ret 5_i32
    }
    if value == "6" {
        ret 6_i32
    }
    if value == "7" {
        ret 7_i32
    }
    if value == "8" {
        ret 8_i32
    }
    if value == "9" {
        ret 9_i32
    }
    ret - 1_i32
}

fn transition_find(value: str, expected: str) -> usize {
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == expected {
            ret index
        }
        index += 1_usize
    }
    ret value.char_len()
}

fn transition_trim(value: str) -> str {
    let mut start = 0_usize
    let mut finish = value.char_len()
    while start < finish && transition_whitespace(value.slice(start, 1_usize)) {
        start += 1_usize
    }
    while finish > start && transition_whitespace(value.slice(finish - 1_usize, 1_usize)) {
        finish -= 1_usize
    }
    ret value.slice(start, finish - start)
}

fn transition_whitespace(value: str) -> bool {
    ret value == " " || value == "\n" || value == "\r" || value == "\t"
}

fn transition_ends_with(value: str, suffix: str) -> bool {
    ret value.char_len() >= suffix.char_len() &&
    value.slice(value.char_len() - suffix.char_len(), suffix.char_len()) == suffix
}
