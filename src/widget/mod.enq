fn intrinsic_widget_size(widget: Widget, maximum: bool) -> Size {
    let children = widget.children()
    let style = widget.style
    let padding = style.padding()
    let chrome_width = padding.left() + padding.right() + style.border_width() * 2.0_f32
    let chrome_height = padding.top() + padding.bottom() + style.border_width() * 2.0_f32
    if children.len() > 0_usize && widget.kind() != widget_rich_text() {
        let mut width = 0.0_f32
        let mut height = 0.0_f32
        let mut index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    let size = if maximum {
                        child.max_content_size()
                    } else {
                        child.min_content_size()
                    }
                    if widget.direction() == horizontal() {
                        width = width + size.width()
                        if size.height() > height {
                            height = size.height()
                        }
                    } else {
                        height = height + size.height()
                        if size.width() > width {
                            width = size.width()
                        }
                    }
                }
                Option[Widget]::None => {
                }
            }
            index = index + 1_usize
        }
        if children.len() > 1_usize {
            if widget.direction() == horizontal() {
                width = width + style.gap() *((children.len() - 1_usize) as f32)
            } else {
                height = height + style.gap() *((children.len() - 1_usize) as f32)
            }
        }
        ret Size::new(width + chrome_width, height + chrome_height)
    }
    if widget.text() != "" {
        let characters = if maximum {
            widget.text().char_len()
        } else {
            longest_text_word(widget.text())
        }
        let width =(characters as f32) * style.font_size() * 0.56_f32
        ret Size::new(width + chrome_width, style.font_size() * 1.35_f32 + chrome_height)
    }
    let preferred = widget.preferred_size()
    ret Size::new(preferred.width() + chrome_width, preferred.height() + chrome_height)
}

fn concatenated_widget_text(children: Vec[Widget]) -> str {
    let mut text = ""
    for child in children {
        text = text + child.text()
    }
    ret text
}

fn longest_text_word(value: str) -> usize {
    let mut longest = 0_usize
    let mut current = 0_usize
    let length = value.len()
    let mut index = 0_usize
    while index < length {
        match value.get_byte(index) {
            Option[u8]::Some(byte) => {
                if byte == 32_u8 || byte == 9_u8 || byte == 10_u8 || byte == 13_u8 {
                    if current > longest {
                        longest = current
                    }
                    current = 0_usize
                } elif byte < 128_u8 || byte >= 192_u8 {
                    current = current + 1_usize
                }
            }
            Option[u8]::None => {
            }
        }
        index = index + 1_usize
    }
    ret if current > longest {
        current
    } else {
        longest
    }
}

fn widget_value(kind: usize, id: str, text: str, style: Style, direction: usize, basis: f32, grow: f32,
    checked: bool, value: f32,) -> Widget {
    ret Widget {
        kind, id, "", Vec[WidgetAttribute]::new(), text, text.char_len(), TextSelection::caret(text.char_len()),
        style,
        direction, basis, grow, checked, false, false, value, Vec[Widget]::new(), SvgDocument::empty(),
        default_widget_tag(kind), false, UiEventHandlers::new(), - 1.0_f32
    }
}

fn selector_tree_widget(widget: Widget, empty_handlers: UiEventHandlers<H>,
    empty_svg: SvgDocument,) -> Widget {
    let mut children = Vec[Widget]::new()
    for child in widget.children {
        children.push(selector_tree_widget(child, empty_handlers, empty_svg))
    }
    ret Widget {
        widget.kind, widget.id, widget.classes, widget.attributes,
        if widget.text == "" {
            ""
        } else {
            "_"
        }
        , 0, TextSelection::caret(0),
        widget.style, widget.direction, widget.basis, widget.grow, widget.checked,
        widget.focused, widget.disabled, 0, children, empty_svg, widget.tag,
        widget.style_explicit, empty_handlers, widget.geometry_basis
    }
}

fn default_widget_tag(kind: usize) -> str {
    if kind == widget_canvas() {
        ret "canvas"
    }
    if kind == widget_panel() {
        ret "div"
    }
    if kind == widget_label() {
        ret "label"
    }
    if kind == widget_button() || kind == widget_icon_button() || kind == widget_icon_card() {
        ret "button"
    }
    if kind == widget_input() || kind == widget_checkbox() || kind == widget_radio() ||
    kind == widget_slider() || kind == widget_range_slider() || kind == widget_color_picker() ||
    kind == widget_color_channel() {
        ret "input"
    }
    if kind == widget_textarea() {
        ret "textarea"
    }
    if kind == widget_select() {
        ret "select"
    }
    if kind == widget_progress() {
        ret "progress"
    }
    if kind == widget_separator() {
        ret "hr"
    }
    if kind == widget_heading() {
        ret "h1"
    }
    if kind == widget_link() {
        ret "a"
    }
    if kind == widget_icon() {
        ret "svg"
    }
    if kind == widget_terminal() {
        ret "terminal"
    }
    if kind == widget_image() {
        ret "img"
    }
    if kind == widget_rich_text() {
        ret "span"
    }
    ret "widget"
}

fn parse_widget_u64(value: str, fallback: u64) -> u64 {
    if value == "" {
        ret fallback
    }
    let mut parsed = 0_u64
    let mut index = 0_usize
    while index < value.char_len() {
        let byte = value.slice(index, 1_usize).byte_at(0_usize)
        if byte < 48_u8 || byte > 57_u8 {
            ret fallback
        }
        parsed = parsed * 10_u64 +(byte - 48_u8) as u64
        index += 1_usize
    }
    ret parsed
}

fn parse_widget_f32(value: str, fallback: f32) -> f32 {
    if value == "" {
        ret fallback
    }
    let mut result = 0.0_f32
    let mut fraction = 0.1_f32
    let mut decimal = false
    let mut index = 0_usize
    while index < value.char_len() {
        let byte = value.slice(index, 1_usize).byte_at(0_usize)
        if byte == 46_u8 {
            if decimal {
                ret fallback
            }
            decimal = true
        } elif byte >= 48_u8 && byte <= 57_u8 {
            let digit =(byte - 48_u8) as f32
            if decimal {
                result = result + digit * fraction
                fraction = fraction * 0.1_f32
            } else {
                result = result * 10.0_f32 + digit
            }
        } else {
            ret fallback
        }
        index += 1_usize
    }
    ret result
}

/// Dispatches capture, target and bubble listeners along the retained widget
/// ancestry. Returns false when a listener prevented the default action.
pub fn dispatch_widget_event(root: Widget, target: str, event: UiEvent<H>) -> bool {
    let mut path = Vec[Widget]::new()
    if !collect_widget_event_path(root, target, path) {
        ret true
    }
    ret dispatch_widget_event_path(path, event)
}

fn dispatch_widget_event_path(path: Vec[Widget], event: UiEvent<H>) -> bool {
    let kind = event.kind()
    let mut index = 0_usize
    while index < path.len() {
        if event.propagation_stopped() {
            ret !event.default_prevented()
        }
        match path.get(index) {
            Some(widget) => {
                let phase = if index + 1_usize == path.len() {
                    ui_phase_target()
                } else {
                    ui_phase_capture()
                }
                event.enter(widget.id(), phase)
                widget.handlers().dispatch(kind, true, event)
            }
            None => {
            }
        }
        index += 1_usize
    }
    if path.len() > 0_usize && !event.propagation_stopped() {
        match path.get(path.len() - 1_usize) {
            Some(widget) => {
                event.enter(widget.id(), ui_phase_target())
                widget.handlers().dispatch(kind, false, event)
            }
            None => {
            }
        }
    }
    if path.len() > 1_usize {
        index = path.len() - 1_usize
        while index > 0_usize {
            index -= 1_usize
            if event.propagation_stopped() {
                ret !event.default_prevented()
            }
            match path.get(index) {
                Some(widget) => {
                    event.enter(widget.id(), ui_phase_bubble())
                    widget.handlers().dispatch(kind, false, event)
                }
                None => {
                }
            }
        }
    }
    ret !event.default_prevented()
}

fn collect_layout_event_path(layout: WidgetLayout, indices: Vec[usize], depth: usize,
    path: mut Vec[Widget],) -> bool {
    path.push(layout.widget())
    if depth >= indices.len() {
        ret true
    }
    let child_index = indices.get(depth).unwrap_or(layout.children().len())
    match layout.children().get(child_index) {
        Some(child) => {
            if collect_layout_event_path(child, indices, depth + 1_usize, path) {
                ret true
            }
        }
        None => {
        }
    }
    path.pop()
    ret false
}

fn collect_widget_event_path(widget: Widget, target: str, path: mut Vec[Widget]) -> bool {
    path.push(widget)
    if widget.id() == target {
        ret true
    }
    for child in widget.children() {
        if collect_widget_event_path(child, target, path) {
            ret true
        }
    }
    path.pop()
    ret false
}

fn control_style() -> Style {
    ret Style::panel().with_padding(Insets::symmetric(8.0_f32, 10.0_f32)).with_radius(4.0_f32).with_overflow_hidden(true)
}

fn clamp_unit(value: f32) -> f32 {
    if value < 0.0_f32 {
        ret 0.0_f32
    }
    if value > 1.0_f32 {
        ret 1.0_f32
    }
    ret value
}

pub struct WidgetLayout {
    widget: Widget
    bounds: Rect
    children: Vec[WidgetLayout]
    paint_bounds: Rect
    source_index: usize
}

#attr(test)
fn scrollbar_geometry_tracks_content_and_clamps_drag() -> bool {
    let bounds = Rect::new(10.0_f32, 20.0_f32, 200.0_f32, 100.0_f32)
    let content_bounds = Rect::new(10.0_f32, - 430.0_f32, 180.0_f32, 1000.0_f32)
    let child = WidgetLayout {
        Widget::spacer(0.0_f32), content_bounds,
        Vec[WidgetLayout]::new(), content_bounds, 0
    }
    let mut children = Vec[WidgetLayout]::new()
    children.push(child)
    let root = Widget::panel("scroll").with_attribute("data-luma-scrollable", "true")
    .with_computed_style(Style::default().with_scroll(0.0_f32, 450.0_f32))
    let layout = WidgetLayout {
        root, bounds, children, bounds, 0
    }
    let thumb = layout.scrollbar_thumb()
    let empty = WidgetLayout {
        Widget::panel("empty"), bounds,
        Vec[WidgetLayout]::new(), bounds, 0
    }
    ret layout.scroll_max_y() == 900.0_f32 && thumb.height() == 24.0_f32 &&
    thumb.y() == 58.0_f32 && thumb.right() <= bounds.right() &&
    layout.scrollbar_offset_at(70.0_f32, 12.0_f32) == 450.0_f32 &&
    layout.scrollbar_offset_at( - 100.0_f32, 12.0_f32) == 0.0_f32 &&
    layout.scrollbar_offset_at(1000.0_f32, 12.0_f32) == 900.0_f32 &&
    empty.scrollbar_thumb().height() == 0.0_f32
}

struct WidgetPath {
    id: str
    indices: Vec[usize]
    bounds: Rect
    clip: Option[Rect]
    disabled: bool
    visible: bool
    pointer_events: bool
    generation: usize
}

fn collect_widgets(widget: Widget, expected: Vec[str],
    found: mut Vec[Widget],) -> bool {
    if expected.len() == 0_usize || found.len() >= expected.len() {
        ret true
    }
    if widget.id() != "" {
        let mut requested = false
        for id in expected {
            if id == widget.id() {
                requested = true
            }
        }
        if requested {
            let mut duplicate = false
            for current in found {
                if current.id() == widget.id() {
                    duplicate = true
                }
            }
            if !duplicate {
                found.push(widget)
                if found.len() >= expected.len() {
                    ret true
                }
            }
        }
    }
    for child in widget.children() {
        if collect_widgets(child, expected, found) {
            ret true
        }
    }
    ret false
}

fn collect_widget_paths(layout: WidgetLayout, indices: Vec[usize],
    inherited_clip: Option[Rect], generation: usize,
    paths: mut Vec[WidgetPath],) ->() {
    let bounds = layout.bounds()
    let widget = layout.widget()
    let clip = if widget.style.layout().overflow_hidden() {
        intersect_clip(inherited_clip, bounds)
    } else {
        inherited_clip
    }
    let id = widget.id()
    if id != "" {
        paths.push(WidgetPath {
                id, indices, bounds, clip, widget.disabled(),
                widget.style.visible(), widget.style.pointer_events(),
                generation
            }
            ,
        )
    }
    let children = layout.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option::Some(child) => {
                // `Vec` is a graph reference: assigning it creates another
                // owner of the same storage node. A path needs a private
                // sequence before appending the child index, otherwise the
                // parent and every previously retained sibling path mutate.
                let mut child_indices = Vec[usize]::new()
                child_indices.extend(indices)
                child_indices.push(index)
                collect_widget_paths(child, child_indices, clip, generation,
                    paths,)
            }
            Option::None => {
            }
        }
        index += 1_usize
    }
    ret()
}

fn widget_paths(layout: WidgetLayout, generation: usize) -> Vec[WidgetPath] {
    let mut paths = Vec[WidgetPath]::new()
    collect_widget_paths(layout, Vec[usize]::new(), Option[Rect]::None,
        generation, paths,)
    ret paths
}

fn path_has_prefix(path: Vec[usize], prefix: Vec[usize]) -> bool {
    if path.len() < prefix.len() {
        ret false
    }
    let mut index = 0_usize
    while index < prefix.len() {
        if path.get(index).unwrap_or(path.len()) !=
        prefix.get(index).unwrap_or(prefix.len()) {
            ret false
        }
        index = index + 1_usize
    }
    ret true
}

fn inherited_clip_at_path(layout: WidgetLayout, indices: Vec[usize],
    depth: usize, inherited: Option[Rect],) -> Option[Rect] {
    if depth >= indices.len() {
        ret inherited
    }
    let bounds = layout.bounds()
    let clip = if layout.widget().style.layout().overflow_hidden() {
        intersect_clip(inherited, bounds)
    } else {
        inherited
    }
    let index = indices.get(depth).unwrap_or(layout.children().len())
    match layout.children().get(index) {
        Option::Some(child) => {
            ret inherited_clip_at_path(child, indices, depth + 1_usize,
                clip,)
        }
        Option::None => {
        }
    }
    ret inherited
}

fn intersect_clip(inherited: Option[Rect], bounds: Rect) -> Option[Rect] {
    match inherited {
        Option::Some(parent) => {
            let left = if parent.x() > bounds.x() {
                parent.x()
            } else {
                bounds.x()
            }
            let top = if parent.y() > bounds.y() {
                parent.y()
            } else {
                bounds.y()
            }
            let right = if parent.right() < bounds.right() {
                parent.right()
            } else {
                bounds.right()
            }
            let bottom = if parent.bottom() < bounds.bottom() {
                parent.bottom()
            } else {
                bounds.bottom()
            }
            ret Option[Rect]::Some(Rect::new(left, top,
                    if right > left {
                        right - left
                    } else {
                        0.0_f32
                    }
                    ,
                    if bottom > top {
                        bottom - top
                    } else {
                        0.0_f32
                    }
                    ,))
        }
        Option::None => {
            ret Option[Rect]::Some(bounds)
        }
    }
    ret Option[Rect]::None
}

fn point_inside_clip(clip: Option[Rect], x: f32, y: f32) -> bool {
    match clip {
        Option::Some(bounds) => {
            ret x >= bounds.x() && y >= bounds.y() &&
            x < bounds.right() && y < bounds.bottom()
        }
        Option::None => {
            ret true
        }
    }
    ret true
}

fn widget_paint_bounds(widget: Widget, bounds: Rect,
    children: Vec[WidgetLayout],) -> Rect {
    let outline = widget.style.outline()
    let outline_extent = outline.width() +
    if outline.offset() > 0.0_f32 {
        outline.offset()
    } else {
        0.0_f32
    }
    let shadow = widget.style.shadow()
    let shadow_extent = if shadow.inset() {
        0.0_f32
    } else {
        shadow.blur() + if shadow.spread() > 0.0_f32 {
            shadow.spread()
        } else {
            0.0_f32
        }
    }
    let left = outline_extent +
    if shadow_extent - shadow.x() > 0.0_f32 {
        shadow_extent - shadow.x()
    } else {
        0.0_f32
    }
    let right = outline_extent +
    if shadow_extent + shadow.x() > 0.0_f32 {
        shadow_extent + shadow.x()
    } else {
        0.0_f32
    }
    let top = outline_extent +
    if shadow_extent - shadow.y() > 0.0_f32 {
        shadow_extent - shadow.y()
    } else {
        0.0_f32
    }
    let bottom = outline_extent +
    if shadow_extent + shadow.y() > 0.0_f32 {
        shadow_extent + shadow.y()
    } else {
        0.0_f32
    }
    let mut result = Rect::new(bounds.x() - left, bounds.y() - top,
        bounds.width() + left + right, bounds.height() + top + bottom,)
    for child in children {
        let child_bounds = if widget.style.layout().overflow_hidden() {
            intersect_rect(child.paint_bounds(), bounds)
        } else {
            child.paint_bounds()
        }
        result = union_rect(result, child_bounds)
    }
    ret result
}

fn intersect_rect(left: Rect, right: Rect) -> Rect {
    let x = if left.x() > right.x() {
        left.x()
    } else {
        right.x()
    }
    let y = if left.y() > right.y() {
        left.y()
    } else {
        right.y()
    }
    let edge_x = if left.right() < right.right() {
        left.right()
    } else {
        right.right()
    }
    let edge_y = if left.bottom() < right.bottom() {
        left.bottom()
    } else {
        right.bottom()
    }
    ret Rect::new(x, y,
        if edge_x > x {
            edge_x - x
        } else {
            0.0_f32
        }
        ,
        if edge_y > y {
            edge_y - y
        } else {
            0.0_f32
        }
        ,)
}

fn union_rect(left: Rect, right: Rect) -> Rect {
    if right.width() <= 0.0_f32 || right.height() <= 0.0_f32 {
        ret left
    }
    let x = if left.x() < right.x() {
        left.x()
    } else {
        right.x()
    }
    let y = if left.y() < right.y() {
        left.y()
    } else {
        right.y()
    }
    let edge_x = if left.right() > right.right() {
        left.right()
    } else {
        right.right()
    }
    let edge_y = if left.bottom() > right.bottom() {
        left.bottom()
    } else {
        right.bottom()
    }
    ret Rect::new(x, y, edge_x - x, edge_y - y)
}

fn widget_attributes_equal(lhs: Vec[WidgetAttribute],
    rhs: Vec[WidgetAttribute],) -> bool {
    if lhs.len() != rhs.len() {
        ret false
    }
    let mut index = 0_usize
    while index < lhs.len() {
        let left = lhs.get(index).unwrap_or(WidgetAttribute::new("", ""))
        let right = rhs.get(index).unwrap_or(WidgetAttribute::new("", ""))
        if left.name() != right.name() || left.value() != right.value() {
            ret false
        }
        index += 1_usize
    }
    ret true
}

// 0 = unchanged, 1 = paint, 2 = layout, 3 = structure.
pub fn widget_change_kind(previous: Widget, next: Widget) -> u32 {
    let mut targets = Vec[str]::new()
    ret collect_widget_changes(previous, next, targets)
}

fn collect_widget_changes(previous: Widget, next: Widget,
    targets: mut Vec[str],) -> u32 {
    ret collect_widget_changes_owned(previous, next, targets, "")
}

// Selector, focus and paint changes keep assigned geometry when every
// descriptor which can affect measurement and child ordering is unchanged.
fn component_paint_compatible(previous: Widget, next: Widget) -> bool {
    if previous.kind() != next.kind() || previous.id() != next.id() || previous.tag() != next.tag() ||
    previous.direction() != next.direction() || previous.basis() != next.basis() || previous.grow() != next.grow() ||
    previous.geometry_basis() != next.geometry_basis() || previous.text() != next.text() ||
    previous.value() != next.value() || previous.checked() != next.checked() ||
    !previous.style.layout_equivalent(next.style) || !widget_attributes_equal(previous.attributes, next.attributes) ||
    !previous.svg().equivalent(next.svg()) || previous.children().len() != next.children().len() {
        ret false
    }
    let mut index = 0_usize
    for child in previous.children() {
        match next.children().get(index) {
            Some(other) => {
                if !component_paint_compatible(child, other) {
                    ret false
                }
            }
            None => {
                ret false
            }
        }
        index += 1_usize
    }
    ret true
}

#attr(test)
fn widget_dispatch_policy_preserves_default_and_callback_modes() -> bool {
    let root = Widget::button("callback", "Button").with_on_click( | event | {
            event.prevent_default()
        }
    )
    let mut ui = ReactiveUi::new(layout_widget(root, Rect::new(0_f32, 0_f32, 200_f32, 40_f32)))
    if ui.dispatch_event("callback", UiEvent::new(ui_event_click(), "callback")) {
        std::io::eprintln("callback policy: initial callback did not prevent default")
        ret false
    }
    ui.set_widget_event_dispatch(false)
    if !ui.dispatch_event("callback", UiEvent::new(ui_event_click(), "callback")) {
        std::io::eprintln("callback policy: disabled callback still prevented default")
        ret false
    }
    ui.set_widget_event_dispatch(true)
    let allowed = ui.dispatch_event("callback", UiEvent::new(ui_event_click(), "callback"))
    if allowed {
        std::io::eprintln("callback policy: callback did not resume")
    }
    ret !allowed
}

#attr(test)
fn retained_component_paint_keeps_bounds_and_refreshes_hit_state() -> bool {
    let button = Widget::button("paint-child", "Content").with_style(Style::panel().with_width(80_f32).with_height(28_f32))
    let component = Widget::panel("paint-component").with_style(Style::panel().with_width(180_f32).with_height(60_f32)).with_child(button)
    let root = Widget::panel("paint-root").with_child(component).with_child(Widget::button("paint-outside", "Outside"))
    let mut ui = ReactiveUi::new(layout_widget(root, Rect::new(0_f32, 0_f32, 400_f32, 300_f32)))
    let outside = ui.segment_generation("paint-outside")
    let before = ui.find_layout("paint-child").unwrap_or(ui.layout()).bounds()
    let child = button.with_computed_style(button.style().with_background(Color::rgb(10, 20, 30)).with_pointer_events(false))
    let changed = component.with_classes("selected").with_children(vec![child])
    let path = vec![0_usize]
    if !ui.commit_styled_subtree(path, changed, changed) {
        ret false
    }
    let after = ui.find_layout("paint-child").unwrap_or(ui.layout()).bounds()
    let actual = ui.find_widget("paint-child").unwrap_or(button)
    if !same_layout_bounds(before, after) || actual.style().background().red() != 10_u8 || actual.style().pointer_events() ||
    ui.hit(after.x() + 1_f32, after.y() + 1_f32) == "paint-child" || ui.segment_generation("paint-outside") != outside {
        ret false
    }
    let wider = child.with_computed_style(child.style().with_width(100_f32))
    let resized = component.with_children(vec![wider])
    if !ui.commit_styled_subtree(path, resized, resized) {
        ret false
    }
    if ui.find_layout("paint-child").unwrap_or(ui.layout()).bounds().width() != 100_f32 ||
    ui.segment_generation("paint-outside") != outside {
        ret false
    }
    let renamed = component.with_children(vec![wider.with_id("paint-renamed")])
    if !ui.commit_styled_subtree(path, renamed, renamed) || ui.find_widget("paint-child").is_some() ||
    ui.find_widget("paint-renamed").is_none() {
        ret false
    }
    let inserted = renamed.with_children(vec![wider.with_id("paint-renamed"), Widget::label("Tail").with_id("paint-tail")])
    if !ui.commit_styled_subtree(path, inserted, inserted) {
        ret false
    }
    ret ui.find_widget("paint-tail").is_some() && ui.segment_generation("paint-outside") == outside
}

fn collect_widget_changes_owned(previous: Widget, next: Widget,
    targets: mut Vec[str], owner: str,) -> u32 {
    if previous.kind() != next.kind() || previous.id() != next.id() || previous.tag() != next.tag() {
        ret 3_u32
    }
    let previous_children = previous.children()
    let next_children = next.children()
    if previous_children.len() != next_children.len() {
        ret 3_u32
    }
    let mut change = 0_u32
    if previous.direction() != next.direction() ||
    previous.basis() != next.basis() || previous.grow() != next.grow() ||
    previous.geometry_basis() != next.geometry_basis() ||
    previous.has_explicit_style() != next.has_explicit_style() ||
    !previous.style.layout_equivalent(next.style) {
        change = 2_u32
    }
    let content_changed = previous.text() != next.text() ||
    previous.cursor() != next.cursor() ||
    previous.selection().start() != next.selection().start() ||
    previous.selection().end() != next.selection().end() ||
    previous.checked() != next.checked() ||
    previous.focused() != next.focused() ||
    previous.disabled() != next.disabled() ||
    previous.value() != next.value() ||
    !previous.svg().equivalent(next.svg()) ||
    previous.classes() != next.classes() ||
    !widget_attributes_equal(previous.attributes, next.attributes) ||
    !previous.style.equivalent(next.style)
    if content_changed && change < 1_u32 {
        if next.id() == "" &&(owner == "" || previous.text() != next.text()) {
            change = 2_u32
        } else {
            change = 1_u32
            targets.push(if next.id() == "" {
                    owner
                } else {
                    next.id()
                }
            )
        }
    }
    let mut index = 0_usize
    while index < previous_children.len() {
        let previous_child = previous_children.get(index).unwrap_or(
            Widget::spacer(0.0_f32),)
        let next_child = next_children.get(index).unwrap_or(
            Widget::spacer(0.0_f32),)
        let child_change = collect_widget_changes_owned(previous_child, next_child,
            targets, if next.id() == "" {
                owner
            } else {
                next.id()
            }
            ,)
        if child_change > change {
            change = child_change
        }
        if change == 3_u32 {
            ret change
        }
        index += 1_usize
    }
    ret change
}

impl for WidgetLayout {
    // Paint/source order normally coincide. Fall back to a search for CSS
    // order, z-index, hidden nodes and absolute children, without allocating
    // an owned Option<WidgetLayout> table on each recursive layout call.
    #attr(borrowed_self)
    pub fn source_child(self: Self, source: usize) -> Option[WidgetLayout] {
        match self.children.get(source) {
            Some(child) => {
                if child.source_index == source {
                    ret Option[WidgetLayout]::Some(child)
                }
            }
            None => {
            }
        }
        for child in self.children {
            if child.source_index == source {
                ret Option[WidgetLayout]::Some(child)
            }
        }
        ret Option[WidgetLayout]::None
    }
    pub fn with_source_index(self: Self, index: usize) -> Self {
        ret Self {
            self.widget, self.bounds, self.children, self.paint_bounds, index
        }
    }
    pub fn source_children(self: Self) -> Vec[Option[WidgetLayout]] {
        let mut result = Vec[Option[WidgetLayout]]::new()
        for child in self.widget.children() {
            result.push(Option[WidgetLayout]::None)
        }
        for child in self.children {
            if child.source_index < result.len() {
                result.set(child.source_index, Option[WidgetLayout]::Some(child))
            }
        }
        ret result
    }
    /// Vertical content extent, including the retained scroll translation.
    pub fn scroll_max_y(self: Self) -> f32 {
        let mut bottom = self.bounds.bottom()
        let offset = self.widget.style.layout().scroll().y()
        for child in self.children {
            let edge = child.paint_bounds().bottom() + offset
            if edge > bottom {
                bottom = edge
            }
        }
        ret bottom - self.bounds.bottom()
    }
    /// Shared scrollbar geometry for painting and pointer interaction.
    pub fn scrollbar_thumb(self: Self) -> Rect {
        let bounds = self.bounds
        let maximum = self.scroll_max_y()
        if self.widget.attribute("data-luma-scrollable").unwrap_or("") != "true" ||
        maximum <= 0.0_f32 || bounds.height() <= 0.0_f32 {
            ret Rect::new(0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32)
        }
        let raw_height = bounds.height() * bounds.height() /(bounds.height() + maximum)
        let height = if raw_height < 24.0_f32 {
            24.0_f32
        } else {
            raw_height
        }
        let height = if height > bounds.height() {
            bounds.height()
        } else {
            height
        }
        let offset = self.widget.style.layout().scroll().y()
        let offset = if offset < 0.0_f32 {
            0.0_f32
        } elif offset > maximum {
            maximum
        } else {
            offset
        }
        ret Rect::new(bounds.right() - 10.0_f32,
            bounds.y() +(bounds.height() - height) * offset / maximum,
            8.0_f32, height,)
    }
    pub fn scrollbar_offset_at(self: Self, pointer_y: f32, grab: f32) -> f32 {
        let thumb = self.scrollbar_thumb()
        let travel = self.bounds.height() - thumb.height()
        if travel <= 0.0_f32 {
            ret 0.0_f32
        }
        let fraction =(pointer_y - self.bounds.y() - grab) / travel
        ret self.scroll_max_y() * if fraction < 0.0_f32 {
            0.0_f32
        } elif fraction > 1.0_f32 {
            1.0_f32
        } else {
            fraction
        }
    }
    #attr(borrowed_self)
    pub fn widget(self: Self) -> Widget {
        ret self.widget
    }
    #attr(borrowed_self)
    pub fn bounds(self: Self) -> Rect {
        ret self.bounds
    }
    #attr(borrowed_self)
    pub fn paint_bounds(self: Self) -> Rect {
        ret self.paint_bounds
    }
    #attr(borrowed_self)
    pub fn children(self: Self) -> Vec[WidgetLayout] {
        ret self.children
    }
    pub fn hit(self: Self, x: f32, y: f32) -> str {
        let inside = x >= self.bounds.x() && y >= self.bounds.y() &&
        x < self.bounds.right() && y < self.bounds.bottom()
        if self.widget.style.layout().overflow_hidden() && !inside {
            ret ""
        }
        let mut index = self.children.len()
        while index > 0_usize {
            index = index - 1_usize
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let found = child.hit(x, y)
                    if found != "" {
                        ret found
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
        }
        if inside {
            if self.widget.disabled() || !self.widget.style.visible() || !self.widget.style.pointer_events()
            {
                ret ""
            }
            ret self.widget.id()
        }
        ret ""
    }
    pub fn find_bounds(self: Self, id: str) -> Option[Rect] {
        if self.widget.id() == id {
            ret Option[Rect]::Some(self.bounds)
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    match child.find_bounds(id) {
                        Option[Rect]::Some(bounds) => {
                            ret Option[Rect]::Some(bounds)
                        }
                        Option[Rect]::None => {
                        }
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret Option[Rect]::None
    }
    pub fn find_widget(self: Self, id: str) -> Option[Widget] {
        if self.widget.id() == id {
            ret Option[Widget]::Some(self.widget)
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    match child.find_widget(id) {
                        Option[Widget]::Some(widget) => {
                            ret Option[Widget]::Some(widget)
                        }
                        Option[Widget]::None => {
                        }
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret Option[Widget]::None
    }

    #attr(borrowed_self)
    pub fn widget_at_path(self: Self, indices: Vec[usize], depth: usize) ->
    Option[Widget] {
        if depth >= indices.len() {
            ret Option[Widget]::Some(self.widget)
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        if index < self.children.len() {
            ret self.children.get_unchecked_borrowed(index).widget_at_path(indices, depth + 1_usize)
        }
        ret Option[Widget]::None
    }

    // Binding identities follow authored order, not paint stacking, CSS order
    // or the subset of children with display enabled.
    pub fn source_widget_at_path(self: Self, indices: Vec[usize], depth: usize) -> Option[Widget] {
        if depth >= indices.len() {
            ret Option[Widget]::Some(self.widget)
        }
        let source = indices.get(depth).unwrap_or(self.widget.children().len())
        for child in self.children {
            if child.source_index == source {
                ret child.source_widget_at_path(indices, depth + 1)
            }
        }
        ret Option[Widget]::None
    }

    pub fn patch_source_widget_at_path(self: mut Self, indices: Vec[usize], depth: usize,
        replacement: Widget,) -> bool {
        if depth >= indices.len() {
            self.widget = replacement.with_children(self.widget.children())
            self.paint_bounds = widget_paint_bounds(self.widget, self.bounds, self.children)
            ret true
        }
        let source = indices.get(depth).unwrap_or(self.widget.children().len())
        let mut index = 0_usize
        for child in self.children {
            if child.source_index == source {
                let mut updated = child
                if !updated.patch_source_widget_at_path(indices, depth + 1, replacement) {
                    ret false
                }
                self.children.set(index, updated)
                self.paint_bounds = widget_paint_bounds(self.widget, self.bounds, self.children)
                ret true
            }
            index += 1
        }
        ret false
    }

    pub fn layout_at_path(self: Self, indices: Vec[usize], depth: usize) ->
    Option[WidgetLayout] {
        if depth >= indices.len() {
            ret Option[WidgetLayout]::Some(self)
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                ret child.layout_at_path(indices, depth + 1_usize)
            }
            Option::None => {
            }
        }
        ret Option[WidgetLayout]::None
    }

    pub fn patch_widget_at_path(self: mut Self, indices: Vec[usize], depth: usize,
        replacement: Widget,) -> bool {
        if depth >= indices.len() {
            self.widget = replacement.with_children(self.widget.children())
            self.paint_bounds = widget_paint_bounds(
                self.widget, self.bounds, self.children,)
            ret true
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                let mut updated = child
                if updated.patch_widget_at_path(indices, depth + 1_usize,
                    replacement,) {
                    self.children.set(index, updated)
                    self.paint_bounds = widget_paint_bounds(
                        self.widget, self.bounds, self.children,)
                    ret true
                }
            }
            Option::None => {
            }
        }
        ret false
    }

    pub fn replace_subtree_at_path(self: mut Self, indices: Vec[usize],
        depth: usize, replacement: Widget,) -> bool {
        if depth >= indices.len() {
            let updated = layout_widget(replacement, self.bounds)
            self.widget = updated.widget
            self.children = updated.children
            self.paint_bounds = updated.paint_bounds
            ret true
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Option::Some(child) => {
                let mut updated = child
                if updated.replace_subtree_at_path(indices, depth + 1_usize,
                    replacement,) {
                    self.children.set(index, updated)
                    self.paint_bounds = widget_paint_bounds(
                        self.widget, self.bounds, self.children,)
                    ret true
                }
            }
            Option::None => {
            }
        }
        ret false
    }

    fn refresh_component(self: mut Self, widget: Widget) ->() {
        self.widget = widget
        let mut index = 0_usize
        for previous in self.children {
            match widget.children().get(previous.source_index) {
                Some(child) => {
                    let mut updated = previous
                    updated.refresh_component(child)
                    self.children.set(index, updated)
                }
                None => {
                }
            }
            index += 1_usize
        }
        self.paint_bounds = widget_paint_bounds(self.widget, self.bounds, self.children)
        ret()
    }

    /// Refreshes a component whose geometry and source topology were validated.
    pub fn refresh_component_at_path(self: mut Self, indices: Vec[usize], depth: usize, widget: Widget) -> bool {
        if depth >= indices.len() {
            self.refresh_component(widget) ret true
        }
        let index = indices.get(depth).unwrap_or(self.children.len())
        match self.children.get(index) {
            Some(child) => {
                let mut updated = child
                if updated.refresh_component_at_path(indices, depth + 1_usize, widget) {
                    self.children.set(index, updated)
                    self.paint_bounds = widget_paint_bounds(self.widget, self.bounds, self.children)
                    ret true
                }
            }
            None => {
            }
        }
        ret false
    }

    /// Reconstructs the current retained widget tree from layout nodes. Unlike
    /// the original root widget, this includes every subtree replacement made
    /// since the last full layout.
    pub fn retained_widget(self: Self) -> Widget {
        if self.children.len() == 0_usize {
            ret self.widget
        }
        let mut retained_children = Vec[Widget]::new()
        let source = self.source_children()
        let mut index = 0_usize
        for original in self.widget.children() {
            match source.get(index).unwrap_or(Option[WidgetLayout]::None) {
                Some(child) => retained_children.push(child.retained_widget())
                None => retained_children.push(original)
            }
            index += 1
        }
        ret self.widget.with_children(retained_children)
    }

    // Flex measures only immediate descriptors. Read them from current layout
    // nodes instead of reconstructing every unchanged descendant. Intrinsic
    // grid tracks still need a complete subtree for min/max-content sizing.
    #attr(borrowed_self)
    pub fn geometry_input(self: Self) -> Widget {
        if self.children.len() == 0 {
            ret self.widget
        }
        let mut children = Vec[Widget]::with_capacity(self.widget.children().len())
        let mut index = 0_usize
        for original in self.widget.children() {
            let child = match self.source_child(index) {
                Some(layout) => layout.widget() None => original
            }
            children.push(child)
            index += 1
        }
        let flex = self.widget.style().layout().flex()
        if flex.grid() {
            let mut placements = Vec[GridPlacement]::new()
            for child in children {
                if child.style().layout().flex().displayed() &&
                !child.style().layout().position().absolute() {
                    placements.push(child.style().layout().grid_placement())
                }
            }
            if grid_needs_content_sizes(flex.column_template(), flex.row_template(),
                flex.auto_column_template(), flex.auto_row_template(), placements,) {
                ret self.retained_widget()
            }
        }
        ret self.widget.with_children(children)
    }

    // A position-only constraint change cannot alter local flex/grid sizing.
    // Translate retained boxes, including overflow, without measuring again.
    pub fn translated(self: Self, dx: f32, dy: f32) -> Self {
        let mut children = Vec[WidgetLayout]::with_capacity(self.children.len())
        for child in self.children {
            children.push(child.translated(dx, dy))
        }
        ret Self {
            self.widget,
            Rect::new(self.bounds.x() + dx, self.bounds.y() + dy,
                self.bounds.width(), self.bounds.height(),),
            children,
            Rect::new(self.paint_bounds.x() + dx, self.paint_bounds.y() + dy,
                self.paint_bounds.width(), self.paint_bounds.height(),),
            self.source_index
        }
    }

    // Replaces paint-only widget state while preserving the geometry of the
    // existing tree. This is intended for hover/focus changes whose styles do
    // not alter layout. Absolute overlays are laid out again because their
    // pointer-relative position may have changed.
    pub fn restyle(self: Self, widget: Widget) -> WidgetLayout {
        ret restyle_widget_layout(self, widget)
    }

    /// Replaces one retained widget without rebuilding or laying out the tree.
    /// This is the paint-only fast path; callers must use a normal layout pass
    /// when the replacement changes geometry or child structure.
    pub fn patch_widget(self: mut Self, id: str, replacement: Widget) -> bool {
        if self.widget.id() == id {
            self.widget = replacement.with_children(self.widget.children())
            self.paint_bounds = widget_paint_bounds(
                self.widget, self.bounds, self.children,)
            ret true
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let mut updated = child
                    if updated.patch_widget(id, replacement) {
                        self.children.set(index, updated)
                        self.paint_bounds = widget_paint_bounds(
                            self.widget, self.bounds, self.children,)
                        ret true
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }

    pub fn patch_text(self: mut Self, id: str, value: str) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_text(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_style(self: mut Self, id: str, value: Style) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_style(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_focus(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_focus(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_disabled(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_disabled(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_checked(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_checked(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    pub fn patch_value(self: mut Self, id: str, value: f32) -> bool {
        match self.find_widget(id) {
            Option[Widget]::Some(widget) => {
                ret self.patch_widget(id, widget.with_value(value))
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }

    /// Recomputes only the named subtree inside its existing outer bounds.
    /// Parent and sibling geometry stays intact.
    pub fn relayout_subtree(self: mut Self, id: str) -> bool {
        if self.widget.id() == id {
            // Paint patches update retained layout nodes, not the original
            // widget's child snapshots. Reflow must preserve their latest
            // styles, values and interaction state.
            let updated = layout_widget(self.retained_widget(), self.bounds)
            self.widget = updated.widget
            self.children = updated.children
            self.paint_bounds = updated.paint_bounds
            ret true
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let mut updated = child
                    if updated.relayout_subtree(id) {
                        self.children.set(index, updated)
                        self.paint_bounds = widget_paint_bounds(
                            self.widget, self.bounds, self.children,)
                        ret true
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }

    /// Replaces and lays out one structural component inside its current
    /// bounds. Unrelated ancestors, siblings, and their layout results are
    /// retained.
    pub fn replace_subtree(self: mut Self, id: str, replacement: Widget) -> bool {
        if self.widget.id() == id {
            let updated = layout_widget(replacement, self.bounds)
            self.widget = updated.widget
            self.children = updated.children
            self.paint_bounds = updated.paint_bounds
            ret true
        }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let mut updated = child
                    if updated.replace_subtree(id, replacement) {
                        self.children.set(index, updated)
                        self.paint_bounds = widget_paint_bounds(
                            self.widget, self.bounds, self.children,)
                        ret true
                    }
                }
                Option[WidgetLayout]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
}

fn restyle_widget_layout(previous: WidgetLayout, widget: Widget) -> WidgetLayout {
    let previous_children = previous.children()
    let source_children = widget.children()
    if previous_children.len() == 0_usize && source_children.len() == 0_usize {
        ret WidgetLayout {
            widget, previous.bounds(), previous_children,
            widget_paint_bounds(widget, previous.bounds(), previous_children), previous.source_index
        }
    }
    let content = previous.bounds().inset(widget.style.padding())
    let scroll = widget.style.layout().scroll()
    let positioned_content = Rect::new(content.x() - scroll.x(), content.y() - scroll.y(), content.width(),
        content.height(),)
    let by_source = previous.source_children()
    let mut flow = Vec[IndexedWidget]::new()
    let mut positioned = Vec[IndexedWidget]::new()
    let mut index = 0_usize
    while index < source_children.len() {
        match source_children.get(index) {
            Option[Widget]::Some(child) => {
                if child.style.layout().flex().displayed() {
                    if child.style.layout().position().absolute() {
                        positioned.push(IndexedWidget {
                                child, index
                            }
                            ,
                        )
                    } else {
                        flow.push(IndexedWidget {
                                child, index
                            }
                            ,
                        )
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    flow = ordered_widgets(flow)
    let mut layouts = Vec[WidgetLayout]::new()
    index = 0_usize
    while index < flow.len() {
        match flow.get(index) {
            Option[IndexedWidget]::Some(item) => {
                let child = item.widget
                match by_source.get(item.index).unwrap_or(Option[WidgetLayout]::None) {
                    Option[WidgetLayout]::Some(old_child) => {
                        layouts.push(restyle_widget_layout(old_child, child))
                    }
                    Option[WidgetLayout]::None => {
                        // A structural change is outside the fast-path contract,
                        // but laying out the new subtree keeps the result valid.
                        layouts.push(layout_widget(child, previous.bounds()).with_source_index(item.index))
                    }
                }
            }
            Option[IndexedWidget]::None => {
            }
        }
        index = index + 1_usize
    }
    index = 0_usize
    while index < positioned.len() {
        match positioned.get(index) {
            Option[IndexedWidget]::Some(item) => {
                layouts.push(layout_widget(item.widget, absolute_child_rect(item.widget, positioned_content)).with_source_index(item.index))
            }
            Option[IndexedWidget]::None => {
            }
        }
        index = index + 1_usize
    }
    let stacked = stacked_layouts(layouts)
    ret WidgetLayout {
        widget, previous.bounds(), stacked,
        widget_paint_bounds(widget, previous.bounds(), stacked), previous.source_index
    }
}

#attr(test)
fn retained_source_order_survives_stacking_and_reflow() -> bool {
    let mut root = Widget::panel("root")
    root.push(Widget::label("first").with_style(Style::default().with_z_index(20).with_order(2)).with_flex(32.0, 0.0))
    root.push(Widget::label("hidden").with_style(Style::default().with_displayed(false)))
    root.push(Widget::label("second").with_style(Style::default().with_z_index( - 2)).with_flex(24.0, 0.0))
    root.push(Widget::button("save", "Save").with_flex(28.0, 0.0))
    root.push(Widget::button("popup", "Popup").with_style(Style::default().with_absolute(true)
            .with_top(80.0).with_width(80.0).with_height(90.0).with_z_index(10)))
    let bounds = Rect::new(0.0, 0.0, 320.0, 240.0)
    let initial = layout_widget(root, bounds)
    let original = initial.source_children()
    let mut current = layout_widget(root, bounds)
    for pass in 0..20 {
        let retained = current.retained_widget()
        if retained.children().len() != root.children().len() {
            ret false
        }
        let mut index = 0_usize
        for source in root.children() {
            if retained.children().get(index).unwrap_or(Widget::spacer(0.0)).text() != source.text() {
                ret false
            }
            index += 1
        }
        // Data-only reconciliation must use the same mapping as restyling.
        refresh_layout_data(current, retained)
        current = current.restyle(retained)
        let next = current.source_children()
        for index in 0..original.len() {
            match original.get(index).unwrap_or(Option[WidgetLayout]::None) {
                Some(before) => {
                    match next.get(index).unwrap_or(Option[WidgetLayout]::None) {
                        Some(after) => {
                            if before.bounds().x() != after.bounds().x() || before.bounds().y() != after.bounds().y() ||
                            before.bounds().width() != after.bounds().width() || before.bounds().height() != after.bounds().height() {
                                ret false
                            }
                        }
                        None => {
                            ret false
                        }
                    }
                }
                None => {
                }
            }
        }
        let _reflowed = current.relayout_subtree("root")
    }
    ret true
}

fn patch_authored_path(root: Widget, indices: Vec[usize], depth: usize,
    local: Widget, branch: bool,) -> Widget {
    if depth == indices.len() {
        ret if branch {
            local
        } else {
            local.with_children(root.children())
        }
    }
    let selected = indices.get(depth).unwrap_or(root.children().len())
    let mut children = Vec[Widget]::new()
    let mut index = 0_usize
    for child in root.children() {
        children.push(if index == selected {
                patch_authored_path(child, indices, depth + 1, local, branch)
            } else {
                child
            }
        )
        index += 1
    }
    ret root.with_children(children)
}

/// Owns a persistent layout and records the smallest class of work required
/// after state changes. Paint-only patches keep geometry and child structure
/// intact; callers explicitly invalidate layout or structure when necessary.
pub struct ReactiveUi {
    layout: WidgetLayout
    paths: Vec[WidgetPath]
    lookup: RetainedWidgetIndex
    paint_targets: Vec[str]
    layout_targets: Vec[str]
    transitions: Vec[StyleTransition]
    range_transitions: Vec[RangeTransition]
    reduced_motion: bool
    structure_dirty: bool
    generation: usize
    full_repaint: bool
    declarative_root: Widget
    hovered_id: str
    active_id: str
    focused_id: str
    keyboard_focus: bool
    scroll_offsets: Vec[RetainedScroll]
    damage: Vec[PaintDamage]
    presentation_pending: bool
    widget_events: bool
}

struct PaintDamage {
    id: str
    bounds: Rect
}

struct RetainedScroll {
    id: str
    x: f32
    y: f32
}

// Persistent ID index for reconciling reordered children. Store path indices,
// not copies of the large Widget payload, and verify IDs after hash collisions.
struct RetainedWidgetIndex {
    ids: Vec[str]
    heads: Vec[usize]
    links: Vec[usize]
}

fn retained_widget_bucket(id: str) -> usize {
    let mut hash = 1469598103934665603_u64
    for index in 0_usize..id.len() {
        hash =(hash ^ id.byte_at(index) as u64) * 1099511628211_u64
    }
    ret(hash % 256_u64) as usize
}

impl for RetainedWidgetIndex {
    pub fn new(paths: Vec[WidgetPath]) -> Self {
        let mut ids = Vec[str]::new()
        let mut heads = Vec[usize]::new()
        let mut links = Vec[usize]::new()
        for _index in 0_usize..256_usize {
            heads.push(0_usize)
        }
        for entry in paths {
            links.push(0_usize)
            ids.push(entry.id)
        }
        let mut remaining = paths.len()
        while remaining > 0_usize {
            remaining -= 1_usize
            match paths.get(remaining) {
                Some(entry) => {
                    let bucket = retained_widget_bucket(entry.id)
                    links.set(remaining, heads.get(bucket).unwrap_or(0_usize))
                    heads.set(bucket, remaining + 1_usize)
                }
                None => {
                }
            }
        }
        ret Self {
            ids, heads, links
        }
    }
    pub fn refresh(self: Self, paths: Vec[WidgetPath]) -> Self {
        if self.ids.len() == paths.len() {
            let mut same_ids = true
            let mut index = 0_usize
            for entry in paths {
                match self.ids.get(index) {
                    Some(previous) => {
                        if previous != entry.id {
                            same_ids = false
                            break
                        }
                    }
                    None => {
                        same_ids = false
                        break
                    }
                }
                index += 1
            }
            if same_ids {
                ret self
            }
        }
        ret RetainedWidgetIndex::new(paths)
    }
    pub fn entry(self: Self, paths: Vec[WidgetPath], id: str) -> Option[WidgetPath] {
        ret paths.get(self.position(id))
    }
    pub fn position(self: Self, id: str) -> usize {
        if id == "" {
            ret self.ids.len()
        }
        let mut cursor = self.heads.get(retained_widget_bucket(id)).unwrap_or(0_usize)
        while cursor > 0_usize {
            match self.ids.get(cursor - 1_usize) {
                Some(entry) => {
                    if entry == id {
                        ret cursor - 1
                    }
                }
                None => {
                }
            }
            cursor = self.links.get(cursor - 1_usize).unwrap_or(0_usize)
        }
        ret self.ids.len()
    }
    pub fn find(self: Self, paths: Vec[WidgetPath], layout: WidgetLayout, id: str) -> Option[Widget] {
        ret match self.entry(paths, id) {
            Some(entry) => layout.widget_at_path(entry.indices, 0)
            None => Option[Widget]::None
        }
    }
}

#attr(test)
fn retained_widget_index_preserves_identity_and_collisions() -> bool {
    let mut root = Widget::panel("root")
    for index in 0_usize..300_usize {
        root.push(Widget::button(f"item-{index}", f"Label {index}"))
    }
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 600.0_f32, 400.0_f32))
    let paths = widget_paths(layout, 1_usize)
    let lookup = RetainedWidgetIndex::new(paths)
    for index in 0_usize..300_usize {
        match lookup.find(paths, layout, f"item-{299_usize - index}") {
            Some(widget) => {
                if widget.text() != f"Label {299_usize - index}" {
                    ret false
                }
            }
            None => {
                ret false
            }
        }
    }
    ret lookup.find(paths, layout, "absent").is_none() && lookup.find(paths, layout, "").is_none()
}

struct StyleTransition {
    id: str
    from: Style
    to: Style
    from_value: f32
    to_value: f32
    started_at: u64
    duration_ms: u64
    delay_ms: u64
    elapsed_offset_ms: u64
    easing: usize
    properties: str
    started: bool
    layout: bool
    value: bool
}

fn refresh_layout_data(layout: mut WidgetLayout, widget: Widget) ->() {
    layout.widget = widget
    let mut index = 0_usize
    let source = widget.children()
    for previous in layout.children {
        match source.get(previous.source_index) {
            Some(child) => {
                let mut updated = previous
                refresh_layout_data(updated, child)
                layout.children.set(index, updated)
            }
            None => {
            }
        }
        index += 1
    }
    ret()
}

struct RangeTransition {
    id: str
    from_start: f32
    from_end: f32
    to_start: f32
    to_end: f32
    started_at: u64
    duration_ms: u64
}

impl for ReactiveUi {
    pub fn new(layout: WidgetLayout) -> Self {
        let paths = widget_paths(layout, 1_usize)
        ret Self {
            layout, paths, RetainedWidgetIndex::new(paths), Vec[str]::new(),
            Vec[str]::new(), Vec[StyleTransition]::new(),
            Vec[RangeTransition]::new(), false, false, 1_usize, false,
            layout.retained_widget(), "", "", "", true, Vec[RetainedScroll]::new(), Vec[PaintDamage]::new(), false, true
        }
    }

    /// Copies only the changed local descriptor along its ancestry. CSS IDs
    /// are paint-segment names, not the identity used to locate this node.
    pub fn bound_content_needs_layout(self: Self, indices: Vec[usize], local: Widget) -> bool {
        let current = match self.layout.source_widget_at_path(indices, 0) {
            Some(widget) => widget
            None => {
                ret false
            }
        }
        if current.direction() != local.direction() || current.basis() != local.basis() ||
        current.grow() != local.grow() || current.geometry_basis() != local.geometry_basis() {
            ret true
        }
        if current.text() == local.text() {
            ret false
        }
        if current.children().len() != 0 {
            ret true
        }
        let sizing = current.style().layout()
        if sizing.width() >= 0.0 && sizing.height() >= 0.0 {
            ret false
        }
        // Flex controls use their preferred size, not the length of their
        // displayed value. An auto dimension alone is not a dependency on
        // glyph content. Labels/buttons still reflow when that size changes.
        let before = current.preferred_size()
        let after = current.with_text(local.text()).preferred_size()
        if (sizing.width() < 0.0 && before.width() != after.width()) ||
        (sizing.height() < 0.0 && before.height() != after.height()) {
            ret true
        }
        // An ancestor grid can consume the leaf's min/max-content size even
        // when its ordinary preferred dimensions did not change.
        let mut ancestor = Vec[usize]::new()
        for index in indices {
            match self.layout.source_widget_at_path(ancestor, 0) {
                Some(parent) => {
                    if parent.style().layout().flex().grid() {
                        ret true
                    }
                }
                None => {
                    ret true
                }
            }
            ancestor.push(index)
        }
        ret false
    }

    /// Geometry writes are not selector changes. Preserve displayed CSS and
    /// override only the sizing property supplied by the retained transaction.
    pub fn patch_bound_geometry(self: mut Self, indices: Vec[usize], local: Widget) -> bool {
        self.declarative_root = patch_authored_path(self.declarative_root, indices, 0, local, false)
        match self.layout.source_widget_at_path(indices, 0) {
            Some(current) => {
                let displayed = local.with_computed_style(local.geometry_style(current.style()))
                .with_focus(current.focused())
                ret self.layout.patch_source_widget_at_path(indices, 0, displayed)
            }
            None => {
                ret true
            }
        }
    }

    /// Reuses layout results with unchanged constraints. Only changed geometry
    /// branches receive new hit paths and damage; IDs and lookup indices stay.
    pub fn reflow_bound_geometry(self: mut Self, dirty: Vec[Vec[usize]]) -> bool {
        if self.structure_dirty || self.layout_targets.len() > 0 {
            ret false
        }
        let previous = self.layout
        let next = layout_widget_reusing(previous.widget(), previous.bounds(),
            Option[WidgetLayout]::Some(previous), dirty, Vec[usize]::new(),)
        let mut roots = Vec[Vec[usize]]::new()
        collect_geometry_changes(previous, next, Vec[usize]::new(), roots)
        if roots.len() == 0 {
            self.layout = next ret true
        }
        self.generation += 1
        for path in roots {
            let old = previous.layout_at_path(path, 0).unwrap_or(previous)
            let updated = next.layout_at_path(path, 0).unwrap_or(next)
            let clip = inherited_clip_at_path(next, path, 0, Option[Rect]::None)
            let mut entries = Vec[WidgetPath]::new()
            collect_widget_paths(updated, path, clip, self.generation, entries)
            let mut offset = 0_usize
            let mut count = 0_usize
            for index in 0..self.paths.len() {
                let entry = self.paths.get(index).unwrap_or(WidgetPath {
                        "", Vec[usize]::new(), Rect::new(0, 0, 0, 0), Option[Rect]::None,
                        false, false, false, 0
                    }
                    ,)
                if path_has_prefix(entry.indices, path) {
                    if count == 0 {
                        offset = index
                    }
                    count += 1
                }
            }
            if count != entries.len() {
                self.replace_layout(next) ret true
            }
            for index in 0..entries.len() {
                match entries.get(index) {
                    Some(entry) => {
                        self.paths.set(offset + index, entry)
                    }
                    None => {
                    }
                }
            }
            let id = if updated.widget().id() != "" {
                updated.widget().id()
            } else {
                next.widget().id()
            }
            self.damage.push(PaintDamage {
                    id, union_rect(old.paint_bounds(), updated.paint_bounds())
                }
                ,
            )
            let mut found = false
            for target in self.paint_targets {
                found = found || target == id
            }
            if !found {
                self.paint_targets.push(id)
            }
        }
        self.layout = next
        ret true
    }

    pub fn patch_bound_node(self: mut Self, indices: Vec[usize], local: Widget,
        computed: Option[Style], paint: bool,) -> bool {
        self.declarative_root = patch_authored_path(self.declarative_root, indices, 0, local, false)
        let current = match self.layout.source_widget_at_path(indices, 0) {
            Some(widget) => widget
            None => {
                // Hidden nodes own state too, but produce no paint damage.
                ret true
            }
        }
        let displayed = local.with_computed_style(local.geometry_style(computed.unwrap_or(current.style())))
        .with_focus(current.focused())
        if current.id() != "" {
            ret self.patch_widget(current.id(), displayed)
        }
        // Anonymous nodes still have exact paths. Damage belongs to their
        // nearest named ancestor, or to the whole frame when none exists.
        if !self.layout.patch_source_widget_at_path(indices, 0, displayed) {
            ret false
        }
        if !paint {
            ret true
        }
        let mut depth = indices.len()
        while depth > 0 {
            let mut ancestor = Vec[usize]::new()
            for index in 0..depth {
                ancestor.push(indices.get(index).unwrap_or(0))
            }
            match self.layout.source_widget_at_path(ancestor, 0) {
                Some(widget) => {
                    if widget.id() != "" {
                        self.mark_paint(widget.id()) ret true
                    }
                }
                None => {
                }
            }
            depth -= 1
        }
        let root_id = self.layout.widget().id()
        if root_id != "" {
            self.mark_paint(root_id)
        } else {
            self.full_repaint = true
        }
        ret true
    }

    /// Enables the accessibility mode in which CSS transitions commit their
    /// final state immediately while retaining normal transition semantics.
    pub fn with_reduced_motion(self: mut Self, reduced: bool) -> Self {
        self.reduced_motion = reduced
        ret self
    }

    pub fn has_active_transitions(self: mut Self) -> bool {
        ret self.transitions.len() > 0_usize || self.range_transitions.len() > 0_usize
    }

    /// Input modality belongs to this UI, never to a shared stylesheet cache.
    pub fn keyboard_focus(self: mut Self) -> bool {
        ret self.keyboard_focus
    }
    /// Returns whether the focus indicator needs a new cascade.
    pub fn set_keyboard_focus(self: mut Self, keyboard: bool) -> bool {
        let changed = self.keyboard_focus != keyboard
        self.keyboard_focus = keyboard
        ret changed
    }

    /// The application's authored tree, separate from computed and animated styles.
    pub fn declarative_root(self: mut Self) -> Widget {
        ret self.declarative_root
    }
    pub fn set_declarative_root(self: mut Self, root: Widget) ->() {
        let mut retained = Vec[RetainedScroll]::new()
        for offset in self.scroll_offsets {
            if root.find(offset.id).is_some() {
                retained.push(offset)
            }
        }
        self.scroll_offsets = retained
        self.declarative_root = root
        ret()
    }

    /// Queues an authored component replacement. CSS/layout is resolved once
    /// by the window transaction; unstyled nodes never enter the live layout.
    pub fn stage_subtree(self: mut Self, id: str, replacement: Widget) -> bool {
        let updated = self.declarative_root.replace_branch(id, replacement)
        if !updated.1 {
            ret false
        }
        self.declarative_root = updated.0
        self.mark_paint(id)
        ret true
    }

    /// Out-of-flow components can be laid out in their assigned box without
    /// changing sibling geometry. Validate before any part of a batch commits.
    pub fn independent_component(self: mut Self, id: str) -> bool {
        if id == "" {
            ret false
        }
        ret match self.find_widget(id) {
            Some(widget) => {
                let layout = widget.style().layout()
                let position = layout.position()
                position.absolute() &&(layout.width() >= 0.0 ||(position.left_set() && position.right_set()))
            }
            None => false
        }
    }

    /// Checks the complete computed replacement before a component commit.
    pub fn can_commit_styled_subtree(self: mut Self, branch: Widget) -> bool {
        let current = match self.find_widget(branch.id()) {
            Some(widget) => widget
            None => {
                ret false
            }
        }
        // Scroll transforms move contents inside an unchanged outer box.
        // Native offsets are restored during commit and must not force a
        // whole-window transaction for a virtualized component.
        let scroll = current.style().layout().scroll()
        let outer_style = branch.style().with_scroll(scroll.x(), scroll.y())
        if current.kind() != branch.kind() || current.tag() != branch.tag() ||
        !current.style().layout_equivalent(outer_style) || current.direction() != branch.direction() ||
        current.basis() != branch.basis() || current.grow() != branch.grow() ||
        self.needs_animation_transaction(branch) {
            ret false
        }
        if self.independent_component(branch.id()) {
            ret true
        }
        // Ordinary flex boxes also have content-independent outer bounds.
        // Check the same preferred-size inputs used by their parent rather
        // than requiring every independently updatable component to be absolute.
        let sizing = current.style().layout()
        let before = current.preferred_size()
        let after = branch.preferred_size()
        if (sizing.width() < 0.0 && before.width() != after.width()) ||
        (sizing.height() < 0.0 && before.height() != after.height()) {
            ret false
        }
        let path = match self.path(branch.id()) {
            Some(value) => value
            None => {
                ret false
            }
        }
        let mut ancestor = Vec[usize]::new()
        for ordinal in path {
            match self.layout.widget_at_path(ancestor, 0) {
                Some(parent) => {
                    // Grid tracks may depend recursively on min/max-content.
                    if parent.style().layout().flex().grid() {
                        ret false
                    }
                }
                None => {
                    ret false
                }
            }
            ancestor.push(ordinal)
        }
        ret true
    }

    /// Commits CSS, content and layout of one independent component. The
    /// authored path is distinct from paint order and contains unstyled data.
    pub fn commit_styled_subtree(self: mut Self, source: Vec[usize], authored: Widget, styled: Widget) -> bool {
        if !self.can_commit_styled_subtree(styled) {
            ret false
        }
        let target = self.preserve_scroll_offsets(styled)
        let paint_only = match self.find_layout(target.id()) {
            Some(previous) => component_paint_compatible(previous.retained_widget(), target)
            None => false
        }
        if !self.replace_component(target.id(), target, !paint_only) {
            ret false
        }
        self.declarative_root = patch_authored_path(self.declarative_root, source, 0, authored, true)
        ret true
    }

    /// Scroll is retained interaction state, not an inline CSS override.
    pub fn set_scroll_offset(self: mut Self, id: str, x: f32, y: f32) ->() {
        let mut retained = Vec[RetainedScroll]::new()
        for offset in self.scroll_offsets {
            if offset.id != id {
                retained.push(offset)
            }
        }
        retained.push(RetainedScroll {
                id, x, y
            }
            ,
        )
        self.scroll_offsets = retained
        ret()
    }
    /// Wheel routing for embedded/manual event loops. A declared scroller
    /// consumes the wheel even at its limits, so input cannot leak to a canvas.
    pub fn scroll_at(self: mut Self, x: f32, y: f32, delta_y: f32) -> bool {
        let target = scroll_container_at(self.layout, x, y)
        if target == "" {
            ret false
        }
        match self.find_layout(target) {
            Some(layout) => {
                let previous = layout.widget().style().layout().scroll()
                let maximum = layout.scroll_max_y()
                let raw = previous.y() + delta_y
                let offset = if raw < 0 {
                    0_f32
                } elif raw > maximum {
                    maximum
                } else {
                    raw
                }
                if offset != previous.y() {
                    self.set_scroll_offset(target, previous.x(), offset)
                    let widget = layout.retained_widget()
                    let _changed = self.replace_subtree(target, widget.with_computed_style(widget.style().with_scroll(previous.x(), offset)))
                }
            }
            None => {
            }
        }
        ret true
    }
    pub fn preserve_scroll_offsets(self: mut Self, root: Widget) -> Widget {
        if self.scroll_offsets.len() == 0_usize {
            ret root
        }
        if root.children().len() == 0_usize {
            for offset in self.scroll_offsets {
                if offset.id == root.id() {
                    ret root.with_computed_style(root.style.with_scroll(offset.x, offset.y))
                }
            }
            ret root
        }
        let mut children = Vec[Widget]::new()
        for child in root.children() {
            children.push(self.preserve_scroll_offsets(child))
        }
        let mut result = root.with_children(children)
        for offset in self.scroll_offsets {
            if offset.id == root.id() {
                result = result.with_computed_style(root.style.with_scroll(offset.x, offset.y))
            }
        }
        ret result
    }

    /// Keep the displayed style while reconciling new data for an animated target.
    pub fn prepare_style_targets(self: mut Self, root: Widget) -> Widget {
        let previous = self.corresponding_widget(root, Option[Widget]::Some(self.layout.retained_widget()))
        ret self.prepare_style_targets_from(root, previous)
    }
    /// True only when a new model needs no animation target transaction.
    /// Content and closures may differ; geometry still has to be laid out.
    pub fn style_targets_unchanged(self: mut Self, root: Widget) -> bool {
        ret !self.has_active_transitions() &&
        same_animation_targets(self.layout, root)
    }
    /// Declaring a transition does not require an animation transaction.
    /// Only changed animated destinations, running transitions or timers do.
    pub fn needs_animation_transaction(self: mut Self, root: Widget) -> bool {
        ret self.has_active_transitions() || self.animation_targets_needed(root)
    }
    fn animation_targets_needed(self: mut Self, root: Widget) -> bool {
        if root.countdown_duration_ms() > 0 {
            ret true
        }
        let transition = root.style().transition()
        if !self.reduced_motion && transition.properties() != "none" &&
        transition_duration_ms(transition.durations()) > 0 {
            if root.id() == "" {
                ret true
            }
            match self.find_widget(root.id()) {
                Some(previous) => {
                    if previous.kind() == root.kind() && !previous.style().equivalent(root.style()) {
                        ret true
                    }
                }
                None => {
                }
            }
        }
        for child in root.children() {
            if self.animation_targets_needed(child) {
                ret true
            }
        }
        ret false
    }
    fn prepare_style_targets_from(self: mut Self, root: Widget, previous_option: Option[Widget]) -> Widget {
        let mut rebuilt = root.with_children(root.children())
        if root.children().len() > 0_usize {
            let previous_children = match previous_option {
                Some(value) => value.children()
                None => Vec[Widget]::new()
            }
            let mut children = Vec[Widget]::new()
            let mut index = 0_usize
            for child in root.children() {
                let candidate = previous_children.get(index)
                let retained = match candidate {
                    Some(value) => if value.id() == child.id() && value.kind() == child.kind() {
                        candidate
                    } else {
                        self.find_widget(child.id())
                    }
                    None => self.find_widget(child.id())
                }
                children.push(self.prepare_style_targets_from(child, retained))
                index += 1_usize
            }
            rebuilt = root.with_children(children)
        }
        if root.countdown_duration_ms() > 0_u64 {
            match previous_option {
                Some(previous) => {
                    rebuilt = rebuilt.with_value(previous.value())
                    .with_attribute("data-luma-countdown-cycle", Debug::fmt(previous.countdown_cycle()))
                    .with_attribute("data-luma-countdown-duration", Debug::fmt(previous.countdown_duration_ms()))
                }
                None => {
                    rebuilt = rebuilt.with_value(1.0_f32)
                    .with_attribute("data-luma-countdown-duration", "0")
                }
            }
        }
        if !self.reduced_motion && root.style.transition().properties() != "none" {
            match previous_option {
                Some(previous) => {
                    // A transition declaration is not an active animation.
                    // Unchanged styles need neither duration parsing nor
                    // per-property interpolation during scroll/model updates.
                    if previous.kind() == root.kind() &&
                    !previous.style.equivalent(root.style) &&
                    transition_duration_ms(root.style.transition().durations()) > 0_u64 {
                        ret rebuilt.with_computed_style(root.style.with_transition_sample(
                                previous.style, root.style.transition().properties(),))
                    }
                }
                None => {
                }
            }
        }
        ret rebuilt
    }

    // Stable trees can be traversed together in linear time. ID lookup is
    // necessary only after insertion, removal or reordering, not per node
    // on every hover/animation transaction.
    fn corresponding_widget(self: mut Self, next: Widget, candidate: Option[Widget]) -> Option[Widget] {
        match candidate {
            Some(value) => {
                if value.id() == next.id() && value.kind() == next.kind() {
                    ret candidate
                }
            }
            None => {
            }
        }
        ret self.find_widget(next.id())
    }

    /// A stable ID may be removed or reused for another widget kind.
    pub fn prune_transitions(self: mut Self, root: Widget, now_ms: u64) ->() {
        let mut retained = Vec[StyleTransition]::new()
        for transition in self.transitions {
            let same_kind = match root.find(transition.id) {
                Some(next) => match self.find_widget(transition.id) {
                    Some(previous) => previous.kind() == next.kind()
                    None => false
                }
                None => false
            }
            if same_kind {
                retained.push(transition)
            } else {
                dispatch_transition_properties(self, transition.id, ui_event_transition_cancel(),
                    transition.properties,(now_ms - transition.started_at) as f32 / 1000.0_f32,)
            }
        }
        self.transitions = retained
        let mut ranges = Vec[RangeTransition]::new()
        for transition in self.range_transitions {
            match root.find(transition.id) {
                Some(next) => {
                    if next.kind() == widget_range_slider() {
                        ranges.push(transition)
                    }
                }
                None => {
                }
            }
        }
        self.range_transitions = ranges
        ret()
    }

    /// Update target styles independently of content reconciliation.
    pub fn apply_style_targets(self: mut Self, root: Widget, now_ms: u64) ->() {
        self.apply_style_targets_from(root, Option[Widget]::Some(self.layout.retained_widget()), now_ms)
        ret()
    }
    fn apply_style_targets_from(self: mut Self, root: Widget, previous: Option[Widget], now_ms: u64) ->() {
        match previous {
            Some(current) => {
                // Equal displayed styles do not imply equal destinations.
                // A reversal can return to the current sample before the old
                // transition has advanced; it must still cancel/retarget it.
                let mut transitioning = false
                for transition in self.transitions {
                    if transition.id == root.id() {
                        transitioning = true
                        break
                    }
                }
                if transitioning || !current.style.equivalent(root.style) ||
                current.countdown_cycle() != root.countdown_cycle() ||
                (current.countdown_duration_ms() == 0_u64 && root.countdown_duration_ms() > 0_u64) {
                    let _updated = self.transition_widget(root.id(), root, now_ms)
                }
            }
            None => {
            }
        }
        let previous_children = match previous {
            Some(value) => value.children()
            None => Vec[Widget]::new()
        }
        let mut index = 0_usize
        for child in root.children() {
            let retained = self.corresponding_widget(child, previous_children.get(index))
            self.apply_style_targets_from(child, retained, now_ms)
            index += 1_usize
        }
        ret()
    }

    /// Animates a range control from its retained visual position to committed
    /// model endpoints without delaying pointer input or layout.
    pub fn transition_range(self: mut Self, id: str, start: f32, end: f32,
        now_ms: u64, duration_ms: u64,) -> bool {
        let current = match self.find_widget(id) {
            Some(value) => value
            None => {
                ret false
            }
        }
        self.cancel_range_transition(id)
        if self.reduced_motion || duration_ms == 0_u64 {
            ret self.patch_range(id, start, end)
        }
        self.range_transitions.push(RangeTransition {
                id, current.range_start(), current.range_end(), start, end,
                now_ms, duration_ms
            }
            ,)
        ret true
    }

    pub fn cancel_range_transition(self: mut Self, id: str) ->() {
        let mut retained = Vec[RangeTransition]::new()
        for transition in self.range_transitions {
            if transition.id != id {
                retained.push(transition)
            }
        }
        self.range_transitions = retained
        ret()
    }

    /// Starts a retained CSS transition from the currently displayed style.
    pub fn transition_widget(self: mut Self, id: str, replacement: Widget,
        now_ms: u64,) -> bool {
        let current = match self.find_widget(id) {
            Some(value) => value
            None => {
                ret false
            }
        }
        let transition = replacement.style.transition()
        let countdown = replacement.countdown_duration_ms() > 0_u64 &&
        (replacement.countdown_cycle() != current.countdown_cycle() || current.countdown_duration_ms() == 0_u64)
        // Reconciliation can deliver the same target on every model update.
        // Keep the existing clock and displayed style instead of restarting
        // the transition; content and ordinary values remain authoritative.
        if !countdown && !self.reduced_motion {
            let mut index = 0_usize
            for running in self.transitions {
                let target_matches = replacement.style.with_transition_sample(
                    running.to, running.properties,).equivalent(replacement.style)
                if running.id == id &&(running.value || running.properties == transition.properties()) && target_matches {
                    let value = if running.value {
                        current.value()
                    } else {
                        replacement.value()
                    }
                    self.transitions.set(index, StyleTransition {
                            running.id, running.from, replacement.style, running.from_value,
                            if running.value {
                                running.to_value
                            } else {
                                replacement.value()
                            }
                            ,
                            running.started_at, running.duration_ms, running.delay_ms,
                            running.elapsed_offset_ms, running.easing, running.properties,
                            running.started, running.layout, running.value
                        }
                        ,)
                    ret self.patch_widget(id, replacement.with_computed_style(
                            replacement.style.with_transition_sample(current.style, running.properties))
                        .with_value(value),)
                }
                index += 1_usize
            }
        }
        self.cancel_transition(id, now_ms)
        let properties = if countdown {
            "value"
        } else {
            transition.properties()
        }
        let duration = if self.reduced_motion {
            0_u64
        } elif countdown {
            replacement.countdown_duration_ms()
        } else {
            transition_duration_ms(transition.durations())
        }
        // Ordinary control values are authoritative model state and must be
        // committed immediately. Only an explicit countdown owns a retained,
        // paint-only value animation.
        let value_changed = countdown
        if properties == "none" || duration == 0_u64 ||
        (current.style.equivalent(replacement.style) && !value_changed)
        {
            ret self.patch_widget(id, replacement)
        }
        let signed_delay = transition_delay_ms(transition.delays())
        let delay = if signed_delay > 0_i64 {
            signed_delay as u64
        } else {
            0_u64
        }
        let offset = if signed_delay < 0_i64 {
            ( - signed_delay) as u64
        } else {
            0_u64
        }
        let start_style = replacement.style.with_transition_sample(current.style, properties)
        let layout_changed = !start_style.layout_equivalent(replacement.style)
        let from_value = if countdown {
            1.0_f32
        } else {
            replacement.value()
        }
        let staged = replacement.with_computed_style(start_style).with_value(from_value)
        if !self.patch_widget(id, staged) {
            ret false
        }
        self.transitions.push(StyleTransition {
                id, current.style, replacement.style, from_value, replacement.value(),
                now_ms, duration, delay,
                if offset > duration {
                    duration
                } else {
                    offset
                }
                ,
                if countdown {
                    easing_linear()
                } else {
                    transition_easing(transition.easings())
                }
                ,
                properties, false, layout_changed, value_changed
            }
            ,)
        dispatch_transition_properties(self, id, ui_event_transition_run(), properties, 0.0_f32)
        ret true
    }

    /// Advances active CSS transitions and patches only their retained nodes.
    pub fn advance_transitions(self: mut Self, now_ms: u64) -> bool {
        if self.transitions.len() == 0_usize && self.range_transitions.len() == 0_usize {
            ret false
        }
        let mut retained = Vec[StyleTransition]::new()
        let mut changed = false
        for transition in self.transitions {
            let begin = transition.started_at + transition.delay_ms
            if now_ms < begin {
                retained.push(transition)
            } else {
                if !transition.started {
                    dispatch_transition_properties(self, transition.id, ui_event_transition_start(),
                        transition.properties, transition.elapsed_offset_ms as f32 / 1000.0_f32,)
                }
                let elapsed = now_ms - begin + transition.elapsed_offset_ms
                let amount = if elapsed >= transition.duration_ms {
                    1.0_f32
                } else {
                    elapsed as f32 / transition.duration_ms as f32
                }
                let eased = apply_easing(amount, transition.easing)
                match self.find_widget(transition.id) {
                    Some(widget) => {
                        let interpolated_value = transition.from_value +
                        (transition.to_value - transition.from_value) * eased
                        let sample = interpolate_style(transition.from, transition.to, eased)
                        let next = widget.with_computed_style(transition.to.with_transition_sample(
                                sample, transition.properties,)).with_value(if transition.value {
                                interpolated_value
                            } else {
                                widget.value()
                            }
                        )
                        if self.patch_widget(transition.id, next) {
                            if transition.layout {
                                self.invalidate_layout(self.layout.widget().id())
                            }
                            changed = true
                        }
                    }
                    None => {
                    }
                }
                if amount >= 1.0_f32 {
                    match self.find_widget(transition.id) {
                        Some(widget) => {
                            let committed = widget.with_computed_style(transition.to)
                            .with_value(if transition.value {
                                    transition.to_value
                                } else {
                                    widget.value()
                                }
                            )
                            let _committed = self.patch_widget(transition.id, committed)
                        }
                        None => {
                        }
                    }
                    dispatch_transition_properties(self, transition.id, ui_event_transition_end(),
                        transition.properties, transition.duration_ms as f32 / 1000.0_f32,)
                } else {
                    retained.push(StyleTransition {
                            transition.id, transition.from, transition.to,
                            transition.from_value, transition.to_value, transition.started_at,
                            transition.duration_ms, transition.delay_ms, transition.elapsed_offset_ms,
                            transition.easing, transition.properties, true, transition.layout,
                            transition.value
                        }
                        ,)
                }
            }
        }
        self.transitions = retained
        let mut retained_ranges = Vec[RangeTransition]::new()
        for transition in self.range_transitions {
            let elapsed = if now_ms > transition.started_at {
                now_ms - transition.started_at
            } else {
                0_u64
            }
            let amount = if elapsed >= transition.duration_ms {
                1.0_f32
            } else {
                elapsed as f32 / transition.duration_ms as f32
            }
            let eased = apply_easing(amount, easing_out())
            let start = transition.from_start +
            (transition.to_start - transition.from_start) * eased
            let end = transition.from_end +
            (transition.to_end - transition.from_end) * eased
            if self.patch_range(transition.id, start, end) {
                changed = true
            }
            if amount < 1.0_f32 {
                retained_ranges.push(transition)
            }
        }
        self.range_transitions = retained_ranges
        ret changed
    }

    fn cancel_transition(self: mut Self, id: str, now_ms: u64) ->() {
        let mut retained = Vec[StyleTransition]::new()
        for transition in self.transitions {
            if transition.id == id {
                let begin = transition.started_at + transition.delay_ms
                let elapsed = if now_ms > begin {
                    now_ms - begin
                } else {
                    0_u64
                }
                dispatch_transition_properties(self, id, ui_event_transition_cancel(),
                    transition.properties, elapsed as f32 / 1000.0_f32,)
            } else {
                retained.push(transition)
            }
        }
        self.transitions = retained
        ret()
    }

    pub fn layout(self: mut Self) -> WidgetLayout {
        ret self.layout
    }
    pub fn paint_targets(self: mut Self) -> Vec[str] {
        ret self.paint_targets
    }
    pub fn needs_layout(self: mut Self) -> bool {
        ret self.layout_targets.len() > 0_usize || self.structure_dirty
    }
    pub fn needs_structure(self: mut Self) -> bool {
        ret self.structure_dirty
    }
    pub fn is_dirty(self: mut Self) -> bool {
        ret self.presentation_pending || self.needs_preparation()
    }
    /// GPU backpressure does not invalidate already prepared paint commands.
    pub fn needs_preparation(self: mut Self) -> bool {
        ret self.full_repaint || self.paint_targets.len() > 0_usize || self.layout_targets.len() > 0_usize || self.structure_dirty
    }
    /// Whether the retained render cache must be rebuilt at the next commit.
    pub fn needs_full_repaint(self: mut Self) -> bool {
        ret self.full_repaint
    }
    /// Generation of the current retained geometry and hit-test paths.
    pub fn inspection_revision(self: Self) -> usize {
        ret self.generation
    }

    pub fn segment_generation(self: mut Self, id: str) -> usize {
        ret match self.lookup.entry(self.paths, id) {
            Some(entry) => entry.generation
            None => 0_usize
        }
    }

    /// Reconciles a newly rendered tree against retained state. Stable
    /// structure and geometry become paint patches; geometry changes request
    /// layout, and identity/order changes request a structural rebuild.
    pub fn reconcile(self: mut Self, root: Widget) -> u32 {
        ret self.reconcile_styled(inherit_widget_styles(root))
    }

    /// The cascade already resolved inheritance for the complete tree.
    /// Retain reconciliation without constructing that tree a second time.
    pub fn reconcile_styled(self: mut Self, root: Widget) -> u32 {
        let next = self.preserve_range_transition_values(root)
        let mut targets = Vec[str]::new()
        let previous = self.layout.retained_widget()
        let patched = self.reconcile_absolute_islands(previous, next)
        let change = collect_widget_changes(patched.0, next, targets)
        if change == 0_u32 {
            // Event closures may capture a new graph even when no pixels
            // changed. Refresh retained widget values and hit-path entries
            // without invalidating layout or paint.
            refresh_layout_data(self.layout, next)
        } elif change == 1_u32 {
            for target in targets {
                match next.find(target) {
                    Some(replacement) => {
                        let _patched = self.patch_widget(target, replacement)
                    }
                    None => {
                    }
                }
            }
            // Refresh event captures, but keep geometry and the hit index.
            refresh_layout_data(self.layout, next)
        } elif change == 2_u32 {
            self.invalidate_layout(self.layout.widget().id())
        } elif change == 3_u32 {
            self.invalidate_structure()
        }
        ret change
    }

    // Out-of-flow islands have independently assigned bounds. Their child
    // structure can change without laying out every sibling in the window.
    fn reconcile_absolute_islands(self: mut Self, previous: Widget,
        next: Widget,) ->(Widget, bool) {
        if previous.id() != next.id() || previous.kind() != next.kind() || previous.tag() != next.tag() {
            ret(previous, false)
        }
        if next.id() != "" && previous.style.layout().position().absolute() &&
        next.style.layout().position().absolute() &&
        previous.direction() == next.direction() && previous.basis() == next.basis() &&
        previous.grow() == next.grow() && previous.style.layout_equivalent(next.style) {
            let mut targets = Vec[str]::new()
            if collect_widget_changes(previous, next, targets) >= 2 && self.replace_subtree(next.id(), next) {
                ret(next, true)
            }
        }
        let source = previous.children()
        let desired = next.children()
        if source.len() != desired.len() {
            ret(previous, false)
        }
        let mut updated = previous
        let mut changed = false
        let mut index = 0_usize
        for child in source {
            match desired.get(index) {
                Some(replacement) => {
                    let result = self.reconcile_absolute_islands(child, replacement)
                    if result.1 {
                        let mut children = Vec[Widget]::new()
                        let mut slot = 0_usize
                        for original in updated.children() {
                            children.push(if slot == index {
                                    result.0
                                } else {
                                    original
                                }
                            )
                            slot += 1
                        }
                        updated = updated.with_children(children)
                        changed = true
                    }
                }
                None => {
                }
            }
            index += 1
        }
        ret(updated, changed)
    }

    /// A data-only transaction must refresh closures even when its rendered
    /// state is identical. Geometry, hit paths and their generations survive.
    pub fn refresh_unchanged(self: mut Self, root: Widget) -> bool {
        let mut targets = Vec[str]::new()
        if collect_widget_changes(self.layout.retained_widget(), root, targets) != 0 {
            ret false
        }
        refresh_layout_data(self.layout, root)
        ret true
    }

    fn preserve_range_transition_values(self: mut Self, root: Widget) -> Widget {
        if self.range_transitions.len() == 0_usize {
            ret root
        }
        let mut children = Vec[Widget]::new()
        for child in root.children() {
            children.push(self.preserve_range_transition_values(child))
        }
        let mut rebuilt = root.with_children(children)
        for transition in self.range_transitions {
            if transition.id == rebuilt.id() {
                match self.find_widget(rebuilt.id()) {
                    Some(current) => {
                        rebuilt = rebuilt.with_value(current.range_start())
                        .with_attribute("data-luma-range-end",
                            Debug::fmt(current.range_end()),)
                    }
                    None => {
                    }
                }
            }
        }
        ret rebuilt
    }

    fn path(self: mut Self, id: str) -> Option[Vec[usize]] {
        ret match self.lookup.entry(self.paths, id) {
            Some(entry) => Option[Vec[usize]]::Some(entry.indices)
            None => Option[Vec[usize]]::None
        }
    }

    pub fn find_widget(self: mut Self, id: str) -> Option[Widget] {
        ret match self.paths.get(self.lookup.position(id)) {
            Some(entry) => self.layout.widget_at_path(entry.indices, 0)
            None => Option[Widget]::None
        }
    }

    /// Indexed existence checks do not materialize an owned widget descriptor.
    pub fn contains_widget(self: mut Self, id: str) -> bool {
        ret self.lookup.position(id) < self.paths.len()
    }

    /// Dispatches through the retained path index in O(tree depth), avoiding
    /// reconstruction and recursive search of the complete widget tree for
    /// every pointer/key event.
    pub fn dispatch_event(self: mut Self, id: str, event: UiEvent<H>) -> bool {
        if !self.widget_events {
            ret true
        }
        match self.path(id) {
            Some(indices) => {
                let mut ancestry = Vec[Widget]::new()
                if collect_layout_event_path(self.layout, indices, 0_usize, ancestry) {
                    ret dispatch_widget_event_path(ancestry, event)
                }
            }
            None => {
            }
        }
        ret true
    }
    /// Skips per-widget callback routing while retaining native default actions.
    pub fn set_widget_event_dispatch(self: mut Self, enabled: bool) ->() {
        self.widget_events = enabled ret()
    }

    /// Records interaction identity independently of authored and computed styles.
    pub fn set_interaction_state(self: mut Self, id: str, hovered: bool, active: bool, focused: bool) ->() {
        if hovered {
            self.hovered_id = id
        } elif self.hovered_id == id {
            self.hovered_id = ""
        }
        if active {
            self.active_id = id
        } elif self.active_id == id {
            self.active_id = ""
        }
        if focused {
            self.focused_id = id
        } elif self.focused_id == id {
            self.focused_id = ""
        }
        ret()
    }
    pub fn set_interaction_ids(self: mut Self, hovered: str, active: str, focused: str) ->() {
        self.hovered_id = hovered
        self.active_id = active
        self.focused_id = focused
        ret()
    }
    pub fn hovered_id(self: mut Self) -> str {
        ret self.hovered_id
    }
    pub fn active_id(self: mut Self) -> str {
        ret self.active_id
    }
    pub fn focused_id(self: mut Self) -> str {
        ret self.focused_id
    }

    /// Hit-tests the retained flat paint-order index. This avoids recursively
    /// copying the complete layout tree on every pointer-move event.
    pub fn hit(self: mut Self, x: f32, y: f32) -> str {
        let mut index = self.paths.len()
        while index > 0_usize {
            index -= 1_usize
            match self.paths.get(index) {
                Option::Some(entry) => {
                    let inside = x >= entry.bounds.x() && y >= entry.bounds.y() &&
                    x < entry.bounds.right() && y < entry.bounds.bottom()
                    if inside && !entry.disabled && entry.visible &&
                    entry.pointer_events && point_inside_clip(entry.clip, x, y) {
                        ret entry.id
                    }
                }
                Option::None => {
                }
            }
        }
        ret ""
    }

    pub fn find_layout(self: mut Self, id: str) -> Option[WidgetLayout] {
        match self.path(id) {
            Option::Some(indices) => {
                ret self.layout.layout_at_path(indices, 0_usize)
            }
            Option::None => {
            }
        }
        ret Option[WidgetLayout]::None
    }

    /// Tests retained ancestry, including the ancestor itself, in path depth.
    pub fn target_within(self: mut Self, id: str, ancestor: str) -> bool {
        let child = match self.path(id) {
            Some(path) => path
            None => {
                ret false
            }
        }
        ret match self.path(ancestor) {
            Some(parent) => path_has_prefix(child, parent)
            None => false
        }
    }

    /// Nearest named ancestor which requests application scroll events.
    pub fn scrollable_ancestor(self: mut Self, id: str) -> str {
        let path = match self.path(id) {
            Some(path) => path None => {
                ret ""
            }
        }
        let mut depth = path.len()
        loop {
            let mut prefix = Vec[usize]::new()
            for index in 0..depth {
                prefix.push(path.get(index).unwrap_or(0_usize))
            }
            match self.layout.widget_at_path(prefix, 0_usize) {
                Some(widget) => {
                    if widget.id() != "" && widget.attribute("data-luma-scrollable").unwrap_or("") == "true" {
                        ret widget.id()
                    }
                }
                None => {
                }
            }
            if depth == 0_usize {
                break
            }
            depth -= 1_usize
        }
        ret ""
    }

    /// Stable cache damage excludes entire transient branches, not just roots.
    pub fn stable_paint_regions(self: mut Self, excluded: Vec[str]) -> Vec[Rect] {
        let mut regions = Vec[Rect]::new()
        for id in self.paint_targets {
            let mut transient = false
            for root in excluded {
                transient = transient || self.target_within(id, root)
            }
            if !transient {
                match self.find_layout(id) {
                    Some(node) => {
                        let mut bounds = node.paint_bounds()
                        for previous in self.damage {
                            if previous.id == id {
                                bounds = union_rect(bounds, previous.bounds)
                            }
                        }
                        regions.push(bounds)
                    }
                    None => {
                    }
                }
            }
        }
        ret regions
    }

    pub fn clip_for(self: mut Self, id: str) -> Option[Rect] {
        match self.lookup.entry(self.paths, id) {
            Some(entry) => {
                ret entry.clip
            }
            None => {
                ret Option[Rect]::None
            }
        }
    }

    pub fn patch_widget(self: mut Self, id: str, replacement: Widget) -> bool {
        let current = match self.find_widget(id) {
            Some(value) => value
            None => {
                ret false
            }
        }
        let mut changed_targets = Vec[str]::new()
        let paint_changed = collect_widget_changes(
            current.with_children(Vec[Widget]::new()),
            replacement.with_children(Vec[Widget]::new()), changed_targets,) != 0_u32
        if paint_changed {
            self.record_damage(id)
        }
        match self.path(id) {
            Option::Some(indices) => {
                if !self.layout.patch_widget_at_path(indices, 0_usize, replacement) {
                    ret false
                }
            }
            Option::None => {
                ret false
            }
        }
        let index = self.lookup.position(id)
        match self.paths.get(index) {
            Option::Some(entry) => {
                if entry.id == id {
                    self.paths.set(index, WidgetPath {
                            entry.id, entry.indices, entry.bounds, entry.clip,
                            replacement.disabled(), replacement.style.visible(),
                            replacement.style.pointer_events(),
                            self.generation + 1_usize
                        }
                        ,)
                    self.generation = self.generation + 1_usize
                }
            }
            Option::None => {
            }
        }
        if paint_changed {
            self.mark_paint(id)
        }
        ret true
    }
    /// Restores a widget and marks it for repaint. This is required when the
    /// previous reactive state has already been committed to the retained cache.
    pub fn restore_widget(self: mut Self, id: str, replacement: Widget) -> bool {
        let restored = self.patch_widget(id, replacement)
        if restored {
            self.mark_paint(id)
        }
        ret restored
    }
    pub fn patch_text(self: mut Self, id: str, value: str) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_text(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_style(self: mut Self, id: str, value: Style) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_style(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_focus(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_focus(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_disabled(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_disabled(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_checked(self: mut Self, id: str, value: bool) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_checked(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_value(self: mut Self, id: str, value: f32) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_value(value))
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn patch_range(self: mut Self, id: str, start: f32, end: f32) -> bool {
        match self.find_widget(id) {
            Option::Some(widget) => {
                ret self.patch_widget(id, widget.with_value(start)
                    .with_attribute("data-luma-range-end", Debug::fmt(clamp_unit(end))),)
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn replace_subtree(self: mut Self, id: str, replacement: Widget) -> bool {
        ret self.replace_component(id, replacement, true)
    }
    fn replace_component(self: mut Self, id: str, replacement: Widget, relayout: bool) -> bool {
        self.record_damage(id)
        match self.path(id) {
            Option::Some(indices) => {
                let inherited_clip = inherited_clip_at_path(
                    self.layout, indices, 0_usize, Option[Rect]::None,)
                let updated = if relayout {
                    self.layout.replace_subtree_at_path(indices, 0_usize, replacement)
                } else {
                    self.layout.refresh_component_at_path(indices, 0_usize, replacement)
                }
                if !updated {
                    ret false
                }
                self.generation = self.generation + 1_usize
                let replacement_generation = self.generation
                let mut replacement_paths = Vec[WidgetPath]::new()
                match self.layout.layout_at_path(indices, 0_usize) {
                    Option::Some(updated) => {
                        collect_widget_paths(updated, indices, inherited_clip,
                            replacement_generation, replacement_paths,)
                    }
                    Option::None => {
                        ret false
                    }
                }
                // A retained animation normally replaces a subtree with the
                // same shape. Its entries are contiguous in preorder, so
                // overwrite that range without allocating and copying the
                // complete window hit index.
                let first = self.lookup.position(id)
                let mut former_count = 0_usize
                let mut path_index = first
                while path_index < self.paths.len() {
                    match self.paths.get(path_index) {
                        Option::Some(entry) => {
                            if path_has_prefix(entry.indices, indices) {
                                former_count = former_count + 1_usize
                            } else {
                                break
                            }
                        }
                        Option::None => {
                        }
                    }
                    path_index = path_index + 1_usize
                }
                if first < self.paths.len() &&
                former_count == replacement_paths.len() {
                    let mut ids_changed = false
                    let mut replacement_index = 0_usize
                    while replacement_index < replacement_paths.len() {
                        match replacement_paths.get(replacement_index) {
                            Option::Some(entry) => {
                                match self.paths.get(first + replacement_index) {
                                    Some(old) => {
                                        ids_changed = ids_changed || old.id != entry.id
                                    }
                                    None => {
                                        ids_changed = true
                                    }
                                }
                                self.paths.set(first + replacement_index, entry)
                            }
                            Option::None => {
                            }
                        }
                        replacement_index = replacement_index + 1_usize
                    }
                    if ids_changed {
                        self.lookup = RetainedWidgetIndex::new(self.paths)
                    }
                } else {
                    let mut next_paths = Vec[WidgetPath]::new()
                    let mut inserted = false
                    for entry in self.paths {
                        if path_has_prefix(entry.indices, indices) {
                            if !inserted {
                                for replacement_path in replacement_paths {
                                    next_paths.push(replacement_path)
                                }
                                inserted = true
                            }
                        } else {
                            next_paths.push(entry)
                        }
                    }
                    if !inserted {
                        for replacement_path in replacement_paths {
                            next_paths.push(replacement_path)
                        }
                    }
                    self.paths = next_paths
                    self.lookup = RetainedWidgetIndex::new(self.paths)
                }
            }
            Option::None => {
                ret false
            }
        }
        // A component background must be restored before any already-dirty
        // descendants are painted on top of it.
        let already_first = match self.paint_targets.get(0_usize) {
            Option::Some(target) => {
                target == id
            }
            Option::None => {
                false
            }
        }
        if !already_first {
            let mut ordered = Vec[str]::new()
            if id != "" {
                ordered.push(id)
            }
            for target in self.paint_targets {
                if target != id {
                    ordered.push(target)
                }
            }
            self.paint_targets = ordered
        }
        self.record_damage(id)
        ret true
    }
    pub fn invalidate_layout(self: mut Self, id: str) ->() {
        self.mark_paint(id)
        if id != "" {
            let mut found = false
            for target in self.layout_targets {
                if target == id {
                    found = true
                }
            }
            if !found {
                self.layout_targets.push(id)
            }
        }
        ret()
    }
    /// Marks a stable widget subtree for repaint without changing its layout.
    pub fn invalidate_paint(self: mut Self, id: str) ->() {
        self.mark_paint(id)
        ret()
    }
    pub fn invalidate_structure(self: mut Self) ->() {
        self.structure_dirty = true
        ret()
    }
    pub fn flush_layout(self: mut Self) -> bool {
        if self.structure_dirty {
            ret false
        }
        for target in self.layout_targets {
            if !self.layout.relayout_subtree(target) {
                ret false
            }
        }
        if self.layout_targets.len() > 0_usize {
            self.full_repaint = true
        }
        self.layout_targets.clear()
        self.generation = self.generation + 1_usize
        self.paths = widget_paths(self.layout, self.generation)
        self.lookup = self.lookup.refresh(self.paths)
        ret true
    }
    pub fn replace_layout(self: mut Self, value: WidgetLayout) ->() {
        self.layout = value
        self.generation = self.generation + 1_usize
        self.paths = widget_paths(value, self.generation)
        self.lookup = self.lookup.refresh(self.paths)
        self.paint_targets.clear()
        self.damage.clear()
        self.layout_targets.clear()
        self.structure_dirty = false
        self.full_repaint = true
        ret()
    }
    pub fn clear_paint(self: mut Self) ->() {
        self.paint_targets.clear()
        self.damage.clear()
        self.full_repaint = false
        self.presentation_pending = false
        ret()
    }
    /// Marks the current retained layout as committed by a renderer that owns
    /// presentation outside `Window.draw_reactive`.
    pub fn commit_rendered(self: mut Self) ->() {
        self.paint_targets.clear()
        self.damage.clear()
        self.layout_targets.clear()
        self.structure_dirty = false
        self.full_repaint = false
        self.presentation_pending = false
        ret()
    }
    /// Paint commands are complete, but their frame has not been presented.
    /// Further model changes still invalidate the normal paint/layout state.
    pub fn commit_prepared(self: mut Self) ->() {
        self.paint_targets.clear()
        self.damage.clear()
        self.full_repaint = false
        self.presentation_pending = true
        ret()
    }
    /// Clears committed targets while retaining caller-owned transient layers.
    pub fn retain_paint(self: mut Self, targets: Vec[str]) ->() {
        let mut retained = Vec[str]::new()
        for target in self.paint_targets {
            let mut keep = false
            for retained_target in targets {
                if target == retained_target {
                    keep = true
                }
            }
            if keep {
                retained.push(target)
            }
        }
        self.paint_targets = retained
        let mut damage = Vec[PaintDamage]::new()
        for entry in self.damage {
            for target in retained {
                if entry.id == target {
                    damage.push(entry)
                }
            }
        }
        self.damage = damage
        ret()
    }

    /// Damage covers both the old and new visual footprint, including
    /// outlines, shadows and overflowing children, not just layout bounds.
    pub fn paint_regions(self: mut Self) -> Vec[Rect] {
        let mut regions = Vec[Rect]::new()
        for entry in self.damage {
            regions.push(entry.bounds)
        }
        ret regions
    }
    fn record_damage(self: mut Self, id: str) ->() {
        match self.find_layout(id) {
            Some(layout) => {
                let bounds = layout.paint_bounds()
                let mut index = 0_usize
                for entry in self.damage {
                    if entry.id == id {
                        self.damage.set(index, PaintDamage {
                                id, union_rect(entry.bounds, bounds)
                            }
                            ,
                        )
                        ret()
                    }
                    index += 1_usize
                }
                self.damage.push(PaintDamage {
                        id, bounds
                    }
                    ,
                )
            }
            None => {
            }
        }
        ret()
    }
    fn mark_paint(self: mut Self, id: str) ->() {
        if id == "" {
            ret()
        }
        self.record_damage(id)
        for target in self.paint_targets {
            if target == id {
                ret()
            }
        }
        self.paint_targets.push(id)
        ret()
    }
}

fn slider_edge_inset(style: Style) -> f32 {
    // Include the stroke/AA fringe and reserve inset focus outlines even
    // while unfocused, so focusing cannot move the slider's endpoints.
    let outline = - style.outline().offset()
    let border = style.border_width()
    ret 1.0_f32 + if outline > border && outline > 0.0_f32 {
        outline
    } elif border > 0.0_f32 {
        border
    } else {
        0.0_f32
    }
}

/// Shared thumb geometry for slider painting and pointer normalization.
pub fn slider_thumb_radius(bounds: Rect, style: Style) -> f32 {
    let inset = slider_edge_inset(style)
    let available = if bounds.width() < bounds.height() {
        bounds.width() / 2.0_f32 - inset
    } else {
        bounds.height() / 2.0_f32 - inset
    }
    ret if available < 0.0_f32 {
        0.0_f32
    } elif available < 7.0_f32 {
        available
    } else {
        7.0_f32
    }
}

/// Track endpoints keep the complete thumb inside its repaint rectangle.
pub fn slider_track_bounds(bounds: Rect, style: Style) -> Rect {
    let desired = slider_edge_inset(style) + slider_thumb_radius(bounds, style)
    let inset = if desired * 2.0_f32 > bounds.width() {
        bounds.width() / 2.0_f32
    } else {
        desired
    }
    ret Rect::new(bounds.x() + inset, bounds.y() + bounds.height() / 2.0_f32,
        bounds.width() - inset * 2.0_f32, 0.0_f32,)
}

#attr(test)
fn slider_geometry_contains_thumb_and_focus_border() -> bool {
    let bounds = Rect::new(20.0_f32, 30.0_f32, 240.0_f32, 32.0_f32)
    let style = Style::default().with_border(2.0_f32, Color::rgb(0_u8, 0_u8, 0_u8))
    .with_outline(2.0_f32, Color::rgb(0_u8, 0_u8, 0_u8), - 2.0_f32)
    let track = slider_track_bounds(bounds, style)
    let radius = slider_thumb_radius(bounds, style)
    let tiny = Rect::new(0.0_f32, 0.0_f32, 4.0_f32, 4.0_f32)
    ret track.x() - radius >= bounds.x() + 3.0_f32 &&
    track.right() + radius <= bounds.right() - 3.0_f32 &&
    slider_track_bounds(tiny, style).width() >= 0.0_f32 &&
    slider_thumb_radius(tiny, style) == 0.0_f32
}

fn scroll_container_at(layout: WidgetLayout, x: f32, y: f32) -> str {
    let bounds = layout.bounds()
    if x < bounds.x() || x >= bounds.right() || y < bounds.y() || y >= bounds.bottom() {
        ret ""
    }
    let children = layout.children()
    let mut index = children.len()
    while index > 0 {
        index -= 1
        match children.get(index) {
            Some(child) => {
                let target = scroll_container_at(child, x, y) if target != "" {
                    ret target
                }
            }
            None => {
            }
        }
    }
    ret if layout.widget().attribute("data-luma-scrollable").unwrap_or("") == "true" {
        layout.widget().id()
    } else {
        ""
    }
}

pub fn layout_widget(widget: Widget, bounds: Rect) -> WidgetLayout {
    ret layout_widget_reusing(widget, bounds, Option[WidgetLayout]::None,
        Vec[Vec[usize]]::new(), Vec[usize]::new(),)
}

fn same_layout_bounds(left: Rect, right: Rect) -> bool {
    ret left.x() == right.x() && left.y() == right.y() &&
    left.width() == right.width() && left.height() == right.height()
}

fn collect_geometry_changes(previous: WidgetLayout, next: WidgetLayout,
    path: Vec[usize], roots: mut Vec[Vec[usize]],) ->() {
    if !same_layout_bounds(previous.bounds(), next.bounds()) {
        roots.push(path) ret()
    }
    if previous.children().len() == next.children().len() &&
    previous.children().as_ptr() == next.children().as_ptr() {
        ret()
    }
    let mut index = 0_usize
    for child in next.children() {
        match previous.children().get(index) {
            Some(old) => {
                let mut child_path = Vec[usize]::new()
                child_path.extend(path) child_path.push(index)
                collect_geometry_changes(old, child, child_path, roots)
            }
            None => {
                roots.push(path) ret()
            }
        }
        index += 1
    }
}

fn layout_widget_reusing(widget: Widget, bounds: Rect, previous: Option[WidgetLayout],
    dirty: Vec[Vec[usize]], path: Vec[usize],) -> WidgetLayout {
    let mut affected = false
    for target in dirty {
        affected = affected || path_has_prefix(target, path)
    }
    match previous {
        Some(old) => {
            if !affected && same_layout_bounds(old.bounds(), bounds) {
                ret old
            }
            if !affected && old.bounds().width() == bounds.width() &&
            old.bounds().height() == bounds.height() {
                ret old.translated(bounds.x() - old.bounds().x(), bounds.y() - old.bounds().y())
            }
        }
        None => {
        }
    }
    // Keep the local descriptor independent of the temporary sizing input.
    // Persisting geometry_input() here embeds previous-frame child snapshots
    // alongside the new layout children and retains a growing history graph.
    let descriptor = match previous {
        Some(old) => old.widget() None => widget
    }
    let widget = match previous {
        Some(old) => old.geometry_input() None => widget
    }
    // Leaves have no flex/grid work. Avoid constructing all the layout work
    // vectors (and copying style subobjects) for every icon/text/control.
    if widget.children().len() == 0 || widget.kind() == widget_rich_text() {
        let children = Vec[WidgetLayout]::new()
        ret WidgetLayout {
            descriptor, bounds, children, widget_paint_bounds(descriptor, bounds, children), 0
        }
    }
    let content = bounds.inset(widget.style.padding())
    let scroll = widget.style.layout().scroll()
    let scrolled_content = Rect::new(content.x() - scroll.x(), content.y() - scroll.y(), content.width(),
        content.height(),)
    let widget_flex = widget.style.layout().flex()
    let direction = if widget_flex.direction_set() {
        widget_flex.direction()
    } else {
        widget.direction()
    }
    let all_children = if widget.kind() == widget_rich_text() {
        Vec[Widget]::new()
    } else {
        widget.children()
    }
    let mut indexed = Vec[IndexedWidget]::new()
    let mut positioned = Vec[IndexedWidget]::new()
    let mut child_index = 0_usize
    while child_index < all_children.len() {
        match all_children.get(child_index) {
            Option[Widget]::Some(child) => {
                if child.style.layout().flex().displayed() {
                    if child.style.layout().position().absolute() {
                        positioned.push(IndexedWidget {
                                child, child_index
                            }
                            ,
                        )
                    } else {
                        indexed.push(IndexedWidget {
                                child, child_index
                            }
                            ,
                        )
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        child_index = child_index + 1_usize
    }
    indexed = ordered_widgets(indexed)
    let mut children = Vec[Widget]::new()
    for item in indexed {
        children.push(item.widget)
    }
    let rects = child_layout_rects(widget, children, scrolled_content, direction, widget_flex)
    let mut index = 0_usize
    let mut layouts = Vec[WidgetLayout]::new()
    index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                match rects.get(index) {
                    Option[Rect]::Some(rect) => {
                        let self_align = child.style.layout().flex().self_align()
                        let effective_align = if self_align >= 0_i32 {
                            self_align as usize
                        } else {
                            widget_flex.align()
                        }
                        let child_bounds = if widget_flex.grid() {
                            styled_grid_rect(child, rect, effective_align)
                        } else {
                            styled_child_rect(child, rect, direction, effective_align)
                        }
                        let source_index = indexed.get(index).unwrap_or(IndexedWidget {
                                child, index
                            }
                            ,
                        ).index
                        let mut child_path = Vec[usize]::new()
                        child_path.extend(path) child_path.push(source_index)
                        layouts.push(layout_widget_reusing(child, child_bounds,
                                match previous {
                                    Some(old) => old.source_child(source_index) None => Option[WidgetLayout]::None
                                }
                                ,
                                dirty, child_path,).with_source_index(source_index))
                    }
                    Option[Rect]::None => {
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    index = 0_usize
    while index < positioned.len() {
        match positioned.get(index) {
            Option[IndexedWidget]::Some(item) => {
                let mut child_path = Vec[usize]::new()
                child_path.extend(path) child_path.push(item.index)
                layouts.push(layout_widget_reusing(item.widget, absolute_child_rect(item.widget, scrolled_content),
                        match previous {
                            Some(old) => old.source_child(item.index) None => Option[WidgetLayout]::None
                        }
                        ,
                        dirty, child_path,).with_source_index(item.index))
            }
            Option[IndexedWidget]::None => {
            }
        }
        index = index + 1_usize
    }
    layouts = stacked_layouts(layouts)
    ret WidgetLayout {
        descriptor, bounds, layouts, widget_paint_bounds(descriptor, bounds, layouts), 0
    }
}

fn child_layout_rects(widget: Widget, children: Vec[Widget], scrolled_content: Rect,
    direction: usize, widget_flex: FlexStyle,) -> Vec[Rect] {
    let mut flex_items = Vec[FlexItem]::new()
    let mut cross_extents = Vec[f32]::new()
    let mut grid_placements = Vec[GridPlacement]::new()
    let mut grid_minimum_content = Vec[Size]::new()
    let mut grid_maximum_content = Vec[Size]::new()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                let layout = child.style.layout()
                if widget_flex.grid() {
                    grid_placements.push(layout.grid_placement())
                } else {
                    let flex = layout.flex()
                    let margin = layout.margin()
                    let horizontal_parent = direction == horizontal()
                    let explicit = if horizontal_parent {
                        child.resolved_width(scrolled_content.width())
                    } else {
                        child.resolved_height(scrolled_content.height())
                    }
                    let minimum = if horizontal_parent {
                        child.resolved_min_width()
                    } else {
                        child.resolved_min_height()
                    }
                    let maximum = if horizontal_parent {
                        child.resolved_max_width()
                    } else {
                        child.resolved_max_height()
                    }
                    let margin_size = if horizontal_parent {
                        margin.left() + margin.right()
                    } else {
                        margin.top() + margin.bottom()
                    }
                    let default_basis = if flex.basis() >= 0.0_f32 {
                        flex.basis()
                    } elif flex.basis() == - 2.0_f32 {
                        auto_content_extent(child, horizontal_parent)
                    } else {
                        child.basis()
                    }
                    let basis =(if explicit >= 0.0_f32 {
                            explicit
                        } else {
                            default_basis
                        }
                    ) + margin_size
                    let grow = if flex.grow() >= 0.0_f32 {
                        flex.grow()
                    } else {
                        child.grow()
                    }
                    let shrink = if flex.shrink() >= 0.0_f32 {
                        flex.shrink()
                    } else {
                        1.0_f32
                    }
                    flex_items.push(FlexItem::sized(basis, grow, shrink, minimum + margin_size, maximum +
                            margin_size,))
                    if widget_flex.wrap() {
                        let cross_explicit = if horizontal_parent {
                            child.resolved_height(scrolled_content.height())
                        } else {
                            child.resolved_width(scrolled_content.width())
                        }
                        let cross_default = if horizontal_parent {
                            child.preferred_size().height()
                        } else {
                            child.preferred_size().width()
                        }
                        let cross_margin = if horizontal_parent {
                            margin.top() + margin.bottom()
                        } else {
                            margin.left() + margin.right()
                        }
                        cross_extents.push((if cross_explicit >= 0.0_f32 {
                                    cross_explicit
                                } else {
                                    cross_default
                                }
                            ) + cross_margin)
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    let intrinsic_grid = widget_flex.grid() &&
    (widget_flex.column_template() != "" || widget_flex.auto_column_template() != "" ||
        widget_flex.auto_row_template() != "" || has_grid_placement(grid_placements))
    if intrinsic_grid && grid_needs_content_sizes(widget_flex.column_template(),
        widget_flex.row_template(), widget_flex.auto_column_template(),
        widget_flex.auto_row_template(), grid_placements,) {
        index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    grid_minimum_content.push(child.min_content_size())
                    grid_maximum_content.push(child.max_content_size())
                }
                Option[Widget]::None => {
                }
            }
            index = index + 1_usize
        }
    }
    let row_gap = if widget_flex.row_gap() >= 0.0_f32 {
        widget_flex.row_gap()
    } else {
        widget.style.gap()
    }
    let column_gap = if widget_flex.column_gap() >= 0.0_f32 {
        widget_flex.column_gap()
    } else {
        widget.style.gap()
    }
    let main_gap = if direction == horizontal() {
        column_gap
    } else {
        row_gap
    }
    let cross_gap = if direction == horizontal() {
        row_gap
    } else {
        column_gap
    }
    ret if widget_flex.grid() {
        if intrinsic_grid {
            grid_layout_intrinsic_placed(scrolled_content, widget_flex.column_template(), widget_flex.row_template(),
                widget_flex.auto_column_template(), widget_flex.auto_row_template(), row_gap, column_gap,
                grid_placements,
                grid_minimum_content, grid_maximum_content, widget_flex.auto_flow_column(), widget_flex.auto_flow_dense(),)
        } else {
            grid_layout_gaps(scrolled_content, widget_flex.columns(), row_gap, column_gap, children.len())
        }
    } elif widget_flex.wrap() {
        flex_wrap_layout(scrolled_content, direction, main_gap, cross_gap, widget_flex.justify(), flex_items,
            cross_extents, widget_flex.direction_reverse(), widget_flex.wrap_reverse(), widget_flex.align_content(),)
    } else {
        flex_layout_directional(scrolled_content, direction, main_gap, widget_flex.justify(), flex_items,
            widget_flex.direction_reverse(),)
    }
}

fn has_grid_placement(values: Vec[GridPlacement]) -> bool {
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[GridPlacement]::Some(value) => {
                if value.column() > 0_usize || value.row() > 0_usize || value.column_span() > 1_usize
                || value.row_span() > 1_usize {
                    ret true
                }
            }
            Option[GridPlacement]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn stacked_layouts(source: Vec[WidgetLayout]) -> Vec[WidgetLayout] {
    let mut ordered = true
    let mut previous_z = - 2147483648_i32
    let mut ordered_index = 0_usize
    while ordered_index < source.len() {
        match source.get(ordered_index) {
            Option[WidgetLayout]::Some(layout) => {
                let z = layout.widget().style.layout().position().z_index()
                if z < previous_z {
                    ordered = false
                }
                previous_z = z
            }
            Option[WidgetLayout]::None => {
            }
        }
        ordered_index = ordered_index + 1_usize
    }
    if ordered {
        ret source
    }
    let mut result = Vec[WidgetLayout]::new()
    let mut used = Vec[bool]::new()
    let mut index = 0_usize
    while index < source.len() {
        used.push(false) index = index + 1_usize
    }
    while result.len() < source.len() {
        let mut best = source.len()
        let mut best_z = 2147483647_i32
        index = 0_usize
        while index < source.len() {
            match used.get(index) {
                Option[bool]::Some(is_used) => {
                    if !is_used {
                        match source.get(index) {
                            Option[WidgetLayout]::Some(layout) => {
                                let z = layout.widget().style.layout().position().z_index()
                                if best == source.len() || z < best_z {
                                    best = index best_z = z
                                }
                            }
                            Option[WidgetLayout]::None => {
                            }
                        }
                    }
                }
                Option[bool]::None => {
                }
            }
            index = index + 1_usize
        }
        if best == source.len() {
            break
        }
        match source.get(best) {
            Option[WidgetLayout]::Some(layout) => {
                result.push(layout) used.set(best, true)
            }
            Option[WidgetLayout]::None => {
                break
            }
        }
    }
    ret result
}

struct IndexedWidget {
    widget: Widget
    index: usize
}

fn ordered_widgets(source: Vec[IndexedWidget]) -> Vec[IndexedWidget] {
    let mut ordered = true
    let mut previous_order = - 2147483648_i32
    let mut ordered_index = 0_usize
    while ordered_index < source.len() {
        match source.get(ordered_index) {
            Option[IndexedWidget]::Some(widget) => {
                let order = widget.widget.style.layout().flex().order()
                if order < previous_order {
                    ordered = false
                }
                previous_order = order
            }
            Option[IndexedWidget]::None => {
            }
        }
        ordered_index = ordered_index + 1_usize
    }
    if ordered {
        ret source
    }
    let mut result = Vec[IndexedWidget]::new()
    let mut used = Vec[bool]::new()
    let mut index = 0_usize
    while index < source.len() {
        used.push(false) index = index + 1_usize
    }
    while result.len() < source.len() {
        let mut best = source.len()
        let mut best_order = 2147483647_i32
        index = 0_usize
        while index < source.len() {
            match used.get(index) {
                Option[bool]::Some(is_used) => {
                    if !is_used {
                        match source.get(index) {
                            Option[IndexedWidget]::Some(widget) => {
                                let order = widget.widget.style.layout().flex().order()
                                if best == source.len() || order < best_order {
                                    best = index best_order = order
                                }
                            }
                            Option[IndexedWidget]::None => {
                            }
                        }
                    }
                }
                Option[bool]::None => {
                }
            }
            index = index + 1_usize
        }
        if best == source.len() {
            break
        }
        match source.get(best) {
            Option[IndexedWidget]::Some(widget) => {
                result.push(widget) used.set(best, true)
            }
            Option[IndexedWidget]::None => {
                break
            }
        }
    }
    ret result
}

fn same_animation_targets(layout: WidgetLayout, next: Widget) -> bool {
    let previous = layout.widget()
    if previous.id() != next.id() || previous.kind() != next.kind() ||
    previous.children().len() != next.children().len() ||
    !previous.style.equivalent(next.style) ||
    previous.countdown_cycle() != next.countdown_cycle() ||
    // An idle/completed countdown still owns its sampled value. Let the
    // animation transaction preserve it instead of resetting to model value.
    previous.countdown_duration_ms() > 0 || next.countdown_duration_ms() > 0 {
        ret false
    }
    let source = next.children()
    for old in layout.children() {
        match source.get(old.source_index) {
            Some(child) => {
                if !same_animation_targets(old, child) {
                    ret false
                }
            }
            None => {
                ret false
            }
        }
    }
    ret true
}

pub fn inherit_widget_styles(root: Widget) -> Widget {
    ret inherit_widget_node(root, Option[Style]::None)
}

fn inherit_widget_node(widget: Widget, parent: Option[Style]) -> Widget {
    let styled = match parent {
        Option[Style]::Some(parent_style) => {
            widget.with_computed_style(widget.style.inherit_text(parent_style))
        }
        Option[Style]::None => {
            widget
        }
    }
    let source = styled.children()
    if source.len() == 0_usize {
        ret styled
    }
    let mut children = Vec[Widget]::new()
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[Widget]::Some(child) => {
                children.push(inherit_widget_node(child, Option[Style]::Some(styled.style)))
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    ret styled.with_children(children)
}

fn absolute_child_rect(widget: Widget, containing: Rect) -> Rect {
    // The containing block resolves percentages/insets, not a size ceiling.
    // Explicit popup dimensions may overflow it; ancestor clips apply later.
    let layout = widget.style.layout()
    let position = layout.position()
    let margin = layout.margin()
    let available_width = containing.width() - margin.left() - margin.right()
    let available_height = containing.height() - margin.top() - margin.bottom()
    let explicit_width = widget.resolved_width(available_width)
    let explicit_height = widget.resolved_height(available_height)
    let automatic_width = if explicit_width >= 0 {
        explicit_width
    } elif position.left_set() && position.right_set() {
        available_width - position.left() - position.right()
    } else {
        if widget.children().len() > 0 {
            auto_content_extent(widget, true)
        } else {
            widget.preferred_size().width()
        }
    }
    let automatic_height = if explicit_height >= 0 {
        explicit_height
    } elif position.top_set() && position.bottom_set() {
        available_height - position.top() - position.bottom()
    } else {
        if widget.children().len() > 0 {
            auto_content_extent(widget, false)
        } else {
            widget.basis()
        }
    }
    let width = clamp_dimension(if explicit_width >= 0.0_f32 {
            explicit_width
        } else {
            automatic_width
        }
        ,
        widget.resolved_min_width(), widget.resolved_max_width(), widget.resolved_max_width(),)
    let height = clamp_dimension(if explicit_height >= 0.0_f32 {
            explicit_height
        } else {
            automatic_height
        }
        ,
        widget.resolved_min_height(), widget.resolved_max_height(), widget.resolved_max_height(),)
    let x = if position.left_set() {
        containing.x() + position.left() + margin.left()
    } elif position.right_set() {
        containing.right() - position.right() - margin.right() - width
    } else {
        containing.x() + margin.left()
    }
    let y = if position.top_set() {
        containing.y() + position.top() + margin.top()
    } elif position.bottom_set() {
        containing.bottom() - position.bottom() - margin.bottom() - height
    } else {
        containing.y() + margin.top()
    }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn styled_child_rect(widget: Widget, allocated: Rect, parent_direction: usize, align: usize) -> Rect
{
    let layout = widget.style.layout()
    let inner = allocated.inset(layout.margin())
    let explicit_width = if parent_direction == horizontal() {
        - 1.0_f32
    } else {
        widget.resolved_width(inner.width())
    }
    let explicit_height = if parent_direction == vertical() {
        - 1.0_f32
    } else {
        widget.resolved_height(inner.height())
    }
    let requested_width = if explicit_width >= 0.0_f32 {
        explicit_width
    } else {
        inner.width()
    }
    let requested_height = if explicit_height >= 0.0_f32 {
        explicit_height
    } else {
        inner.height()
    }
    let width = clamp_dimension(requested_width, widget.resolved_min_width(), widget.resolved_max_width(),
        inner.width(),)
    let height = clamp_dimension(requested_height, widget.resolved_min_height(), widget.resolved_max_height(),
        inner.height(),)
    let x = if parent_direction == vertical() && align == align_center() {
        inner.x() +(inner.width() - width) / 2.0_f32
    } elif parent_direction == vertical() && align == align_end() {
        inner.right() - width
    } else {
        inner.x()
    }
    let y = if parent_direction == horizontal() && align == align_center() {
        inner.y() +(inner.height() - height) / 2.0_f32
    } elif parent_direction == horizontal() && align == align_end() {
        inner.bottom() - height
    } else {
        inner.y()
    }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn relative_child_rect(widget: Widget, bounds: Rect) -> Rect {
    let position = widget.style.layout().position()
    if !position.relative() {
        ret bounds
    }
    let x = bounds.x() + if position.left_set() {
        position.left()
    } elif position.right_set() {
        - position.right()
    } else {
        0.0_f32
    }
    let y = bounds.y() + if position.top_set() {
        position.top()
    } elif position.bottom_set() {
        - position.bottom()
    } else {
        0.0_f32
    }
    ret Rect::new(x, y, bounds.width(), bounds.height())
}

fn styled_grid_rect(widget: Widget, allocated: Rect, align: usize) -> Rect {
    let layout = widget.style.layout()
    let inner = allocated.inset(layout.margin())
    let explicit_width = widget.resolved_width(inner.width())
    let explicit_height = widget.resolved_height(inner.height())
    let width = clamp_dimension(if explicit_width >= 0.0_f32 {
            explicit_width
        } else {
            inner.width()
        }
        ,
        widget.resolved_min_width(), widget.resolved_max_width(), inner.width(),)
    let height = clamp_dimension(if explicit_height >= 0.0_f32 {
            explicit_height
        } else {
            inner.height()
        }
        ,
        widget.resolved_min_height(), widget.resolved_max_height(), inner.height(),)
    let x = if align == align_center() {
        inner.x() +(inner.width() - width) / 2.0_f32
    } elif align == align_end() {
        inner.right() - width
    } else {
        inner.x()
    }
    let y = if align == align_center() {
        inner.y() +(inner.height() - height) / 2.0_f32
    } elif align == align_end() {
        inner.bottom() - height
    } else {
        inner.y()
    }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

impl for Widget {
    #attr(borrowed_self)
    pub fn resolved_width(self: Self, available: f32) -> f32 {
        let layout = self.style.layout()
        let value = if layout.relative().width() >= 0.0_f32 {
            available * layout.relative().width()
        } else {
            layout.width()
        }
        ret if value >= 0.0_f32 && layout.content_box() {
            value + self.box_width_extra()
        } else {
            value
        }
    }

    #attr(borrowed_self)
    pub fn resolved_height(self: Self, available: f32) -> f32 {
        let layout = self.style.layout()
        let value = if layout.relative().height() >= 0.0_f32 {
            available * layout.relative().height()
        } else {
            layout.height()
        }
        ret if value >= 0.0_f32 && layout.content_box() {
            value + self.box_height_extra()
        } else {
            value
        }
    }

    #attr(borrowed_self)
    fn box_width_extra(self: Self) -> f32 {
        let style = self.style
        ret style.padding().left() + style.padding().right() + style.border_width() * 2.0_f32
    }

    #attr(borrowed_self)
    fn box_height_extra(self: Self) -> f32 {
        let style = self.style
        ret style.padding().top() + style.padding().bottom() + style.border_width() * 2.0_f32
    }

    #attr(borrowed_self)
    pub fn resolved_min_width(self: Self) -> f32 {
        let extra = if self.style.layout().content_box() {
            self.box_width_extra()
        } else {
            0.0_f32
        }
        ret self.style.layout().min_width() + extra
    }
    #attr(borrowed_self)
    pub fn resolved_min_height(self: Self) -> f32 {
        let extra = if self.style.layout().content_box() {
            self.box_height_extra()
        } else {
            0.0_f32
        }
        ret self.style.layout().min_height() + extra
    }
    #attr(borrowed_self)
    pub fn resolved_max_width(self: Self) -> f32 {
        let extra = if self.style.layout().content_box() {
            self.box_width_extra()
        } else {
            0.0_f32
        }
        ret self.style.layout().max_width() + extra
    }
    #attr(borrowed_self)
    pub fn resolved_max_height(self: Self) -> f32 {
        let extra = if self.style.layout().content_box() {
            self.box_height_extra()
        } else {
            0.0_f32
        }
        ret self.style.layout().max_height() + extra
    }
}

fn clamp_dimension(value: f32, minimum: f32, maximum: f32, available: f32) -> f32 {
    let mut result = value
    if result < minimum {
        result = minimum
    }
    if result > maximum {
        result = maximum
    }
    if result > available {
        result = available
    }
    if result < 0.0_f32 {
        ret 0.0_f32
    }
    ret result
}

fn dispatch_transition_properties(ui: mut ReactiveUi, id: str, kind: u32,
    properties: str, elapsed: f32,) ->() {
    let mut remaining = transition_trim(properties)
    while remaining != "" {
        let comma = transition_find(remaining, ",")
        let property = transition_trim(if comma < remaining.char_len() {
                remaining.slice(0_usize, comma)
            } else {
                remaining
            }
        )
        if property != "" && property != "none" {
            let _dispatched = ui.dispatch_event(id, UiEvent::transition(kind, id, property, elapsed))
        }
        if comma == remaining.char_len() {
            break
        }
        remaining = transition_trim(remaining.slice(comma + 1_usize,
                remaining.char_len() - comma - 1_usize,))
    }
    ret()
}

fn transition_duration_ms(values: str) -> u64 {
    let mut maximum = 0_i64
    let mut remaining = transition_trim(values)
    while remaining != "" {
        let comma = transition_find(remaining, ",")
        let value = transition_time_ms(transition_trim(if comma < remaining.char_len() {
                    remaining.slice(0_usize, comma)
                } else {
                    remaining
                }
            ))
        if value > maximum {
            maximum = value
        }
        if comma == remaining.char_len() {
            break
        }
        remaining = transition_trim(remaining.slice(comma + 1_usize,
                remaining.char_len() - comma - 1_usize,))
    }
    ret if maximum > 0_i64 {
        maximum as u64
    } else {
        0_u64
    }
}

fn transition_delay_ms(values: str) -> i64 {
    let comma = transition_find(values, ",")
    ret transition_time_ms(transition_trim(if comma < values.char_len() {
                values.slice(0_usize, comma)
            } else {
                values
            }
        ))
}

fn transition_easing(values: str) -> usize {
    let comma = transition_find(values, ",")
    let value = transition_trim(if comma < values.char_len() {
            values.slice(0_usize, comma)
        } else {
            values
        }
    )
    if value == "linear" {
        ret easing_linear()
    }
    if value == "ease-in" {
        ret easing_in()
    }
    if value == "ease-out" {
        ret easing_out()
    }
    if value == "ease-in-out" || value == "ease" {
        ret easing_in_out()
    }
    ret easing_in_out()
}

fn transition_time_ms(value: str) -> i64 {
    let input = transition_trim(value)
    let seconds = transition_ends_with(input, "s") && !transition_ends_with(input, "ms")
    let suffix = if seconds {
        1_usize
    } else {
        2_usize
    }
    if input.char_len() < suffix {
        ret 0_i64
    }
    let number = input.slice(0_usize, input.char_len() - suffix)
    let mut negative = false
    let mut result = 0.0_f32
    let mut fraction = 0.1_f32
    let mut decimal = false
    let mut index = 0_usize
    while index < number.char_len() {
        let character = number.slice(index, 1_usize)
        if character == "-" && index == 0_usize {
            negative = true
        } elif character == "." {
            decimal = true
        } else {
            let digit = transition_digit(character)
            if digit < 0_i32 {
                ret 0_i64
            }
            if decimal {
                result = result +(digit as f32) * fraction
                fraction = fraction * 0.1_f32
            } else {
                result = result * 10.0_f32 + digit as f32
            }
        }
        index += 1_usize
    }
    if seconds {
        result = result * 1000.0_f32
    }
    ret if negative {
        -(result as i64)
    } else {
        result as i64
    }
}

fn transition_digit(value: str) -> i32 {
    if value == "0" {
        ret 0_i32
    }
    if value == "1" {
        ret 1_i32
    }
    if value == "2" {
        ret 2_i32
    }
    if value == "3" {
        ret 3_i32
    }
    if value == "4" {
        ret 4_i32
    }
    if value == "5" {
        ret 5_i32
    }
    if value == "6" {
        ret 6_i32
    }
    if value == "7" {
        ret 7_i32
    }
    if value == "8" {
        ret 8_i32
    }
    if value == "9" {
        ret 9_i32
    }
    ret - 1_i32
}

fn transition_find(value: str, expected: str) -> usize {
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == expected {
            ret index
        }
        index += 1_usize
    }
    ret value.char_len()
}

fn transition_trim(value: str) -> str {
    let mut start = 0_usize
    let mut finish = value.char_len()
    while start < finish && transition_whitespace(value.slice(start, 1_usize)) {
        start += 1_usize
    }
    while finish > start && transition_whitespace(value.slice(finish - 1_usize, 1_usize)) {
        finish -= 1_usize
    }
    ret value.slice(start, finish - start)
}

fn transition_whitespace(value: str) -> bool {
    ret value == " " || value == "\n" || value == "\r" || value == "\t"
}

fn transition_ends_with(value: str, suffix: str) -> bool {
    ret value.char_len() >= suffix.char_len() &&
    value.slice(value.char_len() - suffix.char_len(), suffix.char_len()) == suffix
}

// Explicit CSS auto uses content; an unspecified basis keeps constructor geometry.
fn auto_content_extent(widget: Widget, horizontal_axis: bool) -> f32 {
    if widget.children().len() == 0 {
        let size = widget.max_content_size()
        if horizontal_axis && widget.kind() == widget_icon_button() && widget.text() != "" {
            let height = widget.resolved_height(0)
            let icon = if height > 0 && height < 36 {
                height - 14
            } else {
                22_f32
            }
            // Match the icon button's renderer: leading inset, icon, gap, caption.
            ret(widget.text().char_len() as f32) * widget.style().font_size() * 0.56_f32 + 10_f32 + icon + 9_f32 + 8_f32
        }
        ret if horizontal_axis {
            size.width()
        } else {
            size.height()
        }
    }
    let mut extent = 0_f32 let direction = widget.direction() == horizontal()
    let mut visible_children = 0_usize
    for child in widget.children() {
        if !child.style().layout().flex().displayed() || child.style().layout().position().absolute() {
            continue
        }
        visible_children += 1_usize
        let explicit = if horizontal_axis {
            child.resolved_width(0)
        } else {
            child.resolved_height(0)
        }
        let size = if explicit >= 0 {
            explicit
        } else {
            auto_content_extent(child, horizontal_axis)
        }
        let margin = child.style().layout().margin()
        let outer = size + if horizontal_axis {
            margin.left() + margin.right()
        } else {
            margin.top() + margin.bottom()
        }
        if direction == horizontal_axis {
            extent += outer
        } elif outer > extent {
            extent = outer
        }
    }
    if direction == horizontal_axis && visible_children > 1 {
        extent += widget.style().gap() *((visible_children - 1_usize) as f32)
    }
    let padding = widget.style().padding()
    ret extent + if horizontal_axis {
        padding.left() + padding.right() + widget.style().border_width() * 2
    } else {
        padding.top() + padding.bottom() + widget.style().border_width() * 2
    }
}
