        self.tag == other.tag && self.classes == other.classes &&
        self.checked == other.checked && self.focused == other.focused &&
        self.disabled == other.disabled &&(self.text == "") ==(other.text == "") &&
        self.children.len() == other.children.len() &&
        widget_attributes_equal(self.attributes, other.attributes)
