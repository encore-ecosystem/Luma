    #attr(borrowed_self)
    pub fn selector_signature(self: Self) -> str {
        let mut signature = self.tag + "|" + Debug::fmt(self.kind) + "|" + self.id + "|" +
        self.classes + "|" + Debug::fmt(self.checked) + "|" + Debug::fmt(self.focused) + "|" +
        Debug::fmt(self.disabled)
        for attribute in self.attributes {
            signature = signature + "|@" + attribute.name() + "=" + attribute.value()
        }
        ret signature
    }
    /// Cache signature restricted to attributes that can affect this stylesheet.
    #attr(borrowed_self)
    pub fn selector_signature_for_attributes(self: Self, names: Vec[str]) -> str {
        let mut signature = self.tag + "|" + Debug::fmt(self.kind) + "|" + self.id + "|" +
        self.classes + "|" + Debug::fmt(self.checked) + "|" + Debug::fmt(self.focused) + "|" +
        Debug::fmt(self.disabled)
        for attribute in self.attributes {
            for name in names {
                if name == attribute.name() {
                    signature = signature + "|@" + name + "=" + attribute.value()
                    break
                }
            }
        }
        ret signature
    }
