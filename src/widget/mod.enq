        if self.kind == widget_label() || self.kind == widget_rich_text() {
            ret Size::new((self.text.len() as f32) * 8.0_f32, self.basis)
        }
        if self.kind == widget_button() {
            ret Size::new((self.text.len() as f32) * 8.0_f32 + 24.0_f32, self.basis)
        }
        ret Size::new(self.basis, self.basis)
    }
    pub fn min_content_size(self: Self) -> Size {
        ret intrinsic_widget_size(self, false)
    }
    pub fn max_content_size(self: Self) -> Size {
