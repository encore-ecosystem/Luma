//! Retained 2D vector canvas. No renderer resources or application graph types.
import color::Color
import core::option::Option
import core::vec::Vec
import refrain::display::{DisplayCommand, DisplayList, DisplayPoint}
import refrain::geometry::{Point, Rect}

pub struct CanvasView {
    pan_x: f32
    pan_y: f32
    zoom: f32
}
pub struct CanvasItem {
    id: u64
    bounds: Rect
    display: DisplayList
    interactive: bool
}
pub struct CanvasScene {
    items: Vec[CanvasItem]
    background: Option[CanvasItem]
}
fn intersects(a: Rect, b: Rect) -> bool {
    ret a.x() <= b.right() && a.right() >= b.x() && a.y() <= b.bottom() && a.bottom() >= b.y()
}

impl for CanvasView {
    pub fn new() -> CanvasView {
        ret CanvasView { 0, 0, 1 }
    }
    pub fn scale(self: Self) -> f32 {
        ret self.zoom
    }
    pub fn pan(self: Self, dx: f32, dy: f32) -> CanvasView {
        ret CanvasView {
            self.pan_x + dx, self.pan_y + dy, self.zoom
        }
    }
    pub fn world(self: Self, x: f32, y: f32) -> Point {
        ret Point::new((x - self.pan_x) / self.zoom,(y - self.pan_y) / self.zoom)
    }
    pub fn project(self: Self, x: f32, y: f32, origin: Rect) -> Point {
        ret Point::new(origin.x() + self.pan_x + x * self.zoom, origin.y() + self.pan_y + y * self.zoom)
    }
    /// Zoom about the pointer, preserving its world-space anchor.
    pub fn zoom_at(self: Self, factor: f32, x: f32, y: f32) -> CanvasView {
        let candidate = self.zoom * factor
        let scale = if candidate < 0.001 {
            0.001_f32
        } elif candidate > 2.5 {
            2.5_f32
        } else {
            candidate
        }
        let anchor = self.world(x, y)
        ret CanvasView { x - anchor.x() * scale, y - anchor.y() * scale, scale }
    }
    pub fn project_rect(self: Self, bounds: Rect, origin: Rect) -> Rect {
        let point = self.project(bounds.x(), bounds.y(), origin)
        ret Rect::new(point.x(), point.y(), bounds.width() * self.zoom, bounds.height() * self.zoom)
    }
}

impl for CanvasView {
    /// Center world geometry in a local viewport without depending on UI layout.
    pub fn fit(self: Self, world: Rect, viewport: Rect, padding: f32) -> CanvasView {
        if viewport.width() <= padding * 2 || viewport.height() <= padding * 2 {
            ret self
        }
        let width = if world.width() > 1 {
            world.width()
        } else {
            1_f32
        }
        let height = if world.height() > 1 {
            world.height()
        } else {
            1_f32
        }
        let sx =(viewport.width() - padding * 2) / width
        let sy =(viewport.height() - padding * 2) / height
        let candidate = if sx < sy {
            sx
        } else {
            sy
        }
        let scale = if candidate > 1.25 {
            1.25_f32
        } elif candidate < 0.001 {
            0.001_f32
        } else {
            candidate
        }
        ret CanvasView {
            viewport.width() / 2 -(world.x() + width / 2) * scale,
            viewport.height() / 2 -(world.y() + height / 2) * scale, scale
        }
    }
}

impl for CanvasScene {
    pub fn new() -> CanvasScene {
        ret CanvasScene {
            Vec[CanvasItem]::new(), Option[CanvasItem]::None
        }
    }
    /// Background paint never participates in hit testing or retained item slots.
    pub fn with_background(self: Self, bounds: Rect, display: DisplayList) -> CanvasScene {
        ret CanvasScene {
            self.items, Option[CanvasItem]::Some(CanvasItem {
                    0, bounds, display, false
                }
                ,
            )
        }
    }
    /// Add transient selection/gesture paint without mutating retained items
    /// shared by the previous frame or rebuilding their vector geometry.
    pub fn with_overlay(self: Self, bounds: Rect, display: DisplayList) -> CanvasScene {
        let mut items = Vec[CanvasItem]::with_capacity(self.items.len() + 1)
        for item in self.items {
            items.push(item)
        }
        items.push(CanvasItem { 0, bounds, display, false })
        ret CanvasScene { items, self.background }
    }
    pub fn add(self: mut Self, id: u64, bounds: Rect, display: DisplayList, interactive: bool) ->() {
        self.items.push(CanvasItem { id, bounds, display, interactive })
    }
    pub fn len(self: Self) -> usize {
        ret self.items.len()
    }
    /// Slots remain stable while topology is unchanged. Never mutates old paint lists.
    pub fn update_item(self: mut Self, slot: usize, bounds: Rect, display: DisplayList) -> bool {
        match self.items.get(slot) {
            Some(item) => {
                self.items.set(slot, CanvasItem {
                        item.id, bounds, display, item.interactive
                    }
                    ,
                ) ret true
            }
            None => {
                ret false
            }
        }
    }
    pub fn hit(self: Self, view: CanvasView, x: f32, y: f32) -> Option[u64] {
        let world = view.world(x, y)
        let mut result = Option[u64]::None
        for item in self.items {
            if item.interactive && item.bounds.contains(world) {
                result = Option[u64]::Some(item.id)
            }
        }
        ret result
    }
    pub fn intersecting(self: Self, bounds: Rect) -> Vec[u64] {
        let mut ids = Vec[u64]::new()
        for item in self.items {
            if item.interactive && intersects(item.bounds, bounds) {
                ids.push(item.id)
            }
        }
        ret ids
    }
    pub fn visible_count(self: Self, view: CanvasView, bounds: Rect) -> usize {
        let mut count = 0_usize
        for item in self.items {
            if intersects(view.project_rect(item.bounds, bounds), bounds) {
                count += 1
            }
        }
        ret count
    }
    pub fn display(self: Self, view: CanvasView, bounds: Rect) -> DisplayList {
        let mut list = DisplayList::new()
        match self.background {
            Some(item) => {
                for command in item.display.commands() {
                    transform_command(list, command, view, bounds)
                }
            }
            None => {
            }
        }
        for item in self.items {
            if intersects(view.project_rect(item.bounds, bounds), bounds) {
                for command in item.display.commands() {
                    transform_command(list, command, view, bounds)
                }
            }
        }
        ret list
    }
}
fn transform_command(list: mut DisplayList, command: DisplayCommand, view: CanvasView, bounds: Rect) ->() {
    let scale = view.scale()
    match command {
        FillRect(item) => {
            list.fill_rect(view.project_rect(item.bounds(), bounds), item.color())
        }
        StrokeRect(item) => {
            list.stroke_rect(view.project_rect(item.bounds(), bounds), item.color())
        }
        RoundRect(item) => {
            list.round_rect(view.project_rect(item.bounds(), bounds), item.radius() * scale, item.color(), item.filled())
        }
        Line(item) => {
            let a = view.project(item.x0(), item.y0(), bounds) let b = view.project(item.x1(), item.y1(), bounds)
            list.line(a.x(), a.y(), b.x(), b.y(), item.width() * scale, item.color())
        }
        GradientLine(item) => {
            let a = view.project(item.x0(), item.y0(), bounds) let b = view.project(item.x1(), item.y1(), bounds)
            list.gradient_line(a.x(), a.y(), b.x(), b.y(), item.width() * scale, item.start_color(), item.end_color())
        }
        Svg(item) => {
            list.svg(view.project_rect(item.bounds(), bounds), item.document(), item.color(), item.stroke_width())
        }
        Text(item) => {
            let p = view.project(item.x(), item.y(), bounds) list.text(p.x(), p.y(), item.value(), item.color())
        }
        StyledText(item) => {
            let p = view.project(item.x(), item.y(), bounds)
            list.styled_text(p.x(), p.y(), item.value(), item.style().with_font_size(item.style().font_size() * scale))
        }
        Path(item) => {
            let mut points = Vec[DisplayPoint]::new()
            for point in item.points() {
                let p = view.project(point.x(), point.y(), bounds) points.push(DisplayPoint::new(p.x(), p.y()))
            }
            list.path(points, item.width() * scale, item.color(), item.closed())
        }
        Triangle(item) => {
            let a = view.project(item.a().x(), item.a().y(), bounds) let b = view.project(item.b().x(), item.b().y(), bounds) let c = view.project(item.c().x(), item.c().y(), bounds)
            list.triangle(DisplayPoint::new(a.x(), a.y()), DisplayPoint::new(b.x(), b.y()), DisplayPoint::new(c.x(), c.y()), item.color())
        }
        Clip(item) => {
            if item.enabled() {
                let rect = view.project_rect(item.bounds(), bounds)
                let x = if rect.x() > bounds.x() {
                    rect.x()
                } else {
                    bounds.x()
                }
                let y = if rect.y() > bounds.y() {
                    rect.y()
                } else {
                    bounds.y()
                }
                let right = if rect.right() < bounds.right() {
                    rect.right()
                } else {
                    bounds.right()
                }
                let bottom = if rect.bottom() < bounds.bottom() {
                    rect.bottom()
                } else {
                    bounds.bottom()
                }
                list.clip(Rect::new(x, y, if right > x {
                            right - x
                        } else {
                            0_f32
                        }
                        , if bottom > y {
                            bottom - y
                        } else {
                            0_f32
                        }
                        ,
                    ))
            } else {
                list.clip(bounds)
            }
        }
    }
}

/// Tessellate a wire when its endpoints change, not when the view pans.
pub fn canvas_cubic(a: DisplayPoint, b: DisplayPoint, c: DisplayPoint, d: DisplayPoint, steps: u32) -> Vec[DisplayPoint] {
    let count = if steps < 2 {
        2_u32
    } elif steps > 128 {
        128_u32
    } else {
        steps
    }
    let mut points = Vec[DisplayPoint]::new() let mut i = 0_u32
    while i <= count {
        let t = i as f32 / count as f32 let u = 1_f32 - t
        points.push(DisplayPoint::new(u * u * u * a.x() + 3 * u * u * t * b.x() + 3 * u * t * t * c.x() + t * t * t * d.x(), u * u * u * a.y() + 3 * u * u * t * b.y() + 3 * u * t * t * c.y() + t * t * t * d.y()))
        i += 1
    }
    ret points
}

/// World-aligned editor grid with bounded work at every canvas zoom.
pub fn canvas_grid(view: CanvasView, viewport: Rect, minor: Color, major: Color) -> DisplayList {
    let mut paint = DisplayList::new()
    if viewport.width() <= 0 || viewport.height() <= 0 {
        ret paint
    }
    let first = view.world(0, 0)
    let last = view.world(viewport.width(), viewport.height())
    let scale = view.scale()
    let mut step = 24_f32
    while step * scale < 16 {
        step *= 5
    }
    let mut column =(first.x() / step) as i64
    if (column as f32) * step < first.x() {
        column += 1
    }
    let mut row =(first.y() / step) as i64
    if (row as f32) * step < first.y() {
        row += 1
    }
    while (column as f32) * step <= last.x() {
        let x =(column as f32) * step
        paint.line(x, first.y(), x, last.y(), 1 / scale, if column % 5 == 0 {
                major
            } else {
                minor
            }
            ,
        )
        column += 1
    }
    while (row as f32) * step <= last.y() {
        let y =(row as f32) * step
        paint.line(first.x(), y, last.x(), y, 1 / scale, if row % 5 == 0 {
                major
            } else {
                minor
            }
            ,
        )
        row += 1
    }
    ret paint
}
