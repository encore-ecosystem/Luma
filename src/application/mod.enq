    }
    /// Sets the smallest logical client area accepted by the platform window.
    /// Window managers may choose a larger size to satisfy their own layout.
    pub fn set_minimum_size(self: Self, width: u32, height: u32) -> bool {
        ret self.handle != 0_usize && width > 0_u32 && height > 0_u32 &&
        native_set_window_minimum_size(self.handle, width, height)
    }
    /// Waits until an OS event arrives or the timeout expires, then returns
    /// the next coalesced event. This is the event-driven alternative to
    /// application-side polling and sleeping.
    pub fn wait(self: Self, timeout_ms: u32) -> Event {
        if self.handle == 0_usize {
            ret Event::none()
        }
        let _ready = native_wait(self.handle, timeout_ms)
        ret self.poll()
    }
    /// Sleeps until the operating system delivers an event. A low-frequency
    /// watchdog wake keeps signal-driven shutdown and future scheduler
    /// deadlines observable without a busy loop.
    pub fn wait_event(self: Self) -> Event {
        ret self.wait(1000_u32)
    }
    pub fn begin(self: Self, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        ret native_begin(self.handle, color.packed())
    }
    pub fn clipboard_text(self: Self) -> str {
        ret native_clipboard_text()
    }
    pub fn set_clipboard(self: Self, value: str) -> bool {
        ret native_clipboard_set(value)
    }
    pub fn fill_rect(self: Self, rect: Rect, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        ret native_fill_rect(self.handle, rect.x(), rect.y(), rect.width(), rect.height(), color.packed())
    }
    pub fn stroke_rect(self: Self, rect: Rect, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        ret native_stroke_rect(self.handle, rect.x(), rect.y(), rect.width(), rect.height(), color.packed())
    }
    pub fn line(self: Self, x0: f32, y0: f32, x1: f32, y1: f32, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        ret native_line(self.handle, x0, y0, x1, y1, color.packed())
    }
    pub fn svg(self: Self, bounds: Rect, document: SvgDocument, color: Color, stroke_width: f32) ->()
    {
        if self.handle != 0_usize {
            render_svg(self.handle, bounds, document, color, stroke_width)
        }
        ret()
    }
    pub fn text(self: Self, x: f32, y: f32, value: str, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        ret native_text(self.handle, x, y, value, color.packed())
    }
    pub fn load_font(self: Self, path: str, size: f32) -> bool {
        ret self.load_font_with_weight(path, size, 400_u32)
    }
    pub fn load_font_with_weight(self: Self, path: str, size: f32, weight: u32) -> bool {
        if self.handle == 0_usize || size <= 0.0_f32 {
            ret false
        }
        self.text_cache.clear()
        ret native_font_load(self.handle, path, size, weight)
    }
    pub fn register_font(self: Self, family: str, path: str) -> bool {
        if self.handle == 0_usize || family == "" || path == "" {
            ret false
        }
        self.text_cache.clear()
        ret native_font_register(self.handle, family, path)
    }
    pub fn select_font(self: Self, family: str, size: f32, weight: u32) -> bool {
        if self.handle == 0_usize || family == "" || size <= 0.0_f32 {
            ret false
        }
        ret native_font_select(self.handle, family, size, weight)
    }
    pub fn clear_font(self: Self) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        self.text_cache.clear()
        ret native_font_clear(self.handle)
    }
    pub fn text_width(self: Self, value: str) -> f32 {
        if self.handle == 0_usize {
            ret 0.0_f32
        }
        ret native_text_width(self.handle, value)
    }
    pub fn text_index(self: Self, value: str, width: f32) -> usize {
        if self.handle == 0_usize {
            ret 0_usize
        }
        ret native_text_index(self.handle, value, width)
    }
    /// Hit-tests the exact single-line input origin used by the renderer.
    pub fn input_text_index(self: Self, widget: Widget, bounds: Rect, value: str, cursor: usize, x: f32) -> usize {
        if self.handle == 0 {
            ret 0_usize
        }
        let style = widget.style()
        if style.font_family() == "" || !native_font_select(self.handle, style.font_family(), style.font_size(), style.font_weight()) {
            native_font_style(self.handle, style.font_size(), style.font_weight())
        }
        let aligned = aligned_text_x(self.handle, bounds, value, style.text_align(), 10_f32, 10_f32)
        let origin = focused_input_text_x(self.handle, bounds, value, cursor, aligned)
        ret native_text_index(self.handle, value, x - origin)
    }
    /// Hit-tests a textarea with the same font, text origin and scroll as painting.
    pub fn textarea_text_index(self: Self, widget: Widget, bounds: Rect, x: f32, y: f32) -> usize {
        if self.handle == 0_usize {
            ret 0_usize
        }
        let style = widget.style()
        if style.font_family() == "" || !native_font_select(self.handle, style.font_family(), style.font_size(), style.font_weight()) {
            native_font_style(self.handle, style.font_size(), style.font_weight())
        }
        let gutter = if widget.attribute("line-numbers").is_some() {
            52_f32
        } else {
            0_f32
        }
        let width = if widget.attribute("wrap").is_some() {
            1000000_f32
        } else {
            bounds.width() - 20_f32 - gutter
        }
        let lines = self.text_cache.lines(self.handle, widget, width)
        let height = native_text_height(self.handle, "Mg") + 2_f32
        let local_y = y - bounds.y() - 10_f32 + style.layout().scroll().y()
        let row = if local_y > 0_f32 {
            (local_y / height) as usize
        } else {
            0_usize
        }
        match lines.get(row) {
            Some(line) => {
                let local_x = x - bounds.x() - 10_f32 - gutter + style.layout().scroll().x()
                let count = if local_x < 16000_f32 && line.end - line.start > 8192_usize {
                    8192_usize
                } else {
                    line.end - line.start
                }
                let text = widget.text().slice(line.start, count)
                let at = line.start + native_text_index(self.handle, text, if local_x > 0_f32 {
                        local_x
                    } else {
                        0_f32
                    }
                    ,
                )
                ret if at > line.end {
                    line.end
                } else {
                    at
                }
            }
            None => {
                ret widget.text().char_len()
            }
        }
    }
    pub fn wrapped_text_index(self: Self, value: str, width: f32, x: f32, y: f32) -> usize {
        if self.handle == 0_usize {
            ret 0_usize
        }
        ret wrapped_text_index(self.handle, value, width, x, y)
    }
    pub fn text_height(self: Self, value: str) -> f32 {
        if self.handle == 0_usize {
            ret 0.0_f32
        }
        ret native_text_height(self.handle, value)
    }
    pub fn present(self: Self) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        ret native_end(self.handle)
    }
    /// Presentation availability: failed=0, ready=1, pending=2, suspended=3.
    /// Whether the next backend slot can accept a new producer frame.
    /// Event handling and layout remain available while the GPU is busy.
    pub fn render_frame_ready(self: Self) -> bool {
        ret native_frame_status(self.handle) != 3_u32 &&(self.direct_swapchain == 0_usize || native_swapchain_frame_ready(self.direct_swapchain))
    }
    pub fn frame_status(self: Self) -> u32 {
        ret native_frame_status(self.handle)
    }
    /// Replays a backend-independent display list through the renderer owned
    /// by this window. Vulkan and software backends share this entrypoint.
    pub fn draw_display_list(self: Self, list: DisplayList) -> bool {
        if self.handle == 0_usize || !native_begin(self.handle, self.background.packed()) {
            ret false
        }
        replay_display_commands(self.handle, list.commands(), Option[Rect]::None)
        ret native_end(self.handle)
    }
    /// Compiles the stable base segments into the backend cache. Overlay
    /// segments remain transient and are composed at presentation time.
    pub fn cache_retained_display_list(self: Self,
        retained: RetainedDisplayList,) -> bool {
        if self.handle == 0_usize ||
        !native_layout_cache_begin(self.handle, self.background.packed()) {
            ret false
        }
        for segment in retained.segments() {
            if !segment.overlay() {
                replay_display_commands(self.handle,
                    segment.commands(), Option[Rect]::None,)
            }
        }
        ret native_layout_cache_end(self.handle)
    }
    /// Applies only damaged base regions. Each patch replays intersecting
    /// segments in original paint order and keeps damage as the outer clip.
    pub fn commit_retained_display_list(self: Self,
        retained: RetainedDisplayList,) -> bool {
        if self.handle == 0_usize || !native_layout_cache_ready(self.handle) {
            ret false
        }
        let mut committed = true
        for damage in retained.damage() {
            if native_layout_cache_patch_begin(self.handle,
                self.background.packed(), damage.x(), damage.y(),
                damage.width(), damage.height(),) {
                for segment in retained.segments() {
                    if !segment.overlay() && segment.intersects(damage) {
                        replay_display_commands(self.handle,
                            segment.commands(), Option[Rect]::Some(damage),)
                    }
                }
                committed = native_layout_cache_end(self.handle) && committed
            } else {
                committed = false
            }
        }
        ret committed
    }
    /// Presents the cached base and transient overlay segments.
    pub fn present_retained_display_list(self: Self,
        retained: RetainedDisplayList,) -> bool {
        if self.handle == 0_usize ||
        !native_cached_frame_begin(self.handle, self.background.packed()) {
            ret false
        }
        for segment in retained.segments() {
            if segment.overlay() {
                replay_display_commands(self.handle,
                    segment.commands(), Option[Rect]::None,)
            }
        }
        ret native_end(self.handle)
    }
    pub fn draw(self: Self, root: Widget) -> WidgetLayout {
        let mut geometry = self.prepare_geometry()
        let mut layout = self.layout(root)
        while self.is_open() {
            if !self.draw_layout(layout) {
                ret layout
            }
            let current = self.prepare_geometry()
            if current.generation() == geometry.generation() &&
            current.pixel_width() == geometry.pixel_width() &&
            current.pixel_height() == geometry.pixel_height() {
                ret layout
            }
            // Mapping/configure is one authored-layout transaction, not a
            // stretched old image or a hidden/transparent pre-map buffer.
            geometry = current
            layout = self.layout(root)
        }
        ret layout
    }
    /// Creates a retained reactive tree, uploads its stable base frame to the
    /// renderer cache, and presents it. Subsequent paint-only updates should
    /// use `draw_reactive` instead of rebuilding the whole widget tree.
    pub fn reactive(self: Self, root: Widget) -> ReactiveUi {
        let layout = self.reactive_layout(root)
        let mut reactive = ReactiveUi::new(layout)
        reactive.set_widget_event_dispatch(self.widget_event_dispatch())
        if self.cache_layout(layout) {
            reactive.commit_prepared()
            if self.draw_cached_layout() {
                reactive.commit_rendered()
            }
        } else {
            // A backend without render-target support still gets one complete
            // first frame; it never exposes a technical or partial frame.
            if !self.draw_layout(layout) {
                reactive.replace_layout(layout)
            }
        }
        reactive.set_declarative_root(root)
        ret reactive
    }
    /// Binds one window root. Several roots can share subscriptions and storage.
    pub fn with_bindings(self: Self, bindings: UiBindings<H>, root: NodeId) -> Window {
        ret Window {
            self.handle, self.width, self.height, self.background,
            self.direct_context, self.direct_window, self.direct_device, self.direct_swapchain,
            self.direct_compositor, self.stylesheet, RetainedCascade::new(),
            Option[WindowBindings]::Some(WindowBindings { bindings, root }), self.text_cache, self.updates
        }
    }
    pub fn has_bindings(self: Self) -> bool {
        ret self.bindings.is_some()
    }
    /// Whether this window's registry requests per-widget callback dispatch.
    #attr(borrowed_self)
    pub fn widget_event_dispatch(self: Self) -> bool {
        ret match self.bindings {
            Some(owner) => owner.bindings.widget_event_dispatch() None => true
        }
    }
    /// A model-supplied authored focus target for this window's mounted root.
    #attr(borrowed_self)
    pub fn bound_declared_focus(self: Self) -> Option[str] {
        ret match self.bindings {
            Some(owner) => owner.bindings.declared_focus(owner.root) None => Option[str]::None
        }
    }
    pub fn has_pending_bindings(self: Self) -> bool {
        ret match self.bindings {
            Some(owner) => owner.bindings.has_pending_for(owner.root)
            None => false
        }
    }

    /// Custom event loops submit component descriptors to the same transaction
    /// as signal writes. The normal unbound compatibility path remains valid.
    pub fn stage_component(self: Self, reactive: mut ReactiveUi, id: str, widget: Widget) -> bool {
        match self.bindings {
            Some(owner) => {
                let tree = owner.bindings.tree()
                match tree.find(owner.root, id) {
                    Some(node) => {
                        ret owner.bindings.reconcile(node, widget)
                    }
                    None => {
                        ret false
                    }
                }
            }
            None => {
                ret reactive.stage_subtree(id, widget)
            }
        }
    }

    pub fn authored_widget(self: Self, reactive: mut ReactiveUi, id: str) -> Option[Widget] {
        match self.bindings {
            Some(owner) => {
                let tree = owner.bindings.tree()
                match tree.find(owner.root, id) {
                    Some(node) => {
                        ret tree.widget(node)
                    }
                    None => {
                        ret Option[Widget]::None
                    }
                }
            }
            None => {
                ret reactive.find_widget(id)
            }
        }
    }

    pub fn stage_text(self: Self, reactive: mut ReactiveUi, id: str, text: str) -> bool {
        match self.bindings {
            Some(owner) => {
                let tree = owner.bindings.tree()
                match tree.find(owner.root, id) {
                    Some(node) => {
                        ret tree.set_text(node, text)
                    }
                    None => {
                        ret false
                    }
                }
            }
            None => {
                ret reactive.patch_text(id, text)
            }
        }
    }

    /// One custom-loop frame boundary, shared by properties and interaction.
    pub fn stage_binding_frame(self: Self, reactive: mut ReactiveUi,
        hovered: str, active: str, focused: str, now_ms: u64,) -> ReactiveUi {
        let started = self.updates.begin()
        let before = self.updates.snapshot()
        let result = self.stage_binding_transaction(reactive, hovered, active, focused, now_ms)
        self.updates.finish_transaction(started, before)
        ret result
    }
    fn stage_binding_transaction(self: Self, reactive: mut ReactiveUi,
        hovered: str, active: str, focused: str, now_ms: u64,) -> ReactiveUi {
        reactive.set_interaction_ids(hovered, active, focused)
        reactive = self.stage_bindings(reactive)
        let cascade_valid = self.cascade.matches_root(reactive.declarative_root())
        if self.has_bindings() && cascade_valid && self.cascade.matches_interaction(self.stylesheet.revision(), hovered, active,
            focused, reactive.keyboard_focus(),) {
            ret reactive
        }
        if self.has_bindings() && cascade_valid {
            let css_started = self.updates.begin()
            let local = self.stylesheet.stage_interaction(hovered, active, focused,
                reactive.keyboard_focus(), self.cascade,)
            self.updates.finish(UiUpdateStage::SubtreeStyles, css_started, self.cascade.interaction_evaluations())
            if local {
                if self.patch_cascade_styles(reactive, now_ms) {
                    ret reactive
                }
                // Geometric transitions still use the ordinary animation path.
                let styled = self.resolve_styles(self.stylesheet(), reactive.declarative_root(),
                    hovered, active, focused, reactive.keyboard_focus(),)
                ret self.stage_animated_reactive(reactive, styled, now_ms)
            }
        }
        let styled = self.resolve_styles(self.stylesheet(), reactive.declarative_root(),
            hovered, active, focused, reactive.keyboard_focus(),)
        if self.patch_cascade_styles(reactive, now_ms) {
            ret reactive
        }
        ret self.stage_animated_reactive(reactive, styled, now_ms)
    }

    // This path is only used after authored data has been committed. A pure
    // interaction change must not reconcile content, closures, geometry or the
    // complete hit-test index again. Complex selectors still use the same cascade.
    fn patch_cascade_styles(self: Self, reactive: mut ReactiveUi, now_ms: u64) -> bool {
        let started = self.updates.begin()
        let patches = match self.cascade.style_patches() {
            Some(values) => values
            None => {
                self.updates.finish(UiUpdateStage::Reconcile, started, 0)
                ret false
            }
        }
        // Validate the complete batch before mutating any displayed state.
        for patch in patches {
            match reactive.find_widget(patch.id()) {
                Some(current) => {
                    if !current.style().layout_equivalent(patch.style()) {
                        self.updates.finish(UiUpdateStage::Reconcile, started, 0)
                        ret false
                    }
                }
                None => {
                    self.updates.finish(UiUpdateStage::Reconcile, started, 0)
                    ret false
                }
            }
        }
        for patch in patches {
            match reactive.find_widget(patch.id()) {
                Some(current) => {
                    let _updated = reactive.transition_widget(patch.id(),
                        current.with_computed_style(patch.style()).with_focus(patch.focused()), now_ms,)
                }
                None => {
                }
            }
        }
        self.updates.finish(UiUpdateStage::Reconcile, started, patches.len())
        ret true
    }

    /// Commits one complete property transaction without presentation. Simple
    /// data writes bypass CSS and reconciliation; selector/structure changes
    /// retain the complete CSS context, including :has and sibling selectors.
    pub fn stage_bindings(self: Self, reactive: mut ReactiveUi) -> ReactiveUi {
        let owner = match self.bindings {
            Some(value) => value
            None => {
                ret reactive
            }
        }
        let bindings = owner.bindings
        reactive.set_widget_event_dispatch(bindings.widget_event_dispatch())
        let root = owner.root
        let started = self.updates.begin()
        let _evaluated = bindings.flush()
        let tree = bindings.tree()
        let changes = tree.take_changes_for(root)
        self.updates.finish(UiUpdateStage::Bindings, started, changes.len())
        if changes.len() == 0 {
            ret reactive
        }
        let mut structural = !tree.contains(root)
        let mut selectors = false
        for change in changes {
            selectors = selectors ||(change.flags() & dirty_style()) != 0
            if (change.flags() & dirty_structure()) != 0 {
                structural = true
            }
        }
        if (structural || selectors) && tree.contains(root) && self.stage_binding_subtrees(reactive, owner, changes) {
            let _committed = bindings.commit_authored_view_for(root, reactive.declarative_root())
            ret reactive
        }
        if structural {
            let authored = tree.snapshot(root).unwrap_or(Widget::panel(reactive.declarative_root().id()))
            let _committed = bindings.commit_authored_view_for(root, authored)
            ret self.stage_reactive_view(reactive, authored, self.stylesheet(),
                reactive.hovered_id(), reactive.active_id(), reactive.focused_id(), perf_counter_ms(),)
        }
        let mut style_changed = false
        let mut layout_changed = false
        let mut geometry_only = true
        let mut geometry_paths = Vec[Vec[usize]]::new()
        for change in changes {
            geometry_only = geometry_only &&(change.flags() & dirty_geometry()) != 0 &&
            (change.flags() &(dirty_style() | dirty_structure() | dirty_computed_style())) == 0
            match tree.path(root, change.node()) {
                Some(indices) => {
                    match tree.widget(change.node()) {
                        Some(local) => {
                            if (change.flags() & dirty_geometry()) != 0 &&
                            (change.flags() &(dirty_style() | dirty_computed_style())) == 0 {
                                let _patched = reactive.patch_bound_geometry(indices, local)
                                if !self.cascade.adopt_geometry(indices, local) {
                                    style_changed = true
                                    geometry_only = false
                                }
                                geometry_paths.push(indices)
                                layout_changed = true
                                continue
                            }
                            let computed = if (change.flags() & dirty_computed_style()) != 0 {
                                tree.computed_style(change.node())
                            } else {
                                Option[Style]::None
                            }
                            let needs_layout =(change.flags() & dirty_layout()) != 0 &&
                            ((change.flags() & dirty_geometry()) != 0 ||
                                computed.is_some() || reactive.bound_content_needs_layout(indices, local))
                            if (change.flags() & dirty_geometry()) != 0 {
                                let _adopted = self.cascade.adopt_geometry(indices, local)
                            }
                            let _patched = reactive.patch_bound_node(indices, local, computed,(change.flags() & dirty_paint()) != 0)
                            style_changed = style_changed ||(change.flags() & dirty_style()) != 0
                            layout_changed = layout_changed || needs_layout
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
        }
        if style_changed {
            let now = perf_counter_ms()
            let styled = self.resolve_styles(self.stylesheet(), reactive.declarative_root(),
                reactive.hovered_id(), reactive.active_id(), reactive.focused_id(), reactive.keyboard_focus(),)
            if !self.patch_cascade_styles(reactive, now) {
                reactive = self.stage_animated_reactive(reactive, styled, now)
            }
        }
        if layout_changed {
            if !geometry_only || !reactive.reflow_bound_geometry(geometry_paths) {
                reactive = self.stage_relayout_reactive(reactive)
            }
        }
        let _committed = bindings.commit_authored_view_for(root, reactive.declarative_root())
        ret reactive
    }

    // Coalesce dirty descendants under the highest changed source node. Do
    // not snapshot unrelated siblings merely to discover they are unchanged.
    fn stage_binding_subtrees(self: Self, reactive: mut ReactiveUi, owner: WindowBindings,
        changes: Vec[NodeChange],) -> bool {
        if !self.cascade.matches_root(reactive.declarative_root()) {
            ret false
        }
        let tree = owner.bindings.tree()
        let mut roots = Vec[BindingBranch]::new()
        for change in changes {
            if (change.flags() & dirty_computed_style()) != 0 {
                ret false
            }
            // Content-only siblings do not belong to the CSS/layout island.
            // Including them here turns a local popup update plus a fixed-box
            // label write into a full-window cascade.
            if (change.flags() &(dirty_structure() | dirty_style())) == 0 {
                continue
            }
            let mut cursor = change.node()
            let mut island = Option[NodeId]::None
            let mut named = Option[NodeId]::None
            loop {
                if cursor.same(owner.root) {
                    break
                }
                let id = tree.identifier(cursor)
                if named.is_none() && id != "" && reactive.contains_widget(id) {
                    named = Option[NodeId]::Some(cursor)
                }
                if reactive.independent_component(id) {
                    island = Option[NodeId]::Some(cursor)
                }
                match tree.parent(cursor) {
                    Some(parent) => {
                        cursor = parent
                    }
                    None => {
                        break
                    }
                }
            }
            // Nested absolute boxes can resize when their content changes.
            // Their outer island owns that positioning/layout dependency.
            let selected = match island {
                Some(node) => node
                None => match named {
                    Some(node) => node
                    None => {
                        ret false
                    }
                }
            }
            let path = match tree.path(owner.root, selected) {
                Some(value) => value
                None => {
                    ret false
                }
            }
            let mut covered = false
            for branch in roots {
                covered = covered || binding_path_contains(branch.path, path)
            }
            if covered {
                continue
            }
            let mut next = Vec[BindingBranch]::new()
            for branch in roots {
                if !binding_path_contains(path, branch.path) {
                    next.push(branch)
                }
            }
            next.push(BindingBranch { selected, path })
            roots = next
        }
        let trace = env("LUMA_TRACE_UI").unwrap_or("") == "1"
        let started = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        let mut patches = Vec[StyledBindingBranch]::new()
        let mut evaluated = 0_usize
        let cache_hits = if trace {
            self.stylesheet.cache_hits()
        } else {
            0_u64
        }
        let cache_misses = if trace {
            self.stylesheet.cache_misses()
        } else {
            0_u64
        }
        for branch in roots {
            let authored = match tree.snapshot(branch.node) {
                Some(value) => value
                None => {
                    ret false
                }
            }
            let css_started = self.updates.begin()
            let resolved = self.stylesheet.apply_retained_subtree(branch.path, authored, self.cascade)
            self.updates.finish(UiUpdateStage::SubtreeStyles, css_started, if resolved.is_some() {
                    self.cascade.interaction_evaluations()
                } else {
                    0_usize
                }
                ,
            )
            let styled = match resolved {
                Some(value) => value
                None => {
                    ret false
                }
            }
            evaluated += self.cascade.interaction_evaluations()
            if !reactive.can_commit_styled_subtree(styled) {
                ret false
            }
            patches.push(StyledBindingBranch { branch.path, authored, styled })
        }
        let css_at = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        let reconcile_started = self.updates.begin()
        for patch in patches {
            if !reactive.commit_styled_subtree(patch.path, patch.authored, patch.styled) {
                ret false
            }
        }
        self.updates.finish(UiUpdateStage::Reconcile, reconcile_started, patches.len())
        // Island snapshots already include their changed descendants. Apply
        // independent property writes outside them in the same transaction;
        // never lose these writes when the local structural batch succeeds.
        let mut layout_changed = false
        for change in changes {
            match tree.path(owner.root, change.node()) {
                Some(indices) => {
                    let mut covered = false
                    for branch in roots {
                        covered = covered || binding_path_contains(branch.path, indices)
                    }
                    if covered {
                        continue
                    }
                    match tree.widget(change.node()) {
                        Some(local) => {
                            if (change.flags() & dirty_geometry()) != 0 &&
                            (change.flags() &(dirty_style() | dirty_computed_style())) == 0 {
                                let _geometry = reactive.patch_bound_geometry(indices, local)
                                let _adopted = self.cascade.adopt_geometry(indices, local)
                                layout_changed = true
                                continue
                            }
                            let needs_layout =(change.flags() & dirty_layout()) != 0 && reactive.bound_content_needs_layout(indices, local)
                            if trace && needs_layout {
                                eprintln(f"LUMA_UI_LAYOUT id={local.id()} flags={change.flags()}")
                            }
                            layout_changed = layout_changed || needs_layout
                            let _patched = reactive.patch_bound_node(indices, local,
                                Option[Style]::None,(change.flags() & dirty_paint()) != 0,)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
        }
        if layout_changed {
            reactive.replace_layout(self.relayout(reactive.layout()))
        }
        if trace {
            eprintln(f"LUMA_UI_SUBTREE css_us={(css_at-started)/1000} layout_us={(perf_counter_ns()-css_at)/1000} roots={patches.len()} evaluated={evaluated} hits={self.stylesheet.cache_hits()-cache_hits} misses={self.stylesheet.cache_misses()-cache_misses}")
        }
        ret true
    }

    /// Flushes pending subtree layout work, commits only dirty widgets into
    /// the cached frame, and presents the result.
    pub fn draw_reactive(self: Self, reactive: mut ReactiveUi) -> ReactiveUi {
        reactive = self.stage_bindings(reactive)
        if reactive.needs_structure() {
            // A pending structural replacement is not a complete frame.
            ret reactive
        }
        if reactive.needs_layout() && !reactive.flush_layout() {
            ret reactive
        }
        if reactive.needs_full_repaint() || !native_layout_cache_ready(self.handle) {
            if self.cache_layout(reactive.layout()) {
                reactive.commit_prepared()
                if self.draw_cached_layout() {
                    reactive.clear_paint()
                }
            } else {
                if self.draw_layout(reactive.layout()) {
                    reactive.clear_paint()
                }
            }
            ret reactive
        }
        let targets = reactive.paint_targets()
        let mut cache_valid = true
        if targets.len() > 0_usize {
            let committed = self.commit_cached_layout_regions(reactive.layout(), reactive.paint_regions())
            if !committed {
                cache_valid = false
            }
        }
        if cache_valid {
            reactive.commit_prepared()
            if self.draw_cached_layout() {
                reactive.clear_paint()
            }
        } else {
            if self.cache_layout(reactive.layout()) {
                reactive.commit_prepared()
                if self.draw_cached_layout() {
                    reactive.clear_paint()
                }
            }
        }
        ret reactive
    }
    /// Advances retained CSS transitions for custom event loops and presents
    /// the smallest resulting paint/layout update.
    pub fn advance_transitions(self: Self, reactive: mut ReactiveUi,
        now_ms: u64,) -> ReactiveUi {
        if reactive.advance_transitions(now_ms) {
            ret self.draw_reactive(reactive)
        }
        ret reactive
    }
    /// Stages pseudo-class changes through the same cascade and animation
    /// transaction as model updates, including ancestor and sibling selectors.
    pub fn patch_interaction_style(self: Self, reactive: mut ReactiveUi,
        sheet: StyleSheet, id: str, hovered: bool, active: bool, focused: bool,) -> bool {
        if id == "" || reactive.find_widget(id).is_none() {
            ret false
        }
        reactive.set_interaction_state(id, hovered, active, focused)
        let styled = self.resolve_styles(sheet, reactive.declarative_root(), reactive.hovered_id(),
            reactive.active_id(), reactive.focused_id(), reactive.keyboard_focus(),)
        reactive = self.stage_animated_reactive(reactive, styled, perf_counter_ms())
        ret true
    }
    /// Stages a new authored tree and resolves its complete CSS context before
    /// reconciling retained nodes. Custom loops and managed applications use
    /// the same model/interaction/animation transaction.
    pub fn stage_reactive_view(self: Self, reactive: mut ReactiveUi, root: Widget,
        sheet: StyleSheet, hovered: str, active: str, focused: str,
        now_ms: u64,) -> ReactiveUi {
        reactive.set_interaction_ids(hovered, active, focused)
        reactive.set_declarative_root(root)
        let trace = env("LUMA_TRACE_UI").unwrap_or("") == "1"
        let started = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        let styled = self.resolve_styles(sheet, root, hovered, active, focused, reactive.keyboard_focus())
        let styled_at = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        reactive = self.stage_animated_reactive(reactive, styled, now_ms)
        if trace {
            eprintln(f"LUMA_UI css_us={(styled_at-started)/1000} reconcile_us={(perf_counter_ns()-styled_at)/1000}")
        }
        ret reactive
    }
    /// Reflows a retained reactive tree after a window resize, rebuilds the
    /// cached frame, and presents it.
    pub fn relayout_reactive(self: Self, reactive: mut ReactiveUi) -> ReactiveUi {
        reactive = self.stage_relayout_reactive(reactive)
        ret self.draw_reactive(reactive)
    }
    /// Stages resize/scroll geometry without submitting an intermediate frame.
    pub fn stage_relayout_reactive(self: Self, reactive: mut ReactiveUi) -> ReactiveUi {
        reactive.replace_layout(self.relayout(reactive.layout()))
        ret reactive
    }
    /// Stages a resize as one layout transaction. Reconciliation at the old
    /// extent would rebuild hit paths and paint damage only to discard them.
    /// Keep authored updates, scroll offsets and running transitions, but lay
    /// out their displayed state directly at the current window dimensions.
    pub fn stage_resized_reactive(self: Self, reactive: mut ReactiveUi,
        root: Widget, sheet: StyleSheet, hovered: str, active: str,
        focused: str, now_ms: u64,) -> ReactiveUi {
        reactive = self.stage_bindings(reactive)
        let authored = if self.has_bindings() {
            reactive.declarative_root()
        } else {
            root
        }
        let trace = env("LUMA_TRACE_RESIZE").unwrap_or("") == "1"
        let t0 = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        reactive.set_interaction_ids(hovered, active, focused)
        reactive.set_declarative_root(authored)
        let styled = self.resolve_styles(sheet, authored, hovered, active, focused,
            reactive.keyboard_focus(),)
        let t1 = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        let target = reactive.preserve_scroll_offsets(styled)
        if reactive.style_targets_unchanged(target) {
            let t2 = if trace {
                perf_counter_ns()
            } else {
                0_u64
            }
            let layout = layout_widget(target,
                Rect::new(0.0, 0.0, self.width() as f32, self.height() as f32),)
            let t3 = if trace {
                perf_counter_ns()
            } else {
                0_u64
            }
            reactive.replace_layout(layout)
            if trace {
                eprintln(f"LUMA_RESIZE css_us={(t1-t0)/1000} compare_us={(t2-t1)/1000} layout_us={(t3-t2)/1000} paths_us={(perf_counter_ns()-t3)/1000}")
            }
            ret reactive
        }
        reactive.prune_transitions(target, now_ms)
        let displayed = reactive.prepare_style_targets(target)
        let t2 = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        reactive.replace_layout(layout_widget(displayed,
                Rect::new(0.0_f32, 0.0_f32, self.width() as f32, self.height() as f32),))
        let t3 = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        reactive.apply_style_targets(target, now_ms)
        if trace {
            eprintln(f"LUMA_RESIZE css_us={(t1-t0)/1000} targets_us={(t2-t1)/1000} layout_us={(t3-t2)/1000} apply_us={(perf_counter_ns()-t3)/1000}")
        }
        ret reactive
    }
    /// Reconciles a computed-style tree without presenting. Managed input,
    /// animation and model updates share this transaction before one commit.
    pub fn stage_styled_reactive(self: Self, reactive: mut ReactiveUi,
        root: Widget,) -> ReactiveUi {
        let reconcile_started = self.updates.begin()
        let changed = reactive.reconcile_styled(root)
        self.updates.finish(UiUpdateStage::Reconcile, reconcile_started, 1)
        if changed >= 2_u32 {
            let layout_started = self.updates.begin()
            reactive.replace_layout(layout_widget(root,
                    Rect::new(0.0_f32, 0.0_f32, self.width() as f32, self.height() as f32),))
            self.updates.finish(UiUpdateStage::Layout, layout_started, 1)
        }
        ret reactive
    }
    /// Stages model data and CSS targets without resetting displayed animations.
    pub fn stage_animated_reactive(self: Self, reactive: mut ReactiveUi,
        root: Widget, now_ms: u64,) -> ReactiveUi {
        let target = reactive.preserve_scroll_offsets(root)
        if !reactive.needs_animation_transaction(target) {
            ret self.stage_styled_reactive(reactive, target)
        }
        if !reactive.has_active_transitions() && reactive.refresh_unchanged(target) {
            ret reactive
        }
        reactive.prune_transitions(target, now_ms)
        let displayed = reactive.prepare_style_targets(target)
        reactive = self.stage_styled_reactive(reactive, displayed)
        reactive.apply_style_targets(target, now_ms)
        ret reactive
    }
    /// Replaces the complete root after a structural state change and rebuilds
    /// the retained cache while preserving the caller's `ReactiveUi` value.
    pub fn rebuild_reactive(self: Self, reactive: mut ReactiveUi, root: Widget) -> ReactiveUi {
        let hovered = reactive.hovered_id()
        let active = reactive.active_id()
        let focused = reactive.focused_id()
        reactive = self.stage_reactive_view(reactive, root, self.stylesheet(),
            hovered, active, focused,
            perf_counter_ms(),)
        reactive.replace_layout(self.relayout(reactive.layout()))
        ret self.draw_reactive(reactive)
    }
    /// Reconciles a new declarative tree and automatically chooses paint,
    /// layout, or structural work.
    pub fn update_reactive(self: Self, reactive: mut ReactiveUi,
        root: Widget,) -> ReactiveUi {
        let hovered = reactive.hovered_id()
        let active = reactive.active_id()
        let focused = reactive.focused_id()
        reactive = self.stage_reactive_view(reactive, root, self.stylesheet(),
            hovered, active, focused,
            perf_counter_ms(),)
        if reactive.is_dirty() {
            ret self.draw_reactive(reactive)
        }
        ret reactive
    }
    /// Applies a new styled tree while preserving geometry, invalidates the
    /// requested stable widget IDs, and commits only their screen regions.
    pub fn restyle_reactive(self: Self, reactive: mut ReactiveUi, root: Widget,
        targets: Vec[str],) -> ReactiveUi {
        if targets.len() == 0_usize {
            ret reactive
        }
        let mut authored = reactive.declarative_root()
        let mut found = false
        for id in targets {
            match root.find(id) {
                Option[Widget]::Some(replacement) => {
                    authored = authored.replace_by_id(id, replacement)
                    found = true
                }
                Option[Widget]::None => {
                }
            }
        }
        if !found {
            ret reactive
        }
        let hovered = reactive.hovered_id()
        let active = reactive.active_id()
        let focused = reactive.focused_id()
        reactive = self.stage_reactive_view(reactive, authored, self.stylesheet(),
            hovered, active, focused,
            perf_counter_ms(),)
        if !reactive.is_dirty() {
            ret reactive
        }
        ret self.draw_reactive(reactive)
    }
    /// One-shot layout never replaces the reactive tree's retained CSS state.
    /// Loading screens, previews and temporary frames use this path.
    pub fn layout(self: Self, root: Widget) -> WidgetLayout {
        let geometry = self.prepare_geometry()
        ret layout_widget(self.stylesheet.apply_with_focus_visibility(root, "", "", "", true),
            Rect::new(0.0_f32, 0.0_f32, geometry.width() as f32, geometry.height() as f32),)
    }
    /// Prepares a retained UI without presenting, for custom window/render loops.
    pub fn reactive_layout(self: Self, root: Widget) -> WidgetLayout {
        let geometry = self.prepare_geometry()
        ret layout_widget(self.resolve_styles(self.stylesheet(), root, "", "", "", true),
            Rect::new(0.0_f32, 0.0_f32, geometry.width() as f32, geometry.height() as f32),)
    }
    /// Reflows the current retained tree for new window bounds without asking
    /// application code to construct the widget tree again.
    pub fn relayout(self: Self, layout: WidgetLayout) -> WidgetLayout {
        let started = self.updates.begin()
        let result = layout_widget(layout.retained_widget(),
            Rect::new(0.0_f32, 0.0_f32, self.width() as f32, self.height() as f32),)
        self.updates.finish(UiUpdateStage::Layout, started, 1)
        ret result
    }
    pub fn restyle_layout(self: Self, layout: WidgetLayout, root: Widget) -> WidgetLayout {
        ret layout.restyle(self.style_view(root, "", "", ""))
    }
    /// Captures render-surface geometry and DPI for one immutable frame
    /// transaction. Producers must render against the returned slot rather
    /// than querying layout and window metrics independently.
    pub fn prepare_frame(self: Self, layout: WidgetLayout, cached: bool) -> PreparedFrame {
        let geometry = self.prepare_geometry()
        let density = geometry.density()
        let logical_width = geometry.width()
        let logical_height = geometry.height()
        let scale_x = if logical_width == 0_u32 {
            density
        } else {
            (geometry.pixel_width() as f32) /(logical_width as f32)
        }
        let scale_y = if logical_height == 0_u32 {
            density
        } else {
            (geometry.pixel_height() as f32) /(logical_height as f32)
        }
        let mut surfaces = Vec[SurfaceSlot]::new()
        collect_surface_slots(layout, scale_x, scale_y, density, surfaces)
        ret PreparedFrame {
            layout, cached, surfaces, Vec[SurfaceSubmission]::new(),
            Vec[str]::new(), Vec[WidgetLayout]::new(), false, geometry, Vec[DisplayOverlay]::new(), Vec[UiLayerSubmission]::new()
        }
    }
    /// Captures one named surface through the retained index. Geometry and
    /// clipping follow the current transaction without walking unrelated UI.
    pub fn surface_slot(self: Self, reactive: mut ReactiveUi, id: str) -> Option[SurfaceSlot] {
        let layout = match reactive.find_layout(id) {
            Some(value) => value None => {
                ret Option[SurfaceSlot]::None
            }
        }
        if layout.widget().kind() != widget_render_surface() {
            ret Option[SurfaceSlot]::None
        }
        let geometry = self.prepare_geometry()
        let density = geometry.density()
        let scale_x = if geometry.width() == 0 {
            density
        } else {
            geometry.pixel_width() as f32 / geometry.width() as f32
        }
        let scale_y = if geometry.height() == 0 {
            density
        } else {
            geometry.pixel_height() as f32 / geometry.height() as f32
        }
        let mut slots = Vec[SurfaceSlot]::new()
        collect_surface_slots_clipped(layout, scale_x, scale_y, density,
            reactive.clip_for(id), slots,)
        for slot in slots {
            if slot.id() == id {
                ret Option[SurfaceSlot]::Some(slot)
            }
        }
        ret Option[SurfaceSlot]::None
    }
    /// Prepares a frame from geometry captured by an earlier layout
    /// transaction. Interactive producers should retain their slot and use
    /// this path until relayout or DPI change invalidates its generation.
    pub fn prepare_frame_with_surface(self: Self, layout: WidgetLayout,
        cached: bool, surface: SurfaceSlot,) -> PreparedFrame {
        let mut surfaces = Vec[SurfaceSlot]::new()
        surfaces.push(surface)
        ret PreparedFrame {
            layout, cached, surfaces, Vec[SurfaceSubmission]::new(),
            Vec[str]::new(), Vec[WidgetLayout]::new(), false, self.prepare_geometry(), Vec[DisplayOverlay]::new(), Vec[UiLayerSubmission]::new()
        }
    }
    /// Captures explicitly indexed surfaces from the same retained layout transaction.
    pub fn prepare_frame_with_surfaces(self: Self, layout: WidgetLayout,
        cached: bool, surfaces: Vec[SurfaceSlot],) -> PreparedFrame {
        ret PreparedFrame {
            layout, cached, surfaces, Vec[SurfaceSubmission]::new(),
            Vec[str]::new(), Vec[WidgetLayout]::new(), false, self.prepare_geometry(), Vec[DisplayOverlay]::new(), Vec[UiLayerSubmission]::new()
        }
    }
    /// Lightweight packet for an already retained GPU base. Named layout lookups
    /// are intentionally absent: attach canvases by bounds and overlays by layout
    /// or display list. The large retained widget graph stays UI-owned.
    pub fn prepare_cached_surface_frame(self: Self, bounds: Rect,
        surfaces: Vec[SurfaceSlot],) -> PreparedFrame {
        let packet_root = layout_widget(Widget::panel("cached-surface-packet"), bounds)
        ret self.prepare_frame_with_surfaces(packet_root, true, surfaces)
    }
    /// Scalar form of `prepare_frame_with_surface`, useful for language
    /// frontends that cannot safely retain an owned layout-node aggregate.
    pub fn prepare_frame_with_surface_extent(self: Self, layout: WidgetLayout,
        cached: bool, id: str, pixel_x: u32, pixel_y: u32,
        pixel_width: u32, pixel_height: u32, density: f32,
        generation: u64,) -> PreparedFrame {
        let logical_density = if density <= 0.0_f32 {
            1.0_f32
        } else {
            density
        }
        let slot = SurfaceSlot {
            id,
            Rect::new((pixel_x as f32) / logical_density,
                (pixel_y as f32) / logical_density,
                (pixel_width as f32) / logical_density,
                (pixel_height as f32) / logical_density,),
            pixel_x, pixel_y, pixel_width, pixel_height, logical_density,
            generation, Option[Rect]::None
        }
        ret self.prepare_frame_with_surface(layout, cached, slot)
    }
    /// Builds the retained base for a prepared frame. Render surfaces and
    /// transient overlays are excluded automatically.
    pub fn cache_prepared_frame(self: Self, frame: PreparedFrame) -> bool {
        let mut excluded = Vec[str]::new()
        for slot in frame.surfaces {
            excluded.push(slot.id)
        }
        for overlay in frame.overlays {
            excluded.push(overlay)
        }
        ret self.cache_layout_excluding(frame.layout, excluded)
    }
    /// Presents only a complete prepared transaction. A missing, stale or
    /// incorrectly sized producer image leaves the previous complete frame on
    /// screen instead of exposing mixed resize generations.
    /// Reuses one prepared UI transaction while an external producer advances
    /// independently. Geometry and surface generations are validated normally;
    /// this does not run bindings, layout, or simulation for intermediate images.
    pub fn present_external_update(self: Self, frame: PreparedFrame, id: str,
        generation: u64, image: ExternalVulkanImage,) -> bool {
        let mut next = frame
        if !next.submit_external(id, generation, image) {
            ret false
        }
        ret self.present_prepared(next)
    }
    pub fn present_prepared(self: Self, frame: PreparedFrame) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        let current = self.prepare_geometry()
        let bounds = frame.layout.bounds()
        if !current.valid() || current.generation() != frame.geometry.generation() ||
        current.pixel_width() != frame.geometry.pixel_width() ||
        current.pixel_height() != frame.geometry.pixel_height() ||
        bounds.width() != current.width() as f32 || bounds.height() != current.height() as f32 {
            native_backend_set_error("Prepared frame rejected: stale window geometry or layout bounds")
            ret false
        }
        for slot in frame.surfaces {
            let mut matched = false
            for submission in frame.submissions {
                if submission.id == slot.id &&
                submission.generation == slot.generation &&
                submission.image.content_width() == slot.pixel_width &&
                submission.image.content_height() == slot.pixel_height {
                    matched = true
                }
            }
            if !matched {
                native_backend_set_error("Prepared frame rejected: missing or stale surface " + slot.id)
                ret false
            }
        }
        let begun = if frame.cached {
            native_cached_frame_begin(self.handle, self.background.packed())
        } else {
            native_begin(self.handle, self.background.packed())
        }
        if !begun {
            ret false
        }
        if !frame.cached {
            let mut excluded = frame.overlays
            for slot in frame.surfaces {
                excluded.push(slot.id)
            }
            render_layout_filtered(self.handle, self.text_cache, frame.layout,
                Option[Rect]::None, excluded,)
        }
        for slot in frame.surfaces {
            for submission in frame.submissions {
                if submission.id == slot.id &&
                submission.generation == slot.generation {
                    if !self.bind_external_vulkan_image(submission.image) {
                        let _ended = native_end(self.handle)
                        ret false
                    }
                    let bounds = slot.logical_bounds
                    apply_clip(self.handle, slot.clip)
                    if !native_external_image_draw(self.handle, bounds.x(), bounds.y(),
                        bounds.width(), bounds.height(),) {
                        apply_clip(self.handle, Option[Rect]::None)
                        let _ended = native_end(self.handle)
                        ret false
                    }
                    apply_clip(self.handle, Option[Rect]::None)
                }
            }
        }
        replay_display_overlays(self.handle, frame.display_overlays, false)
        if frame.cached_overlays {
            let _overlay = native_overlay_cache_draw(self.handle)
        } elif frame.overlay_layouts.len() > 0_usize {
            for overlay in frame.overlay_layouts {
                render_layout(self.handle, self.text_cache, overlay, Option[Rect]::None)
            }
        } else {
            for overlay in frame.overlays {
                let _drawn = render_layout_target(self.handle, self.text_cache, frame.layout,
                    overlay, Option[Rect]::None,)
            }
        }
        for layer in frame.ui_layers {
            render_layout(self.handle, self.text_cache, layer.layout, Option[Rect]::Some(layer.clip))
        }
        replay_display_overlays(self.handle, frame.display_overlays, true)
        ret native_end(self.handle)
    }
    /// Records the retained UI transaction and lends Graphene the active
    /// direct-Vulkan command buffer. The viewport pass is recorded by the
    /// borrower; Luma later appends these UI batches and remains the sole
    /// submit/present owner.
    pub fn begin_vulkan_frame(self: Self, frame: PreparedFrame) -> VulkanFrameInterop {
        if self.handle == 0_usize || self.direct_swapchain == 0_usize ||
        self.direct_compositor == 0_usize {
            ret VulkanFrameInterop::new(0_usize, 0_usize, 0_u32, 0_u32)
        }
        let begun = if frame.cached {
            native_cached_frame_begin(self.handle, self.background.packed())
        } else {
            native_begin(self.handle, self.background.packed())
        }
        if !begun {
            ret VulkanFrameInterop::new(0_usize, 0_usize, 0_u32, 0_u32)
        }
        if !frame.cached {
            let mut excluded = frame.overlays
            for slot in frame.surfaces {
                excluded.push(slot.id)
            }
            render_layout_filtered(self.handle, self.text_cache, frame.layout,
                Option[Rect]::None, excluded,)
        }
        if !native_direct_composition_split(self.handle) {
            ret VulkanFrameInterop::new(0_usize, 0_usize, 0_u32, 0_u32)
        }
        replay_display_overlays(self.handle, frame.display_overlays, false)
        if frame.cached_overlays {
            let _overlay = native_overlay_cache_draw(self.handle)
        } elif frame.overlay_layouts.len() > 0_usize {
            for overlay in frame.overlay_layouts {
                render_layout(self.handle, self.text_cache, overlay, Option[Rect]::None)
            }
        } else {
            for overlay in frame.overlays {
                let _drawn = render_layout_target(self.handle, self.text_cache, frame.layout,
                    overlay, Option[Rect]::None,)
            }
        }
        for layer in frame.ui_layers {
            render_layout(self.handle, self.text_cache, layer.layout, Option[Rect]::Some(layer.clip))
        }
        replay_display_overlays(self.handle, frame.display_overlays, true)
        let borrowed = native_direct_frame_acquire(self.handle)
        ret VulkanFrameInterop::new(borrowed, self.direct_swapchain,
            self.pixel_width(), self.pixel_height(),)
    }
    /// Begins a direct Vulkan frame from retained UI without copying or
    /// traversing its owned `WidgetLayout`. This is the camera/render hot path;
    /// callers rebuild the retained cache only after an actual UI relayout.
    pub fn begin_cached_vulkan_frame(self: Self,
        overlay_layouts: Vec[WidgetLayout], cached_overlays: bool,) ->
    VulkanFrameInterop {
        let frame = self.prepare_cached_vulkan_frame(overlay_layouts, cached_overlays)
        if !frame.valid() || !self.begin_vulkan_composition(frame) {
            ret VulkanFrameInterop::new(0_usize, 0_usize, 0_u32, 0_u32)
        }
        ret frame
    }
    /// Prepares retained UI and borrows a command buffer before Luma starts
    /// its render pass. Embedded renderers may record compute work here.
    pub fn prepare_cached_vulkan_frame(self: Self,
        overlay_layouts: Vec[WidgetLayout], cached_overlays: bool,) ->
    VulkanFrameInterop {
        if self.handle == 0_usize || self.direct_swapchain == 0_usize ||
        self.direct_compositor == 0_usize ||
        !native_cached_frame_begin(self.handle, self.background.packed()) {
            ret VulkanFrameInterop::new(0_usize, 0_usize, 0_u32, 0_u32)
        }
        if !native_direct_composition_split(self.handle) {
            ret VulkanFrameInterop::new(0_usize, 0_usize, 0_u32, 0_u32)
        }
        if cached_overlays {
            let _overlay = native_overlay_cache_draw(self.handle)
        } else {
            for overlay in overlay_layouts {
                render_layout(self.handle, self.text_cache, overlay, Option[Rect]::None)
            }
        }
        let borrowed = native_direct_frame_prepare(self.handle)
        ret VulkanFrameInterop::new(borrowed, self.direct_swapchain,
            self.pixel_width(), self.pixel_height(),)
    }
    /// Starts Luma's UI composition after all external compute work has been
    /// recorded into the prepared frame.
    pub fn begin_vulkan_composition(self: Self, frame: VulkanFrameInterop) -> bool {
        ret frame.valid() && frame.swapchain() == self.direct_swapchain &&
        native_direct_frame_begin_composition(self.handle, frame.frame())
    }
    /// Appends Luma's UI pass with color-load semantics, then submits and
    /// presents the borrowed frame exactly once.
    pub fn present_vulkan_frame(self: Self, frame: VulkanFrameInterop) -> bool {
        ret frame.valid() && frame.swapchain() == self.direct_swapchain &&
        native_direct_frame_finish(self.handle, frame.frame())
    }
    /// Presents retained UI, embedded renderer output and transient overlays
    /// through one composition path.
    pub fn present_frame(self: Self, frame: CompositeFrame) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        match frame.external_image {
            Option::Some(image) => {
                if !self.bind_external_vulkan_image(image) {
                    ret false
                }
            }
            Option::None => {
            }
        }
        let begun = if frame.cached {
            native_cached_frame_begin(self.handle, self.background.packed())
        } else {
            native_begin(self.handle, self.background.packed())
        }
        if !begun {
            ret false
        }
        if !frame.cached {
            let mut excluded = frame.overlays
            if frame.external_target != "" {
                excluded.push(frame.external_target)
            }
            render_layout_filtered(self.handle, self.text_cache, frame.layout, Option[Rect]::None, excluded)
        }
        match frame.external_image {
            Option::Some(_) => {
                let external_bounds = match frame.external_bounds {
                    Option::Some(bounds) => {
                        Option[Rect]::Some(bounds)
                    }
                    Option::None => {
                        frame.layout.find_bounds(frame.external_target)
                    }
                }
                match external_bounds {
                    Option::Some(bounds) => {
                        let height = bounds.height() - frame.external_top_inset
                        if height > 0.0_f32 {
                            let _external = native_external_image_draw(self.handle,
                                bounds.x(), bounds.y() + frame.external_top_inset,
                                bounds.width(), height,)
                        }
                    }
                    Option::None => {
                    }
                }
            }
            Option::None => {
            }
        }
        if frame.cached_overlays {
            let _overlay = native_overlay_cache_draw(self.handle)
        } elif frame.overlay_layouts.len() > 0_usize {
            for overlay_layout in frame.overlay_layouts {
                render_layout(self.handle, self.text_cache, overlay_layout, Option[Rect]::None)
            }
        } else {
            for overlay in frame.overlays {
                if overlay != "" && overlay != frame.external_target {
                    let _drawn = render_layout_target(self.handle, self.text_cache, frame.layout,
                        overlay, Option[Rect]::None,)
                }
            }
        }
        ret native_end(self.handle)
    }
    pub fn draw_layout(self: Self, layout: WidgetLayout) -> bool {
        ret self.present_frame(CompositeFrame::full(layout))
    }
    /// Composites a producer-owned Vulkan image into one layout target without
    /// staging through CPU memory. Both renderers must use `vulkan_interop()`.
    pub fn draw_layout_with_external_vulkan_image(self: Self, layout: WidgetLayout,
        target: str, image: ExternalVulkanImage, top_inset: f32,) -> bool {
        ret self.present_frame(CompositeFrame::full(layout)
            .with_external_vulkan_image(target, image, top_inset))
    }
    pub fn cache_layout(self: Self, layout: WidgetLayout) -> bool {
        ret self.cache_layout_excluding(layout, Vec[str]::new())
    }
    /// Builds the retained base without external-renderer targets or transient
    /// overlays. Excluded layers are composed exactly once by `present_frame`.
    pub fn cache_layout_excluding(self: Self, layout: WidgetLayout,
        excluded: Vec[str],) -> bool {
        if self.handle == 0_usize || !native_layout_cache_begin(self.handle, self.background.packed())
        {
            ret false
        }
        render_layout_filtered(self.handle, self.text_cache, layout, Option[Rect]::None, excluded)
        ret native_layout_cache_end(self.handle)
    }
    /// Rebuilds the transparent layer composited above an embedded renderer.
    /// Applications refresh it on overlay damage, then reuse it across
    /// continuous viewport frames.
    pub fn cache_overlay_layouts(self: Self, layouts: Vec[WidgetLayout]) -> bool {
        if self.handle == 0_usize || !native_overlay_cache_begin(self.handle) {
            ret false
        }
        for layout in layouts {
            render_layout(self.handle, self.text_cache, layout, Option[Rect]::None)
        }
        ret native_overlay_cache_end(self.handle)
    }
    pub fn draw_cached_layout_with_external_vulkan_image(self: Self,
        layout: WidgetLayout, target: str, image: ExternalVulkanImage,
        top_inset: f32,) -> bool {
        ret self.present_frame(CompositeFrame::cached(layout)
            .with_external_vulkan_image(target, image, top_inset))
    }
    /// Composites a shared Vulkan image into the retained base and then paints
    /// transient targets above it. This keeps menus, dialogs and tooltips out
    /// of the cached texture without hiding them behind the viewport.
    pub fn draw_cached_layout_targets_with_external_vulkan_image(self: Self,
        layout: WidgetLayout, target: str, image: ExternalVulkanImage,
        top_inset: f32, overlay_targets: Vec[str],) -> bool {
        ret self.present_frame(CompositeFrame::cached(layout)
            .with_external_vulkan_image(target, image, top_inset)
            .with_overlays(overlay_targets))
    }
    pub fn draw_cached_layout(self: Self) -> bool {
        // The retained texture is already owned by the native renderer; an
        // empty layout is not available here, so this compatibility method
        // keeps the minimal direct presentation path.
        if self.handle == 0_usize ||
        !native_cached_frame_begin(self.handle, self.background.packed()) {
            ret false
        }
        ret native_end(self.handle)
    }
    pub fn draw_cached_layout_overlays(self: Self, layout: WidgetLayout, first: str, second: str) ->
    bool {
        let mut overlays = Vec[str]::new()
        if first != "" {
            overlays.push(first)
        }
        if second != "" && second != first {
            overlays.push(second)
        }
        ret self.present_frame(CompositeFrame::cached(layout)
            .with_overlays(overlays))
    }
    /// Draws the cached base plus only the retained widgets invalidated by a
    /// reactive update. Geometry remains unchanged and no tree construction or
    /// layout pass is performed.
    pub fn draw_cached_layout_targets(self: Self, layout: WidgetLayout, targets: Vec[str]) -> bool {
        ret self.present_frame(CompositeFrame::cached(layout)
            .with_overlays(targets))
    }
    /// Commits stable reactive component updates into the retained cache.
    /// Transient overlays stay composited at frame time so opening and closing
    /// them never destroys the cached content underneath.
    pub fn commit_cached_layout_targets(self: Self, layout: WidgetLayout,
        targets: Vec[str], transient_targets: Vec[str],) -> bool {
        let mut indexed = ReactiveUi::new(layout)
        for target in targets {
            indexed.invalidate_paint(target)
        }
        ret self.commit_cached_reactive_targets(indexed, transient_targets)
    }
    /// Uses the caller's retained index and old/new damage without constructing
    /// another widget tree. Transient descendants never enter the stable cache.
    pub fn commit_cached_reactive_targets(self: Self, reactive: mut ReactiveUi, transient_targets: Vec[str]) -> bool {
        ret self.commit_filtered_layout_regions(reactive.layout(), reactive.stable_paint_regions(transient_targets), transient_targets)
    }
    /// Replays the current scene through each visual damage region.
    pub fn commit_cached_layout_regions(self: Self, layout: WidgetLayout,
        regions: Vec[Rect],) -> bool {
        ret self.commit_filtered_layout_regions(layout, regions, Vec[str]::new())
    }
    fn commit_filtered_layout_regions(self: Self, layout: WidgetLayout,
        regions: Vec[Rect], excluded: Vec[str],) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        let started = self.updates.begin()
        let mut committed = true
        let mut committed_bounds = Vec[Rect]::new()
        for bounds in regions {
            let mut covered = false
            for previous in committed_bounds {
                if bounds.x() >= previous.x() && bounds.y() >= previous.y() &&
                bounds.right() <= previous.right() && bounds.bottom() <= previous.bottom() {
                    covered = true
                }
            }
            if !covered {
                if native_layout_cache_patch_begin(self.handle, self.background.packed(),
                    bounds.x(), bounds.y(), bounds.width(), bounds.height(),) {
                    render_layout_filtered(self.handle, self.text_cache, layout, Option[Rect]::Some(bounds), excluded)
                    committed = native_layout_cache_end(self.handle) && committed
                    committed_bounds.push(bounds)
                } else {
                    committed = false
                }
            }
        }
        self.updates.finish(UiUpdateStage::Paint, started, committed_bounds.len())
        ret committed
    }
    pub fn destroy(self: Self) -> bool {
        self.text_cache.clear()
        match self.bindings {
            Some(owner) => {
                let _unmounted = owner.bindings.unmount(owner.root)
            }
            None => {
            }
        }
        if self.handle == 0_usize {
            ret false
        }
        let mut destroyed = true
        if self.direct_compositor != 0_usize {
            destroyed = native_direct_resources_release(self.handle) && destroyed
        }
        if self.direct_compositor != 0_usize {
            destroyed = direct_ui_destroy(self.direct_compositor) && destroyed
        }
        if self.direct_context != 0_usize {
            if !direct_context_destroy(self.direct_context) {
                ret false
            }
        }
        ret native_destroy(self.handle) && destroyed
    }
}

pub struct WindowEvent {
    window: WindowId
    event: Event
}

impl for WindowEvent {
    pub fn window(self: Self) -> WindowId {
        ret self.window
    }
    pub fn event(self: Self) -> Event {
        ret self.event
    }
}
struct WindowMember {
    id: WindowId
    window: Window
}

/// Main-thread event routing for several independently rendered windows.
/// Removing a window does not destroy it; the host first moves its panels out.
pub struct WindowSet {
    members: Vec[WindowMember]
    cursor: usize
}

impl for WindowSet {
    pub fn new() -> WindowSet<H> {
        ret WindowSet<H>{ Vec[WindowMember]::new(), 0 }
    }
    pub fn add(self: mut Self&, window: Window) -> WindowId {
        for member in self.members {
            if member.window.handle == window.handle {
                ret member.id
            }
        }
        if !window.is_open() {
            ret WindowId::new(0)
        }
        let id = WindowId::new(reactive_identity())
        self.members.push(WindowMember { id, window })
        ret id
    }
    pub fn get(self: Self&, id: WindowId) -> Option[Window] {
        for member in self.members {
            if member.id.same(id) {
                ret Option[Window]::Some(member.window)
            }
        }
        ret Option[Window]::None
    }
    pub fn update(self: mut Self&, id: WindowId, window: Window) -> bool {
        let mut index = 0_usize
        for member in self.members {
            if member.id.same(id) {
                if member.window.handle != window.handle {
                    ret false
                }
                self.members.set(index, WindowMember { id, window })
                ret true
            }
            index += 1
        }
        ret false
    }
    pub fn remove(self: mut Self&, id: WindowId) -> bool {
        let mut remaining = Vec[WindowMember]::new()
        let mut found = false
        for member in self.members {
            if member.id.same(id) {
                found = true
            } else {
                remaining.push(member)
            }
        }
        self.members = remaining
        if self.cursor >= self.members.len() {
            self.cursor = 0
        }
        ret found
    }
    pub fn ids(self: Self&) -> Vec[WindowId] {
        let mut ids = Vec[WindowId]::new()
        for member in self.members {
            ids.push(member.id)
        }
        ret ids
    }
    /// Round-robin delivery prevents a busy viewport from starving a text panel.
    pub fn poll(self: mut Self&) -> Option[WindowEvent] {
        let count = self.members.len()
        for offset in 0..count {
            let index =(self.cursor + offset) % count
            match self.members.get(index) {
                Some(member) => {
                    let event = member.window.poll()
                    if event.kind() != event_none() {
                        self.cursor =(index + 1) % count
                        ret Option[WindowEvent]::Some(WindowEvent { member.id, event })
                    }
                }
                None => {
                }
            }
        }
        ret Option[WindowEvent]::None
    }
    /// One OS wait wakes for any window; no sequential per-window timeouts.
    pub fn wait(self: mut Self&, timeout_ms: u32) -> Option[WindowEvent] {
        let queued = self.poll()
        if queued.is_some() || self.members.len() == 0 {
            ret queued
        }
        let timeout = if timeout_ms > 2147483647_u32 {
            2147483647_i32
        } else {
            timeout_ms as i32
        }
        let _ready = native_wait_any(timeout)
        ret self.poll()
    }
}

fn failed_direct_window(handle: usize, context: usize, compositor: usize, message: str,
    width: u32, height: u32,) -> Window {
    native_backend_set_error(message)
    if compositor != 0_usize {
        let _compositor = direct_ui_destroy(compositor)
    }
    if context != 0_usize {
        let _context = direct_context_destroy(context)
    }
    if handle != 0_usize {
        let _handle = native_destroy(handle)
    }
    ret Window {
        0_usize, width, height, white(), 0_usize, 0_usize, 0_usize, 0_usize, 0_usize,
        StyleSheet::default(), RetainedCascade::new(), Option[WindowBindings]::None, WindowTextCache::new(), UiUpdateTracker::new()
    }
}

fn create_direct_vulkan_window(title: str, width: u32, height: u32,
    features: VulkanFeatureRequest,) -> Window {
    let handle = native_create_with_renderer(title, width, height, 3_u32)
    if handle == 0_usize {
        ret Window {
            0_usize, width, height, white(), 0_usize, 0_usize, 0_usize, 0_usize, 0_usize,
            StyleSheet::default(), RetainedCascade::new(), Option[WindowBindings]::None, WindowTextCache::new(), UiUpdateTracker::new()
        }
    }
    let context = direct_context_create(native_platform_handle(handle),
        features.required().mask(), features.optional().mask(),)
    if !direct_context_available(context) {
        ret failed_direct_window(handle, context, 0_usize,
            direct_context_error(context), width, height,)
    }
    let window = direct_context_surface(context)
    let device = direct_context_device(context)
    let swapchain = direct_context_swapchain(context)
    let compositor = direct_ui_create(device, swapchain)
    if !direct_ui_available(compositor) ||
    !native_direct_compositor_bind(handle, compositor) {
        ret failed_direct_window(handle, context, compositor,
            direct_ui_error(compositor), width, height,)
    }
    ret Window {
        handle, width, height, white(), context, window, device, swapchain, compositor,
        StyleSheet::default(), RetainedCascade::new(), Option[WindowBindings]::None, WindowTextCache::new(), UiUpdateTracker::new()
    }
}

fn surface_edge_floor(value: f32) -> u32 {
    ret if value <= 0.0_f32 {
        0_u32
    } else {
        value as u32
    }
}

fn surface_edge_ceil(value: f32) -> u32 {
    if value <= 0.0_f32 {
        ret 0_u32
    }
    let floor = value as u32
    ret if (floor as f32) < value {
        floor + 1_u32
    } else {
        floor
    }
}

fn surface_slot_generation(x: u32, y: u32, width: u32, height: u32,
    density: f32,) -> u64 {
    // Geometry itself is the generation identity. The factors are pairwise
    // odd and include density so a same-sized slot on another DPI generation
    // cannot accidentally accept an old producer image.
    let scaled_density =(density * 1000.0_f32) as u64
    ret(x as u64) * 73856093_u64 +(y as u64) * 19349663_u64 +
    (width as u64) * 83492791_u64 +(height as u64) * 2654435761_u64 +
    scaled_density * 97531_u64
}

fn collect_surface_slots(layout: WidgetLayout, scale_x: f32, scale_y: f32,
    density: f32,
    slots: mut Vec[SurfaceSlot],) ->() {
    collect_surface_slots_clipped(layout, scale_x, scale_y, density,
        Option[Rect]::None, slots,)
    ret()
}

fn collect_surface_slots_clipped(layout: WidgetLayout, scale_x: f32,
    scale_y: f32, density: f32,
    inherited_clip: Option[Rect], slots: mut Vec[SurfaceSlot],) ->() {
    let widget = layout.widget()
    let bounds = layout.bounds()
    let clip = if widget.style().layout().overflow_hidden() {
        clipped_bounds(inherited_clip, bounds)
    } else {
        inherited_clip
    }
    if widget.kind() == widget_render_surface() && widget.id() != "" &&
    widget.style().visible() && bounds.width() > 0.0_f32 &&
    bounds.height() > 0.0_f32 {
        let pixel_x = surface_edge_floor(bounds.x() * scale_x)
        let pixel_y = surface_edge_floor(bounds.y() * scale_y)
        let pixel_right = surface_edge_ceil(bounds.right() * scale_x)
        let pixel_bottom = surface_edge_ceil(bounds.bottom() * scale_y)
        let pixel_width = if pixel_right > pixel_x {
            pixel_right - pixel_x
        } else {
            1_u32
        }
        let pixel_height = if pixel_bottom > pixel_y {
            pixel_bottom - pixel_y
        } else {
            1_u32
        }
        slots.push(SurfaceSlot {
                widget.id(), bounds, pixel_x, pixel_y, pixel_width, pixel_height,
                density, surface_slot_generation(pixel_x, pixel_y, pixel_width,
                    pixel_height, density,), clip
            }
            ,)
    }
    for child in layout.children() {
        collect_surface_slots_clipped(child, scale_x, scale_y, density,
            clip, slots,)
    }
    ret()
}

fn replay_display_overlays(handle: usize, overlays: Vec[DisplayOverlay], foreground: bool) ->() {
    for overlay in overlays {
        if overlay.foreground == foreground {
            replay_display_commands(handle, overlay.list.commands(), Option[Rect]::Some(overlay.clip))
        }
    }
}

fn replay_display_commands(handle: usize, commands: Vec[DisplayCommand],
    damage: Option[Rect],) ->() {
    apply_clip(handle, damage)
    for command in commands {
        match command {
            DisplayCommand::FillRect(value) => {
                let bounds = value.bounds()
                native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(),
                    value.color().packed(),)
            }
            DisplayCommand::StrokeRect(value) => {
                let bounds = value.bounds()
                native_stroke_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(),
                    value.color().packed(),)
            }
            DisplayCommand::RoundRect(value) => {
                let bounds = value.bounds()
                native_round_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(),
                    value.radius(), value.color().packed(), value.filled(),)
            }
            DisplayCommand::Line(value) => {
                native_vector_line(handle, value.x0(), value.y0(), value.x1(), value.y1(),
                    value.width(), value.color().packed(),)
            }
            DisplayCommand::GradientLine(value) => {
                native_vector_gradient_line(handle, value.x0(), value.y0(), value.x1(), value.y1(),
                    value.width(), value.start_color().packed(), value.end_color().packed(),)
            }
            DisplayCommand::Svg(value) => {
                render_svg(handle, value.bounds(), value.document(), value.color(), value.stroke_width())
            }
            DisplayCommand::Text(value) => {
                native_text(handle, value.x(), value.y(), value.value(), value.color().packed())
            }
            DisplayCommand::Clip(value) => {
                if value.enabled() {
                    apply_clip(handle, clipped_bounds(damage, value.bounds()))
                } else {
                    apply_clip(handle, damage)
                }
            }
            DisplayCommand::Path(value) => {
                let mut first = true
                for point in value.points() {
                    if first {
                        native_vector_path_begin(handle, point.x(), point.y())
                        first = false
                    } else {
                        native_vector_path_point(handle, point.x(), point.y())
                    }
                }
                if !first {
                    native_vector_path_stroke(handle, value.width(), value.color().packed(), value.closed())
                }
            }
            DisplayCommand::Triangle(value) => {
                native_vector_triangle(handle, value.a().x(), value.a().y(), value.b().x(), value.b().y(),
                    value.c().x(), value.c().y(), value.color().packed(),)
            }
            DisplayCommand::StyledText(value) => {
                let style = value.style()
                if style.font_family() == "" || !native_font_select(handle, style.font_family(), style.font_size(), style.font_weight()) {
                    native_font_style(handle, style.font_size(), style.font_weight())
                }
                native_text(handle, value.x(), value.y(), value.value(), apply_opacity(style.foreground(), style.opacity()).packed())
            }
        }
    }
    apply_clip(handle, Option[Rect]::None)
    ret()
}

fn render_layout_target(handle: usize, cache: mut WindowTextCache&, layout: WidgetLayout, target: str, inherited_clip: Option[Rect])
-> bool {
    if layout.widget().id() == target {
        render_layout(handle, cache, layout, inherited_clip)
        ret true
    }
    let bounds = layout.bounds()
    let clip = if layout.widget().style().layout().overflow_hidden() {
        clipped_bounds(inherited_clip, bounds)
    } else {
        inherited_clip
    }
    let children = layout.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[WidgetLayout]::Some(child) => {
                if render_layout_target(handle, cache, child, target, clip) {
                    ret true
                }
            }
            Option[WidgetLayout]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn render_layout(handle: usize, cache: mut WindowTextCache&, layout: WidgetLayout, inherited_clip: Option[Rect]) ->() {
    render_layout_filtered(handle, cache, layout, inherited_clip, Vec[str]::new())
    ret()
}

fn render_layout_filtered(handle: usize, cache: mut WindowTextCache&, layout: WidgetLayout, inherited_clip: Option[Rect],
    excluded: Vec[str],) ->() {
    let widget = layout.widget()
    if contains_target(excluded, widget.id()) {
        ret()
    }
    let bounds = layout.bounds()
    let style = widget.style()
    // Opacity applies to the whole group, including explicitly styled children.
    // Retained hidden overlays must neither paint descendants nor shape text.
    if style.opacity() <= 0_f32 {
        ret()
    }
    // Dirty-region commits pass the damage rectangle as the inherited clip.
    // A clipping container whose bounds do not touch that damage cannot
    // contribute any pixels, including through its descendants.
    match inherited_clip {
        Option::Some(damage) => {
            if !rectangles_intersect(layout.paint_bounds(), damage) {
                ret()
            }
        }
        Option::None => {
        }
    }
    // Disabled presentation belongs to the stylesheet. The default preset
    // already supplies `opacity: 0.48`; applying another renderer-side factor
    // made disabled controls unintentionally render at roughly 24% opacity
    // and prevented application styles from restoring accessible contrast.
    let opacity = style.opacity()
    let clip = if style.layout().overflow_hidden() {
        clipped_bounds(inherited_clip, bounds)
    } else {
        inherited_clip
    }
    // Overflow clips content/descendants, not this box's own outline or
    // outer shadow. Decorations are still clipped by ancestors and damage.
    apply_clip(handle, inherited_clip)
    let background = apply_opacity(style.background(), opacity)
    let foreground = apply_opacity(style.foreground(), opacity)
    let border_color = apply_opacity(style.border_color(), opacity)
    if !style.visible() {
        render_children_filtered(handle, cache, layout, clip, excluded)
        apply_clip(handle, inherited_clip)
        ret()
    }
    if style.font_family() == "" || !native_font_select(handle, style.font_family(), style.font_size(),
        style.font_weight(),) {
        native_font_style(handle, style.font_size(), style.font_weight())
    }
    if !style.shadow().inset() {
        render_outer_shadow(handle, bounds, style, opacity)
    }
    if widget.kind() != widget_spacer() && !widget_renders_intrinsic_box(widget.kind()) {
        if style.linear_gradient().is_enabled() {
            render_linear_gradient(handle, bounds, style, opacity)
        } elif style.radius() > 0.0_f32 {
            native_round_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(), style.radius(),
                background.packed(), true,)
        } else {
            native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(), background.packed())
        }
    }
    if style.shadow().inset() {
        render_inset_shadow(handle, bounds, style, opacity)
        apply_clip(handle, inherited_clip)
    }
    if style.border_width() > 0.0_f32 {
        let mut inset = 0.0_f32
        while inset < style.border_width() {
            let stroke_inset = inset + 0.5_f32
            let width = bounds.width() - stroke_inset * 2.0_f32
            let height = bounds.height() - stroke_inset * 2.0_f32
            let remaining = style.border_width() - inset
            let coverage = if remaining > 1.0_f32 {
                1.0_f32
            } else {
                remaining
            }
            let layer_color = apply_opacity(border_color, coverage)
            if width > 0.0_f32 && height > 0.0_f32 {
                let radius = style.radius() - stroke_inset
                if radius > 0.0_f32 {
                    native_round_rect(handle, bounds.x() + stroke_inset, bounds.y() + stroke_inset, width,
                        height, radius, layer_color.packed(), false,)
                } else {
                    native_stroke_rect(handle, bounds.x() + stroke_inset, bounds.y() + stroke_inset,
                        width, height, layer_color.packed(),)
                }
            }
            inset = inset + 1.0_f32
        }
    }
    let outline = style.outline()
    if outline.width() > 0.0_f32 {
        let outline_color = apply_opacity(outline.color(), opacity)
        let mut layer = 0.0_f32
        while layer < outline.width() {
            let distance = outline.offset() + layer + 0.5_f32
            let x = bounds.x() - distance
            let y = bounds.y() - distance
            let width = bounds.width() + distance * 2.0_f32
            let height = bounds.height() + distance * 2.0_f32
            let remaining = outline.width() - layer
            let coverage = if remaining > 1.0_f32 {
                1.0_f32
            } else {
                remaining
            }
            let color = apply_opacity(outline_color, coverage)
            let radius = style.radius() + distance
            if width > 0.0_f32 && height > 0.0_f32 {
                if radius > 0.0_f32 {
                    native_round_rect(handle, x, y, width, height, radius, color.packed(), false)
                } else {
                    native_stroke_rect(handle, x, y, width, height, color.packed())
                }
            }
            layer = layer + 1.0_f32
        }
    }
    apply_clip(handle, clip)
    let kind = widget.kind()
    if kind == widget_label() || kind == widget_button() || kind == widget_heading() {
        if widget.text_wrap() {
            native_text_wrapped(handle, bounds.x() + 8.0_f32, bounds.y() + 4.0_f32,
                widget.text(), foreground.packed(), bounds.width() - 16.0_f32,)
        } else {
            let text_y = centered_text_y(handle, bounds, widget.text())
            let left = if kind == widget_label() {
                style.padding().left() + style.border_width()
            } else {
                8.0_f32
            }
            let right = if kind == widget_label() {
                style.padding().right() + style.border_width()
            } else {
                8.0_f32
            }
            let value = if widget.attribute("data-luma-text-overflow").unwrap_or("") == "ellipsis" {
                ellipsized_text(handle, widget.text(), bounds.width() - left - right)
            } else {
                widget.text()
            }
            let text_x = aligned_text_x(handle, bounds, value, style.text_align(), left, right)
            native_text(handle, text_x, text_y, value, foreground.packed())
            render_text_decoration(handle, text_x, text_y, value, style, foreground, opacity)
        }
    } elif kind == widget_rich_text() {
        let text_y = centered_text_y(handle, bounds, widget.text())
        let text_x = if widget.text_anchor_child() == "" {
            aligned_text_x(handle, bounds, widget.text(), style.text_align(), 8.0_f32, 8.0_f32)
        } else {
            bounds.x() + bounds.width() / 2.0_f32
        }
        native_styled_text(handle, text_x, text_y, widget.text(),
            rich_text_run_payload(widget, opacity),)
    } elif kind == widget_image() {
        native_image_rgba(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(),
            widget.text(),)
    } elif kind == widget_icon() {
        render_svg(handle, bounds, widget.svg(), foreground, 2.0_f32)
    } elif kind == widget_icon_button() {
        let icon_size = if bounds.height() - 14.0_f32 < 22.0_f32 {
            bounds.height() - 14.0_f32
        } else {
            22.0_f32
        }
        let icon_bounds = Rect::new(bounds.x() + 10.0_f32, bounds.y() +(bounds.height() - icon_size)
            / 2.0_f32, icon_size, icon_size,)
        render_svg(handle, icon_bounds, widget.svg(), foreground, 2.0_f32)
        let text_x = icon_bounds.right() + 9.0_f32
        let text_y = centered_text_y(handle, bounds, widget.text())
        let value = if widget.attribute("data-luma-text-overflow").unwrap_or("") == "ellipsis" {
            ellipsized_text(handle, widget.text(), bounds.right() - text_x - 6_f32)
        } else {
            widget.text()
        }
        native_text(handle, text_x, text_y, value, foreground.packed())
        render_text_decoration(handle, text_x, text_y, value, style, foreground, opacity)
    } elif kind == widget_icon_card() {
        let caption = Rect::new(bounds.x() + 8.0, bounds.y() + 8.0,
            if bounds.width() > 16.0 {
                bounds.width() - 16.0
            } else {
                0.0_f32
            }
            ,
            if bounds.height() > 18.0 {
                bounds.height() - 18.0
            } else {
                0.0_f32
            }
            ,)
        let lines = caption_lines(handle, widget.text(), caption.width())
        let line_height = native_text_height(handle, "Mg")
        let wanted_y = bounds.bottom() -(lines.len() as f32) * line_height - 10.0
        let text_y = if wanted_y > caption.y() {
            wanted_y
        } else {
            caption.y()
        }
        let icon_bounds = icon_card_bounds(bounds, text_y)
        render_svg(handle, icon_bounds, widget.svg(), foreground, 2.0_f32)
        apply_clip(handle, clipped_bounds(clip, caption))
        let mut y = text_y
        for line in lines {
            let x = caption.x() +(caption.width() - native_text_width(handle, line)) / 2.0
            if y + line_height > caption.bottom() + 0.01 {
                break
            }
            native_text(handle, x, y, line, foreground.packed())
            y += line_height
        }
        apply_clip(handle, clip)
    } elif kind == widget_input() || kind == widget_select() {
        let text_y = centered_text_y(handle, bounds, widget.text())
        let aligned_x = aligned_text_x(handle, bounds, widget.text(), style.text_align(), 10.0_f32,
            if kind == widget_select() {
                34.0_f32
            } else {
                10.0_f32
            }
            ,)
        let text_x = if kind == widget_input() && widget.focused() {
            focused_input_text_x(handle, bounds, widget.text(), widget.cursor(), aligned_x)
        } else {
            aligned_x
        }
        let selection = widget.selection()
        if kind == widget_input() && widget.focused() && selection.end() > selection.start() {
            let before = widget.text().slice(0_usize, selection.start())
            let selected = widget.text().slice(selection.start(), selection.end() - selection.start())
            native_fill_rect(handle, text_x + native_text_width(handle, before), text_y,
                native_text_width(handle, selected), native_text_height(handle, selected),
                Color::rgba(style.accent_color().red(), style.accent_color().green(),
                    style.accent_color().blue(), 100_u8,).packed(),)
        }
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, foreground, opacity)
        if kind == widget_select() {
            let arrow_x = bounds.right() - 17.0_f32
            let arrow_y = bounds.y() + bounds.height() / 2.0_f32 - 2.0_f32
            native_line(handle, arrow_x - 4.0_f32, arrow_y, arrow_x, arrow_y + 4.0_f32, foreground.packed())
            native_line(handle, arrow_x, arrow_y + 4.0_f32, arrow_x + 4.0_f32, arrow_y, foreground.packed())
        } elif widget.focused() {
            let prefix = widget.text().slice(0_usize, widget.cursor())
            let caret_x = text_x + native_text_width(handle, prefix) + 1.0_f32
            let text_height = native_text_height(handle, widget.text())
            native_line(handle, caret_x, text_y, caret_x, text_y + text_height,
                style.accent_color().packed(),)
        }
    } elif kind == widget_textarea() {
        render_textarea(handle, cache, bounds, widget, style, foreground, opacity)
    } elif kind == widget_terminal() {
        native_terminal(handle, bounds.x() + 8.0_f32, bounds.y() + 6.0_f32,
            bounds.width() - 16.0_f32, bounds.height() - 12.0_f32,
            widget.text(), foreground.packed(), background.packed(),
            widget.focused(),)
    } elif kind == widget_checkbox() || kind == widget_radio() {
        render_choice(handle, bounds, widget.text(), widget.checked(), kind == widget_radio(), style,
            foreground, opacity,)
    } elif kind == widget_switch() {
        render_switch(handle, bounds, widget.text(), widget.checked(), style, foreground, opacity)
    } elif kind == widget_slider() {
        render_slider(handle, bounds, widget.value(), style, opacity)
    } elif kind == widget_range_slider() {
        render_range_slider(handle, bounds, widget, style, opacity)
    } elif kind == widget_color_channel() {
        render_color_channel(handle, bounds, widget)
    } elif kind == widget_progress() {
        render_progress(handle, bounds, widget.value(), style, opacity)
    } elif kind == widget_separator() {
        native_line(handle, bounds.x(), bounds.y(), bounds.right(), bounds.y(),
            apply_opacity(style.background(), opacity).packed(),)
    } elif kind == widget_link() {
        let link = foreground
        let text_y = centered_text_y(handle, bounds, widget.text())
        let text_x = aligned_text_x(handle, bounds, widget.text(), style.text_align(), 4.0_f32, 4.0_f32)
        native_text(handle, text_x, text_y, widget.text(), link.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, link, opacity)
        native_line(handle, text_x, bounds.bottom() - 4.0_f32,
            text_x + native_text_width(handle, widget.text()), bounds.bottom() - 4.0_f32, link.packed(),)
    } elif kind == widget_color_picker() {
        let sample = match widget.attribute("data-luma-picker-color") {
            Some(value) => css_color(value) None => border_color
        }
        native_fill_rect(handle, bounds.x() + 8.0_f32, bounds.y() + 8.0_f32, 22.0_f32, bounds.height()
            - 16.0_f32, sample.packed(),)
        native_stroke_rect(handle, bounds.x() + 8.0_f32, bounds.y() + 8.0_f32, 22.0_f32, bounds.height()
            - 16.0_f32, Color::rgb(92_u8, 103_u8, 116_u8).packed(),)
        let text_x = bounds.x() + 40.0_f32
        let text_y = centered_text_y(handle, bounds, widget.text())
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, foreground, opacity)
        let arrow_x = bounds.right() - 17.0_f32
        let arrow_y = bounds.y() + bounds.height() / 2.0_f32 - 2.0_f32
        native_line(handle, arrow_x - 4.0_f32, arrow_y, arrow_x, arrow_y + 4.0_f32, foreground.packed())
        native_line(handle, arrow_x, arrow_y + 4.0_f32, arrow_x + 4.0_f32, arrow_y, foreground.packed())
    } elif kind == widget_color_swatch() {
    }
    if kind != widget_rich_text() {
        render_children_filtered(handle, cache, layout, clip, excluded)
    }
    let thumb = layout.scrollbar_thumb()
    if thumb.height() > 0.0_f32 {
        apply_clip(handle, clip)
        native_round_rect(handle, thumb.x(), thumb.y(), thumb.width(), thumb.height(),
            4.0_f32, apply_opacity(style.foreground(), opacity * 0.5_f32).packed(), true,)
    }
    apply_clip(handle, inherited_clip)
    ret()
}

fn rich_text_run_payload(widget: Widget, parent_opacity: f32) -> str {
    let mut payload = ""
    let mut offset = 0_usize
    let anchor_child = widget.text_anchor_child()
    for child in widget.children() {
        let length = child.text().len()
        if length > 0_usize {
            let color = apply_opacity(child.style().foreground(),
                parent_opacity * child.style().opacity(),)
            payload = payload + Debug::fmt(offset) + ":" + Debug::fmt(length) + ":" +
            Debug::fmt(color.packed()) + ":" +
            if anchor_child != "" && child.id() == anchor_child {
                "1;"
            } else {
                "0;"
            }
        }
        offset += length
    }
    ret payload
}

fn rectangles_intersect(lhs: Rect, rhs: Rect) -> bool {
    ret lhs.x() < rhs.right() && lhs.right() > rhs.x() &&
    lhs.y() < rhs.bottom() && lhs.bottom() > rhs.y()
}

fn widget_renders_intrinsic_box(kind: usize) -> bool {
    ret kind == widget_checkbox() || kind == widget_radio() || kind == widget_switch() ||
    kind == widget_slider() || kind == widget_range_slider() || kind == widget_progress() ||
    kind == widget_separator()
}

fn render_linear_gradient(handle: usize, bounds: Rect, style: Style, opacity: f32) ->() {
    let gradient = style.linear_gradient()
    native_gradient_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(),
        apply_opacity(gradient.start(), opacity).packed(), apply_opacity(gradient.end(), opacity).packed(), gradient.is_vertical(),)
}

fn render_children_filtered(handle: usize, cache: mut WindowTextCache&, layout: WidgetLayout, clip: Option[Rect],
    excluded: Vec[str],) ->() {
    let children = layout.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[WidgetLayout]::Some(child) => {
                render_layout_filtered(handle, cache, child, clip, excluded)
            }
            Option[WidgetLayout]::None => {
            }
        }
        index = index + 1_usize
    }
    ret()
}

fn contains_target(targets: Vec[str], target: str) -> bool {
    if target == "" {
        ret false
    }
    for value in targets {
        if value == target {
            ret true
        }
    }
    ret false
}

fn render_svg(handle: usize, bounds: Rect, document: SvgDocument, color: Color, stroke_width: f32) ->()
{
    if !document.valid() || document.width() <= 0.0_f32 || document.height() <= 0.0_f32 {
        ret()
    }
    // The SVG viewBox already owns its visual padding (Lucide paths normally
    // stay within 2..22 of a 24-unit box). Scaling the box plus stroke and then
    // subtracting another two pixels made small icons undersized and blurry.
    let scale_x = bounds.width() / document.width()
    let scale_y = bounds.height() / document.height()
    let scale = if scale_x < scale_y {
        scale_x
    } else {
        scale_y
    }
    let mut offset_x = bounds.x() +(bounds.width() - document.width() * scale) / 2.0_f32
    let mut offset_y = bounds.y() +(bounds.height() - document.height() * scale) / 2.0_f32
    let capture = native_vector_cache_begin(handle, document.source(), scale,
        stroke_width, offset_x, offset_y, color.packed(),)
    if capture == 1 {
        ret()
    }
    if capture == 2 {
        offset_x = 0.0
        offset_y = 0.0
    }
    let packed_color = if capture == 2 {
        4294967295_u32
    } else {
        color.packed()
    }
    let lines = document.lines()
    let thickness = stroke_width * scale
    let mut previous_x = 0.0_f32
    let mut previous_y = 0.0_f32
    let mut path_start_x = 0.0_f32
    let mut path_start_y = 0.0_f32
    let mut has_previous = false
    let mut index = 0_usize
    while index < lines.len() {
        match lines.get(index) {
            Option[SvgLine]::Some(line) => {
                let start = line.start()
                let finish = line.finish()
                let x0 = offset_x +(start.x() - document.min_x()) * scale
                let y0 = offset_y +(start.y() - document.min_y()) * scale
                let x1 = offset_x +(finish.x() - document.min_x()) * scale
                let y1 = offset_y +(finish.y() - document.min_y()) * scale
                if !has_previous || previous_x != x0 || previous_y != y0 {
                    if has_previous {
                        native_vector_path_stroke(handle, thickness, packed_color, false)
                    }
                    native_vector_path_begin(handle, x0, y0)
                    path_start_x = x0
                    path_start_y = y0
                }
                native_vector_path_point(handle, x1, y1)
                previous_x = x1
                previous_y = y1
                has_previous = true
            }
            Option[SvgLine]::None => {
            }
        }
        index = index + 1_usize
    }
    if has_previous {
        native_vector_path_stroke(handle, thickness, packed_color,
            previous_x == path_start_x && previous_y == path_start_y,)
    }
    if capture == 2 {
        native_vector_cache_end(handle)
    }
    ret()
}

fn render_text_decoration(handle: usize, x: f32, y: f32, text: str, style: Style,
    foreground: Color, opacity: f32,) ->() {
    let decoration = style.decoration()
    if !decoration.underline() && !decoration.overline() && !decoration.line_through() {
        ret()
    }
    let color = if decoration.color_set() {
        apply_opacity(decoration.color(), opacity)
    } else {
        foreground
    }
    let width = native_text_width(handle, text)
    let height = native_text_height(handle, text)
    let mut layer = 0.0_f32
    while layer < decoration.thickness() {
        if decoration.overline() {
            native_line(handle, x, y + layer, x + width, y + layer, color.packed())
        }
        if decoration.line_through() {
            native_line(handle, x, y + height * 0.55_f32 + layer, x + width, y + height * 0.55_f32 +
                layer, color.packed(),)
        }
        if decoration.underline() {
            native_line(handle, x, y + height - 1.0_f32 + layer, x + width, y + height - 1.0_f32 + layer,
                color.packed(),)
        }
        layer = layer + 1.0_f32
    }
    ret()
}

struct WrappedLine {
    start: usize
    end: usize
    next: usize
    hard_break: bool
}

struct TextareaLines {
    id: str
    value: str
    width: f32
    family: str
    size: f32
    weight: u32
    density: f32
    lines: Vec[WrappedLine]
}
struct SyntaxToken {
    text: str
    x: f32
    color: u32
    styled: bool
}
struct SyntaxTokens {
    value: str
    language: str
    family: str
    size: f32
    weight: u32
    density: f32
    color: u32
    tokens: Vec[SyntaxToken]
    bytes: usize
}
/// Per-window caches hold descriptors only; native textures keep their own budget.
struct WindowTextCache {
    layouts: Vec[TextareaLines]
    syntax: Vec[SyntaxTokens]
    next_layout: usize
    next_syntax: usize
    syntax_bytes: usize
}

impl for WindowTextCache {
    pub fn clear(self: mut Self&) ->() {
        self.layouts = Vec[TextareaLines]::new() self.syntax = Vec[SyntaxTokens]::new()
        self.next_layout = 0_usize self.next_syntax = 0_usize self.syntax_bytes = 0_usize
        ret()
    }
    pub fn new() -> WindowTextCache<H> {
        ret WindowTextCache<H> {
            Vec[TextareaLines]::new(), Vec[SyntaxTokens]::new(), 0_usize, 0_usize, 0_usize
        }
    }
    pub fn lines(self: mut Self&, handle: usize, widget: Widget, width: f32) -> Vec[WrappedLine] {
        let value = widget.text() let style = widget.style() let density = native_pixel_density(handle)
        for entry in self.layouts {
            if entry.id == widget.id() && entry.value == value && entry.width == width && entry.family == style.font_family() &&
            entry.size == style.font_size() && entry.weight == style.font_weight() && entry.density == density {
                ret entry.lines
            }
        }
        let mut result = Vec[WrappedLine]::new()
        let mut byte = 0_usize let mut chars = 0_usize
        while byte < value.byte_len() {
            let end = value.find_byte_from(10_u8, byte)
            let text = value.slice_bytes(byte, end - byte)
            let length = text.char_len()
            let hard = end < value.byte_len()
            if widget.attribute("wrap").is_some() || length == 0_usize {
                result.push(WrappedLine {
                        chars, chars + length, chars + length + if hard {
                            1_usize
                        } else {
                            0_usize
                        }
                        , hard
                    }
                )
            } else {
                let mut local = 0_usize
                while local < length {
                    let wrapped = wrapped_line(handle, text, local, width)
                    let last = wrapped.next >= length
                    result.push(WrappedLine {
                            chars + wrapped.start, chars + wrapped.end,
                            chars + wrapped.next + if last && hard {
                                1_usize
                            } else {
                                0_usize
                            }
                            , last && hard
                        }
                    )
                    local = wrapped.next
                }
            }
            chars += length + if hard {
                1_usize
            } else {
                0_usize
            }
            byte = end + if hard {
                1_usize
            } else {
                0_usize
            }
        }
        if result.len() == 0_usize {
            result.push(WrappedLine { 0_usize, 0_usize, 0_usize, false })
        }
        if value.byte_len() <= 262144_usize {
            let entry = TextareaLines {
                widget.id(), value, width, style.font_family(), style.font_size(), style.font_weight(), density, result
            }
            let mut found = false let mut index = 0_usize
            for previous in self.layouts {
                if previous.id == widget.id() {
                    self.layouts.set(index, entry) found = true break
                }
                index += 1_usize
            }
            if !found {
                if self.layouts.len() < 8_usize {
                    self.layouts.push(entry)
                } else {
                    self.layouts.set(self.next_layout % 8_usize, entry) self.next_layout += 1_usize
                }
            }
        }
        ret result
    }
    pub fn tokens(self: mut Self&, handle: usize, value: str, color: Color, language: str, style: Style) -> Vec[SyntaxToken] {
        let density = native_pixel_density(handle)
        for entry in self.syntax {
            if entry.value == value && entry.language == language && entry.family == style.font_family() && entry.size == style.font_size() &&
            entry.weight == style.font_weight() && entry.density == density && entry.color == color.packed() {
                ret entry.tokens
            }
        }
        let tokens = syntax_tokens(handle, value, color, language)
        let mut bytes = value.byte_len() + tokens.len() * 64_usize
        for token in tokens {
            bytes += token.text.byte_len()
        }
        if bytes <= 1048576_usize {
            while self.syntax_bytes + bytes > 1048576_usize && self.syntax.len() > 0_usize {
                let old = self.syntax.pop().unwrap_or(SyntaxTokens {
                        "", "", "", 0_f32, 0_u32, 0_f32, 0_u32, Vec[SyntaxToken]::new(), 0_usize
                    }
                )
                self.syntax_bytes -= old.bytes
            }
            let entry = SyntaxTokens {
                value, language, style.font_family(), style.font_size(), style.font_weight(), density, color.packed(), tokens, bytes
            }
            if self.syntax.len() < 256_usize {
                self.syntax.push(entry)
            } else {
                let index = self.next_syntax % 256_usize
                self.syntax_bytes -= self.syntax.get(index).unwrap_or(entry).bytes
                self.syntax.set(index, entry) self.next_syntax += 1_usize
            }
            self.syntax_bytes += bytes
        }
        ret tokens
    }
}

#attr(test)
fn textarea_cache_preserves_wrapping_metrics_and_font_invalidation() -> bool {
    let window = Window::create_with_renderer("Textarea cache", 360, 240, RendererKind::Software)
    if !window.available() {
        ret false
    }
    let font = "assets/fonts/RobotoMono/RobotoMono-VariableFont_wght.ttf"
    if !window.register_font("Cache Mono", font) {
        window.destroy() ret false
    }
    let text = "abc Ж😀 def ghi jkl\n\nsecond visual line\n"
    let mut valid = true
    for size in vec![14_f32, 22_f32] {
        let _selected = window.select_font("Cache Mono", size, 400_u32)
        for width in vec![80_f32, 140_f32] {
            let style = Style::default().with_font_family("Cache Mono").with_font_size(size).with_scroll(0_f32, 18_f32)
            let field = Widget::textarea("cached", text).with_style(style)
            let bounds = Rect::new(30_f32, 20_f32, width + 20_f32, 180_f32)
            let expected = wrapped_text_index(window.handle, text, width, 24_f32, 53_f32)
            valid = valid && window.textarea_text_index(field, bounds, 64_f32, 65_f32) == expected
        }
    }
    let style = Style::default().with_font_family("Cache Mono").with_font_size(22_f32)
    let first = window.text_cache.tokens(window.handle, "let α = 123 // 😀", Color::rgb(200_u8, 200_u8, 200_u8), "encore", style)
    let second = window.text_cache.tokens(window.handle, "let α = 123 // 😀", Color::rgb(200_u8, 200_u8, 200_u8), "encore", style)
    valid = valid && first.len() == 1_usize && second.len() == 1_usize && window.text_cache.syntax.len() == 1_usize
    let _registered = window.register_font("Cache Mono", font)
    valid = valid && window.text_cache.layouts.len() == 0_usize && window.text_cache.syntax.len() == 0_usize
    window.destroy()
    ret valid
}

fn wrapped_line(handle: usize, value: str, start: usize, width: f32) -> WrappedLine {
    let length = value.char_len()
    let tail = value.slice(start, length - start)
    let newline_byte = tail.find_byte_from(10_u8, 0_usize)
    let newline = start + tail.slice_bytes(0_usize, newline_byte).char_len()
    if newline == start {
        ret WrappedLine {
            start, start, start + 1_usize, true
        }
    }
    let remaining = value.slice(start, newline - start)
    let measured = native_text_index(handle, remaining, width)
    let count = if measured == 0_usize {
        1_usize
    } else {
        measured
    }
    let end = if start + count < newline {
        start + count
    } else {
        newline
    }
    let hard_break = end == newline && newline < length
    ret WrappedLine {
        start, end, if hard_break {
            newline + 1_usize
        } else {
            end
        }
        , hard_break
    }
}

fn wrapped_text_index(handle: usize, value: str, width: f32, x: f32, y: f32) -> usize {
    let length = value.char_len()
    if length == 0_usize || width <= 0.0_f32 {
        ret 0_usize
    }
    let height = native_text_height(handle, "Mg")
    let line_height = if height > 0.0_f32 {
        height + 2.0_f32
    } else {
        16.0_f32
    }
    let target_row =(if y > 0.0_f32 {
            y / line_height
        } else {
            0.0_f32
        }
    ) as usize
    let mut start = 0_usize
    let mut row = 0_usize
    while start < length {
        let line = wrapped_line(handle, value, start, width)
        if row == target_row {
            let text = value.slice(line.start, line.end - line.start)
            let local = native_text_index(handle, text, if x > 0.0_f32 {
                    x
                } else {
                    0.0_f32
                }
                ,
            )
            let index = line.start + local
            ret if index < line.end {
                index
            } else {
                line.end
            }
        }
        start = line.next
        row = row + 1_usize
    }
    ret length
}

fn textarea_line_number(value: str, index: usize) -> usize {
    let mut line = 1_usize
    let mut cursor = 0_usize
    let limit = if index > value.char_len() {
        value.char_len()
    } else {
        index
    }
    while cursor < limit {
        if value.slice(cursor, 1_usize) == "\n" {
            line = line + 1_usize
        }
        cursor = cursor + 1_usize
    }
    ret line
}

fn render_textarea(handle: usize, cache: mut WindowTextCache&, bounds: Rect, widget: Widget, style: Style,
    foreground: Color, opacity: f32,) ->() {
    let value = widget.text()
    let value_length = value.char_len()
    let gutter = if widget.attribute("line-numbers").is_some() {
        52.0_f32
    } else {
        0.0_f32
    }
    let scroll_x = style.layout().scroll().x()
    let x = bounds.x() + 10.0_f32 + gutter - scroll_x
    let width = if widget.attribute("wrap").is_some() {
        1000000.0_f32
    } else {
        bounds.width() - 20.0_f32 - gutter
    }
    let height = native_text_height(handle, "Mg")
    let line_height = if height > 0.0_f32 {
        height + 2.0_f32
    } else {
        16.0_f32
    }
    let visual_lines = cache.lines(handle, widget, width)
    let selection = widget.selection()
    let mut start = 0_usize
    let mut row = 0_usize
    let mut finished = false
    let scroll_y = style.layout().scroll().y()
    row = if scroll_y > 0_f32 {
        (scroll_y / line_height) as usize
    } else {
        0_usize
    }
    start = visual_lines.get(row).unwrap_or(WrappedLine {
            value_length, value_length, value_length, false
        }
    ).start
    if gutter > 0.0_f32 {
        native_fill_rect(handle, bounds.x(), bounds.y(), gutter, bounds.height(),
            Color::rgba(12_u8, 16_u8, 24_u8, 150_u8).packed(),)
    }
    while !finished {
        let line = if value_length == 0_usize || start >= value_length {
            WrappedLine {
                start, start, start, false
            }
        } else {
            visual_lines.get(row).unwrap_or(WrappedLine {
                    value_length, value_length, value_length, false
                }
            )
        }
        let y = bounds.y() + 10.0_f32 +(row as f32) * line_height - scroll_y
        if y > bounds.bottom() {
            break
        }
        if y + line_height >= bounds.y() && gutter > 0.0_f32 {
            let number = Debug::fmt(textarea_line_number(value, line.start))
            let number_width = native_text_width(handle, number)
            native_text(handle, bounds.x() + gutter - number_width - 8.0_f32, y,
                number, Color::rgb(86_u8, 96_u8, 112_u8).packed(),)
        }
        let count = if widget.attribute("wrap").is_some() && scroll_x < 16000_f32 && line.end - line.start > 8192_usize {
            8192_usize
        } else {
            line.end - line.start
        }
        let mut text = value.slice(line.start, count)
        if text.byte_len() > 4096_usize && scroll_x < 16000_f32 {
            let visible = native_text_index(handle, text, scroll_x + bounds.width() + 32_f32)
            if visible + 4_usize < text.char_len() {
                text = text.slice(0_usize, visible + 4_usize)
            }
        }
        let painted_end = line.start + text.char_len()
        if widget.focused() && selection.end() > selection.start() {
            let selected_start = if selection.start() > line.start {
                selection.start()
            } else {
                line.start
            }
            let selected_end = if selection.end() < painted_end {
                selection.end()
            } else {
                painted_end
            }
            if selected_end > selected_start {
                let before = value.slice(line.start, selected_start - line.start)
                let selected = value.slice(selected_start, selected_end - selected_start)
                native_fill_rect(handle, x + native_text_width(handle, before), y,
                    native_text_width(handle, selected), height, Color::rgba(40_u8, 120_u8, 220_u8, 100_u8).packed(),)
            }
        }
        match widget.attribute("syntax") {
            Option::Some(language) => {
                render_syntax_line(handle, cache, x, y, text, foreground, language, style)
            }
            Option::None => {
                native_text(handle, x, y, text, foreground.packed())
            }
        }
        render_text_decoration(handle, x, y, text, style, foreground, opacity)
        let cursor_on_line = widget.cursor() >= line.start &&
        (widget.cursor() < line.end || line.end == value_length ||(line.hard_break && widget.cursor()
                == line.end))
        if widget.focused() && cursor_on_line && widget.cursor() <= painted_end {
            let prefix = value.slice(line.start, widget.cursor() - line.start)
            let caret_x = x + native_text_width(handle, prefix) + 1.0_f32
            native_line(handle, caret_x, y, caret_x, y + height, Color::rgb(18_u8, 153_u8, 126_u8).packed())
        }
        finished = line.next >= value_length
        if line.hard_break && line.next == value_length {
            start = line.next
            row = row + 1_usize
            let empty_y = bounds.y() + 10.0_f32 +(row as f32) * line_height
            if widget.focused() && widget.cursor() == value_length {
                native_line(handle, x + 1.0_f32, empty_y - scroll_y, x + 1.0_f32,
                    empty_y + height - scroll_y,
                    Color::rgb(18_u8, 153_u8, 126_u8).packed(),)
            }
        } else {
            start = line.next
            row = row + 1_usize
        }
    }
    ret()
}

fn syntax_digit(value: str) -> bool {
    ret "0123456789".contains(value)
}

fn syntax_uppercase(value: str) -> bool {
    ret "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(value)
}

fn syntax_identifier_char(value: str) -> bool {
    ret "abcdefghijklmnopqrstuvwxyz".contains(value) ||
    syntax_uppercase(value) || syntax_digit(value) || value == "_"
}

fn syntax_keyword(value: str) -> bool {
    ret value == "fn" || value == "let" || value == "mut" ||
    value == "struct" || value == "enum" || value == "trait" ||
    value == "impl" || value == "for" || value == "in" ||
    value == "import" || value == "pub" || value == "ret" ||
    value == "if" || value == "else" || value == "elif" ||
    value == "match" || value == "while" || value == "do" ||
    value == "loop" || value == "break" || value == "continue" ||
    value == "as" || value == "with" || value == "macro_rules" ||
    value == "true" || value == "false" || value == "not" ||
    value == "unsafe" || value == "extern" || value == "ehir"
}

fn syntax_operator(value: str) -> bool {
    ret value == "+" || value == "-" || value == "*" || value == "/" ||
    value == "%" || value == "=" || value == "!" || value == "<" ||
    value == ">" || value == "&" || value == "|" || value == "^" ||
    value == "~" || value == "?" || value == "."
}

fn toml_key_limit(value: str) -> usize {
    let mut index = 0_usize
    let mut quoted = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "\"" {
            quoted = !quoted
        } elif current == "=" && !quoted {
            ret index
        }
        index = index + 1_usize
    }
    ret 0_usize
}

struct SyntaxSpan {
    start: usize
    end: usize
    color: u32
}
fn syntax_identifier_byte(value: u8) -> bool {
    ret value >= 65_u8 && value <= 90_u8 || value >= 97_u8 && value <= 122_u8 || value >= 48_u8 && value <= 57_u8 || value == 95_u8
}
fn syntax_tokens(handle: usize, value: str, foreground: Color, language: str) -> Vec[SyntaxToken] {
    let length = value.byte_len()
    let mut spans = Vec[SyntaxSpan]::new()
    let mut index = 0_usize
    if language == "toml" {
        let count = toml_key_limit(value)
        let key = value.slice(0_usize, count).byte_len()
        if key > 0_usize {
            spans.push(SyntaxSpan {
                    0_usize, key, Color::rgb(97_u8, 175_u8, 239_u8).packed()
                }
            ) index = key
        }
    }
    while index < length {
        let current = value.byte_at(index)
        let previous = if index > 0_usize {
            value.byte_at(index - 1_usize)
        } else {
            0_u8
        }
        let mut end = index + 1_usize
        let color = if language == "markdown" && current == 35_u8 {
            end = length Color::rgb(97_u8, 175_u8, 239_u8)
        } elif language == "markdown" &&(current == 42_u8 || current == 95_u8) {
            Color::rgb(198_u8, 120_u8, 221_u8)
        } elif language == "markdown" && current == 96_u8 {
            while end < length && value.byte_at(end) != 96_u8 {
                end += 1_usize
            }
            if end < length {
                end += 1_usize
            }
            Color::rgb(152_u8, 195_u8, 121_u8)
        } elif language == "toml" && current == 35_u8 {
            end = length Color::rgb(103_u8, 112_u8, 126_u8)
        } elif language == "toml" && current == 91_u8 {
            while end < length && value.byte_at(end) != 93_u8 {
                end += 1_usize
            }
            if end < length {
                end += 1_usize
            }
            Color::rgb(198_u8, 120_u8, 221_u8)
        } elif language == "encore" && current == 35_u8 {
            while end < length && syntax_identifier_byte(value.byte_at(end)) {
                end += 1_usize
            }
            Color::rgb(86_u8, 182_u8, 194_u8)
        } elif language == "encore" && current == 47_u8 && end < length && value.byte_at(end) == 47_u8 {
            end = length Color::rgb(103_u8, 112_u8, 126_u8)
        } elif (language == "encore" || language == "toml") && current == 34_u8 {
            while end < length && value.byte_at(end) != 34_u8 {
                end += 1_usize
            }
            if end < length {
                end += 1_usize
            }
            Color::rgb(152_u8, 195_u8, 121_u8)
        } elif (language == "encore" || language == "toml") && current >= 48_u8 && current <= 57_u8 {
            while end < length &&(value.byte_at(end) >= 48_u8 && value.byte_at(end) <= 57_u8 || value.byte_at(end) == 46_u8) {
                end += 1_usize
            }
            Color::rgb(209_u8, 154_u8, 102_u8)
        } elif syntax_identifier_byte(current) {
            while end < length && syntax_identifier_byte(value.byte_at(end)) {
                end += 1_usize
            }
            let word = value.slice_bytes(index, end - index)
            if language == "encore" && syntax_keyword(word) {
                Color::rgb(198_u8, 120_u8, 221_u8)
            } elif language == "encore" &&(word == "H" || word == "S" || previous == 46_u8 || end + 1_usize < length && value.byte_at(end) == 58_u8 && value.byte_at(end + 1_usize) == 58_u8) {
                Color::rgb(86_u8, 182_u8, 194_u8)
            } elif language == "encore" && end < length && value.byte_at(end) == 40_u8 {
                Color::rgb(97_u8, 175_u8, 239_u8)
            } elif language == "encore" && current >= 65_u8 && current <= 90_u8 {
                Color::rgb(229_u8, 192_u8, 123_u8)
            } else {
                foreground
            }
        } elif language == "encore" && current < 128_u8 && syntax_operator(value.slice_bytes(index, 1_usize)) {
            Color::rgb(198_u8, 120_u8, 221_u8)
        } else {
            if current >= 128_u8 {
                end = index + if current < 224_u8 {
                    2_usize
                } elif current < 240_u8 {
                    3_usize
                } else {
                    4_usize
                }
            }
            foreground
        }
        let last = spans.len()
        if last > 0_usize && spans.get(last - 1_usize).unwrap_or(SyntaxSpan {
                0_usize, 0_usize, 0_u32
            }
        ).color == color.packed() {
            let prior = spans.get(last - 1_usize).unwrap_or(SyntaxSpan {
                    index, end, color.packed()
                }
            )
            spans.set(last - 1_usize, SyntaxSpan { prior.start, end, prior.color })
        } else {
            spans.push(SyntaxSpan { index, end, color.packed() })
        }
        index = end
    }
    if spans.len() <= 1_usize {
        ret vec![SyntaxToken {
                value, 0_f32, spans.get(0_usize).unwrap_or(SyntaxSpan {
                        0_usize, length, foreground.packed()
                    }
                ).color, false
            }
        ]
    }
    if spans.len() <= 64_usize {
        let mut payload = ""
        for span in spans {
            payload = payload + Debug::fmt(span.start) + ":" + Debug::fmt(span.end - span.start) + ":" + Debug::fmt(span.color) + ":0;"
        }
        ret vec![SyntaxToken { payload, 0_f32, 0_u32, true }]
    }
    let mut tokens = Vec[SyntaxToken]::new()
    for span in spans {
        tokens.push(SyntaxToken {
                value.slice_bytes(span.start, span.end - span.start), native_text_width(handle, value.slice_bytes(0_usize, span.start)), span.color, false
            }
        )
    }
    ret tokens
}

fn render_syntax_line(handle: usize, cache: mut WindowTextCache&, x: f32, y: f32,
    value: str, foreground: Color, language: str, style: Style,) ->() {
    for token in cache.tokens(handle, value, foreground, language, style) {
        if token.styled {
            native_styled_text(handle, x, y, value, token.text)
        } else {
            native_text(handle, x + token.x, y, token.text, token.color)
        }
    }
    ret()
}

#attr(test)
fn syntax_classifier_matches_supported_languages() -> bool {
    ret syntax_keyword("import") && syntax_keyword("struct")
    && syntax_keyword("extern") && !syntax_keyword("ZodiacIcons")
    && syntax_identifier_char("i") && syntax_identifier_char("_")
    && syntax_identifier_char("9") && syntax_uppercase("Z")
    && toml_key_limit("dependencies = [\"core\"]") == 13_usize
}

fn shadow_layers(blur: f32) -> usize {
    let value = blur as usize + 1_usize
    ret if value > 24_usize {
        24_usize
    } else {
        value
    }
}

fn shadow_layer_color(color: Color, opacity: f32, layers: usize) -> Color {
    let alpha =((color.alpha() as f32) * opacity / layers as f32) as u8
    ret Color::rgba(color.red(), color.green(), color.blue(), alpha)
}

fn render_outer_shadow(handle: usize, bounds: Rect, style: Style, opacity: f32) ->() {
    let shadow = style.shadow()
    if shadow.color().alpha() == 0_u8 {
        ret()
    }
    let layers = shadow_layers(shadow.blur())
    let color = shadow_layer_color(shadow.color(), opacity, layers)
    let mut index = layers
    while index > 0_usize {
        index = index - 1_usize
        let expansion = if layers > 1_usize {
            shadow.blur() * index as f32 /(layers - 1_usize) as f32
        } else {
            0.0_f32
        }
        let extent = shadow.spread() + expansion
        let x = bounds.x() + shadow.x() - extent
        let y = bounds.y() + shadow.y() - extent
        let width = bounds.width() + extent * 2.0_f32
        let height = bounds.height() + extent * 2.0_f32
        let radius = style.radius() + extent
        if width > 0.0_f32 && height > 0.0_f32 {
            if radius > 0.0_f32 {
                native_round_rect(handle, x, y, width, height, radius, color.packed(), true)
            } else {
                native_fill_rect(handle, x, y, width, height, color.packed())
            }
        }
    }
    ret()
}

fn render_inset_shadow(handle: usize, bounds: Rect, style: Style, opacity: f32) ->() {
    let shadow = style.shadow()
    if shadow.color().alpha() == 0_u8 {
        ret()
    }
    native_clip(handle, true, bounds.x(), bounds.y(), bounds.width(), bounds.height())
    let layers = shadow_layers(shadow.blur() + if shadow.spread() > 0.0_f32 {
            shadow.spread()
        } else {
            0.0_f32
        }
    )
    let color = shadow_layer_color(shadow.color(), opacity, layers)
    let mut index = 0_usize
    while index < layers {
        let inset = index as f32 - shadow.spread()
        let x = bounds.x() + inset + shadow.x()
        let y = bounds.y() + inset + shadow.y()
        let width = bounds.width() - inset * 2.0_f32
        let height = bounds.height() - inset * 2.0_f32
        let radius = style.radius() - inset
        if width > 0.0_f32 && height > 0.0_f32 {
            if radius > 0.0_f32 {
                native_round_rect(handle, x, y, width, height, radius, color.packed(), false)
            } else {
                native_stroke_rect(handle, x, y, width, height, color.packed())
            }
        }
        index = index + 1_usize
    }
    ret()
}

fn aligned_text_x(handle: usize, bounds: Rect, value: str, alignment: usize, left: f32, right: f32) ->
f32 {
    let minimum = bounds.x() + left
    let available = bounds.width() - left - right
    let width = native_text_width(handle, value)
    if alignment == text_center() {
        let centered = minimum +(available - width) / 2.0_f32
        ret if centered > minimum {
            centered
        } else {
            minimum
        }
    }
    if alignment == text_end() {
        let ended = bounds.right() - right - width
        ret if ended > minimum {
            ended
        } else {
            minimum
        }
    }
    ret minimum
}

fn focused_input_text_x(handle: usize, bounds: Rect, value: str, cursor: usize, aligned: f32) -> f32
{
    let caret = native_text_width(handle, value.slice(0_usize, cursor))
    let right = bounds.right() - 10.0_f32
    if aligned + caret > right {
        ret aligned -(aligned + caret - right)
    }
    ret aligned
}

fn clipped_bounds(parent: Option[Rect], bounds: Rect) -> Option[Rect] {
    match parent {
        Option[Rect]::Some(clip) => {
            let left = if clip.x() > bounds.x() {
                clip.x()
            } else {
                bounds.x()
            }
            let top = if clip.y() > bounds.y() {
                clip.y()
            } else {
                bounds.y()
            }
            let right = if clip.right() < bounds.right() {
                clip.right()
            } else {
                bounds.right()
            }
            let bottom = if clip.bottom() < bounds.bottom() {
                clip.bottom()
            } else {
                bounds.bottom()
            }
            ret Option[Rect]::Some(Rect::new(left, top,
                    if right > left {
                        right - left
                    } else {
                        0.0_f32
                    }
                    ,
                    if bottom > top {
                        bottom - top
                    } else {
                        0.0_f32
                    }
                    ,))
        }
        Option[Rect]::None => {
            ret Option[Rect]::Some(bounds)
        }
    }
}

fn apply_clip(handle: usize, clip: Option[Rect]) ->() {
    match clip {
        Option[Rect]::Some(bounds) => {
            native_clip(handle, true, bounds.x(), bounds.y(), bounds.width(), bounds.height())
        }
        Option[Rect]::None => {
            native_clip(handle, false, 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32)
        }
    }
    ret()
}

fn render_choice(handle: usize, bounds: Rect, text: str, checked: bool, radio: bool,
    style: Style, foreground: Color, opacity: f32,) ->() {
    let size = 18.0_f32
    let x = bounds.x() + 4.0_f32
    let y = bounds.y() +(bounds.height() - size) / 2.0_f32
    let border = apply_opacity(style.border_color(), opacity)
    let accent = apply_opacity(style.accent_color(), opacity)
    let surface = apply_opacity(style.background(), opacity)
    let indicator = contrast_color(style.accent_color(), opacity)
    if radio {
        native_circle(handle, x + 9.0_f32, y + 9.0_f32, 9.0_f32,
            if checked {
                accent.packed()
            } else {
                surface.packed()
            }
            , true,)
        native_circle(handle, x + 9.0_f32, y + 9.0_f32, 9.0_f32, border.packed(), false)
    } else {
        native_fill_rect(handle, x, y, size, size, if checked {
                accent.packed()
            } else {
                surface.packed()
            }
            ,
        )
        native_stroke_rect(handle, x, y, size, size, border.packed())
    }
    if checked {
        if radio {
            native_circle(handle, x + 9.0_f32, y + 9.0_f32, 4.0_f32, indicator.packed(),
                true,)
        } else {
            native_line(handle, x + 4.0_f32, y + 9.0_f32, x + 8.0_f32, y + 13.0_f32,
                indicator.packed(),)
            native_line(handle, x + 8.0_f32, y + 13.0_f32, x + 15.0_f32, y + 5.0_f32,
                indicator.packed(),)
        }
    }
    let text_x = x + 28.0_f32
    let text_y = centered_text_y(handle, bounds, text)
    native_text(handle, text_x, text_y, text, foreground.packed())
    render_text_decoration(handle, text_x, text_y, text, style, foreground, opacity)
    ret()
}

fn render_switch(handle: usize, bounds: Rect, text: str, checked: bool,
    style: Style, foreground: Color, opacity: f32,) ->() {
    let x = bounds.x() + 4.0_f32
    let y = bounds.y() +(bounds.height() - 22.0_f32) / 2.0_f32
    native_fill_rect(handle, x, y, 42.0_f32, 22.0_f32,
        if checked {
            apply_opacity(style.accent_color(), opacity).packed()
        } else {
            apply_opacity(style.background(), opacity).packed()
        }
        ,)
    let knob_x = if checked {
        x + 22.0_f32
    } else {
        x + 2.0_f32
    }
    native_fill_rect(handle, knob_x, y + 2.0_f32, 18.0_f32, 18.0_f32,
        contrast_color(style.background(), opacity).packed(),)
    let text_x = x + 54.0_f32
    let text_y = centered_text_y(handle, bounds, text)
    native_text(handle, text_x, text_y, text, foreground.packed())
    render_text_decoration(handle, text_x, text_y, text, style, foreground, opacity)
    ret()
}

fn render_slider(handle: usize, bounds: Rect, value: f32, style: Style, opacity: f32) ->() {
    let geometry = slider_track_bounds(bounds, style)
    let radius = slider_thumb_radius(bounds, style)
    if radius <= 0.0_f32 {
        ret()
    }
    let x = geometry.x()
    let width = geometry.width()
    let y = geometry.y()
    let track = apply_opacity(style.background(), opacity)
    let accent = apply_opacity(style.accent_color(), opacity)
    native_round_rect(handle, x, y - 2.0_f32, width, 4.0_f32, 2.0_f32,
        track.packed(), true,)
    native_round_rect(handle, x, y - 2.0_f32, width * value, 4.0_f32, 2.0_f32,
        accent.packed(), true,)
    let thumb_x = x + width * value
    native_circle(handle, thumb_x, y, radius,
        contrast_color(style.accent_color(), opacity).packed(), true,)
    native_circle(handle, thumb_x, y, radius, accent.packed(), false)
    ret()
}

fn render_range_slider(handle: usize, bounds: Rect, widget: Widget,
    style: Style, opacity: f32,) ->() {
    let start = widget.range_start()
    let end = widget.range_end()
    let x = bounds.x() + 9.0_f32
    let width = bounds.width() - 18.0_f32
    let y = bounds.y() + bounds.height() / 2.0_f32
    let lower = if start < end {
        start
    } else {
        end
    }
    let upper = if start < end {
        end
    } else {
        start
    }
    let track = apply_opacity(style.background(), opacity)
    let accent = apply_opacity(style.accent_color(), opacity)
    native_round_rect(handle, x, y - 2.0_f32, width, 4.0_f32, 2.0_f32,
        track.packed(), true,)
    native_round_rect(handle, x + width * lower, y - 3.0_f32,
        width *(upper - lower), 6.0_f32, 3.0_f32, accent.packed(), true,)
    let ticks = widget.range_ticks()
    if ticks >= 2_usize {
        let mut index = 0_usize
        while index < ticks {
            let position = index as f32 /(ticks - 1_usize) as f32
            let selected = position >= lower && position <= upper
            let tick = if selected {
                contrast_color(style.accent_color(), opacity)
            } else {
                apply_opacity(style.foreground(), opacity * 0.48_f32)
            }
            let tick_x = x + width * position
            native_round_rect(handle, tick_x - 0.75_f32, y - 5.0_f32,
                1.5_f32, 10.0_f32, 0.75_f32, tick.packed(), true,)
            index = index + 1_usize
        }
    }
    let lower_x = x + width * lower
    let upper_x = x + width * upper
    let thumb_fill = contrast_color(style.accent_color(), opacity)
    native_circle(handle, lower_x, y, 7.0_f32, thumb_fill.packed(), true)
    native_circle(handle, lower_x, y, 7.0_f32, accent.packed(), false)
    native_circle(handle, upper_x, y, 7.0_f32, thumb_fill.packed(), true)
    native_circle(handle, upper_x, y, 7.0_f32, accent.packed(), false)
    ret()
}

fn render_color_channel(handle: usize, bounds: Rect, widget: Widget) ->() {
    let color = widget.style().background()
    let value = widget.value()
    let channel = widget.attribute("channel").unwrap_or("")
    let alpha = channel == "alpha"
    let x = bounds.x() + 7.0_f32
    let width = bounds.width() - 14.0_f32
    let y = bounds.y() + bounds.height() / 2.0_f32 - 6.0_f32
    let steps = 48_usize
    let step_width = width /(steps as f32)
    let mut index = 0_usize
    while index < steps {
        let amount =(index as f32) /((steps - 1_usize) as f32)
        let step_x = x +(index as f32) * step_width
        let gradient_red = if channel == "red" {
            (amount * 255.0_f32) as u8
        } else {
            color.red()
        }
        let gradient_green = if channel == "green" {
            (amount * 255.0_f32) as u8
        } else {
            color.green()
        }
        let gradient_blue = if channel == "blue" {
            (amount * 255.0_f32) as u8
        } else {
            color.blue()
        }
        if alpha {
            let checker = if index % 2_usize == 0_usize {
                Color::rgb(225_u8, 229_u8, 234_u8)
            } else {
                Color::rgb(255_u8, 255_u8, 255_u8)
            }
            native_fill_rect(handle, step_x, y, step_width + 1.0_f32, 12.0_f32, checker.packed())
            native_fill_rect(handle, step_x, y, step_width + 1.0_f32, 12.0_f32,
                Color::rgba(color.red(), color.green(), color.blue(),(amount * 255.0_f32) as u8).packed(),)
        } else {
            native_fill_rect(handle, step_x, y, step_width + 1.0_f32, 12.0_f32,
                Color::rgb(gradient_red, gradient_green, gradient_blue).packed(),)
        }
        index = index + 1_usize
    }
    native_stroke_rect(handle, x, y, width, 12.0_f32, Color::rgb(92_u8, 103_u8, 116_u8).packed())
    let thumb_x = x + width * value
    native_fill_rect(handle, thumb_x - 5.0_f32, y - 3.0_f32, 10.0_f32, 18.0_f32, Color::rgb(255_u8, 255_u8,
            255_u8,).packed())
    native_stroke_rect(handle, thumb_x - 5.0_f32, y - 3.0_f32, 10.0_f32, 18.0_f32, Color::rgb(31_u8,
            36_u8, 43_u8,).packed())
    ret()
}

fn render_progress(handle: usize, bounds: Rect, value: f32, style: Style, opacity: f32) ->() {
    native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(),
        apply_opacity(style.background(), opacity).packed(),)
    native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width() * value, bounds.height(),
        apply_opacity(style.accent_color(), opacity).packed(),)
    ret()
}

fn contrast_color(background: Color, opacity: f32) -> Color {
    let luminance =(background.red() as u32) * 299_u32 +
    (background.green() as u32) * 587_u32 +(background.blue() as u32) * 114_u32
    ret apply_opacity(if luminance > 150000_u32 {
            Color::rgb(17_u8, 24_u8, 39_u8)
        } else {
            Color::rgb(255_u8, 255_u8, 255_u8)
        }
        , opacity,)
}

// Prefer word/hyphen boundaries, but also wrap identifiers without separators.
// text_index is a caret hit test (nearest boundary), so verify actual width.
fn caption_lines(handle: usize, value: str, width: f32) -> Vec[str] {
    let mut lines = Vec[str]::new()
    if width <= 0.0 {
        ret lines
    }
    let mut start = 0_usize
    while start < value.char_len() {
        let wrapped = wrapped_line(handle, value, start, width)
        let mut end = wrapped.end
        while end > start + 1 && native_text_width(handle, value.slice(start, end - start)) > width {
            end -= 1
        }
        let mut next = if end == wrapped.end {
            wrapped.next
        } else {
            end
        }
        if end < value.char_len() &&(end != wrapped.end || !wrapped.hard_break) {
            let mut boundary = end
            while boundary > start {
                let character = value.slice(boundary - 1, 1)
                if character == "-" || character == "_" || character == " " || character == "\t" {
                    end = boundary
                    next = boundary
                    break
                }
                boundary -= 1
            }
        }
        lines.push(value.slice(start, end - start))
        start = next
        while start < value.char_len() &&(value.slice(start, 1) == " " || value.slice(start, 1) == "\t") {
            start += 1
        }
    }
    ret lines
}

fn icon_card_bounds(bounds: Rect, caption_y: f32) -> Rect {
    // Center within the tile's image area; reserve the caption and its gap.
    let top = bounds.y() + 8.0_f32
    let available_height = caption_y - 8.0_f32 - top
    let available_width = bounds.width() - 16.0_f32
    let mut size = 46.0_f32
    if available_height < size {
        size = available_height
    }
    if available_width < size {
        size = available_width
    }
    if size < 0.0_f32 {
        size = 0.0_f32
    }
    ret Rect::new(bounds.x() +(bounds.width() - size) / 2.0_f32,
        top +(if available_height > 0.0_f32 {
                available_height
            } else {
                0.0_f32
            }
            - size) / 2.0_f32,
        size, size,)
}

#attr(test)
fn icon_card_caption_wraps_without_losing_characters() -> bool {
    let window = Window::create_with_renderer("Caption wrapping", 240, 160, RendererKind::Software)
    if !window.available() {
        ret false
    }
    let name = "rectangle-ellipsis-unbrokenlongidentifier-Привет"
    let mut valid = true
    for width in 48_usize..121_usize {
        let lines = caption_lines(window.handle, name, width as f32)
        let mut joined = ""
        for line in lines {
            joined += line
            if native_text_width(window.handle, line) > width as f32 + 0.01 {
                valid = false
            }
        }
        if joined != name || lines.len() < 2 {
            valid = false
        }
    }
    if caption_lines(window.handle, "", 100.0).len() != 0 ||
    caption_lines(window.handle, "A\nB", 100.0).len() != 2 {
        valid = false
    }
    window.destroy()
    ret valid
}

#attr(test)
fn icon_card_centers_image_above_caption() -> bool {
    let tile = Rect::new(20.0, 30.0, 160.0, 112.0)
    let icon = icon_card_bounds(tile, 118.0)
    let small = icon_card_bounds(Rect::new(0.0, 0.0, 20.0, 20.0), 12.0)
    ret icon.width() == 46.0 && icon.height() == 46.0 &&
    icon.x() + icon.width() / 2.0 == 100.0 &&
    icon.y() + icon.height() / 2.0 == 74.0 &&
    icon.bottom() <= 110.0 && small.width() == 0.0 && small.height() == 0.0
}

fn centered_text_y(handle: usize, bounds: Rect, text: str) -> f32 {
    ret bounds.y() +(bounds.height() - native_text_height(handle, text)) / 2.0_f32
}

fn apply_opacity(color: Color, opacity: f32) -> Color {
    ret Color::rgba(color.red(), color.green(), color.blue(),((color.alpha() as f32) * opacity) as u8)
}

pub fn backend_name() -> str {
    ret native_backend_name()
}
pub fn backend_error() -> str {
    ret native_backend_error()
}

fn ellipsized_text(handle: usize, value: str, width: f32) -> str {
    if native_text_width(handle, value) <= width {
        ret value
    }
    let available = width - native_text_width(handle, "…")
    if available < 0 {
        ret ""
    }
    let mut length = native_text_index(handle, value, available)
    while length > 0 && native_text_width(handle, value.slice(0, length)) > available {
        length -= 1
    }
    ret value.slice(0, length) + "…"
}
