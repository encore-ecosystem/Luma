        }
    }
    pub fn stylesheet(self: Self) -> StyleSheet {
        ret self.stylesheet
    }
    /// Keeps exact cascade inputs local to this window, independently of the
    /// declaration cache shared by copies of a stylesheet.
    pub fn resolve_styles(self: Self, sheet: StyleSheet, root: Widget,
        hovered: str, active: str, focused: str, keyboard_focus: bool,) -> Widget {
        let started = self.updates.begin()
        let result = sheet.apply_retained(root, hovered, active, focused, keyboard_focus, self.cascade)
        self.updates.finish(UiUpdateStage::Styles, started, self.cascade.interaction_evaluations())
        ret result
    }
    /// Resolves the window stylesheet for a declarative tree and explicit
    /// interaction state. Custom retained event loops use this before
    /// reconciling or replacing a subtree, just as Luma's standard runtime
    /// does for a complete application view.
    pub fn style_view(self: Self, root: Widget, hovered: str, active: str,
        focused: str,) -> Widget {
        ret self.resolve_styles(self.stylesheet, root, hovered, active, focused, true)
    }
    pub fn reload_stylesheet(self: Self) -> Window {
        ret Window {
            self.handle, self.width, self.height, self.background, self.direct_context,
            self.direct_window, self.direct_device, self.direct_swapchain,
            self.direct_compositor, self.stylesheet.reload(), RetainedCascade::new(), self.bindings, self.text_cache, self.updates
        }
    }
    pub fn poll(self: Self) -> Event {
