impl for PreparedFrame {
    /// Composes an isolated widget tree above producer images and cached editor UI.
    /// The same layer is replayed on external-image updates and generated frames.
    pub fn with_ui_layer(self: Self, layout: WidgetLayout) -> Self {
        ret self.with_ui_layer_clipped(layout, layout.bounds())
    }
    pub fn with_ui_layer_clipped(self: Self, layout: WidgetLayout, clip: Rect) -> Self {
        if clip.width() <= 0 || clip.height() <= 0 {
            ret self
        }
        let mut layers = Vec[UiLayerSubmission]::new()
        for layer in self.ui_layers {
            layers.push(layer)
        }
        layers.push(UiLayerSubmission { layout, clip })
        ret Self {
            self.layout, self.cached, self.surfaces, self.submissions,
            self.overlays, self.overlay_layouts, self.cached_overlays, self.geometry, self.display_overlays, layers
        }
    }
    pub fn ui_layer_count(self: Self) -> usize {
        ret self.ui_layers.len()
    }

    /// Canvas commands participate in this frame's single presentation and
    /// remain below the interactive overlay layer, clipped to their layout slot.
    pub fn with_canvas(self: Self, id: str, scene: CanvasScene, view: CanvasView) -> Self {
        match self.layout.find_bounds(id) {
            Some(bounds) => {
                ret self.with_display_overlay(scene.display(view, bounds), bounds)
            }
            None => {
                ret self
            }
        }
    }
    /// Adds a canvas using bounds from a retained lookup, without walking the layout tree.
    pub fn with_canvas_at(self: Self, scene: CanvasScene, view: CanvasView, bounds: Rect) -> Self {
        ret self.with_display_overlay(scene.display(view, bounds), bounds)
    }
    pub fn surface(self: Self, id: str) -> Option[SurfaceSlot] {
        for slot in self.surfaces {
            if slot.id == id {
                ret Option[SurfaceSlot]::Some(slot)
            }
        }
        ret Option[SurfaceSlot]::None
    }
    pub fn surfaces(self: Self) -> Vec[SurfaceSlot] {
        ret self.surfaces
    }
    /// Adds producer output only when it exactly matches the prepared slot.
    /// This rejects a completed image from an earlier resize generation.
    pub fn submit_external(self: mut Self, id: str, generation: u64,
        image: ExternalVulkanImage,) -> bool {
        match self.surface(id) {
            Option::Some(slot) => {
                if slot.generation != generation || !image.valid() ||
                image.content_width() != slot.pixel_width ||
                image.content_height() != slot.pixel_height {
                    ret false
                }
            }
            Option::None => {
                ret false
            }
        }
        let mut index = 0_usize
        while index < self.submissions.len() {
            match self.submissions.get(index) {
                Option::Some(submission) => {
                    if submission.id == id {
                        self.submissions.set(index, SurfaceSubmission {
                                id, generation, image
                            }
                            ,)
                        ret true
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        self.submissions.push(SurfaceSubmission {
                id, generation, image
            }
            ,)
        ret true
    }
    pub fn with_overlays(self: Self, overlays: Vec[str],
        layouts: Vec[WidgetLayout], cached: bool,) -> Self {
        ret Self {
            self.layout, self.cached, self.surfaces, self.submissions,
            overlays, layouts, cached, self.geometry, self.display_overlays, self.ui_layers
        }
    }
    /// Paint-only commands above embedded surfaces and below interactive UI.
    /// No widget layout, hit targets, retained-cache changes or extra present.
    pub fn with_display_overlay(self: Self, list: DisplayList, clip: Rect) -> Self {
        let mut overlays = Vec[DisplayOverlay]::new()
        for overlay in self.display_overlays {
            overlays.push(overlay)
        }
        if !list.is_empty() && clip.width() > 0 && clip.height() > 0 {
            overlays.push(DisplayOverlay { list, clip, false })
        }
        ret Self {
            self.layout, self.cached, self.surfaces, self.submissions,
            self.overlays, self.overlay_layouts, self.cached_overlays, self.geometry, overlays, self.ui_layers
        }
    }
    /// Paint within a popup above its retained UI, using this frame's logical clipping.
    pub fn with_foreground_overlay(self: Self, list: DisplayList, clip: Rect) -> Self {
        let mut overlays = Vec[DisplayOverlay]::new()
        for overlay in self.display_overlays {
            overlays.push(overlay)
        }
        if !list.is_empty() && clip.width() > 0 && clip.height() > 0 {
            overlays.push(DisplayOverlay { list, clip, true })
        }
        ret Self {
            self.layout, self.cached, self.surfaces, self.submissions,
            self.overlays, self.overlay_layouts, self.cached_overlays, self.geometry, overlays, self.ui_layers
        }
    }
    pub fn display_overlay_count(self: Self) -> usize {
        ret self.display_overlays.len()
    }
}

impl for Window {
    /// Completes native configure before evaluating a view or computing layout.
    pub fn prepare_geometry(self: Self) -> WindowGeometry {
        let generation = native_prepare_geometry(self.handle)
        ret WindowGeometry {
            self.width(), self.height(), self.pixel_width(), self.pixel_height(),
            self.pixel_density(), generation
        }
    }
    /// Creates a window and preserves the native failure at the call site.
    pub fn try_create(title: str, width: u32, height: u32) ->
    Result[Window, str] {
        ret Window::try_create_with_renderer(
            title, width, height, RendererKind::Auto,)
    }
    pub fn try_create_with_renderer(title: str, width: u32, height: u32,
        renderer: RendererKind,) -> Result[Window, str] {
        ret Window::try_create_with_renderer_features(title, width, height,
            renderer, VulkanFeatureRequest::none(),)
    }
    pub fn try_create_with_renderer_features(title: str, width: u32, height: u32,
        renderer: RendererKind, features: VulkanFeatureRequest,) ->
    Result[Window, str] {
        let window = Window::create_with_renderer_features(
            title, width, height, renderer, features,)
        ret if window.available() {
            Result[Window, str]::Ok(window)
        } else {
            Result[Window, str]::Err(backend_error())
        }
    }
    pub fn create(title: str, width: u32, height: u32) -> Window {
        ret Window::create_with_renderer(title, width, height, RendererKind::Auto)
    }
    /// Creates a window with an explicit rendering policy. `Auto` selects the
    /// Luma-owned Direct Vulkan backend; initialization errors are returned
    /// without selecting another renderer.
    pub fn create_with_renderer(title: str, width: u32, height: u32,
        renderer: RendererKind,) -> Window {
        ret Window::create_with_renderer_features(title, width, height,
            renderer, VulkanFeatureRequest::none(),)
    }
    /// Creates a renderer while negotiating reusable Vulkan capabilities.
    /// Feature requests apply to the Luma-owned Direct Vulkan backend.
    pub fn create_with_renderer_features(title: str, width: u32, height: u32,
        renderer: RendererKind, features: VulkanFeatureRequest,) -> Window {
        match renderer {
            RendererKind::Auto => {
                ret create_direct_vulkan_window(title, width, height, features)
            }
            RendererKind::DirectVulkan => {
                ret create_direct_vulkan_window(title, width, height, features)
            }
            _ => {
            }
        }
        ret Window {
            native_create_with_renderer(title, width, height, renderer.native_value()),
            width, height, white(), 0_usize, 0_usize, 0_usize, 0_usize, 0_usize,
            StyleSheet::default(), RetainedCascade::new(), Option[WindowBindings]::None, WindowTextCache::new(), UiUpdateTracker::new()
        }
    }
    /// A satellite has its own surface/compositor but shares this window's GPU.
    pub fn create_shared(self: Self, title: str, width: u32, height: u32) -> Result[Window, str] {
        if !self.available() || self.direct_context == 0 {
            ret Result[Window, str]::Err("A shared window requires a live Direct Vulkan owner")
        }
        let handle = native_create_with_renderer(title, width, height, 3)
        if handle == 0 {
            ret Result[Window, str]::Err(backend_error())
        }
        let context = direct_context_create_shared(native_platform_handle(handle), self.direct_context)
        if !direct_context_available(context) {
            let message = direct_context_error(context)
            let _closed = failed_direct_window(handle, context, 0, message, width, height)
            ret Result[Window, str]::Err(message)
        }
        let surface = direct_context_surface(context)
        let device = direct_context_device(context)
        let swapchain = direct_context_swapchain(context)
        let compositor = direct_ui_create(device, swapchain)
        if !direct_ui_available(compositor) || !native_direct_compositor_bind(handle, compositor) {
            let message = direct_ui_error(compositor)
            let _closed = failed_direct_window(handle, context, compositor, message, width, height)
            ret Result[Window, str]::Err(message)
        }
        ret Result[Window, str]::Ok(Window {
                handle, width, height, self.background, context, surface, device, swapchain, compositor,
                self.stylesheet, RetainedCascade::new(), Option[WindowBindings]::None, WindowTextCache::new(), UiUpdateTracker::new()
            }
            ,)
    }
    pub fn available(self: Self) -> bool {
        ret self.handle != 0_usize
    }
    /// Cumulative host time inside direct Vulkan acquire/present calls. This
    /// is presentation overhead/wait, not a GPU timestamp measurement.
    /// Enables allocation-free CPU diagnostics for this window's retained updates.
    pub fn set_ui_update_profiling(self: Self, enabled: bool) ->() {
        self.updates.set_enabled(enabled)
    }
    /// Cumulative bindings, CSS, reconciliation, layout and paint work. Copies
    /// of one Window share its tracker; different windows remain independent.
    pub fn ui_update_timings(self: Self) -> UiUpdateTimings {
        ret self.updates.snapshot()
    }
    pub fn ui_timings(self: Self) -> UiTimings {
        ret UiTimings {
            luma_vk_ui_timing_value(self.direct_compositor, 0_u32),
            luma_vk_ui_timing_value(self.direct_compositor, 1_u32),
            luma_vk_ui_timing_value(self.direct_compositor, 2_u32),
            luma_vk_ui_timing_value(self.direct_compositor, 3_u32)
        }
    }
    pub fn presentation_ns(self: Self) -> u64 {
        ret luma_vk_ui_presentation_ns(self.direct_compositor)
    }
    pub fn geometry_upload_bytes(self: Self) -> u64 {
        ret luma_vk_ui_upload_bytes(self.direct_compositor)
    }
    /// Changes presentation pacing without recreating the window. Normal Luma
    /// applications use VSync; simulation and profiling tools may opt into
    /// Immediate presentation.
    pub fn set_present_mode(self: Self, mode: PresentMode) -> bool {
        ret self.handle != 0_usize &&
        native_set_present_mode(self.handle, mode.native_value())
    }
    pub fn try_set_present_mode(self: Self, mode: PresentMode) ->
    Result[bool, str] {
        ret if self.set_present_mode(mode) {
            Result[bool, str]::Ok(true)
        } else {
            Result[bool, str]::Err(backend_error())
        }
    }
    pub fn is_open(self: Self) -> bool {
        ret self.handle != 0_usize && native_open(self.handle)
    }
    pub fn width(self: Self) -> u32 {
        let value = if self.handle == 0_usize {
            0_u32
        } else {
            native_width(self.handle)
        }
        ret if value == 0_u32 {
            self.width
        } else {
            value
        }
    }
    pub fn height(self: Self) -> u32 {
        let value = if self.handle == 0_usize {
            0_u32
        } else {
            native_height(self.handle)
        }
        ret if value == 0_u32 {
            self.height
        } else {
            value
        }
    }
    pub fn pixel_width(self: Self) -> u32 {
        let value = if self.handle == 0_usize {
            0_u32
        } else {
            native_pixel_width(self.handle)
        }
        ret if value == 0_u32 {
            ((self.width() as f32) * self.pixel_density()) as u32
        } else {
            value
        }
    }
    pub fn pixel_height(self: Self) -> u32 {
        let value = if self.handle == 0_usize {
            0_u32
        } else {
            native_pixel_height(self.handle)
        }
        ret if value == 0_u32 {
            ((self.height() as f32) * self.pixel_density()) as u32
        } else {
            value
        }
    }
    pub fn pixel_density(self: Self) -> f32 {
        if self.handle == 0_usize {
            ret 1.0_f32
        }
        ret native_pixel_density(self.handle)
    }
    /// Number of complete application frames submitted by this window.
    /// Transparent compositor-setup work is intentionally excluded.
    pub fn presented_frames(self: Self) -> u64 {
        ret if self.handle == 0_usize {
            0_u64
        } else {
            native_present_count(self.handle)
        }
    }
    /// Reads one logical pixel from the active frame. This is a synchronous
    /// diagnostic operation intended for screenshots and visual regression
    /// tests, never for an interactive frame loop.
    /// Creates an owned cross-thread wake capability for this window.
    pub fn waker(self: Self) -> WindowWaker {
        unsafe {
            ret WindowWaker { luma_window_waker(self.handle) }
        }
    }
    /// Request a readback of the next fully composed application frame.
    pub fn request_capture(self: Self) -> bool {
        unsafe {
            ret luma_window_capture_request(self.handle)
        }
    }
    /// Encodes a requested completed frame. Crop is in physical pixels; an empty
    /// rectangle captures the whole client area. Empty PNG means not ready.
    pub fn capture_png(self: Self, crop: Rect, maximum: u32) -> CapturedFrame {
        let png = unsafe {
            luma_window_capture_png(self.handle, crop.x() as u32, crop.y() as u32, crop.width() as u32, crop.height() as u32, maximum)
        }
        ret CapturedFrame {
            png, unsafe {
                luma_window_capture_frame(self.handle)
            }
            , png_word(png, 16), png_word(png, 20)
        }
    }
    pub fn read_pixel(self: Self, x: u32, y: u32) -> Color {
        let packed = if self.handle == 0_usize {
            0_u32
        } else {
            native_read_pixel(self.handle, x, y)
        }
        ret Color::rgba((packed >> 24) as u8,(packed >> 16) as u8,
            (packed >> 8) as u8, packed as u8,)
    }
    /// Returns the SDL renderer selected for this window, for example
    /// "vulkan", "metal", "direct3d12", "opengl", or "software".
    pub fn renderer_name(self: Self) -> str {
        if self.handle == 0_usize {
            ret "unavailable"
        }
        ret native_renderer_name(self.handle)
    }
    /// Reports both the SDL backend and the physical adapter. Software Vulkan
    /// implementations such as llvmpipe are detected by adapter name.
    pub fn renderer_info(self: Self) -> RendererInfo {
        let backend = self.renderer_name()
        let device = if self.direct_context != 0_usize {
            direct_adapter_name(self.direct_context, 0_usize)
        } else {
            if self.handle == 0_usize {
                "unavailable"
            } else {
                native_renderer_device_name(self.handle)
            }
        }
        ret RendererInfo::with_device(backend, device)
    }
    pub fn vulkan_interop(self: Self) -> VulkanInterop {
        if self.direct_context != 0_usize && self.direct_device != 0_usize {
            ret VulkanInterop::new(direct_context_instance(self.direct_context),
                direct_context_physical_device(self.direct_context, 0_usize),
                direct_device_handle(self.direct_device),
                direct_device_queue_family(self.direct_device), self.direct_swapchain,
                self.direct_device,
                VulkanFeatures::from_mask(
                    direct_device_requested_features(self.direct_device),),
                VulkanFeatures::from_mask(
                    direct_device_enabled_features(self.direct_device),),)
        }
        if self.handle == 0_usize || self.renderer_name() != "vulkan" {
            ret VulkanInterop::new(0_usize, 0_usize, 0_usize,
                4294967295_u32, 0_usize, 0_usize,
                VulkanFeatures::none(), VulkanFeatures::none(),)
        }
        ret VulkanInterop::new(native_vulkan_instance(self.handle),
            native_vulkan_physical_device(self.handle),
            native_vulkan_device(self.handle),
            native_vulkan_graphics_queue_family(self.handle), 0_usize, 0_usize,
            VulkanFeatures::none(), VulkanFeatures::none(),)
    }
    /// Wraps an offscreen VkImage created on `vulkan_interop().device()`.
    /// No pixel upload occurs. The producer must synchronize its queue and
    /// transition the image to the supplied shader-readable layout first.
    pub fn bind_external_vulkan_image(self: Self, image: ExternalVulkanImage) -> bool {
