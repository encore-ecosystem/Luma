/// Cumulative host-side UI counters. Difference successive snapshots for one
/// frame. These are CPU durations; GPU timestamps are a separate facility.
pub struct UiTimings {
    acquire_ns: u64
    present_ns: u64
    gpu_preparation_ns: u64
    geometry_upload_bytes: u64
}

impl for UiTimings {
    pub fn acquire_ns(self: Self) -> u64 {
        ret self.acquire_ns
    }
    pub fn present_ns(self: Self) -> u64 {
        ret self.present_ns
    }
    pub fn gpu_preparation_ns(self: Self) -> u64 {
        ret self.gpu_preparation_ns
    }
    pub fn geometry_upload_bytes(self: Self) -> u64 {
        ret self.geometry_upload_bytes
    }
}

