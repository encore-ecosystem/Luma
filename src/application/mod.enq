            ret Event::none()
        }
        let kind = native_poll(self.handle)
        ret Event {
            kind,
            native_event_x(self.handle), native_event_y(self.handle),
            native_event_dx(self.handle), native_event_dy(self.handle),
            native_event_buttons(self.handle),
            native_event_key(self.handle), native_event_modifiers(self.handle), native_event_wheel_x(self.handle),
            native_event_wheel_y(self.handle), native_event_text(self.handle),
            native_event_timestamp_ns(self.handle)
        }
    }
    /// SDL monotonic time in the same domain as Event.timestamp_ns().
    pub fn input_clock_ns(self: Self) -> u64 {
        ret ui_native::native_input_clock_ns(self.handle)
    }
    pub fn set_cursor(self: Self, cursor: u32) -> bool {
        if self.handle == 0_usize {
            ret false
        }
