impl for OutlineStyle {
    pub fn none() -> OutlineStyle {
        ret OutlineStyle {
            0.0_f32, transparent(), 0.0_f32
        }
    }
    pub fn new(width: f32, color: Color, offset: f32) -> OutlineStyle {
        ret OutlineStyle {
            if width > 0.0_f32 {
                width
            } else {
                0.0_f32
            }
            , color, offset
        }
    }
    pub fn width(self: Self) -> f32 {
        ret self.width
    }
    pub fn color(self: Self) -> Color {
        ret self.color
    }
    pub fn offset(self: Self) -> f32 {
        ret self.offset
    }
}

