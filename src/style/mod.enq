        }
    }
    pub fn with_displayed(self: Self, value: bool) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink, self.justify, self.align,
            value, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
            self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
