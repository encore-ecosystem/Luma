pub struct PositionStyle {
    absolute: bool
    relative: bool
    top: f32
    right: f32
    bottom: f32
    left: f32
    top_set: bool
    right_set: bool
    bottom_set: bool
    left_set: bool
    z_index: i32
}

impl for PositionStyle {
    pub fn default() -> PositionStyle {
        ret PositionStyle {
            false, false, 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, false, false, false, false, 0_i32
        }
    }
    pub fn with_absolute(self: Self, value: bool) -> PositionStyle {
        ret PositionStyle {
            value, if value {
                false
            } else {
                self.relative
            }
            , self.top, self.right, self.bottom, self.left,
            self.top_set, self.right_set, self.bottom_set, self.left_set, self.z_index
        }
    }
    pub fn with_relative(self: Self, value: bool) -> PositionStyle {
        ret PositionStyle {
            if value {
                false
            } else {
                self.absolute
            }
            , value, self.top, self.right, self.bottom, self.left,
            self.top_set, self.right_set, self.bottom_set, self.left_set, self.z_index
        }
    }
    pub fn with_top(self: Self, value: f32) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, value, self.right, self.bottom, self.left, true, self.right_set,
            self.bottom_set, self.left_set, self.z_index
        }
    }
    pub fn with_right(self: Self, value: f32) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, value, self.bottom, self.left, self.top_set, true,
            self.bottom_set, self.left_set, self.z_index
        }
    }
    pub fn with_bottom(self: Self, value: f32) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, value, self.left, self.top_set, self.right_set,
            true, self.left_set, self.z_index
        }
    }
    pub fn with_left(self: Self, value: f32) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, self.bottom, value, self.top_set, self.right_set,
            self.bottom_set, true, self.z_index
        }
    }
    pub fn without_top(self: Self) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, self.bottom, self.left, false, self.right_set,
            self.bottom_set, self.left_set, self.z_index
        }
    }
    pub fn without_right(self: Self) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set,
            false, self.bottom_set, self.left_set, self.z_index
        }
    }
    pub fn without_bottom(self: Self) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set,
            self.right_set, false, self.left_set, self.z_index
        }
    }
    pub fn without_left(self: Self) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set,
            self.right_set, self.bottom_set, false, self.z_index
        }
    }
    pub fn with_z_index(self: Self, value: i32) -> PositionStyle {
        ret PositionStyle {
            self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set,
            self.right_set, self.bottom_set, self.left_set, value
        }
    }
    pub fn absolute(self: Self) -> bool {
        ret self.absolute
    }
    pub fn relative(self: Self) -> bool {
        ret self.relative
    }
    pub fn top(self: Self) -> f32 {
        ret self.top
    }
    pub fn right(self: Self) -> f32 {
        ret self.right
    }
    pub fn bottom(self: Self) -> f32 {
        ret self.bottom
    }
    pub fn left(self: Self) -> f32 {
        ret self.left
    }
    pub fn top_set(self: Self) -> bool {
        ret self.top_set
    }
    pub fn right_set(self: Self) -> bool {
        ret self.right_set
    }
    pub fn bottom_set(self: Self) -> bool {
        ret self.bottom_set
    }
    pub fn left_set(self: Self) -> bool {
        ret self.left_set
    }
    pub fn z_index(self: Self) -> i32 {
        ret self.z_index
    }
}

pub struct RelativeSize {
    width: f32
    height: f32
}

impl for RelativeSize {
    pub fn default() -> RelativeSize {
        ret RelativeSize {
            - 1.0_f32, - 1.0_f32
        }
    }
    pub fn with_width(self: Self, value: f32) -> RelativeSize {
        ret RelativeSize {
            value, self.height
        }
    }
    pub fn with_height(self: Self, value: f32) -> RelativeSize {
        ret RelativeSize {
            self.width, value
        }
    }
    pub fn width(self: Self) -> f32 {
        ret self.width
    }
    pub fn height(self: Self) -> f32 {
        ret self.height
    }
}

pub struct ScrollOffset {
    x: f32
    y: f32
}

pub struct GridPlacement {
    column: usize
    row: usize
    column_end: usize
    row_end: usize
    column_span: usize
    row_span: usize
}

impl for GridPlacement {
    pub fn auto() -> GridPlacement {
        ret GridPlacement {
            0_usize, 0_usize, 0_usize, 0_usize, 0_usize, 0_usize
        }
    }
    pub fn with_column(self: Self, value: usize) -> GridPlacement {
        ret GridPlacement {
            value, self.row, self.column_end, self.row_end, self.column_span, self.row_span
        }
    }
    pub fn with_row(self: Self, value: usize) -> GridPlacement {
        ret GridPlacement {
            self.column, value, self.column_end, self.row_end, self.column_span, self.row_span
        }
    }
    pub fn with_column_end(self: Self, value: usize) -> GridPlacement {
        ret GridPlacement {
            self.column, self.row, value, self.row_end, self.column_span, self.row_span
        }
    }
    pub fn with_row_end(self: Self, value: usize) -> GridPlacement {
        ret GridPlacement {
            self.column, self.row, self.column_end, value, self.column_span, self.row_span
        }
    }
    pub fn with_column_span(self: Self, value: usize) -> GridPlacement {
        ret GridPlacement {
            self.column, self.row, self.column_end, self.row_end, value, self.row_span
        }
    }
    pub fn with_row_span(self: Self, value: usize) -> GridPlacement {
        ret GridPlacement {
            self.column, self.row, self.column_end, self.row_end, self.column_span, value
        }
    }
    pub fn column(self: Self) -> usize {
        ret self.column
    }
    pub fn row(self: Self) -> usize {
        ret self.row
    }
    pub fn column_span(self: Self) -> usize {
        ret if self.column_span > 0_usize {
            self.column_span
        } elif self.column > 0_usize && self.column_end > self.column {
            self.column_end - self.column
        } else {
            1_usize
        }
    }
    pub fn row_span(self: Self) -> usize {
        ret if self.row_span > 0_usize {
            self.row_span
        } elif self.row > 0_usize && self.row_end > self.row {
            self.row_end - self.row
        } else {
            1_usize
        }
    }
}

impl for ScrollOffset {
    pub fn zero() -> ScrollOffset {
        ret ScrollOffset {
            0.0_f32, 0.0_f32
        }
    }
    pub fn new(x: f32, y: f32) -> ScrollOffset {
        ret ScrollOffset {
            if x > 0.0_f32 {
                x
            } else {
                0.0_f32
            }
            , if y > 0.0_f32 {
                y
            } else {
                0.0_f32
            }
        }
    }
    pub fn x(self: Self) -> f32 {
        ret self.x
    }
    pub fn y(self: Self) -> f32 {
        ret self.y
    }
}

pub struct LayoutStyle {
    margin: Insets
    width: f32
    height: f32
    min_width: f32
    min_height: f32
    max_width: f32
    max_height: f32
    flex: FlexStyle
    overflow_hidden: bool
    position: PositionStyle
    relative: RelativeSize
    scroll: ScrollOffset
    content_box: bool
    grid_placement: GridPlacement
}

impl for LayoutStyle {
    pub fn with_transition_sample(self: Self, sample: LayoutStyle, properties: str) -> Self {
        let mut result = self
        result.margin = transition_insets(result.margin, sample.margin, properties, "margin")
        if transition_selects(properties, "width", "") {
            result.width = sample.width
        }
        if transition_selects(properties, "height", "") {
            result.height = sample.height
        }
        if transition_selects(properties, "min-width", "") {
            result.min_width = sample.min_width
        }
        if transition_selects(properties, "min-height", "") {
            result.min_height = sample.min_height
        }
        if transition_selects(properties, "max-width", "") {
            result.max_width = sample.max_width
        }
        if transition_selects(properties, "max-height", "") {
            result.max_height = sample.max_height
        }
        if transition_selects(properties, "flex-basis", "flex") {
            result.flex.basis = sample.flex.basis
        }
        if transition_selects(properties, "flex-grow", "flex") {
            result.flex.grow = sample.flex.grow
        }
        if transition_selects(properties, "flex-shrink", "flex") {
            result.flex.shrink = sample.flex.shrink
        }
        if transition_selects(properties, "row-gap", "gap") {
            result.flex.row_gap = sample.flex.row_gap
        }
        if transition_selects(properties, "column-gap", "gap") {
            result.flex.column_gap = sample.flex.column_gap
        }
        if transition_selects(properties, "width", "") {
            result.relative.width = sample.relative.width
        }
        if transition_selects(properties, "height", "") {
            result.relative.height = sample.relative.height
        }
        if transition_selects(properties, "top", "") && result.position.top_set() && sample.position.top_set() {
            result.position = result.position.with_top(sample.position.top())
        }
        if transition_selects(properties, "right", "") && result.position.right_set() && sample.position.right_set() {
            result.position = result.position.with_right(sample.position.right())
        }
        if transition_selects(properties, "bottom", "") && result.position.bottom_set() && sample.position.bottom_set() {
            result.position = result.position.with_bottom(sample.position.bottom())
        }
        if transition_selects(properties, "left", "") && result.position.left_set() && sample.position.left_set() {
            result.position = result.position.with_left(sample.position.left())
        }
        ret result
    }
    pub fn default() -> LayoutStyle {
        ret LayoutStyle {
            Insets::all(0.0_f32), - 1.0_f32, - 1.0_f32,
            0.0_f32, 0.0_f32, 1000000.0_f32, 1000000.0_f32,
            FlexStyle::default(), false, PositionStyle::default(), RelativeSize::default(), ScrollOffset::zero(),
            false, GridPlacement::auto()
        }
    }
    pub fn with_margin(self: Self, value: Insets) -> LayoutStyle {
        ret LayoutStyle {
            value, self.width, self.height, self.min_width, self.min_height, self.max_width, self.max_height,
            self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box,
            self.grid_placement
        }
    }
    pub fn with_width(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle {
            self.margin, value, self.height, self.min_width, self.min_height, self.max_width, self.max_height,
            self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box,
            self.grid_placement
        }
    }
    pub fn with_height(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle {
            self.margin, self.width, value, self.min_width, self.min_height, self.max_width, self.max_height,
