    pub fn with_order(self: Self, value: i32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template,
            self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column,
            self.auto_flow_dense, self.self_align, value, self.wrap, self.wrap_reverse, self.row_gap,
            self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_wrap(self: Self, value: bool, reverse: bool) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template,
            self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column,
            self.auto_flow_dense, self.self_align, self.order,
            value, value && reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_row_gap(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template,
            self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column,
            self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, if value >= 0.0_f32 {
                value
            } else {
                0.0_f32
            }
            , self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_column_gap(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
