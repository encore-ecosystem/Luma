    pub fn with_columns(self: Self, value: usize) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, if value > 0_usize {
                value
            } else {
                1_usize
            }
            , "", self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column,
