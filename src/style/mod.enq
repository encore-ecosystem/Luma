pub struct Style {
    background: Color
    foreground: Color
    border_color: Color
    border_width: f32
    radius: f32
    padding: Insets
    gap: f32
    font_family: str
    font_size: f32
    font_weight: u32
    text_align: usize
    opacity: f32
    layout: LayoutStyle
    foreground_set: bool
    font_family_set: bool
    font_size_set: bool
    font_weight_set: bool
    text_align_set: bool
    visible: bool
    pointer_events: bool
    visibility_set: bool
    pointer_events_set: bool
    outline: OutlineStyle
    shadow: ShadowStyle
    decoration: TextDecorationStyle
    gradient: LinearGradient
    interaction: InteractionStyle
}

impl for Style {
    /// Keep target state except for the animatable properties explicitly selected by CSS.
    pub fn with_transition_sample(self: Self, sample: Style, properties: str) -> Self {
        let mut result = self
        if transition_selects(properties, "background-color", "background") {
            result.background = sample.background
        }
        if transition_selects(properties, "color", "") {
            result.foreground = sample.foreground
        }
        if transition_selects(properties, "border-color", "border") {
            result.border_color = sample.border_color
        }
        if transition_selects(properties, "border-width", "border") {
            result.border_width = sample.border_width
        }
        if transition_selects(properties, "border-radius", "") {
            result.radius = sample.radius
        }
        if transition_selects(properties, "gap", "") {
            result.gap = sample.gap
        }
        if transition_selects(properties, "font-size", "font") {
            result.font_size = sample.font_size
        }
        if transition_selects(properties, "font-weight", "font") {
            result.font_weight = sample.font_weight
        }
        if transition_selects(properties, "opacity", "") {
            result.opacity = sample.opacity
        }
