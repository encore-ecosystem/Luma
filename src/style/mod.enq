    }
    pub fn with_auto_flow(self: Self, column: bool, dense: bool) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template,
            self.row_template,
            self.auto_column_template, self.auto_row_template, column, dense, self.self_align, self.order,
