/// A two-stop background gradient. `vertical` selects top-to-bottom;
/// otherwise the gradient is left-to-right.
pub struct LinearGradient {
    start: Color
    end: Color
    vertical: bool
    enabled: bool
}

fn transition_selects(properties: str, name: str, shorthand: str) -> bool {
    let mut token = ""
    let mut index = 0_usize
    while index <= properties.char_len() {
        let character = if index == properties.char_len() {
            ","
        } else {
            properties.slice(index, 1_usize)
        }
        if character == "," {
            if token == "all" || token == name ||(shorthand != "" && token == shorthand) {
                ret true
            }
            token = ""
        } elif character != " " && character != "\t" && character != "\n" && character != "\r" {
            token = token + character
        }
        index += 1_usize
    }
    ret false
}
fn transition_insets(target: Insets, sample: Insets, properties: str, name: str) -> Insets {
    ret Insets::only(
        if transition_selects(properties, name + "-top", name) {
            sample.top()
        } else {
            target.top()
        }
        ,
        if transition_selects(properties, name + "-right", name) {
            sample.right()
        } else {
            target.right()
        }
        ,
        if transition_selects(properties, name + "-bottom", name) {
            sample.bottom()
        } else {
            target.bottom()
        }
        ,
        if transition_selects(properties, name + "-left", name) {
            sample.left()
        } else {
            target.left()
        }
        ,)
}

/// CSS transition property, timing, delay and easing declarations.
pub struct TransitionStyle {
    properties: str
    durations: str
    delays: str
    easings: str
}

impl for TransitionStyle {
    pub fn none() -> Self {
        ret Self {
            "none", "0ms", "0ms", "ease"
        }
    }
    pub fn new(properties: str, durations: str, delays: str, easings: str) -> Self {
        ret Self {
            properties, durations, delays, easings
        }
    }
    pub fn with_properties(self: Self, value: str) -> Self {
        ret Self {
            value, self.durations, self.delays, self.easings
        }
    }
    pub fn with_durations(self: Self, value: str) -> Self {
        ret Self {
            self.properties, value, self.delays, self.easings
        }
    }
    pub fn with_delays(self: Self, value: str) -> Self {
        ret Self {
            self.properties, self.durations, value, self.easings
        }
    }
    pub fn with_easings(self: Self, value: str) -> Self {
        ret Self {
            self.properties, self.durations, self.delays, value
        }
    }
    pub fn properties(self: Self) -> str {
        ret self.properties
    }
    pub fn durations(self: Self) -> str {
        ret self.durations
    }
    pub fn delays(self: Self) -> str {
        ret self.delays
    }
    pub fn easings(self: Self) -> str {
        ret self.easings
    }
}

