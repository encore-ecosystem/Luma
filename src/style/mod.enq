        }
    }
    pub fn with_self_align(self: Self, value: i32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template,
            self.row_template, self.auto_column_template, self.auto_row_template,
