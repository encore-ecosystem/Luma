    /// visibility, pointer behavior, accent and cursor capabilities.
    #attr(borrowed_self)
    pub fn inheritance_equivalent(self: Self, other: Style) -> bool {
        ret self.foreground.packed() == other.foreground.packed() &&
        self.font_family == other.font_family && self.font_size == other.font_size &&
        self.font_weight == other.font_weight && self.text_align == other.text_align &&
        self.visible == other.visible && self.pointer_events == other.pointer_events &&
        self.interaction.accent.packed() == other.interaction.accent.packed() &&
        self.interaction.accent_set == other.interaction.accent_set &&
        self.interaction.cursor == other.interaction.cursor &&
        self.interaction.cursor_set == other.interaction.cursor_set
    }
    #attr(borrowed_self)
    pub fn background(self: Self) -> Color {
        ret self.background
    }
    #attr(borrowed_self)
    pub fn foreground(self: Self) -> Color {
        ret self.foreground
    }
    #attr(borrowed_self)
    pub fn border_color(self: Self) -> Color {
        ret self.border_color
    }
    #attr(borrowed_self)
    pub fn border_width(self: Self) -> f32 {
        ret self.border_width
    }
    #attr(borrowed_self)
    pub fn radius(self: Self) -> f32 {
        ret self.radius
    }
    #attr(borrowed_self)
    pub fn padding(self: Self) -> Insets {
        ret self.padding
    }
    #attr(borrowed_self)
    pub fn gap(self: Self) -> f32 {
        ret self.gap
    }
    #attr(borrowed_self)
    pub fn font_family(self: Self) -> str {
        ret self.font_family
    }
    #attr(borrowed_self)
    pub fn font_size(self: Self) -> f32 {
        ret self.font_size
    }
    #attr(borrowed_self)
    pub fn font_weight(self: Self) -> u32 {
        ret self.font_weight
    }
    #attr(borrowed_self)
    pub fn text_align(self: Self) -> usize {
        ret self.text_align
    }
    #attr(borrowed_self)
    pub fn opacity(self: Self) -> f32 {
        ret self.opacity
    }
    #attr(borrowed_self)
    pub fn visible(self: Self) -> bool {
        ret self.visible
    }
    #attr(borrowed_self)
    pub fn pointer_events(self: Self) -> bool {
        ret self.pointer_events
    }
    #attr(borrowed_self)
    pub fn outline(self: Self) -> OutlineStyle {
        ret self.outline
    }
    #attr(borrowed_self)
    pub fn shadow(self: Self) -> ShadowStyle {
        ret self.shadow
    }
    #attr(borrowed_self)
    pub fn decoration(self: Self) -> TextDecorationStyle {
        ret self.decoration
    }
    #attr(borrowed_self)
    pub fn linear_gradient(self: Self) -> LinearGradient {
        ret self.gradient
    }
    #attr(borrowed_self)
    pub fn accent_color(self: Self) -> Color {
        ret self.interaction.accent
    }
    #attr(borrowed_self)
    pub fn pointer_cursor(self: Self) -> u32 {
        ret self.interaction.cursor
    }
    #attr(borrowed_self)
    pub fn transition(self: Self) -> TransitionStyle {
        ret self.interaction.transition
    }
    #attr(borrowed_self)
    pub fn layout(self: Self) -> LayoutStyle {
        ret self.layout
    }
    /// Returns whether changing to `other` preserves widget geometry.
    #attr(borrowed_self)
    pub fn layout_equivalent(self: Self, other: Style) -> bool {
        ret self.border_width == other.border_width &&
        insets_equal(self.padding, other.padding) &&
        self.gap == other.gap &&
        self.font_family == other.font_family &&
        self.font_size == other.font_size &&
        self.font_weight == other.font_weight &&
        layout_style_equal(self.layout, other.layout)
    }
    /// Returns whether every rendered and inherited style property is equal.
    #attr(borrowed_self)
    pub fn equivalent(self: Self, other: Style) -> bool {
        ret self.layout_equivalent(other) &&
        self.background.packed() == other.background.packed() &&
        self.foreground.packed() == other.foreground.packed() &&
        self.border_color.packed() == other.border_color.packed() &&
        self.radius == other.radius && self.text_align == other.text_align &&
        self.opacity == other.opacity && self.foreground_set == other.foreground_set &&
        self.font_family_set == other.font_family_set &&
        self.font_size_set == other.font_size_set &&
        self.font_weight_set == other.font_weight_set &&
        self.text_align_set == other.text_align_set &&
        self.visible == other.visible &&
        self.pointer_events == other.pointer_events &&
        self.visibility_set == other.visibility_set &&
        self.pointer_events_set == other.pointer_events_set &&
        outline_equal(self.outline, other.outline) &&
        shadow_equal(self.shadow, other.shadow) &&
        decoration_equal(self.decoration, other.decoration) &&
        gradient_equal(self.gradient, other.gradient) &&
        self.interaction.accent.packed() == other.interaction.accent.packed() &&
        self.interaction.accent_set == other.interaction.accent_set &&
        self.interaction.cursor == other.interaction.cursor &&
        self.interaction.cursor_set == other.interaction.cursor_set &&
        transition_style_equal(self.interaction.transition, other.interaction.transition)
    }
}

fn transition_style_equal(lhs: TransitionStyle, rhs: TransitionStyle) -> bool {
    ret lhs.properties() == rhs.properties() && lhs.durations() == rhs.durations() &&
    lhs.delays() == rhs.delays() && lhs.easings() == rhs.easings()
}

#attr(test)
fn inherited_style_comparison_matches_resolved_child_styles() -> bool {
    let base = Style::default()
    for left in 0..16 {
        let first = if left == 0 {
            base
        } elif left == 1 {
            base.with_foreground(Color::rgb(1, 2, 3))
        } elif left == 2 {
            base.with_font_family("Monospace")
        } elif left == 3 {
            base.with_font_size(20_f32)
        } elif left == 4 {
            base.with_font_weight(700_u32)
        } elif left == 5 {
            base.with_text_align(text_center())
        } elif left == 6 {
            base.with_visibility(false)
        } elif left == 7 {
            base.with_pointer_events(false)
        } elif left == 8 {
            base.with_accent_color(Color::rgb(1, 2, 3))
        } elif left == 9 {
            base.with_pointer_cursor(2_u32)
        } elif left == 10 {
            base.with_background(Color::rgb(1, 2, 3))
        } elif left == 11 {
            base.with_opacity(0.5_f32)
        } elif left == 12 {
            base.with_padding(Insets::all(10_f32))
        } elif left == 13 {
            base.with_gap(20_f32)
        } elif left == 14 {
            base.with_accent_color(base.accent_color())
        } else {
            base.with_pointer_cursor(base.pointer_cursor())
        }
        let normalized = Style::default().inherit_text(first)
        if first.inheritance_equivalent(base) != normalized.equivalent(Style::default().inherit_text(base)) ||
        !first.inheritance_equivalent(first) {
            ret false
        }
    }
    ret true
}

fn insets_equal(lhs: Insets, rhs: Insets) -> bool {
    ret lhs.top() == rhs.top() && lhs.right() == rhs.right() &&
    lhs.bottom() == rhs.bottom() && lhs.left() == rhs.left()
}

fn flex_style_equal(lhs: FlexStyle, rhs: FlexStyle) -> bool {
    ret lhs.direction == rhs.direction && lhs.direction_set == rhs.direction_set &&
    lhs.basis == rhs.basis && lhs.grow == rhs.grow &&
    lhs.shrink == rhs.shrink && lhs.justify == rhs.justify &&
    lhs.align == rhs.align && lhs.displayed == rhs.displayed &&
    lhs.grid == rhs.grid && lhs.columns == rhs.columns &&
    lhs.column_template == rhs.column_template &&
    lhs.row_template == rhs.row_template &&
    lhs.auto_column_template == rhs.auto_column_template &&
    lhs.auto_row_template == rhs.auto_row_template &&
    lhs.auto_flow_column == rhs.auto_flow_column &&
    lhs.auto_flow_dense == rhs.auto_flow_dense &&
    lhs.self_align == rhs.self_align && lhs.order == rhs.order &&
    lhs.wrap == rhs.wrap && lhs.wrap_reverse == rhs.wrap_reverse &&
    lhs.row_gap == rhs.row_gap && lhs.column_gap == rhs.column_gap &&
    lhs.direction_reverse == rhs.direction_reverse &&
    lhs.align_content == rhs.align_content
}

fn position_equal(lhs: PositionStyle, rhs: PositionStyle) -> bool {
    ret lhs.absolute == rhs.absolute && lhs.relative == rhs.relative &&
    lhs.top == rhs.top && lhs.right == rhs.right &&
    lhs.bottom == rhs.bottom && lhs.left == rhs.left &&
    lhs.top_set == rhs.top_set && lhs.right_set == rhs.right_set &&
    lhs.bottom_set == rhs.bottom_set && lhs.left_set == rhs.left_set &&
    lhs.z_index == rhs.z_index
}

fn grid_placement_equal(lhs: GridPlacement, rhs: GridPlacement) -> bool {
    ret lhs.column == rhs.column && lhs.row == rhs.row &&
    lhs.column_end == rhs.column_end && lhs.row_end == rhs.row_end &&
    lhs.column_span == rhs.column_span && lhs.row_span == rhs.row_span
}

fn layout_style_equal(lhs: LayoutStyle, rhs: LayoutStyle) -> bool {
    ret insets_equal(lhs.margin, rhs.margin) && lhs.width == rhs.width &&
    lhs.height == rhs.height && lhs.min_width == rhs.min_width &&
    lhs.min_height == rhs.min_height && lhs.max_width == rhs.max_width &&
    lhs.max_height == rhs.max_height && flex_style_equal(lhs.flex, rhs.flex) &&
    lhs.overflow_hidden == rhs.overflow_hidden &&
    position_equal(lhs.position, rhs.position) &&
    lhs.relative.width == rhs.relative.width &&
    lhs.relative.height == rhs.relative.height &&
    lhs.scroll.x == rhs.scroll.x && lhs.scroll.y == rhs.scroll.y &&
    lhs.content_box == rhs.content_box &&
    grid_placement_equal(lhs.grid_placement, rhs.grid_placement)
}

fn outline_equal(lhs: OutlineStyle, rhs: OutlineStyle) -> bool {
    ret lhs.width == rhs.width && lhs.offset == rhs.offset &&
    lhs.color.packed() == rhs.color.packed()
}

fn shadow_equal(lhs: ShadowStyle, rhs: ShadowStyle) -> bool {
    ret lhs.x == rhs.x && lhs.y == rhs.y && lhs.blur == rhs.blur &&
    lhs.spread == rhs.spread && lhs.inset == rhs.inset &&
    lhs.color.packed() == rhs.color.packed()
}

fn decoration_equal(lhs: TextDecorationStyle, rhs: TextDecorationStyle) -> bool {
    ret lhs.underline == rhs.underline && lhs.overline == rhs.overline &&
    lhs.line_through == rhs.line_through &&
    lhs.color.packed() == rhs.color.packed() &&
    lhs.color_set == rhs.color_set && lhs.thickness == rhs.thickness
}

fn gradient_equal(lhs: LinearGradient, rhs: LinearGradient) -> bool {
    ret lhs.start.packed() == rhs.start.packed() &&
    lhs.end.packed() == rhs.end.packed() &&
    lhs.vertical == rhs.vertical && lhs.enabled == rhs.enabled
}

pub struct Theme {
    canvas: Color
    surface: Color
    ink: Color
    muted: Color
    line: Color
    primary: Color
    secondary: Color
    danger: Color
    warning: Color
}

impl for Theme {
    pub fn light() -> Theme {
        ret Theme {
            Color::rgb(238_u8, 242_u8, 246_u8),
            Color::rgb(255_u8, 255_u8, 255_u8),
            Color::rgb(31_u8, 36_u8, 43_u8),
            Color::rgb(102_u8, 112_u8, 125_u8),
            Color::rgb(203_u8, 211_u8, 220_u8),
            Color::rgb(18_u8, 153_u8, 126_u8),
            Color::rgb(74_u8, 85_u8, 99_u8),
            Color::rgb(207_u8, 72_u8, 72_u8),
            Color::rgb(224_u8, 157_u8, 49_u8)
        }
    }

    pub fn canvas(self: Self) -> Color {
        ret self.canvas
    }
    pub fn surface(self: Self) -> Color {
        ret self.surface
    }
    pub fn ink(self: Self) -> Color {
        ret self.ink
    }
    pub fn muted(self: Self) -> Color {
        ret self.muted
    }
    pub fn line(self: Self) -> Color {
        ret self.line
    }
    pub fn primary(self: Self) -> Color {
        ret self.primary
    }
    pub fn secondary(self: Self) -> Color {
        ret self.secondary
    }
    pub fn danger(self: Self) -> Color {
        ret self.danger
    }
    pub fn warning(self: Self) -> Color {
        ret self.warning
    }

    pub fn root(self: Self) -> Style {
        ret Style::default().with_background(self.canvas)
        .with_foreground(self.ink).with_padding(Insets::all(18.0_f32)).with_gap(12.0_f32)
    }
    pub fn surface_style(self: Self) -> Style {
        ret Style::panel().with_background(self.surface).with_foreground(self.ink)
        .with_border(1.0_f32, self.line).with_padding(Insets::all(12.0_f32)).with_gap(8.0_f32)
    }
    pub fn primary_button(self: Self) -> Style {
        ret themed_button(self.primary, white())
    }
    pub fn secondary_button(self: Self) -> Style {
        ret themed_button(self.secondary, white())
    }
    pub fn danger_button(self: Self) -> Style {
        ret themed_button(self.danger, white())
    }
    pub fn outline_button(self: Self) -> Style {
        ret Style::panel().with_background(self.surface).with_foreground(self.ink)
        .with_border(1.0_f32, self.muted).with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
    }
    pub fn ghost_button(self: Self) -> Style {
        ret Style::default().with_background(self.canvas).with_foreground(self.ink)
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
    }
    pub fn tab(self: Self, selected: bool) -> Style {
        if selected {
            ret self.primary_button()
        }
        ret self.secondary_button()
    }
}

fn themed_button(background: Color, foreground: Color) -> Style {
    ret Style::panel().with_background(background).with_foreground(foreground)
    .with_border(1.0_f32, background).with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}
