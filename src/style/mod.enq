//! Typed visual, layout, typography, shadow, gradient, and theme styles.

import color::{Color, black, transparent, white}

import refrain::geometry::Insets

pub fn text_start() -> usize {
    ret 0_usize
}
pub fn text_center() -> usize {
    ret 1_usize
}
pub fn text_end() -> usize {
    ret 2_usize
}
pub fn align_content_stretch() -> usize {
    ret 0_usize
}
pub fn align_content_start() -> usize {
    ret 1_usize
}
pub fn align_content_center() -> usize {
    ret 2_usize
}
pub fn align_content_end() -> usize {
    ret 3_usize
}
pub fn align_content_space_between() -> usize {
    ret 4_usize
}
pub fn align_content_space_around() -> usize {
    ret 5_usize
}
pub fn align_content_space_evenly() -> usize {
    ret 6_usize
}

pub struct FlexStyle {
    direction: usize
    direction_set: bool
    basis: f32
    grow: f32
    shrink: f32
    justify: usize
    align: usize
    displayed: bool
    grid: bool
    columns: usize
    column_template: str
    row_template: str
    auto_column_template: str
    auto_row_template: str
    auto_flow_column: bool
    auto_flow_dense: bool
    self_align: i32
    order: i32
    wrap: bool
    wrap_reverse: bool
    row_gap: f32
    column_gap: f32
    direction_reverse: bool
    align_content: usize
}

impl for FlexStyle {
    pub fn default() -> FlexStyle {
        ret FlexStyle {
            0_usize, false, - 1.0_f32, - 1.0_f32, - 1.0_f32, 0_usize, 0_usize, true, false, 1_usize,
            "", "", "", "", false, false, - 1_i32, 0_i32, false, false, - 1.0_f32, - 1.0_f32, false,
            0_usize
        }
    }
    pub fn with_direction(self: Self, value: usize) -> FlexStyle {
        ret FlexStyle {
            value, true, self.basis, self.grow, self.shrink, self.justify, self.align, self.displayed,
            self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
            self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, false, self.align_content
        }
    }
    pub fn with_basis(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, value, self.grow, self.shrink, self.justify, self.align,
            self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
            self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_grow(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, value, self.shrink, self.justify, self.align,
            self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
            self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_shrink(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, value, self.justify, self.align,
            self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
            self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_justify(self: Self, value: usize) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink, value, self.align,
            self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
            self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content
        }
    }
    pub fn with_align(self: Self, value: usize) -> FlexStyle {
        ret FlexStyle {
            self.direction, self.direction_set, self.basis, self.grow, self.shrink, self.justify, value,
            self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template,
