import refrain::style::{LinearGradient, Style, TransitionStyle, align_content_center, align_content_end, align_content_space_around, align_content_space_between, align_content_space_evenly, align_content_start, align_content_stretch, text_center, text_end, text_start}
import refrain::widget::{Widget, WidgetSelector, widget_button, widget_checkbox, widget_color_picker, widget_color_swatch, widget_heading, widget_icon, widget_icon_button, widget_icon_card, widget_image, widget_input, widget_label, widget_link, widget_panel, widget_progress, widget_radio, widget_range_slider, widget_select, widget_separator, widget_slider, widget_spacer, widget_switch, widget_textarea}

extern fn luma_default_css_source() -> str

pub struct StyleRule {
    selector: str
    declarations: str
    specificity: usize
}

pub struct CssVariable {
    name: str
    value: str
}

struct RuleCandidate {
    kind: usize
    value: str
}

struct InteractionCandidate {
    subject: RuleCandidate
    mask: u32
}

// Necessary selector subjects indexed once, never a full rule scan per node.
struct RuleIndex {
    heads: Vec[usize]
    next: Vec[usize]
    candidates: Vec[RuleCandidate]
}

fn rule_bucket(kind: usize, value: str) -> usize {
    let mut hash = 1469598103934665603_u64 ^(kind as u64)
    let mut index = 0_usize
    while index < value.byte_len() {
        hash =(hash ^(value.byte_at(index) as u64)) * 1099511628211_u64
        index += 1
    }
    ret(hash % 512_u64) as usize
}

impl for RuleIndex {
    pub fn new(candidates: Vec[RuleCandidate]) -> Self {
        let mut heads = Vec[usize]::new()
        let mut next = Vec[usize]::new()
        while heads.len() < 512 {
            heads.push(0)
        }
        let mut index = 0_usize
        for candidate in candidates {
            let bucket = rule_bucket(candidate.kind, candidate.value)
            next.push(heads.get(bucket).unwrap_or(0))
            heads.set(bucket, index + 1)
            index += 1
        }
        ret Self { heads, next, candidates }
    }
    fn collect(self: Self, kind: usize, value: str, result: mut Vec[usize]) ->() {
        let mut cursor = self.heads.get(rule_bucket(kind, value)).unwrap_or(0)
        while cursor != 0 {
            let index = cursor - 1
            match self.candidates.get(index) {
                Some(candidate) => {
                    if candidate.kind == kind && candidate.value == value {
                        let mut position = 0_usize
                        while position < result.len() && result.get(position).unwrap_or(index) < index {
                            position += 1
                        }
                        if result.get(position).unwrap_or(self.candidates.len()) != index {
                            result.push(index)
                            let mut slot = result.len() - 1
                            while slot > position {
                                result.set(slot, result.get(slot - 1).unwrap_or(index))
                                slot -= 1
                            }
                            result.set(position, index)
                        }
                    }
                }
                None => {
                }
            }
            cursor = self.next.get(index).unwrap_or(0)
        }
        ret()
    }
    pub fn for_widget(self: Self, widget: Widget) -> Vec[usize] {
        let mut result = Vec[usize]::new()
        self.collect(0, "", result)
        self.collect(1, widget.id(), result)
        self.collect(3, widget_type(widget), result)
        let classes = widget.classes()
        let mut start = 0_usize
        let mut cursor = 0_usize
        while cursor <= classes.byte_len() {
            let separator = cursor == classes.byte_len() || classes.byte_at(cursor) <= 32_u8
            if separator {
                if cursor > start {
                    self.collect(2, classes.slice_bytes(start, cursor - start), result)
                }
                start = cursor + 1
            }
            cursor += 1
        }
        ret result
    }
}

struct InteractionStyleState {
    subtree_size: usize
    hovered_within: bool
    active_within: bool
    focused: bool
    focus_within: bool
    widget_focused: bool
    focus_visible: bool
    children: Vec[InteractionStyleState]
}

struct SelectorNode {
    widget: Widget
    index: usize
    count: usize
    siblings: Vec[Widget]
    interaction: InteractionStyleState
    sibling_interactions: Vec[InteractionStyleState]
}

struct SelectorCombinator {
    index: usize
    kind: usize
}

struct ComputedStyleCacheEntry {
    key: str
    declarations: str
    base: Style
    computed: Style
}

struct VariableCacheEntry {
    key: str
    variables: Vec[CssVariable]
}

struct VariableIdentity {
    values: Vec[CssVariable]
    identity: u64
    hash: u64
}

fn variable_text_hash(value: str, initial: u64) -> u64 {
    let mut hash =(initial ^(value.byte_len() as u64)) * 1099511628211_u64
    for index in 0..value.byte_len() {
        hash =(hash ^(value.byte_at(index) as u64)) * 1099511628211_u64
    }
    ret hash
}

fn variable_content_hash(values: Vec[CssVariable]) -> u64 {
    let mut hash = 1469598103934665603_u64
    for variable in values {
        hash = variable_text_hash(variable.value, variable_text_hash(variable.name, hash))
    }
    ret hash
}

#attr(test)
fn css_variable_identity_contract() -> bool {
    let mut sheet = StyleSheet::parse("label { color: var(--ink); }")
    let first = vec![CssVariable { "--ink", "#ff0000" }]
    let equal = vec![CssVariable { "--ink", "#ff0000" }]
    let different = vec![CssVariable { "--ink", "#00ff00" }]
    let identity = sheet.cache.variable_identity(first)
    if identity == 0 || sheet.cache.variable_identity(first) != identity ||
    sheet.cache.variable_identity(equal) != identity ||
    sheet.cache.variable_identity(different) == identity {
        ret false
    }
    // Force the content bucket to contain the right hash but wrong content.
    // Even this collision must receive a different, fresh identity.
    let hash = variable_content_hash(different)
    sheet.cache.variable_contents.set((hash % 512) as usize,
        Option[VariableIdentity]::Some(VariableIdentity { first, identity, hash }),)
    let fresh = vec![CssVariable { "--ink", "#00ff00" }]
    if sheet.cache.variable_identity(fresh) == identity {
        ret false
    }
    let widget = Widget::label("Value").with_attribute("data-luma-css-variables", "--ink: #112233;")
    let initial = sheet.apply(widget, "", "", "")
    let misses = sheet.cache_misses()
    let repeated = sheet.apply(widget, "", "", "")
    ret initial.style().equivalent(repeated.style()) && sheet.cache_misses() == misses
}

struct CascadeEntry {
    selector: WidgetSelector
    explicit: bool
    base: Style
    computed: Style
    variables: Vec[CssVariable]
    inherited_variables: Vec[CssVariable]
    interaction: u32
    subtree_size: usize
    child_index: usize
    sibling_count: usize
    depth: usize
    authored: Style
    parent_index: usize
}

/// Per-tree cascade state. Unlike the shared declaration cache, this retains
/// exact authored inputs and avoids constructing CSS keys for unchanged nodes.
pub struct RetainedCascade {
    entries: Vec[CascadeEntry]
    revision: u64
    hovered: str
    active: str
    focused: str
    keyboard_focus: bool
    patches: Vec[CascadePatch]
    patchable: bool
    interaction_index: Option[InteractionIndex<H>]
    interaction_evaluations: usize
}

struct CascadeInput {
    widget: Widget
    parent: usize
    ordinal: usize
    children: Vec[usize]
    focused_within: bool
}

struct InteractionMark {
    epoch: u64
    forced: bool
}

struct InteractionIndex {
    inputs: Vec[CascadeInput]
    identifiers: Vec[Vec[usize]]
    authored_focus: Vec[usize]
    marks: Vec[InteractionMark]
    epoch: u64
    queue: Vec[usize]
}

struct CascadeUndo {
    index: usize
    entry: CascadeEntry
}

/// A computed local style destination; content and event captures stay retained.
pub struct CascadePatch {
    id: str
    style: Style
    focused: bool
}

impl for CascadePatch {
    pub fn id(self: Self) -> str {
        ret self.id
    }
    pub fn style(self: Self) -> Style {
        ret self.style
    }
    pub fn focused(self: Self) -> bool {
        ret self.focused
    }
}

struct CascadeDelta {
    patches: Vec[CascadePatch]
    patchable: bool
    evaluations: usize
}

impl for RetainedCascade {
    pub fn new() -> Self<H> {
        ret RetainedCascade<H> {
            Vec[CascadeEntry]::new(), 0, "", "", "", true,
            Vec[CascadePatch]::new(), false, Option[InteractionIndex<H>]::None, 0
        }
    }
    pub fn matches_interaction(self: Self&, revision: u64, hovered: str, active: str,
        focused: str, keyboard_focus: bool,) -> bool {
        ret self.revision == revision && self.hovered == hovered && self.active == active &&
        self.focused == focused && self.keyboard_focus == keyboard_focus
    }
    /// None means anonymous or geometric changes require ordinary reconciliation.
    pub fn style_patches(self: Self&) -> Option[Vec[CascadePatch]] {
        ret if self.patchable {
            Option[Vec[CascadePatch]]::Some(self.patches)
        } else {
            Option[Vec[CascadePatch]]::None
        }
    }
    /// Nodes whose CSS was evaluated in the last interaction-only transaction.
    pub fn interaction_evaluations(self: Self&) -> usize {
        ret self.interaction_evaluations
    }
    /// A retained interaction index belongs to its authored root, never to a
    /// transient preview that happens to share the window or stylesheet.
    pub fn matches_root(self: Self&, root: Widget) -> bool {
        match self.interaction_index {
            Some(index) => {
                if index.inputs.len() == 0 {
                    ret false
                }
                let authored = index.input(0).widget
                ret authored.selector_equivalent(root) &&
                authored.style().equivalent(root.style()) &&
                authored.has_explicit_style() == root.has_explicit_style()
            }
            None => {
                ret false
            }
        }
    }

    /// Adopt a retained sizing write without evaluating selectors. Flex basis
    /// is not inherited; future hover/focus transactions must see its new base.
    pub fn adopt_geometry(self: mut Self&, path: Vec[usize], local: Widget) -> bool {
        let mut index = match self.interaction_index {
            Some(value) => value None => {
                ret false
            }
        }
        let position = match index.position(path) {
            Some(value) => value None => {
                ret false
            }
        }
        let input = index.input(position)
        let authored = local.with_children(input.widget.children())
        if !input.widget.selector_inputs().equivalent(authored.selector_inputs(), true) {
            ret false
        }
        let mut entry = match self.entries.get(position) {
            Some(value) => value None => {
                ret false
            }
        }
        let basis = local.geometry_basis()
        entry.authored = local.style()
        entry.explicit = local.has_explicit_style()
        entry.base = entry.base.with_flex_basis(basis)
        entry.computed = entry.computed.with_flex_basis(basis)
        self.entries.set(position, entry)
        index.inputs.set(position, CascadeInput {
                authored, input.parent, input.ordinal,
                input.children, input.focused_within
            }
            ,
        )
        index.refresh_ancestors(position)
        ret true
    }
}

fn interaction_id_bucket(id: str) -> usize {
    let mut hash = 1469598103934665603_u64
    for index in 0..id.byte_len() {
        hash =(hash ^ id.byte_at(index) as u64) * 1099511628211_u64
    }
    ret(hash % 256) as usize
}

impl for InteractionIndex {
    pub fn input(self: Self&, position: usize) -> CascadeInput {
        match self.inputs.get(position) {
            Some(value) => {
                ret value
            }
            None => {
                panic("invalid retained CSS input index")
            }
        }
        // panic exits; its current core signature is nevertheless unit-valued.
        ret CascadeInput { Widget::spacer(0), 0, 0, Vec[usize]::new(), false }
    }
    pub fn new(root: Widget) -> Self<H> {
        ret InteractionIndex::from_snapshot(root.selector_tree())
    }
    pub fn from_snapshot(root: Widget) -> Self<H> {
        let mut buckets = Vec[Vec[usize]]::new()
        for _index in 0..256 {
            buckets.push(Vec[usize]::new())
        }
        let mut index = InteractionIndex<H> {
            Vec[CascadeInput]::new(), buckets, Vec[usize]::new(),
            Vec[InteractionMark]::new(), 0, Vec[usize]::new()
        }
        let _root = index.append(root, 0, 0)
        ret index
    }
    pub fn position(self: Self&, path: Vec[usize]) -> Option[usize] {
        if self.inputs.len() == 0 {
            ret Option[usize]::None
        }
        let mut position = 0_usize
        for ordinal in path {
            match self.input(position).children.get(ordinal) {
                Some(child) => {
                    position = child
                }
                None => {
                    ret Option[usize]::None
                }
            }
        }
        ret Option[usize]::Some(position)
    }
    // Stable names, source ordinals and authored focus keep all lookup/mark
    // tables valid. Validate the complete branch before changing the index.
    pub fn same_topology(self: Self&, position: usize, branch: Widget) -> bool {
        let input = self.input(position)
        if input.widget.id() != branch.id() || input.widget.kind() != branch.kind() ||
        input.widget.tag() != branch.tag() ||
        input.children.len() != branch.children().len() {
            ret false
        }
        let mut ordinal = 0_usize
        for child in branch.children() {
            if !self.same_topology(input.children.get(ordinal).unwrap_or(self.inputs.len()), child) {
                ret false
            }
            ordinal += 1
        }
        ret true
    }
    pub fn refresh_branch(self: mut Self&, position: usize, branch: Widget) ->() {
        let input = self.input(position)
        let mut ordinal = 0_usize
        for child in branch.children() {
            self.refresh_branch(input.children.get(ordinal).unwrap_or(self.inputs.len()), child)
            ordinal += 1
        }
        if input.widget.focused() != branch.focused() {
            let mut focused = Vec[usize]::new()
            for previous in self.authored_focus {
                if previous != position {
                    focused.push(previous)
                }
            }
            if branch.focused() {
                focused.push(position)
            }
            self.authored_focus = focused
        }
        let mut focused_within = branch.focused()
        for child in input.children {
            focused_within = focused_within || self.input(child).focused_within
        }
        self.inputs.set(position, CascadeInput {
                branch, input.parent, input.ordinal, input.children, focused_within
            }
            ,)
        ret()
    }
    pub fn refresh_ancestors(self: mut Self&, position: usize) ->() {
        let mut cursor = position
        loop {
            let input = self.input(cursor)
            if input.parent == cursor {
                break
            }
            let parent = self.input(input.parent)
            let mut focused_within = parent.widget.focused()
            for child in parent.children {
                focused_within = focused_within || self.input(child).focused_within
            }
            let mut children = Vec[Widget]::new()
            let mut ordinal = 0_usize
            for child in parent.widget.children() {
                children.push(if ordinal == input.ordinal {
                        input.widget
                    } else {
                        child
                    }
                )
                ordinal += 1
            }
            self.inputs.set(input.parent, CascadeInput {
                    parent.widget.with_children(children), parent.parent, parent.ordinal,
                    parent.children, focused_within
                }
                ,)
            cursor = input.parent
        }
        ret()
    }
    fn append(self: mut Self&, widget: Widget, parent: usize, ordinal: usize) -> usize {
        let index = self.inputs.len()
        self.inputs.push(CascadeInput {
                widget, parent, ordinal, Vec[usize]::new(), widget.focused()
            }
            ,
        )
        self.marks.push(InteractionMark { 0, false })
        if widget.id() != "" {
            let bucket = interaction_id_bucket(widget.id())
            let mut entries = self.identifiers.get(bucket).unwrap_or(Vec[usize]::new())
            entries.push(index)
        }
        if widget.focused() {
            self.authored_focus.push(index)
        }
        let mut children = Vec[usize]::new()
        let mut focused = widget.focused()
        for child in widget.children() {
            let added = self.append(child, index, children.len())
            children.push(added)
            focused = focused || self.input(added).focused_within
        }
        self.inputs.set(index, CascadeInput { widget, parent, ordinal, children, focused })
        ret index
    }
    pub fn targets(self: Self&, id: str) -> Vec[usize] {
        let mut targets = Vec[usize]::new()
        if id == "" {
            ret targets
        }
        for candidate in self.identifiers.get(interaction_id_bucket(id)).unwrap_or(Vec[usize]::new()) {
            if self.input(candidate).widget.id() == id {
                targets.push(candidate)
            }
        }
        ret targets
    }
    pub fn mark(self: mut Self&, index: usize, forced: bool) ->() {
        let previous = self.marks.get(index).unwrap_or(InteractionMark { 0, false })
        if previous.epoch == self.epoch {
            if forced && !previous.forced {
                self.marks.set(index, InteractionMark {
                        self.epoch, true
                    }
                    ,
                )
            }
            ret()
        }
        self.marks.set(index, InteractionMark { self.epoch, forced })
        // Numeric preorder is also parent-before-child dependency order.
        self.queue.push(index)
        let mut cursor = self.queue.len() - 1
        while cursor > 0 {
            let parent =(cursor - 1) / 2
            let value = self.queue.get(parent).unwrap_or(index)
            if value <= index {
                break
            }
            self.queue.set(cursor, value)
            cursor = parent
        }
        self.queue.set(cursor, index)
        ret()
    }
    pub fn pop(self: mut Self&) -> usize {
        let first = self.queue.get(0).unwrap_or(0)
        let last = self.queue.pop().unwrap_or(first)
        if self.queue.len() == 0 {
            ret first
        }
        let mut cursor = 0_usize
        while cursor * 2 + 1 < self.queue.len() {
            let mut child = cursor * 2 + 1
            if child + 1 < self.queue.len() && self.queue.get(child + 1).unwrap_or(last) < self.queue.get(child).unwrap_or(last) {
                child += 1
            }
            let value = self.queue.get(child).unwrap_or(last)
            if value >= last {
                break
            }
            self.queue.set(cursor, value)
            cursor = child
        }
        self.queue.set(cursor, last)
        ret first
    }
    pub fn mark_paths(self: mut Self&, targets: Vec[usize]) ->() {
        for target in targets {
            let mut cursor = target
            loop {
                self.mark(cursor, false)
                let parent = self.input(cursor).parent
                if parent == cursor {
                    break
                }
                cursor = parent
            }
        }
        ret()
    }
}

fn interaction_contains(targets: Vec[usize], index: usize, span: usize) -> bool {
    for target in targets {
        if target >= index && target < index + span {
            ret true
        }
    }
    ret false
}

fn indexed_interaction(index: InteractionIndex<H>, entries: Vec[CascadeEntry], position: usize,
    hovered: Vec[usize], active: Vec[usize], focused: Vec[usize], explicit_focus: bool,
    keyboard: bool,) -> InteractionStyleState {
    let input = index.input(position)
    let span = cascade_entry_at(entries, position).subtree_size
    let direct = interaction_contains(focused, position, 1)
    let marked = if explicit_focus {
        input.widget.focused()
    } else {
        direct
    }
    ret InteractionStyleState {
        span, interaction_contains(hovered, position, span),
        interaction_contains(active, position, span), direct,
        if explicit_focus {
            input.focused_within
        } else {
            interaction_contains(focused, position, span)
        }
        ,
        marked, marked &&(keyboard || input.widget.kind() == widget_input() || input.widget.kind() == widget_textarea()),
        Vec[InteractionStyleState]::new()
    }
}

fn cascade_entry_at(entries: Vec[CascadeEntry], position: usize) -> CascadeEntry {
    match entries.get(position) {
        Some(value) => {
            ret value
        }
        None => {
            panic("invalid retained CSS cascade index")
        }
    }
    ret CascadeEntry {
        Widget::spacer(0).selector_inputs(), false, Style::default(),
        Style::default(), Vec[CssVariable]::new(), Vec[CssVariable]::new(), 0, 0, 0, 0, 0, Style::default(), 0
    }
}

fn refresh_cascade_ancestor_interactions(state: mut RetainedCascade&, position: usize) ->() {
    let index = match state.interaction_index {
        Some(index) => index None => {
            ret()
        }
    }
    let hovered = index.targets(state.hovered)
    let active = index.targets(state.active)
    let focused = index.targets(state.focused)
    let mut cursor = index.input(position).parent
    loop {
        let previous = cascade_entry_at(state.entries, cursor)
        let interaction = indexed_interaction(index, state.entries, cursor, hovered, active, focused,
            state.focused == "", state.keyboard_focus,)
        state.entries.set(cursor, CascadeEntry {
                previous.selector, previous.explicit, previous.base,
                previous.computed, previous.variables, previous.inherited_variables, cascade_interaction_bits(interaction),
                previous.subtree_size, previous.child_index, previous.sibling_count, previous.depth, previous.authored, previous.parent_index
            }
            ,
        )
        let parent = index.input(cursor).parent
        if parent == cursor {
            break
        }
        cursor = parent
    }
    ret()
}

// Persistent source snapshots copy only the ancestry of a changed branch.
// The snapshot contains selectors, not event closures or renderer resources.
fn replace_cascade_branch(root: Widget, path: Vec[usize], depth: usize, branch: Widget) -> Widget {
    if depth == path.len() {
        ret branch
    }
    let selected = path.get(depth).unwrap_or(root.children().len())
    let mut children = Vec[Widget]::new()
    let mut ordinal = 0_usize
    for child in root.children() {
        children.push(if ordinal == selected {
                replace_cascade_branch(child, path, depth + 1, branch)
            } else {
                child
            }
        )
        ordinal += 1
    }
    ret root.with_children(children)
}

fn shifted_cascade_position(position: usize, end: usize, removed: usize, added: usize) -> usize {
    ret if position >= end {
        position - removed + added
    } else {
        position
    }
}

fn repositioned_cascade_entry(entry: CascadeEntry, parent: usize, span: usize) -> CascadeEntry {
    ret CascadeEntry {
        entry.selector, entry.explicit, entry.base, entry.computed, entry.variables,
        entry.inherited_variables, entry.interaction, span, entry.child_index,
        entry.sibling_count, entry.depth, entry.authored, parent
    }
}

fn cascade_selector_tree_equal(entries: Vec[CascadeEntry], widget: Widget, offset: usize) -> bool {
    match entries.get(offset) {
        Some(entry) => {
            if !entry.selector.equivalent(widget.selector_inputs(), true) {
                ret false
            }
        }
        None => {
            ret false
        }
    }
    let mut index = offset + 1
    for child in widget.children() {
        if !cascade_selector_tree_equal(entries, child, index) {
            ret false
        }
        match entries.get(index) {
            Some(entry) => {
                index += entry.subtree_size
            }
            None => {
                ret false
            }
        }
    }
    ret true
}

// If every authored CSS input is unchanged, parent/position/relational inputs
// are unchanged too. Reuse computed styles, but always take content, resources
// and closures from the new model. This also avoids allocating fresh cascade
// entries and selector ancestry on geometry-only frames.
fn replay_cascade(entries: Vec[CascadeEntry], widget: Widget, offset: usize,
    focused_id: str,) -> Option[Widget] {
    let entry = match entries.get(offset) {
        Some(value) => value
        None => {
            ret Option[Widget]::None
        }
    }
    let marked = if focused_id == "" {
        widget
    } else {
        widget.with_focus(widget.id() == focused_id)
    }
    if !entry.selector.equivalent(marked.selector_inputs(), true) ||
    entry.explicit != widget.has_explicit_style() || !entry.authored.equivalent(widget.style()) {
        ret Option[Widget]::None
    }
    let mut children = Vec[Widget]::new()
    let mut index = offset + 1
    for child in widget.children() {
        match replay_cascade(entries, child, index, focused_id) {
            Some(value) => children.push(value)
            None => {
                ret Option[Widget]::None
            }
        }
        match entries.get(index) {
            Some(value) => {
                index += value.subtree_size
            }
            None => {
                ret Option[Widget]::None
            }
        }
    }
    if index != offset + entry.subtree_size {
        ret Option[Widget]::None
    }
    ret Option[Widget]::Some(widget.with_computed_style(entry.computed)
        .with_focus((entry.interaction & 16) != 0).with_children(children))
}

fn cascade_variables_equal(left: Vec[CssVariable], right: Vec[CssVariable]) -> bool {
    // Cascaded variable sets are immutable. The same storage is the same
    // exact input; do not compare every inherited variable for every child.
    if left.as_ptr() as usize == right.as_ptr() as usize {
        ret true
    }
    if left.len() != right.len() {
        ret false
    }
    let mut index = 0_usize
    for variable in left {
        match right.get(index) {
            Some(other) => {
                if variable.name != other.name || variable.value != other.value {
                    ret false
                }
            }
            None => {
                ret false
            }
        }
        index += 1
    }
    ret true
}

fn cascade_interaction_bits(state: InteractionStyleState) -> u32 {
    let mut bits = 0_u32
    if state.hovered_within {
        bits = bits | 1
    }
    if state.active_within {
        bits = bits | 2
    }
    if state.focused {
        bits = bits | 4
    }
    if state.focus_within {
        bits = bits | 8
    }
    if state.widget_focused {
        bits = bits | 16
    }
    if state.focus_visible {
        bits = bits | 32
    }
    ret bits
}

/// A bounded cache shared by every copy of one stylesheet value. It caches
/// computed styles together with their inherited base. A changed base reuses
/// declarations, while unchanged input does no parsing or rule matching.
struct ComputedStyleCache {
    entries: Vec[ComputedStyleCacheEntry]
    entry_slots: Vec[usize]
    hits: u64
    misses: u64
    variables: Vec[VariableCacheEntry]
    variable_slots: Vec[usize]
    relational: bool
    sibling_dependent: bool
    sibling_interaction_dependent: bool
    ancestor_dependent: bool
    ancestor_interaction_dependent: bool
    ancestor_structure_dependent: bool
    position_dependent: bool
    selector_ids: Vec[str]
    selector_attributes: Vec[str]
    anonymous_id_safe: bool
    declaration_styles: Vec[ComputedStyleCacheEntry]
    declaration_slots: Vec[usize]
    variable_identities: Vec[Option[VariableIdentity]]
    variable_contents: Vec[Option[VariableIdentity]]
    next_variable_identity: u64
}

impl for ComputedStyleCache {
    pub fn new(relational: bool, sibling_dependent: bool, ancestor_dependent: bool, rules: Vec[StyleRule]) -> ComputedStyleCache<H> {
        let mut selector_ids = Vec[str]::new()
        let mut selector_attributes = vec!["required", "readonly", "placeholder", "data-luma-css-variables"]
        let mut anonymous_id_safe = !relational
        let mut position_dependent = sibling_dependent
        let mut ancestor_interaction_dependent = false
        let mut ancestor_structure_dependent = false
        let mut sibling_interaction_dependent = false
        for rule in rules {
            // Type positions inspect sibling descriptors, which stay immutable
            // during this transaction. +/~ can inspect a sibling's live state.
            sibling_interaction_dependent = sibling_interaction_dependent ||
            string_contains(rule.selector, "+") || string_contains(rule.selector, "~")
            let combinator = rightmost_combinator(rule.selector)
            if string_contains(rule.selector, "(") ||
            (combinator.kind != 0_usize && string_contains(rule.selector.slice(0_usize, combinator.index), ":empty")) {
                ancestor_structure_dependent = true
            }
            // A pseudo selector on an ancestor can depend on interaction,
            // including nested :not/:is forms. Static ancestors cannot.
            if string_contains(rule.selector, "(") ||
            (combinator.kind != 0_usize && string_contains(rule.selector.slice(0_usize, combinator.index), ":")) {
                ancestor_interaction_dependent = true
            }
            if string_contains(rule.selector, ":nth-") || string_contains(rule.selector, ":first-") ||
            string_contains(rule.selector, ":last-") || string_contains(rule.selector, ":only-") {
                position_dependent = true
            }
            // IDs on ancestors matter too, but arbitrary application IDs do
            // not. Virtualized rows can therefore reuse an equivalent style.
            let mut cursor = 0_usize
            while cursor < rule.selector.char_len() {
                if rule.selector.slice(cursor, 1_usize) == "[" {
                    let close = matching_bracket(rule.selector, cursor)
                    let expression = trim(rule.selector.slice(cursor + 1_usize, close - cursor - 1_usize))
                    let equals = find_character(expression, "=", 0_usize)
                    let mut end = equals
                    if equals > 0_usize && equals < expression.char_len() {
                        let marker = expression.slice(equals - 1_usize, 1_usize)
                        if marker == "~" || marker == "|" || marker == "^" || marker == "$" || marker == "*" {
                            end -= 1_usize
                        }
                    }
                    let name = trim(expression.slice(0_usize, end))
                    selector_attributes.push(name)
                    if name == "id" {
                        anonymous_id_safe = false
                    }
                    cursor = close + 1_usize
                } elif rule.selector.slice(cursor, 1_usize) == "#" {
                    let start = cursor + 1_usize
                    let end = selector_part_end(rule.selector, start)
                    selector_ids.push(rule.selector.slice(start, end - start))
                    cursor = end
                } else {
                    cursor += 1_usize
                }
            }
            // Keep complex nested/attribute ID matching conservative.
            if string_contains(rule.selector, "(") {
                anonymous_id_safe = false
            }
        }
        ret ComputedStyleCache<H> {
            Vec[ComputedStyleCacheEntry]::new(), Vec[usize]::new(), 0_u64, 0_u64,
            Vec[VariableCacheEntry]::new(), Vec[usize]::new(), relational, sibling_dependent, sibling_interaction_dependent, ancestor_dependent, ancestor_interaction_dependent, ancestor_structure_dependent, position_dependent,
            selector_ids, selector_attributes, anonymous_id_safe,
            Vec[ComputedStyleCacheEntry]::new(), Vec[usize]::new(),
            Vec[Option[VariableIdentity]]::new(), Vec[Option[VariableIdentity]]::new(), 1
        }
    }

    pub fn variable_identity(self: mut Self&, values: Vec[CssVariable]) -> u64 {
        if values.len() == 0 {
            ret 0
        }
        let storage = values.as_ptr() as usize
        let slot =((storage / 8) ^(storage / 4096)) % 512
        while self.variable_identities.len() <= slot {
            self.variable_identities.push(Option[VariableIdentity]::None)
        }
        match self.variable_identities.get(slot).unwrap_or(Option[VariableIdentity]::None) {
            Some(previous) => {
                if previous.values.as_ptr() as usize == storage {
                    ret previous.identity
                }
            }
            None => {
            }
        }
        // Fresh but equal sets share an identity too. Hashes only select a
        // bucket; exact contents decide equality, so a collision cannot turn
        // one set of CSS variables into another.
        let hash = variable_content_hash(values)
        let content_slot =(hash % 512) as usize
        while self.variable_contents.len() <= content_slot {
            self.variable_contents.push(Option[VariableIdentity]::None)
        }
        let mut identity = 0_u64
        match self.variable_contents.get(content_slot).unwrap_or(Option[VariableIdentity]::None) {
            Some(previous) => {
                if previous.hash == hash && cascade_variables_equal(previous.values, values) {
                    identity = previous.identity
                }
            }
            None => {
            }
        }
        // Keeping immutable vectors alive prevents address reuse. Assign a
        // new monotonically increasing identity after a content eviction.
        if identity == 0 {
            identity = self.next_variable_identity
            self.next_variable_identity += 1
            self.variable_contents.set(content_slot, Option[VariableIdentity]::Some(VariableIdentity {
                        values, identity, hash
                    }
                    ,
                ))
        }
        self.variable_identities.set(slot, Option[VariableIdentity]::Some(VariableIdentity {
                    values, identity, hash
                }
                ,
            ))
        ret identity
    }

    pub fn get(self: mut Self&, key: str, base: Style) -> Option[Style] {
        let index = style_cache_bucket(key)
        if index < self.entry_slots.len() {
            match self.entry_slots.get(index) {
                Option::Some(slot) => {
                    if slot > 0_usize {
                        match self.entries.get(slot - 1_usize) {
                            Option::Some(entry) => {
                                if entry.key == key {
                                    self.hits += 1_u64
                                    if entry.base.equivalent(base) {
                                        ret Option[Style]::Some(entry.computed)
                                    }
                                    let computed = self.compute_declarations(base, entry.declarations)
                                    self.entries.set(slot - 1_usize, ComputedStyleCacheEntry {
                                            key, entry.declarations, base, computed
                                        }
                                        ,)
                                    ret Option[Style]::Some(computed)
                                }
                            }
                            Option::None => {
                            }
                        }
                    }
                }
                Option::None => {
                }
            }
        }
        self.misses += 1_u64
        ret Option[Style]::None
    }

    pub fn put(self: mut Self&, key: str, declarations: str, base: Style, computed: Style) ->() {
        let index = style_cache_bucket(key)
        while self.entry_slots.len() <= index {
            self.entry_slots.push(0_usize)
        }
        let slot = match self.entry_slots.get(index) {
            Option::Some(value) => value
            Option::None => 0_usize
        }
        let entry = ComputedStyleCacheEntry {
            key, declarations, base, computed
        }
        if slot == 0_usize {
            self.entries.push(entry)
            self.entry_slots.set(index, self.entries.len())
        } else {
            self.entries.set(slot - 1_usize, entry)
        }
        ret()
    }

    // Different widget IDs often produce identical cascades (for example a
    // grid of icon cards). Parse that cascade once per inherited base style.
    pub fn compute_declarations(self: mut Self&, base: Style, declarations: str) -> Style {
        let bucket = style_cache_bucket(declarations)
        let slot = self.declaration_slots.get(bucket).unwrap_or(0_usize)
        if slot > 0_usize {
            match self.declaration_styles.get(slot - 1_usize) {
                Option::Some(entry) => {
                    if entry.declarations == declarations && entry.base.equivalent(base) {
                        ret entry.computed
                    }
                }
                Option::None => {
                }
            }
        }
        let computed = apply_css(base, declarations)
        while self.declaration_slots.len() <= bucket {
            self.declaration_slots.push(0_usize)
        }
        let entry = ComputedStyleCacheEntry {
            "", declarations, base, computed
        }
        if slot == 0_usize {
            self.declaration_styles.push(entry)
            self.declaration_slots.set(bucket, self.declaration_styles.len())
        } else {
            self.declaration_styles.set(slot - 1_usize, entry)
        }
        ret computed
    }

    pub fn hit_count(self: Self&) -> u64 {
        ret self.hits
    }
    pub fn miss_count(self: Self&) -> u64 {
        ret self.misses
    }
    pub fn get_variables(self: Self&, key: str) -> Option[Vec[CssVariable]] {
        let index = style_cache_bucket(key)
        if index < self.variable_slots.len() {
            match self.variable_slots.get(index) {
                Option::Some(slot) => {
                    if slot > 0_usize {
                        match self.variables.get(slot - 1_usize) {
                            Option::Some(entry) => {
                                if entry.key == key {
                                    ret Option[Vec[CssVariable]]::Some(entry.variables)
                                }
                            }
                            Option::None => {
                            }
                        }
                    }
                }
                Option::None => {
                }
            }
        }
        ret Option[Vec[CssVariable]]::None
    }
    pub fn put_variables(self: mut Self&, key: str, variables: Vec[CssVariable]) ->() {
        let index = style_cache_bucket(key)
        while self.variable_slots.len() <= index {
            self.variable_slots.push(0_usize)
        }
        let slot = match self.variable_slots.get(index) {
            Option::Some(value) => value
            Option::None => 0_usize
        }
        let entry = VariableCacheEntry {
            key, variables
        }
        if slot == 0_usize {
            self.variables.push(entry)
            self.variable_slots.set(index, self.variables.len())
        } else {
            self.variables.set(slot - 1_usize, entry)
        }
        ret()
    }
}

fn style_cache_bucket(key: str) -> usize {
    let mut hash = 1469598103934665603_u64
    let mut index = 0_usize
    while index < key.len() {
        hash =(hash ^(key.byte_at(index) as u64)) * 1099511628211_u64
        index += 1_usize
    }
    ret(hash % 2048_u64) as usize
}

pub struct StyleSheet {
    rules: Vec[StyleRule]
    candidates: Vec[RuleCandidate]
    variable_rules: Vec[StyleRule]
    variable_candidates: Vec[RuleCandidate]
    maximum_specificity: usize
    revision: u64
    source_path: str
    cache: ComputedStyleCache<H>
    rule_index: RuleIndex
    ancestor_interactions: Vec[RuleCandidate]
    local_interactions: Vec[InteractionCandidate]
}

impl for StyleSheet {
    pub fn parse(source: str) -> StyleSheet {
        let mut rules = Vec[StyleRule]::new()
        let source = match memory_css_source(source, false) {
            Result::Ok(clean) => clean
            Result::Err(_) => source
        }
        let source = strip_comments(source)
        let mut cursor = 0_usize
        while cursor < source.byte_len() {
            let open = rule_open(source, cursor)
            if open == source.byte_len() {
                break
            }
            let close = rule_close(source, open)
            if close == source.byte_len() {
                break
            }
            let selector = trim(source.slice_bytes(cursor, open - cursor))
            if selector != "" {
                let declarations = source.slice_bytes(open + 1_usize, close - open - 1_usize)
                append_selector_rules(rules, selector, declarations)
            }
            cursor = close + 1_usize
        }
        let mut maximum_specificity = 0_usize
        let mut ancestor_dependent = false
        for rule in rules {
            if rightmost_combinator(rule.selector).kind != 0_usize ||
            string_contains(rule.selector, " ") || string_contains(rule.selector, "\t") ||
            string_contains(rule.selector, "\n") || string_contains(rule.selector, ">") ||
            string_contains(rule.selector, "+") || string_contains(rule.selector, "~") {
                ancestor_dependent = true
            }
            if rule.specificity > maximum_specificity {
                maximum_specificity = rule.specificity
            }
        }
        let ordered = order_style_rules(rules)
        let variable_rules = variable_style_rules(ordered)
        ret StyleSheet {
            ordered, rule_candidates(ordered), variable_rules, rule_candidates(variable_rules), maximum_specificity, stylesheet_revision(source), "",
            ComputedStyleCache::new(string_contains(source, ":has("),
                string_contains(source, "+") || string_contains(source, "~") ||
                string_contains(source, "-of-type") || string_contains(source, ":has("), ancestor_dependent, ordered,),
            RuleIndex::new(rule_candidates(ordered)), ancestor_interaction_candidates(ordered), local_interaction_candidates(ordered)
        }
    }

    /// Returns Luma's embedded user-agent stylesheet. Applications may layer
    /// their own file over it without relying on the process working directory.
    pub fn default() -> StyleSheet {
        ret StyleSheet::parse(luma_default_css_source())
    }

    pub fn try_parse(source: str) -> Result[StyleSheet, str] {
        let source = memory_css_source(source, true)?
        if !css_balanced(source) {
            ret Result[StyleSheet, str]::Err("unclosed CSS rule or quoted value")
        }
        ret Result[StyleSheet, str]::Ok(StyleSheet::parse(source))
    }

    /// Loads local @import rules relative to each importing file. Imports must
    /// precede ordinary rules; errors include the import chain. No network IO.
    pub fn from_file(path: str) -> Result[StyleSheet, str] {
        let path = Path::new(path).resolve().as_str()
        let source = load_css_file(path)?
        match StyleSheet::try_parse(source) {
            Result::Ok(sheet) => {
                ret Result[StyleSheet, str]::Ok(StyleSheet {
                        sheet.rules, sheet.candidates, sheet.variable_rules, sheet.variable_candidates, sheet.maximum_specificity,
                        sheet.revision, path, sheet.cache, sheet.rule_index, sheet.ancestor_interactions, sheet.local_interactions
                    }
                    ,)
            }
            Result::Err(message) => {
                ret Result[StyleSheet, str]::Err(message)
            }
        }
        ret Result[StyleSheet, str]::Err("cannot load stylesheet: " + path)
    }

    /// Layers `other` after this stylesheet, preserving normal source order.
    pub fn merge(self: Self, other: StyleSheet) -> StyleSheet {
        let mut rules = Vec[StyleRule]::new()
        rules.extend(self.rules)
        rules.extend(other.rules)
        let ordered = order_style_rules(rules)
        let variable_rules = variable_style_rules(ordered)
        ret StyleSheet {
            ordered, rule_candidates(ordered), variable_rules, rule_candidates(variable_rules),
            if self.maximum_specificity > other.maximum_specificity {
                self.maximum_specificity
            } else {
                other.maximum_specificity
            }
            ,
            self.revision ^(other.revision * 1099511628211_u64), other.source_path,
            ComputedStyleCache::new(self.cache.relational || other.cache.relational,
                self.cache.sibling_dependent || other.cache.sibling_dependent,
                self.cache.ancestor_dependent || other.cache.ancestor_dependent, ordered,),
            RuleIndex::new(rule_candidates(ordered)), ancestor_interaction_candidates(ordered), local_interaction_candidates(ordered)
        }
    }

    pub fn reload(self: Self) -> StyleSheet {
        if self.source_path == "" {
            ret self
        }
        match StyleSheet::from_file(self.source_path) {
            Result::Ok(sheet) => {
                ret StyleSheet::default().merge(sheet)
            }
            Result::Err(message) => {
                eprintln("Luma: stylesheet reload failed; keeping previous styles: " + message)
                ret self
            }
        }
        ret self
    }

    pub fn revision(self: Self) -> u64 {
        ret self.revision
    }
    pub fn source_path(self: Self) -> str {
        ret self.source_path
    }
    pub fn cache_hits(self: Self) -> u64 {
        ret self.cache.hit_count()
    }
    pub fn cache_misses(self: Self) -> u64 {
        ret self.cache.miss_count()
    }

    pub fn style(self: Self, widget: Widget, hovered: bool, active: bool, focused: bool) -> Style {
        let ancestors = Vec[SelectorNode]::new()
        let siblings = singleton_widget(widget)
        let focus_within = focused || widget_contains_focus(widget)
        let mut interaction = static_interaction_state(widget)
        interaction.hovered_within = hovered
        interaction.active_within = active
        interaction.focused = focused
        interaction.focus_visible = focused || widget.focused()
        interaction.focus_within = focus_within
        let mut sibling_interactions = Vec[InteractionStyleState]::new()
        sibling_interactions.push(interaction)
        let variables = compute_variables(self, widget, ancestors, siblings, 0_usize, 1_usize,
            hovered, active, focused, focus_within, interaction, sibling_interactions,
            Vec[CssVariable]::new(),)
        ret compute_style(self, widget, ancestors, siblings, 0_usize, 1_usize,
            hovered, active, focused, focus_within, interaction,
            sibling_interactions, variables,)
    }

    pub fn apply(self: Self, root: Widget, hovered_id: str, active_id: str, focused_id: str) -> Widget
    {
        ret self.apply_with_focus_visibility(root, hovered_id, active_id, focused_id, true)
    }

    /// Resolves focus independently from its keyboard indicator. Text entry
    /// keeps an indicator regardless of the input modality.
    pub fn apply_with_focus_visibility(self: Self, root: Widget, hovered_id: str,
        active_id: str, focused_id: str, keyboard_focus: bool,) -> Widget {
        let mut state = RetainedCascade::new()
        ret self.apply_cascade(root, hovered_id, active_id, focused_id, keyboard_focus, state, false)
    }

    /// Reuses resolved nodes while always taking content and event bindings
    /// from the new authored tree. Complex selector dependencies conservatively
    /// invalidate the cascade when any of their tree inputs change.
    pub fn apply_retained(self: Self, root: Widget, hovered_id: str,
        active_id: str, focused_id: str, keyboard_focus: bool,
        state: mut RetainedCascade&,) -> Widget {
        ret self.apply_cascade(root, hovered_id, active_id, focused_id, keyboard_focus, state, true)
    }

    /// Resolves one authored branch in its committed ancestor environment.
    /// Identity, sibling positions and ancestor interaction must stay stable;
    /// dependencies crossing the boundary request the ordinary full cascade.
    pub fn apply_retained_subtree(self: Self, path: Vec[usize], branch: Widget,
        state: mut RetainedCascade&,) -> Option[Widget] {
        if state.revision != self.revision || self.cache.relational || self.cache.sibling_interaction_dependent {
            ret Option[Widget]::None
        }
        let mut index = match state.interaction_index {
            Some(value) => value
            None => {
                ret Option[Widget]::None
            }
        }
        let position = match index.position(path) {
            Some(value) => value
            None => {
                ret Option[Widget]::None
            }
        }
        let input = index.input(position)
        // Changing this node's type can alter :nth-of-type outside the branch.
        if position == 0 || input.widget.id() != branch.id() ||
        input.widget.kind() != branch.kind() || input.widget.tag() != branch.tag() ||
        (branch.id() != "" && index.targets(branch.id()).len() != 1) {
            ret Option[Widget]::None
        }
        let hovered = index.targets(state.hovered)
        let active = index.targets(state.active)
        let focused = index.targets(state.focused)
        let before = indexed_interaction(index, state.entries, position,
            hovered, active, focused, state.focused == "", state.keyboard_focus,)
        let mut states = Vec[InteractionStyleState]::new()
        let marked = append_interaction_style_state(branch, state.hovered, state.active,
            state.focused, state.keyboard_focus, states,)
        let after = states.get(0).unwrap_or(before)
        let mut changed_within = 0_u32
        if before.hovered_within != after.hovered_within {
            changed_within = changed_within | 1_u32
        }
        if before.active_within != after.active_within {
            changed_within = changed_within | 2_u32
        }
        if before.focus_within != after.focus_within {
            changed_within = changed_within | 8_u32
        }
        let mut reversed = Vec[usize]::new()
        let mut cursor = input.parent
        loop {
            reversed.push(cursor)
            let parent = index.input(cursor).parent
            if parent == cursor {
                break
            }
            cursor = parent
        }
        let mut ancestors = Vec[SelectorNode]::new()
        while reversed.len() > 0 {
            let ancestor_position = reversed.pop().unwrap_or(0)
            let ancestor = index.input(ancestor_position)
            // A changed "within" bit only escapes this component when an
            // outside ancestor has a selector which actually depends on it.
            if changed_within != 0_u32 &&((local_interaction_mask(self, ancestor.widget) & changed_within) != 0_u32 ||
                ancestor_interaction_affects_children(self, ancestor.widget)) {
                ret Option[Widget]::None
            }
            let entry = cascade_entry_at(state.entries, ancestor_position)
            let interaction = indexed_interaction(index, state.entries, ancestor_position,
                hovered, active, focused, state.focused == "", state.keyboard_focus,)
            let siblings = if ancestor.parent == ancestor_position {
                singleton_widget(ancestor.widget)
            } else {
                index.input(ancestor.parent).widget.children()
            }
            ancestors.push(SelectorNode {
                    ancestor.widget.with_computed_style(entry.computed).with_focus(interaction.widget_focused),
                    ancestor.ordinal, siblings.len(), siblings, interaction, Vec[InteractionStyleState]::new()
                }
                ,)
        }
        let parent = cascade_entry_at(state.entries, input.parent)
        let siblings = index.input(input.parent).widget.children()
        let mut sibling_states = Vec[InteractionStyleState]::new()
        for sibling in index.input(input.parent).children {
            sibling_states.push(indexed_interaction(index, state.entries, sibling,
                    hovered, active, focused, state.focused == "", state.keyboard_focus,))
        }
        let previous = cascade_entry_at(state.entries, position)
        let mut retained = Vec[CascadeEntry]::new()
        for offset in 0..previous.subtree_size {
            let entry = cascade_entry_at(state.entries, position + offset)
            retained.push(repositioned_cascade_entry(entry,
                    if offset == 0 {
                        0
                    } else {
                        entry.parent_index - position
                    }
                    , entry.subtree_size,))
        }
        let mut next = Vec[CascadeEntry]::new()
        let mut delta = CascadeDelta<S>{ Vec[CascadePatch]::new(), false, 0 }
        let styled = apply_stylesheet_node(self, marked, Option[Style]::Some(parent.computed),
            ancestors, parent.variables, siblings, input.ordinal, siblings.len(),
            0, states, sibling_states, retained, next, false, true, delta, 0, false,)
        let end = position + previous.subtree_size
        let added = next.len()
        let selectors = branch.selector_tree()
        if added == previous.subtree_size && index.same_topology(position, selectors) {
            // No offsets or ancestor spans changed. Update just this branch;
            // rebuilding hundreds of unrelated index entries and 256 ID
            // buckets for a moving two-node overlay was the hot-frame cost.
            let mut local_position = 0_usize
            for replacement in next {
                let parent_position = if local_position == 0 {
                    input.parent
                } else {
                    position + replacement.parent_index
                }
                state.entries.set(position + local_position,
                    repositioned_cascade_entry(replacement, parent_position, replacement.subtree_size),)
                local_position += 1
            }
            index.refresh_branch(position, selectors)
            index.refresh_ancestors(position)
            refresh_cascade_ancestor_interactions(state, position)
            state.patches = Vec[CascadePatch]::new()
            state.patchable = true
            state.interaction_evaluations = delta.evaluations
            ret Option[Widget]::Some(styled)
        }
        let mut merged = Vec[CascadeEntry]::new()
        merged.reserve(state.entries.len() - previous.subtree_size + added)
        let mut old_position = 0_usize
        for entry in state.entries {
            if old_position == position {
                let mut local_position = 0_usize
                for replacement in next {
                    let parent_position = if local_position == 0 {
                        input.parent
                    } else {
                        position + replacement.parent_index
                    }
                    merged.push(repositioned_cascade_entry(replacement, parent_position, replacement.subtree_size))
                    local_position += 1
                }
            }
            if old_position < position || old_position >= end {
                let parent_position = shifted_cascade_position(entry.parent_index, end, previous.subtree_size, added)
                let span = if old_position < position && old_position + entry.subtree_size > position {
                    entry.subtree_size - previous.subtree_size + added
                } else {
                    entry.subtree_size
                }
                merged.push(repositioned_cascade_entry(entry, parent_position, span))
            }
            old_position += 1
        }
        let snapshot = replace_cascade_branch(index.input(0).widget, path, 0, selectors)
        state.entries = merged
        state.interaction_index = Option[InteractionIndex<H>]::Some(InteractionIndex::from_snapshot(snapshot))
        refresh_cascade_ancestor_interactions(state, position)
        state.patches = Vec[CascadePatch]::new()
        state.patchable = true
        state.interaction_evaluations = delta.evaluations
        ret Option[Widget]::Some(styled)
    }

    /// Evaluates an interaction-only transaction against committed CSS inputs.
    /// Relational/sibling selectors and geometric changes use the complete
    /// cascade; their semantics are never approximated by this indexed path.
    pub fn stage_interaction(self: Self, hovered_id: str, active_id: str, focused_id: str,
        keyboard_focus: bool, state: mut RetainedCascade&,) -> bool {
        state.interaction_evaluations = 0
        if state.revision != self.revision || self.cache.relational || self.cache.sibling_interaction_dependent {
            ret false
        }
        let mut index = match state.interaction_index {
            Some(value) => value
            None => {
                ret false
            }
        }
        if index.inputs.len() != state.entries.len() || state.entries.len() == 0 {
            ret false
        }
        index.epoch += 1
        index.queue.clear()
        state.patches = Vec[CascadePatch]::new()
        state.patchable = true
        let hovered = index.targets(hovered_id)
        let active = index.targets(active_id)
        let focused = index.targets(focused_id)
        if state.hovered != hovered_id {
            index.mark_paths(index.targets(state.hovered))
            index.mark_paths(hovered)
        }
        if state.active != active_id {
            index.mark_paths(index.targets(state.active))
            index.mark_paths(active)
        }
        if state.focused != focused_id || state.keyboard_focus != keyboard_focus {
            index.mark_paths(index.targets(state.focused))
            index.mark_paths(focused)
            if state.focused == "" || focused_id == "" {
                index.mark_paths(index.authored_focus)
            }
        }
        let mut undo = Vec[CascadeUndo]::new()
        while index.queue.len() > 0 {
            let position = index.pop()
            let input = index.input(position)
            let previous = cascade_entry_at(state.entries, position)
            let interaction = indexed_interaction(index, state.entries, position,
                hovered, active, focused, focused_id == "", keyboard_focus,)
            let bits = cascade_interaction_bits(interaction)
            let parent = if input.parent == position {
                Option[Style]::None
            } else {
                Option[Style]::Some(state.entries.get(input.parent).unwrap_or(previous).computed)
            }
            let inherited_variables = if input.parent == position {
                Vec[CssVariable]::new()
            } else {
                state.entries.get(input.parent).unwrap_or(previous).variables
            }
            let base = match parent {
                Some(style) => input.widget.style().inherit_text(style)
                None => input.widget.style()
            }
            let forced = index.marks.get(position).unwrap_or(InteractionMark { 0, false }).forced
            if !forced && bits == previous.interaction && previous.base.equivalent(base) &&
            cascade_variables_equal(previous.inherited_variables, inherited_variables) {
                continue
            }
            // Most ancestors only acquire a "within" bit when the pointer or
            // focus moves. Record it without re-running unrelated declarations.
            // Ancestor selectors still invalidate their dependent descendants.
            if !forced &&((bits ^ previous.interaction) &(local_interaction_mask(self, input.widget) | 16_u32)) == 0_u32 &&
            previous.base.equivalent(base) && cascade_variables_equal(previous.inherited_variables, inherited_variables) {
                undo.push(CascadeUndo { position, previous })
                state.entries.set(position, CascadeEntry {
                        previous.selector, previous.explicit, previous.base, previous.computed, previous.variables,
                        previous.inherited_variables, bits, previous.subtree_size, previous.child_index,
                        previous.sibling_count, previous.depth, previous.authored, previous.parent_index
                    }
                    ,
                )
                if bits != previous.interaction && ancestor_interaction_affects_children(self, input.widget) {
                    for child in position + 1..position + previous.subtree_size {
                        index.mark(child, true)
                    }
                }
                continue
            }
            state.interaction_evaluations += 1
            let widget = input.widget.with_computed_style(base).with_focus(interaction.widget_focused)
            let mut ancestors = Vec[SelectorNode]::new()
            let mut reversed = Vec[usize]::new()
            let mut cursor = input.parent
            if cursor != position {
                loop {
                    reversed.push(cursor)
                    let owner = index.inputs.get(cursor).unwrap_or(input).parent
                    if owner == cursor {
                        break
                    }
                    cursor = owner
                }
            }
            while reversed.len() > 0 {
                let ancestor_index = reversed.pop().unwrap_or(0)
                let ancestor_input = index.inputs.get(ancestor_index).unwrap_or(input)
                let ancestor_entry = state.entries.get(ancestor_index).unwrap_or(previous)
                let ancestor_state = indexed_interaction(index, state.entries, ancestor_index,
                    hovered, active, focused, focused_id == "", keyboard_focus,)
                let siblings = if ancestor_input.parent == ancestor_index {
                    singleton_widget(ancestor_input.widget)
                } else {
                    index.inputs.get(ancestor_input.parent).unwrap_or(input).widget.children()
                }
                ancestors.push(SelectorNode {
                        ancestor_input.widget.with_computed_style(ancestor_entry.computed).with_focus(ancestor_state.widget_focused),
                        ancestor_input.ordinal, siblings.len(), siblings, ancestor_state,
                        Vec[InteractionStyleState]::new()
                    }
                    ,)
            }
            let siblings = if input.parent == position {
                singleton_widget(widget)
            } else {
                index.inputs.get(input.parent).unwrap_or(input).widget.children()
            }
            let variables = compute_variables(self, widget, ancestors, siblings, input.ordinal,
                siblings.len(), interaction.hovered_within, interaction.active_within, interaction.focused,
                interaction.focus_within, interaction, Vec[InteractionStyleState]::new(), inherited_variables,)
            let computed = compute_style(self, widget, ancestors, siblings, input.ordinal,
                siblings.len(), interaction.hovered_within, interaction.active_within, interaction.focused,
                interaction.focus_within, interaction, Vec[InteractionStyleState]::new(), variables,)
            undo.push(CascadeUndo { position, previous })
            state.entries.set(position, CascadeEntry {
                    widget.selector_inputs(), previous.explicit, base, computed, variables,
                    inherited_variables, bits, previous.subtree_size, previous.child_index,
                    previous.sibling_count, previous.depth, previous.authored, previous.parent_index
                }
                ,)
            if !previous.computed.equivalent(computed) ||
            ((previous.interaction & 16) != 0) != interaction.widget_focused {
                if widget.id() == "" || index.targets(widget.id()).len() != 1 ||
                !previous.computed.layout_equivalent(computed) {
                    state.patchable = false
                }
                state.patches.push(CascadePatch {
                        widget.id(), computed, interaction.widget_focused
                    }
                    ,
                )
            }
            if bits != previous.interaction && ancestor_interaction_affects_children(self, widget) {
                for child in position + 1..position + previous.subtree_size {
                    index.mark(child, true)
                }
            }
            if !previous.computed.inheritance_equivalent(computed) || !cascade_variables_equal(previous.variables, variables) {
                for child in input.children {
                    index.mark(child, false)
                }
            }
        }
        if !state.patchable {
            // Cache writes are provisional until the entire batch is paint-only.
            for saved in undo {
                state.entries.set(saved.index, saved.entry)
            }
            state.patches = Vec[CascadePatch]::new()
            ret false
        }
        state.hovered = hovered_id
        state.active = active_id
        state.focused = focused_id
        state.keyboard_focus = keyboard_focus
        ret true
    }

    fn apply_cascade(self: Self, root: Widget, hovered_id: str,
        active_id: str, focused_id: str, keyboard_focus: bool,
        state: mut RetainedCascade&, retain: bool,) -> Widget {
        state.patches = Vec[CascadePatch]::new()
        state.patchable = false
        if retain && state.revision == self.revision && state.hovered == hovered_id &&
        state.active == active_id && state.focused == focused_id && state.keyboard_focus == keyboard_focus {
            match replay_cascade(state.entries, root, 0, focused_id) {
                Some(value) => {
                    ret value
                }
                None => {
                }
            }
        }
        let mut invalidate = state.revision != self.revision
        if self.cache.relational || self.cache.sibling_dependent {
            invalidate = invalidate || state.hovered != hovered_id || state.active != active_id ||
            state.focused != focused_id || state.keyboard_focus != keyboard_focus
            match state.entries.get(0) {
                Some(previous) => {
                    invalidate = invalidate || !cascade_selector_tree_equal(state.entries, root, 0)
                }
                None => {
                    invalidate = true
                }
            }
        }
        let trace = env("LUMA_TRACE_CSS").unwrap_or("") == "1"
        let started = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        let mut next = Vec[CascadeEntry]::new()
        let mut delta = CascadeDelta<S> {
            Vec[CascadePatch]::new(), retain && state.revision == self.revision, 0
        }
        let mut interaction_states = Vec[InteractionStyleState]::new()
        let marked_root = append_interaction_style_state(root, hovered_id, active_id,
            focused_id, keyboard_focus, interaction_states,)
        let interaction_at = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        let mut root_sibling_interactions = Vec[InteractionStyleState]::new()
        match interaction_states.get(0_usize) {
            Option[InteractionStyleState]::Some(root_interaction) => {
                root_sibling_interactions.push(root_interaction)
            }
            Option[InteractionStyleState]::None => {
            }
        }
        let result = apply_stylesheet_node(self, marked_root, Option[Style]::None,
            Vec[SelectorNode]::new(), Vec[CssVariable]::new(), singleton_widget(marked_root),
            0_usize, 1_usize, 0_usize, interaction_states,
            root_sibling_interactions, state.entries, next, invalidate, retain, delta, 0, true,)
        let cascade_at = if trace {
            perf_counter_ns()
        } else {
            0_u64
        }
        if retain {
            state.entries = next
            state.revision = self.revision
            state.hovered = hovered_id
            state.active = active_id
            state.focused = focused_id
            state.keyboard_focus = keyboard_focus
            state.patches = delta.patches
            state.patchable = delta.patchable
            let index = InteractionIndex::new(root)
            // ID-addressed display patches are only valid for unique targets.
            // Duplicate IDs still receive ordinary per-node CSS reconciliation.
            for patch in state.patches {
                if index.targets(patch.id()).len() != 1 {
                    state.patchable = false
                }
            }
            state.interaction_index = Option[InteractionIndex<H>]::Some(index)
        }
        if trace {
            eprintln(f"LUMA_CSS states_us={(interaction_at-started)/1000} cascade_us={(cascade_at-interaction_at)/1000} index_us={(perf_counter_ns()-cascade_at)/1000} evaluated={delta.evaluations} nodes={interaction_states.len()}")
        }
        ret result
    }

    pub fn len(self: Self) -> usize {
        ret self.rules.len()
    }

    fn maximum_specificity(self: Self) -> usize {
        ret self.maximum_specificity
    }
}

// Precompute a necessary condition on each selector's target widget. Complex
// pseudo selectors still use the complete matcher after this cheap filter.
fn rule_candidates(rules: Vec[StyleRule]) -> Vec[RuleCandidate] {
    let mut candidates = Vec[RuleCandidate]::new()
    for rule in rules {
        let combinator = rightmost_combinator(rule.selector)
        let subject = if combinator.kind == 0_usize {
            rule.selector
        } else {
            trim(rule.selector.slice(combinator.index + 1_usize,
                    rule.selector.char_len() - combinator.index - 1_usize,))
        }
        let first = subject.slice(0_usize, 1_usize)
        if first == "#" || first == "." {
            candidates.push(RuleCandidate {
                    if first == "#" {
                        1_usize
                    } else {
                        2_usize
                    }
                    ,
                    subject.slice(1_usize, selector_part_end(subject, 1_usize) - 1_usize)
                }
                ,)
        } elif first != "" && first != ":" && first != "[" && first != "*" {
            candidates.push(RuleCandidate {
                    3_usize, subject.slice(0_usize, selector_part_end(subject, 0_usize))
                }
                ,
            )
        } else {
            candidates.push(RuleCandidate {
                    0_usize, ""
                }
                ,
            )
        }
    }
    ret candidates
}

fn rule_candidate_matches(candidate: RuleCandidate, widget: Widget) -> bool {
    if candidate.kind == 1_usize {
        ret widget.id() == candidate.value
    }
    if candidate.kind == 2_usize {
        ret has_class(widget.classes(), candidate.value)
    }
    if candidate.kind == 3_usize {
        ret widget_type(widget) == candidate.value
    }
    ret true
}

// Only ancestors which can be the subject of an interaction selector affect
// descendant styles. A hovered menu item must not invalidate the viewport or
// the complete workspace merely because another rule uses `.row:hover label`.
fn ancestor_interaction_candidates(rules: Vec[StyleRule]) -> Vec[RuleCandidate] {
    let mut result = Vec[RuleCandidate]::new()
    for rule in rules {
        let mut selector = rule.selector
        let mut combinator = rightmost_combinator(selector)
        while combinator.kind != 0 {
            selector = trim(selector.slice(0, combinator.index))
            let previous = rightmost_combinator(selector)
            let subject = if previous.kind == 0 {
                selector
            } else {
                trim(selector.slice(previous.index + 1, selector.char_len() - previous.index - 1))
            }
            if string_contains(subject, ":hover") || string_contains(subject, ":active") ||
            string_contains(subject, ":focus") || string_contains(subject, ":has(") {
                let mut subjects = Vec[StyleRule]::new()
                subjects.push(StyleRule { subject, "", 0 })
                result.push(rule_candidates(subjects).get(0).unwrap_or(RuleCandidate { 0, "" }))
            }
            combinator = previous
        }
    }
    ret result
}

fn ancestor_interaction_affects_children(sheet: StyleSheet, widget: Widget) -> bool {
    for candidate in sheet.ancestor_interactions {
        if rule_candidate_matches(candidate, widget) {
            ret true
        }
    }
    ret false
}

fn interaction_selector_mask(selector: str) -> u32 {
    let mut mask = 0_u32
    if string_contains(selector, ":hover") {
        mask = mask | 1_u32
    }
    if string_contains(selector, ":active") {
        mask = mask | 2_u32
    }
    if string_contains(selector, ":focus") {
        mask = mask | 4_u32 | 8_u32 | 16_u32 | 32_u32
    }
    ret mask
}

fn local_interaction_candidates(rules: Vec[StyleRule]) -> Vec[InteractionCandidate] {
    let mut result = Vec[InteractionCandidate]::new()
    for rule in rules {
        let mut selector = rule.selector
        let mut local = true
        loop {
            let split = rightmost_combinator(selector)
            let subject = if split.kind == 0 {
                selector
            } else {
                trim(selector.slice(split.index + 1, selector.char_len() - split.index - 1))
            }
            let mut mask = if local {
                interaction_selector_mask(subject)
            } else {
                0_u32
            }
            if string_contains(subject, ":nth-") || string_contains(subject, ":first-") ||
            string_contains(subject, ":last-") || string_contains(subject, ":only-") {
                mask = mask | 64_u32
            }
            if string_contains(subject, ":empty") {
                mask = mask | 128_u32
            }
            if mask != 0_u32 {
                let mut subjects = Vec[StyleRule]::new()
                subjects.push(StyleRule { subject, "", 0 })
                result.push(InteractionCandidate {
                        rule_candidates(subjects).get(0).unwrap_or(RuleCandidate {
                                0, ""
                            }
                        ), mask
                    }
                )
            }
            if split.kind == 0 {
                break
            }
            selector = trim(selector.slice(0, split.index))
            local = false
        }
    }
    ret result
}

fn local_interaction_mask(sheet: StyleSheet, widget: Widget) -> u32 {
    let mut mask = 0_u32
    let id = widget.id()
    let classes = widget.classes()
    let tag = widget_type(widget)
    for candidate in sheet.local_interactions {
        let subject = candidate.subject
        if subject.kind == 0_usize ||(subject.kind == 1_usize && id == subject.value) ||
        (subject.kind == 2_usize && has_class(classes, subject.value)) ||
        (subject.kind == 3_usize && tag == subject.value) {
            mask = mask | candidate.mask
        }
    }
    ret mask
}

// Sort once per stylesheet, stably: equal specificity keeps source order.
fn order_style_rules(source: Vec[StyleRule]) -> Vec[StyleRule] {
    let mut ordered = Vec[StyleRule]::new()
    for rule in source {
        let mut index = ordered.len()
        ordered.push(rule)
        while index > 0_usize {
            let previous = ordered.get(index - 1_usize).unwrap_or(rule)
            if previous.specificity <= rule.specificity {
                break
            }
            ordered.set(index, previous)
            index -= 1_usize
        }
        ordered.set(index, rule)
    }
    ret ordered
}

fn variable_style_rules(source: Vec[StyleRule]) -> Vec[StyleRule] {
    let mut rules = Vec[StyleRule]::new()
    for rule in source {
        let mut variables = Vec[CssVariable]::new()
        collect_variables(variables, rule.declarations)
        if variables.len() > 0_usize {
            rules.push(rule)
        }
    }
    ret rules
}

fn stylesheet_revision(source: str) -> u64 {
    let mut hash = 1469598103934665603_u64
    let mut index = 0_usize
    while index < source.len() {
        hash =(hash ^(source.byte_at(index) as u64)) * 1099511628211_u64
        index += 1_usize
    }
    ret hash
}

fn css_balanced(source: str) -> bool {
    let mut depth = 0_i32
    let mut quote = 0_u8
    let mut escaped = false
    let mut comment = false
    let mut index = 0_usize
    let length = source.byte_len()
    while index < length {
        let current = source.byte_at(index)
        let next = if index + 1_usize < length {
            source.byte_at(index + 1_usize)
        } else {
            0_u8
        }
        if comment {
            if current == 42_u8 && next == 47_u8 {
                comment = false
                index += 2_usize
                continue
            }
        } elif quote != 0_u8 {
            if escaped {
                escaped = false
            } elif current == 92_u8 {
                escaped = true
            } elif current == quote {
                quote = 0_u8
            }
        } else {
            if current == 47_u8 && next == 42_u8 {
                comment = true
                index += 2_usize
                continue
            } elif current == 34_u8 || current == 39_u8 {
                quote = current
            } elif current == 123_u8 {
                depth += 1_i32
            } elif current == 125_u8 {
                depth -= 1_i32
                if depth < 0_i32 {
                    ret false
                }
            }
        }
        index += 1_usize
    }
    ret depth == 0_i32 && quote == 0_u8 && !comment
}

// CSS punctuation is ASCII. Scan bytes, preserving UTF-8 selector/value
// slices at punctuation boundaries rather than rescanning codepoints per byte.
fn rule_open(value: str, start: usize) -> usize {
    let mut index = start
    let mut quote = 0_u8
    let mut escaped = false
    let length = value.byte_len()
    while index < length {
        let current = value.byte_at(index)
        if quote != 0_u8 {
            if escaped {
                escaped = false
            } elif current == 92_u8 {
                escaped = true
            } elif current == quote {
                quote = 0_u8
            }
        } else {
            if current == 34_u8 || current == 39_u8 {
                quote = current
            } elif current == 123_u8 {
                ret index
            }
        }
        index += 1_usize
    }
    ret length
}

fn rule_close(value: str, open: usize) -> usize {
    let mut index = open
    let mut depth = 0_usize
    let mut quote = 0_u8
    let mut escaped = false
    let length = value.byte_len()
    while index < length {
        let current = value.byte_at(index)
        if quote != 0_u8 {
            if escaped {
                escaped = false
            } elif current == 92_u8 {
                escaped = true
            } elif current == quote {
                quote = 0_u8
            }
        } else {
            if current == 34_u8 || current == 39_u8 {
                quote = current
            } elif current == 123_u8 {
                depth += 1_usize
            } elif current == 125_u8 {
                if depth == 1_usize {
                    ret index
                }
                if depth > 0_usize {
                    depth -= 1_usize
                }
            }
        }
        index += 1_usize
    }
    ret length
}

// Build the focus-marked tree and a preorder state table in one traversal.
// Each entry carries its subtree span so the cascade can advance to the next
// sibling without searching descendant trees for pseudo-state IDs.
fn append_interaction_style_state(widget: Widget, hovered_id: str,
    active_id: str, focused_id: str, keyboard_focus: bool,
    states: mut Vec[InteractionStyleState],) -> Widget {
    let index = states.len()
    let id = widget.id()
    let hovered = hovered_id != "" && id == hovered_id
    let active = active_id != "" && id == active_id
    let focused = focused_id != "" && id == focused_id
    let widget_focused = if focused_id == "" {
        widget.focused()
    } else {
        focused
    }
    let focus_visible = widget_focused &&(keyboard_focus ||
        widget.kind() == widget_input() || widget.kind() == widget_textarea())
    states.push(InteractionStyleState {
            1_usize, hovered, active, focused,
            widget_focused, widget_focused, focus_visible, Vec[InteractionStyleState]::new(),
        }
        ,)
    let mut subtree_size = 1_usize
    let mut hovered_within = hovered
    let mut active_within = active
    let mut focus_within = widget_focused
    let mut children = Vec[Widget]::new()
    let mut child_states = Vec[InteractionStyleState]::new()
    for child in widget.children() {
        let child_index = states.len()
        let marked_child = append_interaction_style_state(child, hovered_id,
            active_id, focused_id, keyboard_focus, states,)
        children.push(marked_child)
        match states.get(child_index) {
            Option[InteractionStyleState]::Some(child_state) => {
                subtree_size += child_state.subtree_size
                hovered_within = hovered_within || child_state.hovered_within
                active_within = active_within || child_state.active_within
                focus_within = focus_within || child_state.focus_within
                child_states.push(child_state)
            }
            Option[InteractionStyleState]::None => {
                child_states.push(static_interaction_state(child))
            }
        }
    }
    states.set(index, InteractionStyleState {
            subtree_size, hovered_within, active_within, focused,
            focus_within, widget_focused, focus_visible, child_states,
        }
        ,)
    ret widget.with_focus(widget_focused).with_children(children)
}

fn compute_style(sheet: StyleSheet, widget: Widget, ancestors: Vec[SelectorNode], siblings: Vec[Widget],
    child_index: usize, sibling_count: usize,
    hovered: bool, active: bool, focused: bool, focus_within: bool,
    interaction: InteractionStyleState, sibling_interactions: Vec[InteractionStyleState],
    variables: Vec[CssVariable],) ->
Style {
    if widget.has_explicit_style() {
        ret widget.geometry_style(widget.style())
    }
    let key = computed_style_cache_key(sheet, widget, ancestors, siblings, child_index,
        sibling_count, hovered, active, focused, focus_within,
        interaction, sibling_interactions, variables,)
    match sheet.cache.get(key, widget.style()) {
        Option::Some(computed) => {
            ret widget.geometry_style(computed)
        }
        Option::None => {
        }
    }
    let mut declarations = ""
    for index in sheet.rule_index.for_widget(widget) {
        match sheet.rules.get(index) {
            Option[StyleRule]::Some(rule) => {
                if selector_tree_matches(rule.selector, widget, ancestors,
                    ancestors.len(), siblings, child_index, sibling_count, hovered, active, focused,
                    focus_within, interaction, sibling_interactions,) {
                    if declarations != "" {
                        declarations = declarations + ";"
                    }
                    declarations = declarations + resolve_variables(rule.declarations, variables)
                }
            }
            Option[StyleRule]::None => {
            }
        }
    }
    let computed = sheet.cache.compute_declarations(widget.style(), declarations)
    sheet.cache.put(key, declarations, widget.style(), computed)
    ret widget.geometry_style(computed)
}

fn selector_cache_signature(widget: Widget, sheet: StyleSheet) -> str {
    let retain_id = selector_retains_id(widget, sheet)
    let selector_widget = if retain_id {
        widget
    } else {
        widget.with_id("")
    }
    let mut signature = selector_widget.selector_signature_for_attributes(sheet.cache.selector_attributes) + "#focus:" + Debug::fmt(widget.focused())
    if sheet.cache.relational ||(local_interaction_mask(sheet, widget) & 128_u32) != 0_u32 {
        signature = signature + "#empty:" + Debug::fmt(widget.text() == "") + "#children:" + Debug::fmt(widget.children().len())
    }
    if sheet.cache.relational {
        for child in widget.children() {
            let child_signature = selector_cache_signature(child, sheet)
            signature = signature + "#child:" + Debug::fmt(child_signature.len()) + ":" + child_signature
        }
    }
    ret signature
}

fn selector_retains_id(widget: Widget, sheet: StyleSheet) -> bool {
    ret selector_id_required(widget.id(), sheet)
}

fn selector_id_required(value: str, sheet: StyleSheet) -> bool {
    if !sheet.cache.anonymous_id_safe {
        ret true
    }
    for id in sheet.cache.selector_ids {
        if id == value {
            ret true
        }
    }
    ret false
}

fn cascade_node_selector_equal(left: WidgetSelector, right: WidgetSelector, sheet: StyleSheet) -> bool {
    ret cascade_selector_inputs_equal(left, right, sheet, true)
}

fn cascade_selector_inputs_equal(left: WidgetSelector, right: WidgetSelector, sheet: StyleSheet, compare_children: bool) -> bool {
    if left.id() == right.id() {
        ret left.equivalent_for_attributes(right, true, sheet.cache.selector_attributes, compare_children)
    }
    if selector_id_required(left.id(), sheet) || selector_id_required(right.id(), sheet) {
        ret false
    }
    ret left.equivalent_for_attributes(right, false, sheet.cache.selector_attributes, compare_children)
}

fn computed_style_cache_key(sheet: StyleSheet, widget: Widget, ancestors: Vec[SelectorNode],
    siblings: Vec[Widget], child_index: usize, sibling_count: usize, hovered: bool, active: bool,
    focused: bool, focus_within: bool, interaction: InteractionStyleState,
    sibling_interactions: Vec[InteractionStyleState],
    variables: Vec[CssVariable],) -> str {
    let mut key = Debug::fmt(sheet.revision) + "#" + selector_cache_signature(widget, sheet) + "#i:" +
    if sheet.cache.relational {
        interaction_cache_signature(interaction, true)
    } else {
        Debug::fmt(cascade_interaction_bits(interaction) & local_interaction_mask(sheet, widget))
    }
    if (local_interaction_mask(sheet, widget) & 64_u32) != 0_u32 {
        key = key + "#position:" + Debug::fmt(child_index) + "/" + Debug::fmt(sibling_count)
    }
    // Flat selectors do not depend on ancestor identities or interaction.
    // Depth still distinguishes :root after reparenting the same widget.
    key = key + "#depth:" + Debug::fmt(ancestors.len())
    if sheet.cache.ancestor_dependent {
        for ancestor in ancestors {
            key = key + "#a:" + selector_cache_signature(ancestor.widget, sheet)
            if (local_interaction_mask(sheet, ancestor.widget) & 64_u32) != 0_u32 {
                key = key + ":" + Debug::fmt(ancestor.index) + "/" + Debug::fmt(ancestor.count)
            }
            if sheet.cache.relational || ancestor_interaction_affects_children(sheet, ancestor.widget) {
                key = key + "#ai:" + interaction_cache_signature(ancestor.interaction, sheet.cache.relational)
            }
            if sheet.cache.sibling_dependent {
                for sibling in ancestor.siblings {
                    key = key + "#as:" + selector_cache_signature(sibling, sheet)
                }
                for sibling_interaction in ancestor.sibling_interactions {
                    key = key + "#asi:" + interaction_cache_signature(sibling_interaction,
                        sheet.cache.relational,)
                }
            }
        }
    }
    // Only selectors which inspect siblings need their signatures. Including
    // the entire row for every card made ordinary grids quadratic even on hits.
    if sheet.cache.sibling_dependent {
        for sibling in siblings {
            key = key + "#s:" + selector_cache_signature(sibling, sheet)
        }
        for sibling_interaction in sibling_interactions {
            key = key + "#si:" + interaction_cache_signature(sibling_interaction,
                sheet.cache.relational,)
        }
    }
    // A variable set can contain dozens of long values. Serialize its exact
    // retained identity once instead of rebuilding that string for each node.
    key = key + "#variables:" + Debug::fmt(sheet.cache.variable_identity(variables))
    ret key
}

fn interaction_cache_signature(state: InteractionStyleState, relational: bool) -> str {
    let mut signature = Debug::fmt(state.hovered_within) + Debug::fmt(state.active_within) +
    Debug::fmt(state.focused) + Debug::fmt(state.focus_within) + Debug::fmt(state.focus_visible)
    if relational {
        for child in state.children {
            let child_signature = interaction_cache_signature(child, true)
            signature = signature + "#c:" + Debug::fmt(child_signature.len()) + ":" + child_signature
        }
    }
    ret signature
}

fn compute_variables(sheet: StyleSheet, widget: Widget, ancestors: Vec[SelectorNode], siblings: Vec[Widget],
    child_index: usize, sibling_count: usize, hovered: bool,
    active: bool, focused: bool, focus_within: bool,
    interaction: InteractionStyleState, sibling_interactions: Vec[InteractionStyleState],
    inherited: Vec[CssVariable],) -> Vec[CssVariable]
{
    // Most nodes only inherit custom properties. Avoid constructing and
    // hashing a second full cascade key when no variable rule can match.
    let mut candidate_index = 0_usize
    let mut may_declare = false
    for rule in sheet.variable_rules {
        let candidate = sheet.variable_candidates.get(candidate_index).unwrap_or(RuleCandidate {
                0_usize, ""
            }
            ,
        )
        if rule_candidate_matches(candidate, widget) &&
        !(rule.selector == ":root" && ancestors.len() > 0_usize) {
            may_declare = true
            break
        }
        candidate_index += 1_usize
    }
    if !may_declare {
        ret widget_css_variables(widget, inherited)
    }
    let key = computed_style_cache_key(sheet, widget, ancestors, siblings, child_index,
        sibling_count, hovered, active, focused, focus_within,
        interaction, sibling_interactions, inherited,)
    match sheet.cache.get_variables(key) {
        Option::Some(cached) => {
            ret widget_css_variables(widget, cached)
        }
        Option::None => {
        }
    }
    let mut result = copy_variables(inherited)
    let mut index = 0_usize
    while index < sheet.variable_rules.len() {
        match sheet.variable_rules.get(index) {
            Option[StyleRule]::Some(rule) => {
                if selector_tree_matches(rule.selector, widget, ancestors,
                    ancestors.len(), siblings, child_index, sibling_count, hovered, active, focused,
                    focus_within, interaction, sibling_interactions,) {
                    collect_variables(result, rule.declarations)
                }
            }
            Option[StyleRule]::None => {
            }
        }
        index = index + 1_usize
    }
    sheet.cache.put_variables(key, result)
    ret widget_css_variables(widget, result)
}

// Runtime values are data bindings, not an explicit Style that bypasses the
// cascade. Copy only when a widget declares its own values; inherited/cache
// vectors remain immutable and can be shared by unrelated siblings.
fn widget_css_variables(widget: Widget, inherited: Vec[CssVariable]) -> Vec[CssVariable] {
    match widget.attribute("data-luma-css-variables") {
        Option::Some(declarations) => {
            let mut values = copy_variables(inherited)
            collect_variables(values, declarations)
            ret values
        }
        Option::None => {
            ret inherited
        }
    }
}

fn copy_variables(source: Vec[CssVariable]) -> Vec[CssVariable] {
    let mut result = Vec[CssVariable]::new()
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[CssVariable]::Some(variable) => {
                result.push(variable)
            }
            Option[CssVariable]::None => {
            }
        }
        index = index + 1_usize
    }
    ret result
}

fn apply_stylesheet_node(sheet: StyleSheet, widget: Widget,
    parent: Option[Style], ancestors: Vec[SelectorNode], inherited_variables: Vec[CssVariable],
    siblings: Vec[Widget], child_index: usize, sibling_count: usize,
    state_index: usize, states: Vec[InteractionStyleState],
    sibling_interactions: Vec[InteractionStyleState], previous: Vec[CascadeEntry],
    next: mut Vec[CascadeEntry], invalidate: bool, retain: bool,
    delta: mut CascadeDelta&, parent_index: usize, parent_stable: bool,) -> Widget {
    let interaction = match states.get(state_index) {
        Option[InteractionStyleState]::Some(state) => state
        Option[InteractionStyleState]::None => InteractionStyleState {
            1_usize, false, false, widget.focused(), widget.focused(),
            widget.focused(), widget.focused(), Vec[InteractionStyleState]::new(),
        }
    }
    let cached = previous.get(state_index)
    // Reuse the inherited base when both its authored input and its parent's
    // inheritance are unchanged. Parent positions are verified explicitly:
    // an insertion/reparenting must not reuse another parent's environment.
    let base_stable = parent_stable && match cached {
        Some(entry) => entry.parent_index == parent_index && entry.authored.equivalent(widget.style())
        None => false
    }
    let base_style = if base_stable {
        match cached {
            Some(entry) => entry.base None => widget.style()
        }
    } else {
        match parent {
            Some(parent_style) => widget.style().inherit_text(parent_style)
            None => widget.style()
        }
    }
    let base = widget.with_computed_style(base_style)
    let inherited = base.with_focus(interaction.widget_focused)
    let hovered = interaction.hovered_within
    let active = interaction.active_within
    let focused = interaction.focused
    let focus_within = interaction.focus_within
    // Ancestor selectors only invalidate descendants of the changed ancestor.
    // Unrelated branches retain their styles when hover, focus or classes change.
    let context_unchanged = match cached {
        Some(entry) => cascade_selector_inputs_equal(entry.selector, widget.selector_inputs(), sheet, sheet.cache.ancestor_structure_dependent) &&
        entry.depth == ancestors.len() &&(!ancestor_interaction_affects_children(sheet, widget) || entry.interaction == cascade_interaction_bits(interaction)) &&
        (!sheet.cache.position_dependent ||(entry.child_index == child_index && entry.sibling_count == sibling_count))
        None => false
    }
    let child_invalidate = invalidate ||(sheet.cache.ancestor_dependent && !context_unchanged)
    let reuse = !invalidate && match cached {
        Some(entry) => cascade_node_selector_equal(entry.selector, widget.selector_inputs(), sheet) &&
        entry.explicit == widget.has_explicit_style() &&
        (base_stable || entry.base.equivalent(inherited.style())) &&
        (!sheet.cache.position_dependent ||(entry.child_index == child_index && entry.sibling_count == sibling_count)) &&
        entry.depth == ancestors.len() && entry.interaction == cascade_interaction_bits(interaction) &&
        cascade_variables_equal(entry.inherited_variables, inherited_variables)
        None => false
    }
    let variables = if reuse {
        match cached {
            Some(entry) => entry.variables None => inherited_variables
        }
    } else {
        delta.evaluations += 1
        compute_variables(sheet, inherited, ancestors, siblings, child_index, sibling_count,
            hovered, active, focused, focus_within, interaction, sibling_interactions,
            inherited_variables,)
    }
    let computed = if reuse {
        match cached {
            Some(entry) => entry.computed None => inherited.style()
        }
    } else {
        compute_style(sheet, inherited, ancestors, siblings, child_index,
            sibling_count,
            hovered, active, focused, focus_within, interaction, sibling_interactions,
            variables,)
    }
    let styled = inherited.with_computed_style(computed)
    let child_parent_stable = reuse || match cached {
        Some(entry) => entry.computed.inheritance_equivalent(computed)
        None => false
    }
    if retain {
        match cached {
            Some(entry) => {
                if entry.selector.id() != widget.id() {
                    delta.patchable = false
                }
                if !entry.computed.equivalent(computed) ||
                ((entry.interaction & 16) != 0) != interaction.widget_focused {
                    if widget.id() == "" || !entry.computed.layout_equivalent(computed) {
                        delta.patchable = false
                    }
                    delta.patches.push(CascadePatch {
                            widget.id(), computed, interaction.widget_focused
                        }
                        ,
                    )
                }
            }
            None => {
                delta.patchable = false
            }
        }
        next.push(CascadeEntry {
                widget.selector_inputs(), widget.has_explicit_style(), inherited.style(), computed, variables,
                inherited_variables, cascade_interaction_bits(interaction), interaction.subtree_size,
                child_index, sibling_count, ancestors.len(), widget.style(), parent_index
            }
            ,)
    }
    let source = styled.children()
    let mut children = Vec[Widget]::new()
    let mut child_interactions = Vec[InteractionStyleState]::new()
    let mut child_state_index = state_index + 1_usize
    for child in source {
        match states.get(child_state_index) {
            Option[InteractionStyleState]::Some(child_state) => {
                child_interactions.push(child_state)
                child_state_index += child_state.subtree_size
            }
            Option[InteractionStyleState]::None => {
                child_interactions.push(InteractionStyleState {
                        1_usize, false, false, false, false, false, false,
                        Vec[InteractionStyleState]::new(),
                    }
                    ,)
                child_state_index += 1_usize
            }
        }
    }
    let child_ancestors = append_ancestor(ancestors, styled, child_index,
        sibling_count, siblings, interaction, sibling_interactions,)
    let mut index = 0_usize
    child_state_index = state_index + 1_usize
    while index < source.len() {
        match source.get(index) {
            Option[Widget]::Some(child) => {
                children.push(apply_stylesheet_node(sheet, child,
                        Option[Style]::Some(styled.style()), child_ancestors, variables,
                        source, index, source.len(), child_state_index, states,
                        child_interactions, previous, next, child_invalidate, retain, delta,
                        state_index, child_parent_stable,))
                match states.get(child_state_index) {
                    Option[InteractionStyleState]::Some(child_state) => {
                        child_state_index += child_state.subtree_size
                    }
                    Option[InteractionStyleState]::None => {
                        child_state_index += 1_usize
                    }
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    ret styled.with_children(children)
}

pub fn css_style(declarations: str) -> Style {
    ret apply_css(Style::default(), declarations)
}

pub fn apply_css(base: Style, declarations: str) -> Style {
    let mut style = base
    let values = css_declarations(declarations)
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[str]::Some(declaration) => {
                style = apply_declaration(style, declaration)
            }
            Option[str]::None => {
            }
        }
        index = index + 1_usize
    }
    ret style
}

fn apply_declaration(style: Style, declaration: str) -> Style {
    let colon = declaration_colon(declaration)
    if colon == declaration.char_len() {
        ret style
    }
    let property = trim(declaration.slice(0_usize, colon))
    let value = trim(declaration.slice(colon + 1_usize, declaration.char_len() - colon - 1_usize))
    if property == "background" || property == "background-color" {
        if starts_with(value, "linear-gradient(") && ends_with(value, ")") {
            ret css_linear_gradient(style, value)
        }
        ret style.with_background(css_color(value))
    }
    if property == "color" {
        ret style.with_foreground(css_color(value))
    }
    if property == "accent-color" {
        ret if value == "auto" {
            style
        } else {
            style.with_accent_color(css_color(value))
        }
    }
    if property == "cursor" {
        ret style.with_pointer_cursor(css_cursor(value))
    }
    if property == "transition" {
        ret style.with_transition(css_transition(value))
    }
    if property == "transition-property" {
        ret style.with_transition(style.transition().with_properties(value))
    }
    if property == "transition-duration" {
        ret style.with_transition(style.transition().with_durations(value))
    }
    if property == "transition-delay" {
        ret style.with_transition(style.transition().with_delays(value))
    }
    if property == "transition-timing-function" {
        ret style.with_transition(style.transition().with_easings(value))
    }
    if property == "border-color" {
        ret style.with_border(style.border_width(), css_color(value))
    }
    if property == "border-width" {
        ret style.with_border(css_number(value), style.border_color())
    }
    if property == "border" {
        ret css_border(style, value)
    }
    if property == "border-style" && value == "none" {
        ret style.with_border(0.0_f32, style.border_color())
    }
    if property == "border-radius" {
        ret style.with_radius(css_number(value))
    }
    if property == "outline" {
        ret css_outline(style, value)
    }
    if property == "outline-width" {
        ret style.with_outline(css_number(value), style.outline().color(), style.outline().offset())
    }
    if property == "outline-color" {
        ret style.with_outline(style.outline().width(), css_color(value), style.outline().offset())
    }
    if property == "outline-offset" {
        ret style.with_outline(style.outline().width(), style.outline().color(), css_number(value))
    }
    if property == "outline-style" && value == "none" {
        ret style.with_outline(0.0_f32, style.outline().color(), style.outline().offset())
    }
    if property == "box-shadow" {
        ret css_box_shadow(style, value)
    }
    if property == "padding" {
        ret style.with_padding(css_insets(value))
    }
    if property == "padding-top" {
        ret style.with_padding(inset_top(style.padding(), css_number(value)))
    }
    if property == "padding-right" {
        ret style.with_padding(inset_right(style.padding(), css_number(value)))
    }
    if property == "padding-bottom" {
        ret style.with_padding(inset_bottom(style.padding(), css_number(value)))
    }
    if property == "padding-left" {
        ret style.with_padding(inset_left(style.padding(), css_number(value)))
    }
    if property == "margin" {
        ret style.with_margin(css_insets(value))
    }
    if property == "margin-top" {
        ret style.with_margin(inset_top(style.layout().margin(), css_number(value)))
    }
    if property == "margin-right" {
        ret style.with_margin(inset_right(style.layout().margin(), css_number(value)))
    }
    if property == "margin-bottom" {
        ret style.with_margin(inset_bottom(style.layout().margin(), css_number(value)))
    }
    if property == "margin-left" {
        ret style.with_margin(inset_left(style.layout().margin(), css_number(value)))
    }
    if property == "width" {
        if ends_with(value, "%") {
            ret style.with_width_percent(css_number(value) / 100.0_f32)
        }
        ret style.with_width(css_dimension(value))
    }
    if property == "height" {
        if ends_with(value, "%") {
            ret style.with_height_percent(css_number(value) / 100.0_f32)
        }
        ret style.with_height(css_dimension(value))
    }
    if property == "min-width" {
        ret style.with_min_width(css_number(value))
    }
    if property == "min-height" {
        ret style.with_min_height(css_number(value))
    }
    if property == "max-width" {
        ret style.with_max_width(css_number(value))
    }
    if property == "max-height" {
        ret style.with_max_height(css_number(value))
    }
    if property == "box-sizing" {
        ret style.with_content_box(value == "content-box")
    }
    if property == "flex-direction" {
        if value == "row" || value == "row-reverse" {
            ret style.with_flex_direction(horizontal()).with_flex_direction_reverse(value == "row-reverse")
        }
        if value == "column" || value == "column-reverse" {
            ret style.with_flex_direction(vertical()).with_flex_direction_reverse(value == "column-reverse")
        }
        ret style
    }
    if property == "flex-basis" {
        ret style.with_flex_basis(if value == "auto" {
                - 2.0_f32
            } else {
                css_dimension(value)
            }
        )
    }
    if property == "flex-grow" {
        ret style.with_flex_grow(css_number(value))
    }
    if property == "flex-shrink" {
        ret style.with_flex_shrink(css_number(value))
    }
    if property == "flex" {
        ret css_flex(style, value)
    }
    if property == "flex-wrap" {
        ret style.with_flex_wrap(value == "wrap" || value == "wrap-reverse", value == "wrap-reverse")
    }
    if property == "flex-flow" {
        ret css_flex_flow(style, value)
    }
    if property == "justify-content" {
        if value == "center" {
            ret style.with_justify(justify_center())
        }
        if value == "flex-end" || value == "end" {
            ret style.with_justify(justify_end())
        }
        if value == "space-between" {
            ret style.with_justify(justify_space_between())
        }
        if value == "space-around" {
            ret style.with_justify(justify_space_around())
        }
        if value == "space-evenly" {
            ret style.with_justify(justify_space_evenly())
        }
        ret style.with_justify(justify_start())
    }
    if property == "align-items" {
        if value == "flex-start" || value == "start" {
            ret style.with_align(align_start())
        }
        if value == "center" {
            ret style.with_align(align_center())
        }
        if value == "flex-end" || value == "end" {
            ret style.with_align(align_end())
        }
        ret style.with_align(align_stretch())
    }
    if property == "align-self" {
        if value == "auto" {
            ret style.with_align_self( - 1_i32)
        }
        if value == "flex-start" || value == "start" {
            ret style.with_align_self(align_start() as i32)
        }
        if value == "center" {
            ret style.with_align_self(align_center() as i32)
        }
        if value == "flex-end" || value == "end" {
            ret style.with_align_self(align_end() as i32)
        }
        ret style.with_align_self(align_stretch() as i32)
    }
    if property == "align-content" {
        if value == "start" || value == "flex-start" {
            ret style.with_align_content(align_content_start())
        }
        if value == "center" {
            ret style.with_align_content(align_content_center())
        }
        if value == "end" || value == "flex-end" {
            ret style.with_align_content(align_content_end())
        }
        if value == "space-between" {
            ret style.with_align_content(align_content_space_between())
        }
        if value == "space-around" {
            ret style.with_align_content(align_content_space_around())
        }
        if value == "space-evenly" {
            ret style.with_align_content(align_content_space_evenly())
        }
        ret style.with_align_content(align_content_stretch())
    }
    if property == "order" {
        ret style.with_order(css_number(value) as i32)
    }
    if property == "display" {
        ret style.with_displayed(value != "none").with_grid(value == "grid" || value == "inline-grid")
    }
    if property == "visibility" {
        ret style.with_visibility(value != "hidden" && value != "collapse")
    }
    if property == "pointer-events" {
        ret style.with_pointer_events(value != "none")
    }
    if property == "grid-template-columns" {
        let template = normalized_grid_template(value)
        ret style.with_grid_column_template(template, grid_column_count(template))
    }
    if property == "grid-template-rows" {
        ret style.with_grid_row_template(normalized_grid_template(value))
    }
    if property == "grid-auto-columns" {
        ret style.with_grid_auto_columns(normalized_grid_template(value))
    }
    if property == "grid-auto-rows" {
        ret style.with_grid_auto_rows(normalized_grid_template(value))
    }
    if property == "grid-auto-flow" {
        let input = trim(value)
        ret style.with_grid_auto_flow(starts_with(input, "column"), input == "dense" || ends_with(input,
                " dense",))
    }
    if property == "grid-column" {
        ret css_grid_placement(style, value, true)
    }
    if property == "grid-row" {
        ret css_grid_placement(style, value, false)
    }
    if property == "grid-column-start" {
        ret style.with_grid_column(grid_line(value))
    }
    if property == "grid-row-start" {
        ret style.with_grid_row(grid_line(value))
    }
    if property == "grid-column-end" {
        ret css_grid_end(style, value, true)
    }
    if property == "grid-row-end" {
        ret css_grid_end(style, value, false)
    }
    if property == "overflow" || property == "overflow-x" || property == "overflow-y" {
        ret style.with_overflow_hidden(value == "hidden" || value == "clip" || value == "scroll" || value
            == "auto")
    }
    if property == "position" {
        if value == "absolute" || value == "fixed" {
            ret style.with_relative_position(false).with_absolute(true)
        }
        if value == "relative" {
            ret style.with_absolute(false).with_relative_position(true)
        }
        ret style.with_absolute(false).with_relative_position(false)
    }
    if property == "top" {
        ret if value == "auto" {
            style.without_top()
        } else {
            style.with_top(css_dimension(value))
        }
    }
    if property == "right" {
        ret if value == "auto" {
            style.without_right()
        } else {
            style.with_right(css_dimension(value))
        }
    }
    if property == "bottom" {
        ret if value == "auto" {
            style.without_bottom()
        } else {
            style.with_bottom(css_dimension(value))
        }
    }
    if property == "left" {
        ret if value == "auto" {
            style.without_left()
        } else {
            style.with_left(css_dimension(value))
        }
    }
    if property == "z-index" {
        ret style.with_z_index(if value == "auto" {
                0_i32
            } else {
                css_number(value) as i32
            }
        )
    }
    if property == "gap" {
        let parts = css_tokens(value)
        let row = css_number(token_at(parts, 0_usize))
        let column = if parts.len() > 1_usize {
            css_number(token_at(parts, 1_usize))
        } else {
            row
        }
        ret style.with_gap(row).with_row_gap(row).with_column_gap(column)
    }
    if property == "row-gap" {
        ret style.with_row_gap(css_number(value))
    }
    if property == "column-gap" {
        ret style.with_column_gap(css_number(value))
    }
    if property == "font-family" {
        ret style.with_font_family(css_font_family(value))
    }
    if property == "font-size" {
        ret style.with_font_size(css_font_size(style, value))
    }
    if property == "font-weight" {
        if value == "normal" {
            ret style.with_font_weight(400_u32)
        }
        if value == "bold" {
            ret style.with_font_weight(700_u32)
        }
        let weight = css_number(value)
        if weight >= 1.0_f32 && weight <= 1000.0_f32 {
            ret style.with_font_weight(weight as u32)
        }
        ret style
    }
    if property == "text-align" {
        if value == "center" {
            ret style.with_text_align(text_center())
        }
        if value == "right" || value == "end" {
            ret style.with_text_align(text_end())
        }
        ret style.with_text_align(text_start())
    }
    if property == "text-decoration" {
        ret css_text_decoration(style, value)
    }
    if property == "text-decoration-line" {
        ret css_text_decoration_line(style, value)
    }
    if property == "text-decoration-color" {
        let decoration = style.decoration()
        ret style.with_text_decoration(decoration.underline(), decoration.overline(), decoration.line_through(),
            css_color(value), true, decoration.thickness(),)
    }
    if property == "text-decoration-thickness" {
        let decoration = style.decoration()
        let thickness = if value == "auto" || value == "from-font" {
            1.0_f32
        } else {
            css_number(value)
        }
        ret style.with_text_decoration(decoration.underline(), decoration.overline(), decoration.line_through(),
            decoration.color(), decoration.color_set(), thickness,)
    }
    if property == "opacity" {
        ret style.with_opacity(css_number(value))
    }
    ret style
}

fn css_cursor(value: str) -> u32 {
    let input = trim(value)
    if input == "text" {
        ret 1_u32
    }
    if input == "crosshair" {
        ret 3_u32
    }
    if input == "ew-resize" || input == "col-resize" {
        ret 7_u32
    }
    if input == "ns-resize" || input == "row-resize" {
        ret 8_u32
    }
    if input == "move" || input == "grab" || input == "grabbing" {
        ret 9_u32
    }
    if input == "not-allowed" {
        ret 10_u32
    }
    if input == "pointer" {
        ret 11_u32
    }
    ret 0_u32
}

fn css_transition(value: str) -> TransitionStyle {
    if trim(value) == "none" {
        ret TransitionStyle::none()
    }
    let items = css_comma_values(value)
    let mut properties = ""
    let mut durations = ""
    let mut delays = ""
    let mut easings = ""
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Some(item) => {
                let tokens = css_tokens(item)
                let mut property = "all"
                let mut duration = "0ms"
                let mut delay = "0ms"
                let mut easing = "ease"
                let mut time_count = 0_usize
                for token in tokens {
                    if css_time_token(token) {
                        if time_count == 0_usize {
                            duration = token
                        } else {
                            delay = token
                        }
                        time_count += 1_usize
                    } elif token == "linear" || token == "ease" || token == "ease-in" ||
                    token == "ease-out" || token == "ease-in-out" || starts_with(token, "cubic-bezier(")
                    {
                        easing = token
                    } elif token != "normal" && token != "allow-discrete" {
                        property = token
                    }
                }
                if index > 0_usize {
                    properties = properties + ","
                    durations = durations + ","
                    delays = delays + ","
                    easings = easings + ","
                }
                properties = properties + property
                durations = durations + duration
                delays = delays + delay
                easings = easings + easing
            }
            None => {
            }
        }
        index += 1_usize
    }
    ret TransitionStyle::new(properties, durations, delays, easings)
}

fn css_time_token(value: str) -> bool {
    ret ends_with(value, "ms") || ends_with(value, "s")
}

fn css_comma_values(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut remaining = trim(value)
    while remaining != "" {
        let comma = top_level_comma(remaining)
        if comma == remaining.char_len() {
            result.push(trim(remaining))
            break
        }
        result.push(trim(remaining.slice(0_usize, comma)))
        remaining = trim(remaining.slice(comma + 1_usize, remaining.char_len() - comma - 1_usize))
    }
    ret result
}

fn css_linear_gradient(style: Style, value: str) -> Style {
    let inner = trim(value.slice(16_usize, value.char_len() - 17_usize))
    let first_comma = top_level_comma(inner)
    if first_comma == inner.char_len() {
        ret style
    }
    let first = trim(inner.slice(0_usize, first_comma))
    let remainder = trim(inner.slice(first_comma + 1_usize, inner.char_len() - first_comma - 1_usize))
    let second_comma = top_level_comma(remainder)
    let mut vertical_gradient = true
    let mut start_value = first
    let mut end_value = remainder
    if starts_with(first, "to ") {
        vertical_gradient = first == "to bottom" || first == "to top"
        if second_comma == remainder.char_len() {
            ret style
        }
        start_value = trim(remainder.slice(0_usize, second_comma))
        end_value = trim(remainder.slice(second_comma + 1_usize, remainder.char_len() - second_comma
                - 1_usize,))
        if first == "to top" || first == "to left" {
            let swap = start_value
            start_value = end_value
            end_value = swap
        }
    }
    let start = css_color(start_value)
    let end = css_color(end_value)
    ret style.with_linear_gradient(if vertical_gradient {
            LinearGradient::vertical(start, end)
        } else {
            LinearGradient::horizontal(start, end)
        }
    )
}

fn css_flex(style: Style, value: str) -> Style {
    let input = trim(value)
    if input == "none" {
        ret style.with_flex_grow(0.0_f32).with_flex_shrink(0.0_f32).with_flex_basis( - 2.0_f32)
    }
    if input == "auto" {
        ret style.with_flex_grow(1.0_f32).with_flex_shrink(1.0_f32).with_flex_basis( - 2.0_f32)
    }
    if input == "initial" {
        ret style.with_flex_grow(0.0_f32).with_flex_shrink(1.0_f32).with_flex_basis( - 2.0_f32)
    }
    let parts = css_tokens(input)
    if parts.len() == 0_usize {
        ret style
    }
    let grow = css_number(token_at(parts, 0_usize))
    if parts.len() == 1_usize {
        ret style.with_flex_grow(grow).with_flex_shrink(1.0_f32).with_flex_basis(0.0_f32)
    }
    let second = token_at(parts, 1_usize)
    if parts.len() == 2_usize &&(second == "auto" || ends_with(second, "px") || ends_with(second, "%"))
    {
        ret style.with_flex_grow(grow).with_flex_shrink(1.0_f32).with_flex_basis(if second == "auto" {
                - 2.0_f32
            } else {
                css_dimension(second)
            }
        )
    }
    let shrink = css_number(second)
    let basis = if parts.len() >= 3_usize {
        if token_at(parts, 2_usize) == "auto" {
            - 2.0_f32
        } else {
            css_dimension(token_at(parts, 2_usize))
        }
    } else {
        0.0_f32
    }
    ret style.with_flex_grow(grow).with_flex_shrink(shrink).with_flex_basis(basis)
}

fn css_flex_flow(style: Style, value: str) -> Style {
    let parts = css_tokens(value)
    let mut result = style
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "row" || token == "row-reverse" {
            result = result.with_flex_direction(horizontal()).with_flex_direction_reverse(token == "row-reverse")
        } elif token == "column" || token == "column-reverse" {
            result = result.with_flex_direction(vertical()).with_flex_direction_reverse(token == "column-reverse")
        } elif token == "nowrap" || token == "wrap" || token == "wrap-reverse" {
            result = result.with_flex_wrap(token != "nowrap", token == "wrap-reverse")
        }
        index = index + 1_usize
    }
    ret result
}

fn css_tokens(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index <= value.char_len() {
        let current = if index < value.char_len() {
            value.slice(index, 1_usize)
        } else {
            ""
        }
        if quote != "" {
            if escaped {
                escaped = false
            } elif current == "\\" {
                escaped = true
            } elif current == quote {
                quote = ""
            }
        } else {
            if current == "\"" || current == "'" {
                quote = current
            } elif current == "(" {
                depth = depth + 1_usize
            } elif current == ")" && depth > 0_usize {
                depth = depth - 1_usize
            }
        }
        if index == value.char_len() ||(whitespace(current) && depth == 0_usize && quote == "") {
            if index > start {
                result.push(value.slice(start, index - start))
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn token_at(values: Vec[str], index: usize) -> str {
    match values.get(index) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            ret ""
        }
    }
}

fn css_font_family(value: str) -> str {
    let mut end = value.char_len()
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == "," {
            end = index break
        }
        index = index + 1_usize
    }
    let family = trim(value.slice(0_usize, end))
    if family.char_len() >= 2_usize {
        let first = family.slice(0_usize, 1_usize)
        let last = family.slice(family.char_len() - 1_usize, 1_usize)
        if (first == "\"" && last == "\"") ||(first == "'" && last == "'") {
            ret family.slice(1_usize, family.char_len() - 2_usize)
        }
    }
    ret family
}

fn css_font_size(style: Style, value: str) -> f32 {
    let input = trim(value)
    let inherited = if style.font_size() > 0.0_f32 {
        style.font_size()
    } else {
        16.0_f32
    }
    if ends_with(input, "%") {
        ret inherited * css_number(input) / 100.0_f32
    }
    if ends_with(input, "rem") {
        ret 16.0_f32 * css_number(input)
    }
    if ends_with(input, "em") {
        ret inherited * css_number(input)
    }
    // Viewport-relative font sizes require a layout viewport. Silently
    // preserving the inherited value is safer than treating `5vw` as 5px.
    if ends_with(input, "vw") || ends_with(input, "vh") ||
    ends_with(input, "vmin") || ends_with(input, "vmax") {
        ret inherited
    }
    ret css_number(input)
}

fn css_dimension(value: str) -> f32 {
    if trim(value) == "auto" {
        ret - 1.0_f32
    }
    ret css_number(value)
}

fn css_border(style: Style, value: str) -> Style {
    if trim(value) == "none" {
        ret style.with_border(0.0_f32, style.border_color())
    }
    let mut width = style.border_width()
    let mut color = style.border_color()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut part = 0_usize
    while index <= value.char_len() {
        if index == value.char_len() || whitespace(value.slice(index, 1_usize)) {
            if index > start {
                let token = trim(value.slice(start, index - start))
                if part == 0_usize {
                    width = css_number(token)
                } elif token != "solid" && token != "dashed" && token != "dotted" && token != "double"
                {
                    color = css_color(token)
                }
                part = part + 1_usize
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret style.with_border(width, color)
}

fn css_outline(style: Style, value: str) -> Style {
    if trim(value) == "none" {
        ret style.with_outline(0.0_f32, style.outline().color(), style.outline().offset())
    }
    let mut width = style.outline().width()
    let mut color = style.outline().color()
    let parts = css_tokens(value)
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if ends_with(token, "px") || decimal_digit(token.slice(0_usize, 1_usize)) >= 0_i32 {
            width = css_number(token)
        } elif token != "solid" && token != "dashed" && token != "dotted" && token != "double" {
            color = css_color(token)
        }
        index = index + 1_usize
    }
    ret style.with_outline(width, color, style.outline().offset())
}

fn css_box_shadow(style: Style, value: str) -> Style {
    if trim(value) == "none" {
        ret style.with_shadow(0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, transparent(), false)
    }
    let parts = css_tokens(value)
    let mut dimensions = Vec[f32]::new()
    let mut color = black()
    let mut inset = false
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "inset" {
            inset = true
        } elif css_numeric_token(token) {
            dimensions.push(css_number(token))
        } else {
            color = css_color(token)
        }
        index = index + 1_usize
    }
    if dimensions.len() < 2_usize {
        ret style
    }
    ret style.with_shadow(number_at(dimensions, 0_usize), number_at(dimensions, 1_usize),
        if dimensions.len() > 2_usize {
            number_at(dimensions, 2_usize)
        } else {
            0.0_f32
        }
        ,
        if dimensions.len() > 3_usize {
            number_at(dimensions, 3_usize)
        } else {
            0.0_f32
        }
        , color, inset,)
}

fn css_text_decoration(style: Style, value: str) -> Style {
    if trim(value) == "none" {
        ret style.with_text_decoration(false, false, false, transparent(), false, 1.0_f32)
    }
    let parts = css_tokens(value)
    let mut underline = false
    let mut overline = false
    let mut line_through = false
    let mut color = transparent()
    let mut color_set = false
    let mut thickness = 1.0_f32
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "underline" {
            underline = true
        } elif token == "overline" {
            overline = true
        } elif token == "line-through" {
            line_through = true
        } elif token == "solid" || token == "double" || token == "dotted" || token == "dashed" || token
        == "wavy" {
        } elif css_numeric_token(token) {
            thickness = css_number(token)
        } else {
            color = css_color(token) color_set = true
        }
        index = index + 1_usize
    }
    ret style.with_text_decoration(underline, overline, line_through, color, color_set, thickness)
}

fn css_text_decoration_line(style: Style, value: str) -> Style {
    let decoration = style.decoration()
    let parts = css_tokens(value)
    let mut underline = false
    let mut overline = false
    let mut line_through = false
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "underline" {
            underline = true
        } elif token == "overline" {
            overline = true
        } elif token == "line-through" {
            line_through = true
        }
        index = index + 1_usize
    }
    ret style.with_text_decoration(underline, overline, line_through, decoration.color(),
        decoration.color_set(), decoration.thickness(),)
}

fn css_numeric_token(value: str) -> bool {
    if value == "" {
        ret false
    }
    let first = value.slice(0_usize, 1_usize)
    ret decimal_digit(first) >= 0_i32 || first == "-" || first == "." || first == "+"
}

fn grid_column_count(value: str) -> usize {
    let input = trim(value)
    let mut count = 0_usize
    let mut index = 0_usize
    if input != "" {
        count = 1_usize
    }
    while index < input.char_len() {
        if input.slice(index, 1_usize) == "|" {
            count = count + 1_usize
        }
        index = index + 1_usize
    }
    ret if count > 0_usize {
        count
    } else {
        1_usize
    }
}

fn normalized_grid_template(value: str) -> str {
    let tokens = css_tokens(trim(value))
    let mut result = ""
    let mut index = 0_usize
    while index < tokens.len() {
        let token = token_at(tokens, index)
        let expanded = if starts_with(token, "repeat(") && ends_with(token, ")") {
            expand_grid_repeat(token)
        } else {
            token
        }
        if expanded != "" {
            if result != "" {
                result = result + "|"
            }
            result = result + expanded
        }
        index = index + 1_usize
    }
    ret if result == "" {
        "1fr"
    } else {
        result
    }
}

fn css_grid_placement(style: Style, value: str, column: bool) -> Style {
    let slash = find_character(value, "/", 0_usize)
    let start = grid_line(trim(value.slice(0_usize, slash)))
    let with_start = if column {
        style.with_grid_column(start)
    } else {
        style.with_grid_row(start)
    }
    if slash == value.char_len() {
        ret with_start
    }
    ret css_grid_end(with_start, trim(value.slice(slash + 1_usize, value.char_len() - slash - 1_usize)),
        column,)
}

fn css_grid_end(style: Style, value: str, column: bool) -> Style {
    let input = trim(value)
    if starts_with(input, "span ") {
        let span = css_number(trim(input.slice(5_usize, input.char_len() - 5_usize))) as usize
        ret if column {
            style.with_grid_column_span(span)
        } else {
            style.with_grid_row_span(span)
        }
    }
    let line = grid_line(input)
    ret if column {
        style.with_grid_column_end(line)
    } else {
        style.with_grid_row_end(line)
    }
}

fn grid_line(value: str) -> usize {
    ret if trim(value) == "auto" {
        0_usize
    } else {
        css_number(value) as usize
    }
}

fn expand_grid_repeat(value: str) -> str {
    let inner = value.slice(7_usize, value.char_len() - 8_usize)
    let comma = find_character(inner, ",", 0_usize)
    if comma == inner.char_len() {
        ret ""
    }
    let count = css_number(trim(inner.slice(0_usize, comma))) as usize
    let tracks = normalized_grid_template(trim(inner.slice(comma + 1_usize, inner.char_len() - comma
                - 1_usize,)))
    let mut result = ""
    let mut index = 0_usize
    while index < count {
        if result != "" {
            result = result + "|"
        }
        result = result + tracks
        index = index + 1_usize
    }
    ret result
}

fn inset_top(value: Insets, top: f32) -> Insets {
    ret Insets::only(top, value.right(), value.bottom(), value.left())
}
fn inset_right(value: Insets, right: f32) -> Insets {
    ret Insets::only(value.top(), right, value.bottom(), value.left())
}
fn inset_bottom(value: Insets, bottom: f32) -> Insets {
    ret Insets::only(value.top(), value.right(), bottom, value.left())
}
fn inset_left(value: Insets, left: f32) -> Insets {
    ret Insets::only(value.top(), value.right(), value.bottom(), left)
}

pub fn css_insets(value: str) -> Insets {
    let values = css_numbers(value)
    if values.len() == 0_usize {
        ret Insets::all(0.0_f32)
    }
    let first = number_at(values, 0_usize)
    if values.len() == 1_usize {
        ret Insets::all(first)
    }
    let second = number_at(values, 1_usize)
    if values.len() == 2_usize {
        ret Insets::symmetric(first, second)
    }
    let third = number_at(values, 2_usize)
    if values.len() == 3_usize {
        ret Insets::only(first, second, third, second)
    }
    ret Insets::only(first, second, third, number_at(values, 3_usize))
}

fn css_numbers(value: str) -> Vec[f32] {
    let mut result = Vec[f32]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= value.char_len() {
        if index == value.char_len() || whitespace(value.slice(index, 1_usize)) {
            if index > start {
                result.push(css_number(value.slice(start, index - start)))
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn number_at(values: Vec[f32], index: usize) -> f32 {
    match values.get(index) {
        Option[f32]::Some(value) => {
            ret value
        }
        Option[f32]::None => {
            ret 0.0_f32
        }
    }
}

pub fn css_color(value: str) -> Color {
    let input = trim(value)
    if input == "transparent" {
        ret transparent()
    }
    if input == "white" {
        ret white()
    }
    if input == "black" {
        ret black()
    }
    if input == "red" {
        ret Color::rgb(255_u8, 0_u8, 0_u8)
    }
    if input == "green" {
        ret Color::rgb(0_u8, 128_u8, 0_u8)
    }
    if input == "blue" {
        ret Color::rgb(0_u8, 0_u8, 255_u8)
    }
    if input == "gray" || input == "grey" {
        ret Color::rgb(128_u8, 128_u8, 128_u8)
    }
    if starts_with(input, "rgb(") || starts_with(input, "rgba(") {
        let open = find_character(input, "(", 0_usize)
        let components = input.slice(open + 1_usize, input.char_len() - open - 2_usize)
        let tokens = css_component_tokens(components)
        if tokens.len() >= 3_usize {
            ret Color::rgba(css_rgb_component(token_at(tokens, 0_usize)),
                css_rgb_component(token_at(tokens, 1_usize)),
                css_rgb_component(token_at(tokens, 2_usize)),
                css_alpha_component(if tokens.len() >= 4_usize {
                        token_at(tokens, 3_usize)
                    } else {
                        "1"
                    }
                ),)
        }
    }
    if starts_with(input, "hsl(") || starts_with(input, "hsla(") {
        let open = find_character(input, "(", 0_usize)
        let components = input.slice(open + 1_usize, input.char_len() - open - 2_usize)
        let tokens = css_component_tokens(components)
        if tokens.len() >= 3_usize {
            let alpha = if tokens.len() >= 4_usize {
                let token = token_at(tokens, 3_usize)
                if ends_with(token, "%") {
                    css_number(token) / 100.0_f32
                } else {
                    css_number(token)
                }
            } else {
                1.0_f32
            }
            ret hsl_color(css_hue(token_at(tokens, 0_usize)), css_number(token_at(tokens, 1_usize)),
                css_number(token_at(tokens, 2_usize)), alpha,)
        }
    }
    if input.char_len() == 4_usize && input.slice(0_usize, 1_usize) == "#" {
        ret Color::rgb(hex_pair(input.slice(1_usize, 1_usize) + input.slice(1_usize, 1_usize)),
            hex_pair(input.slice(2_usize, 1_usize) + input.slice(2_usize, 1_usize)),
            hex_pair(input.slice(3_usize, 1_usize) + input.slice(3_usize, 1_usize)),)
    }
    if input.char_len() == 5_usize && input.slice(0_usize, 1_usize) == "#" {
        ret Color::rgba(hex_pair(input.slice(1_usize, 1_usize) + input.slice(1_usize, 1_usize)),
            hex_pair(input.slice(2_usize, 1_usize) + input.slice(2_usize, 1_usize)),
            hex_pair(input.slice(3_usize, 1_usize) + input.slice(3_usize, 1_usize)),
            hex_pair(input.slice(4_usize, 1_usize) + input.slice(4_usize, 1_usize)),)
    }
    if (input.char_len() == 7_usize || input.char_len() == 9_usize) && input.slice(0_usize, 1_usize)
    == "#" {
        let alpha = if input.char_len() == 9_usize {
            hex_pair(input.slice(7_usize, 2_usize))
        } else {
            255_u8
        }
        ret Color::rgba(hex_pair(input.slice(1_usize, 2_usize)), hex_pair(input.slice(3_usize, 2_usize)),
            hex_pair(input.slice(5_usize, 2_usize)), alpha,)
    }
    ret transparent()
}

fn css_component_tokens(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    while index <= value.char_len() {
        let current = if index < value.char_len() {
            value.slice(index, 1_usize)
        } else {
            ""
        }
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" && depth > 0_usize {
            depth = depth - 1_usize
        }
        let separator = depth == 0_usize &&(current == "," || current == "/" || whitespace(current))
        if index == value.char_len() || separator {
            let token = trim(value.slice(start, index - start))
            if token != "" {
                result.push(token)
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn css_rgb_component(value: str) -> u8 {
    if ends_with(value, "%") {
        let percent = clamp_range(css_number(value), 0.0_f32, 100.0_f32)
        ret css_percent_byte(percent)
    }
    ret rounded_color_component(css_number(value))
}

fn css_alpha_component(value: str) -> u8 {
    if ends_with(value, "%") {
        let percent = clamp_range(css_number(value), 0.0_f32, 100.0_f32)
        ret css_percent_byte(percent)
    }
    let alpha = css_number(value)
    ret rounded_color_component(if alpha <= 1.0_f32 {
            clamp_unit(alpha) * 255.0_f32
        } else {
            alpha
        }
    )
}

fn css_percent_byte(percent: f32) -> u8 {
    if percent <= 0.0_f32 {
        ret 0_u8
    }
    if percent >= 100.0_f32 {
        ret 255_u8
    }
    let fixed =(percent * 1000.0_f32) as usize
    ret((fixed * 255_usize + 50000_usize) / 100000_usize) as u8
}

fn css_hue(value: str) -> f32 {
    let number = css_number(value)
    if ends_with(value, "turn") {
        ret number * 360.0_f32
    }
    if ends_with(value, "grad") {
        ret number * 0.9_f32
    }
    if ends_with(value, "rad") {
        ret number * 57.29578_f32
    }
    ret number
}

fn hsl_color(hue: f32, saturation_percent: f32, lightness_percent: f32, alpha_value: f32) -> Color {
    let mut h = hue
    while h < 0.0_f32 {
        h = h + 360.0_f32
    }
    while h >= 360.0_f32 {
        h = h - 360.0_f32
    }
    let s = clamp_unit(saturation_percent / 100.0_f32)
    let l = clamp_unit(lightness_percent / 100.0_f32)
    let chroma =(1.0_f32 - absolute(2.0_f32 * l - 1.0_f32)) * s
    let sector = h / 60.0_f32
    let sector_pair = sector -((sector as usize / 2_usize) * 2_usize) as f32
    let x = chroma *(1.0_f32 - absolute(sector_pair - 1.0_f32))
    let mut red = 0.0_f32
    let mut green = 0.0_f32
    let mut blue = 0.0_f32
    if sector < 1.0_f32 {
        red = chroma green = x
    } elif sector < 2.0_f32 {
        red = x green = chroma
    } elif sector < 3.0_f32 {
        green = chroma blue = x
    } elif sector < 4.0_f32 {
        green = x blue = chroma
    } elif sector < 5.0_f32 {
        red = x blue = chroma
    } else {
        red = chroma blue = x
    }
    let match_value = l - chroma / 2.0_f32
    let alpha = if alpha_value <= 1.0_f32 {
        clamp_unit(alpha_value) * 255.0_f32
    } else {
        clamp_range(alpha_value, 0.0_f32, 255.0_f32)
    }
    ret Color::rgba(rounded_color_component((red + match_value) * 255.0_f32),
        rounded_color_component((green + match_value) * 255.0_f32),
        rounded_color_component((blue + match_value) * 255.0_f32), rounded_color_component(alpha),)
}

fn rounded_color_component(value: f32) -> u8 {
    if value <= 0.0_f32 {
        ret 0_u8
    }
    if value >= 255.0_f32 {
        ret 255_u8
    }
    ret(value + 0.5_f32) as u8
}

fn absolute(value: f32) -> f32 {
    ret if value < 0.0_f32 {
        - value
    } else {
        value
    }
}
fn clamp_unit(value: f32) -> f32 {
    ret clamp_range(value, 0.0_f32, 1.0_f32)
}
fn clamp_range(value: f32, minimum: f32, maximum: f32) -> f32 {
    if value < minimum {
        ret minimum
    }
    if value > maximum {
        ret maximum
    }
    ret value
}

pub fn css_number(value: str) -> f32 {
    let input = trim(value)
    let mut result = 0.0_f32
    let mut fraction = 0.1_f32
    let mut after_dot = false
    let mut negative = false
    let mut index = 0_usize
    while index < input.char_len() {
        let current = input.slice(index, 1_usize)
        if index == 0_usize && current == "-" {
            negative = true
        } elif current == "." {
            after_dot = true
        } else {
            let digit = decimal_digit(current)
            if digit < 0_i32 {
                break
            }
            if after_dot {
                result = result +(digit as f32) * fraction fraction = fraction * 0.1_f32
            } else {
                result = result * 10.0_f32 + digit as f32
            }
        }
        index = index + 1_usize
    }
    ret if negative {
        - result
    } else {
        result
    }
}

fn decimal_digit(value: str) -> i32 {
    if value == "0" {
        ret 0_i32
    }
    if value == "1" {
        ret 1_i32
    }
    if value == "2" {
        ret 2_i32
    }
    if value == "3" {
        ret 3_i32
    }
    if value == "4" {
        ret 4_i32
    }
    if value == "5" {
        ret 5_i32
    }
    if value == "6" {
        ret 6_i32
    }
    if value == "7" {
        ret 7_i32
    }
    if value == "8" {
        ret 8_i32
    }
    if value == "9" {
        ret 9_i32
    }
    ret - 1_i32
}

fn hex_pair(value: str) -> u8 {
    ret(hex_digit(value.slice(0_usize, 1_usize)) * 16_usize + hex_digit(value.slice(1_usize, 1_usize)))
    as u8
}
fn hex_digit(value: str) -> usize {
    let digit = decimal_digit(value)
    if digit >= 0_i32 {
        ret digit as usize
    }
    if value == "a" || value == "A" {
        ret 10_usize
    }
    if value == "b" || value == "B" {
        ret 11_usize
    }
    if value == "c" || value == "C" {
        ret 12_usize
    }
    if value == "d" || value == "D" {
        ret 13_usize
    }
    if value == "e" || value == "E" {
        ret 14_usize
    }
    if value == "f" || value == "F" {
        ret 15_usize
    }
    ret 0_usize
}

fn trim(value: str) -> str {
    let mut start = 0_usize
    let mut finish = value.char_len()
    while start < finish && whitespace(value.slice(start, 1_usize)) {
        start = start + 1_usize
    }
    while finish > start && whitespace(value.slice(finish - 1_usize, 1_usize)) {
        finish = finish - 1_usize
    }
    ret value.slice(start, finish - start)
}
fn whitespace(value: str) -> bool {
    ret value == " " || value == "\n" || value == "\r" || value == "\t"
}

fn append_selector_rules(rules: mut Vec[StyleRule], selectors: str, declarations: str) ->() {
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() {
            selectors.slice(index, 1_usize)
        } else {
            ""
        }
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" && depth > 0_usize {
            depth = depth - 1_usize
        }
        if index == selectors.char_len() ||(current == "," && depth == 0_usize) {
            let selector = trim(selectors.slice(start, index - start))
            if selector != "" {
                rules.push(StyleRule {
                        selector, declarations, selector_specificity(selector)
                    }
                    ,
                )
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret()
}

fn collect_variables(variables: mut Vec[CssVariable], declarations: str) ->() {
    let values = css_declarations(declarations)
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[str]::Some(declaration) => {
                let colon = declaration_colon(declaration)
                if colon < declaration.char_len() {
                    let name = trim(declaration.slice(0_usize, colon))
                    if starts_with(name, "--") {
                        set_variable(variables, name,
                            trim(declaration.slice(colon + 1_usize, declaration.char_len() - colon -
                                    1_usize,)),)
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index = index + 1_usize
    }
    ret()
}

fn css_declarations(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index <= value.char_len() {
        let current = if index < value.char_len() {
            value.slice(index, 1_usize)
        } else {
            ""
        }
        if quote != "" {
            if escaped {
                escaped = false
            } elif current == "\\" {
                escaped = true
            } elif current == quote {
                quote = ""
            }
        } else {
            if current == "\"" || current == "'" {
                quote = current
            } elif current == "(" {
                depth = depth + 1_usize
            } elif current == ")" && depth > 0_usize {
                depth = depth - 1_usize
            }
        }
        if index == value.char_len() ||(current == ";" && quote == "" && depth == 0_usize) {
            let declaration = trim(value.slice(start, index - start))
            if declaration != "" {
                result.push(declaration)
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn declaration_colon(value: str) -> usize {
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped {
                escaped = false
            } elif current == "\\" {
                escaped = true
            } elif current == quote {
                quote = ""
            }
        } else {
            if current == "\"" || current == "'" {
                quote = current
            } elif current == "(" {
                depth = depth + 1_usize
            } elif current == ")" && depth > 0_usize {
                depth = depth - 1_usize
            } elif current == ":" && depth == 0_usize {
                ret index
            }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn set_variable(variables: mut Vec[CssVariable], name: str, value: str) ->() {
    let mut index = 0_usize
    while index < variables.len() {
        match variables.get(index) {
            Option[CssVariable]::Some(variable) => {
                if variable.name == name {
                    variables.set(index, CssVariable {
                            name, value
                        }
                        ,
                    ) ret()
                }
            }
            Option[CssVariable]::None => {
            }
        }
        index = index + 1_usize
    }
    variables.push(CssVariable {
            name, value
        }
        ,
    )
    ret()
}

fn resolve_variables(declarations: str, variables: Vec[CssVariable]) -> str {
    let mut result = declarations
    let mut pass = 0_usize
    while pass < 8_usize {
        let resolved = resolve_variables_once(result, variables)
        if resolved == result {
            ret result
        }
        result = resolved
        pass = pass + 1_usize
    }
    ret result
}

fn resolve_variables_once(declarations: str, variables: Vec[CssVariable]) -> str {
    let mut result = ""
    let mut cursor = 0_usize
    while cursor < declarations.char_len() {
        let open = find_text(declarations, "var(", cursor)
        if open == declarations.char_len() {
            result = result + declarations.slice(cursor, declarations.char_len() - cursor)
            break
        }
        result = result + declarations.slice(cursor, open - cursor)
        let close = matching_parenthesis(declarations, open + 3_usize)
        if close == declarations.char_len() {
            result = result + declarations.slice(open, declarations.char_len() - open)
            break
        }
        let expression = declarations.slice(open + 4_usize, close - open - 4_usize)
        let comma = top_level_comma(expression)
        let name = trim(if comma < expression.char_len() {
                expression.slice(0_usize, comma)
            } else {
                expression
            }
        )
        let fallback = if comma < expression.char_len() {
            trim(expression.slice(comma + 1_usize, expression.char_len() - comma - 1_usize))
        } else {
            ""
        }
        result = result + variable_value(variables, name, fallback)
        cursor = close + 1_usize
    }
    ret result
}

fn top_level_comma(value: str) -> usize {
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped {
                escaped = false
            } elif current == "\\" {
                escaped = true
            } elif current == quote {
                quote = ""
            }
        } else {
            if current == "\"" || current == "'" {
                quote = current
            } elif current == "(" {
                depth = depth + 1_usize
            } elif current == ")" && depth > 0_usize {
                depth = depth - 1_usize
            } elif current == "," && depth == 0_usize {
                ret index
            }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn variable_value(variables: Vec[CssVariable], name: str, fallback: str) -> str {
    let mut index = variables.len()
    while index > 0_usize {
        index = index - 1_usize
        match variables.get(index) {
            Option[CssVariable]::Some(variable) => {
                if variable.name == name {
                    ret variable.value
                }
            }
            Option[CssVariable]::None => {
            }
        }
    }
    ret fallback
}

fn find_text(value: str, expected: str, start: usize) -> usize {
    let mut index = start
    while index + expected.char_len() <= value.char_len() {
        if value.slice(index, expected.char_len()) == expected {
            ret index
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn strip_comments(source: str) -> str {
    let mut parts = Vec[str]::new()
    let mut index = 0_usize
    let mut start = 0_usize
    let mut quote = 0_u8
    let mut escaped = false
    let length = source.byte_len()
    while index < length {
        let current = source.byte_at(index)
        let next = if index + 1_usize < length {
            source.byte_at(index + 1_usize)
        } else {
            0_u8
        }
        if quote != 0_u8 {
            if escaped {
                escaped = false
            } elif current == 92_u8 {
                escaped = true
            } elif current == quote {
                quote = 0_u8
            }
        } elif current == 34_u8 || current == 39_u8 {
            quote = current
        } elif current == 47_u8 && next == 42_u8 {
            parts.push(source.slice_bytes(start, index - start))
            parts.push(" ")
            index += 2_usize
            while index + 1_usize < length &&
            !(source.byte_at(index) == 42_u8 && source.byte_at(index + 1_usize) == 47_u8) {
                index += 1_usize
            }
            index = if index + 1_usize < length {
                index + 2_usize
            } else {
                length
            }
            start = index
            continue
        }
        index += 1_usize
    }
    if parts.len() == 0_usize {
        ret source
    }
    parts.push(source.slice_bytes(start, length - start))
    // Concatenate whole unchanged spans, not one allocated string per character.
    let mut result = ""
    for part in parts {
        result = result + part
    }
    ret result
}

fn starts_with(value: str, prefix: str) -> bool {
    ret value.char_len() >= prefix.char_len() && value.slice(0_usize, prefix.char_len()) == prefix
}

fn ends_with(value: str, suffix: str) -> bool {
    ret value.char_len() >= suffix.char_len() &&
    value.slice(value.char_len() - suffix.char_len(), suffix.char_len()) == suffix
}

fn find_character(value: str, character: str, start: usize) -> usize {
    let mut index = start
    while index < value.char_len() {
        if value.slice(index, 1_usize) == character {
            ret index
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn selector_specificity(selector: str) -> usize {
    let mut score = 0_usize
    let mut index = 0_usize
    let mut expect_type = true
    while index < selector.char_len() {
        let current = selector.slice(index, 1_usize)
        if whitespace(current) || current == ">" || current == "+" || current == "~" {
            expect_type = true
            index = index + 1_usize
        } elif current == "#" {
            score = score + 100_usize
            index = selector_part_end(selector, index + 1_usize)
            expect_type = false
        } elif current == "." {
            score = score + 10_usize
            index = selector_part_end(selector, index + 1_usize)
            expect_type = false
        } elif current == "[" {
            score = score + 10_usize
            let close = matching_bracket(selector, index)
            index = if close < selector.char_len() {
                close + 1_usize
            } else {
                selector.char_len()
            }
            expect_type = false
        } elif current == ":" {
            let name_end = pseudo_name_end(selector, index + 1_usize)
            let name = selector.slice(index + 1_usize, name_end - index - 1_usize)
            if name_end < selector.char_len() && selector.slice(name_end, 1_usize) == "(" {
                let close = matching_parenthesis(selector, name_end)
                if close == selector.char_len() {
                    ret score + 10_usize
                }
                let content = selector.slice(name_end + 1_usize, close - name_end - 1_usize)
                if name == "is" || name == "not" || name == "has" {
                    score = score + selector_list_specificity(content)
                } elif name != "where" {
                    score = score + 10_usize
                }
                index = close + 1_usize
            } else {
                score = score + 10_usize
                index = name_end
            }
            expect_type = false
        } elif current == "*" {
            expect_type = false
            index = index + 1_usize
        } else {
            if expect_type {
                score = score + 1_usize
            }
            index = selector_part_end(selector, index)
            expect_type = false
        }
    }
    ret score
}

fn selector_list_specificity(selectors: str) -> usize {
    let mut maximum = 0_usize
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut index = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() {
            selectors.slice(index, 1_usize)
        } else {
            ""
        }
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" && depth > 0_usize {
            depth = depth - 1_usize
        }
        if index == selectors.char_len() ||(current == "," && depth == 0_usize) {
            let specificity = selector_specificity(trim(selectors.slice(start, index - start)))
            if specificity > maximum {
                maximum = specificity
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret maximum
}

fn selector_matches(selector: str, widget: Widget, child_index: usize, sibling_count: usize, siblings:
    Vec[Widget],
    root: bool, hovered: bool, active: bool, focused: bool, focus_within: bool,
    interaction: InteractionStyleState,) -> bool {
    let input = trim(selector)
    if input == "*" {
        ret true
    }
    let mut index = 0_usize
    if input.char_len() > 0_usize {
        let first = input.slice(0_usize, 1_usize)
        if first != "." && first != "#" && first != ":" && first != "[" && first != "*" {
            let finish = selector_part_end(input, 0_usize)
            if input.slice(0_usize, finish) != widget_type(widget) {
                ret false
            }
            index = finish
        } elif first == "*" {
            index = 1_usize
        }
    }
    while index < input.char_len() {
        let marker = input.slice(index, 1_usize)
        if marker == "[" {
            let close = matching_bracket(input, index)
            if close == input.char_len() || !attribute_selector_matches(input.slice(index + 1_usize,
                    close - index - 1_usize,), widget) {
                ret false
            }
            index = close + 1_usize
        } elif marker != "." && marker != "#" && marker != ":" {
            ret false
        } else {
            let finish = selector_part_end(input, index + 1_usize)
            let value = input.slice(index + 1_usize, finish - index - 1_usize)
            if marker == "." && !has_class(widget.classes(), value) {
                ret false
            }
            if marker == "#" && widget.id() != value {
                ret false
            }
            if marker == ":" {
                if starts_with(value, "not(") {
                    if functional_selector_matches(value, widget, child_index, sibling_count, siblings,
                        root, hovered, active, focused, focus_within, interaction,) {
                        ret false
                    }
                } elif starts_with(value, "is(") || starts_with(value, "where(") {
                    if !functional_selector_matches(value, widget, child_index, sibling_count, siblings,
                        root, hovered, active, focused, focus_within, interaction,) {
                        ret false
                    }
                } elif starts_with(value, "has(") {
                    if !has_selector_matches(value, widget, interaction) {
                        ret false
                    }
                } elif value == "hover" && !hovered {
                    ret false
                } elif value == "active" && !active {
                    ret false
                } elif value == "focus" && !focused && !widget.focused() {
                    ret false
                } elif value == "checked" && !widget.checked() {
                    ret false
                } elif value == "disabled" && !widget.disabled() {
                    ret false
                } elif value == "enabled" && widget.disabled() {
                    ret false
                } elif value == "focus-visible" && !interaction.focus_visible {
                    ret false
                } elif value == "focus-within" && !focus_within {
                    ret false
                } elif value == "root" && !root {
                    ret false
                } elif value == "required" && !widget_has_attribute(widget, "required") {
                    ret false
                } elif value == "optional" &&(!form_control(widget) || widget_has_attribute(widget, "required"))
                {
                    ret false
                } elif value == "read-write" && !read_write_control(widget) {
                    ret false
                } elif value == "read-only" && read_write_control(widget) {
                    ret false
                } elif value == "placeholder-shown" &&(!read_write_control(widget) || widget.text() !=
                    "" || !widget_has_attribute(widget, "placeholder")) {
                    ret false
                } elif (value == "link" || value == "any-link") && widget.kind() != widget_link() {
                    ret false
                } elif value == "first-child" && child_index != 0_usize {
                    ret false
                } elif value == "last-child" && child_index + 1_usize != sibling_count {
                    ret false
                } elif value == "only-child" && sibling_count != 1_usize {
                    ret false
                } elif starts_with(value, "nth-child(") && !nth_child_matches(value, child_index + 1_usize)
                {
                    ret false
                } elif starts_with(value, "nth-last-child(") && !nth_last_child_matches(value, sibling_count
                    - child_index,) {
                    ret false
                } elif value == "first-of-type" && type_position(widget, siblings, child_index, false)
                != 1_usize {
                    ret false
                } elif value == "last-of-type" && type_position(widget, siblings, child_index, true)
                != 1_usize {
                    ret false
                } elif value == "only-of-type" && type_sibling_count(widget, siblings) != 1_usize {
                    ret false
                } elif starts_with(value, "nth-of-type(") && !nth_of_type_matches(value, type_position(widget,
                        siblings, child_index, false,)) {
                    ret false
                } elif starts_with(value, "nth-last-of-type(") && !nth_last_of_type_matches(value, type_position(widget,
                        siblings, child_index, true,)) {
                    ret false
                } elif value == "empty" &&(widget.text() != "" || widget.children().len() != 0_usize)
                {
                    ret false
                } elif value != "hover" && value != "active" && value != "focus" && value != "checked"
                &&
                value != "disabled" && value != "enabled" && value != "focus-visible" && value != "focus-within"
                && value != "root" &&
                value != "required" && value != "optional" && value != "read-write" && value != "read-only"
                &&
                value != "placeholder-shown" && value != "link" && value != "any-link" &&
                value != "first-child" && value != "last-child" && value != "only-child" && value !=
                "empty" &&
                !starts_with(value, "nth-child(") && !starts_with(value, "nth-last-child(") &&
                value != "first-of-type" && value != "last-of-type" && value != "only-of-type" &&
                !starts_with(value, "nth-of-type(") && !starts_with(value, "nth-last-of-type(") &&
                !starts_with(value, "not(") && !starts_with(value, "is(") && !starts_with(value, "where(")
                &&
                !starts_with(value, "has(") {
                    ret false
                }
            }
            index = finish
        }
    }
    ret true
}

fn widget_contains_focus(widget: Widget) -> bool {
    if widget.focused() {
        ret true
    }
    let children = widget.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                if widget_contains_focus(child) {
                    ret true
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn functional_selector_matches(value: str, widget: Widget, child_index: usize, sibling_count: usize,
    siblings: Vec[Widget],
    root: bool, hovered: bool, active: bool, focused: bool, focus_within: bool,
    interaction: InteractionStyleState,) -> bool {
    let open = find_character(value, "(", 0_usize)
    if open == value.char_len() || !ends_with(value, ")") {
        ret false
    }
    let selectors = value.slice(open + 1_usize, value.char_len() - open - 2_usize)
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut index = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() {
            selectors.slice(index, 1_usize)
        } else {
            ""
        }
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" && depth > 0_usize {
            depth = depth - 1_usize
        }
        if index == selectors.char_len() ||(current == "," && depth == 0_usize) {
            let selector = trim(selectors.slice(start, index - start))
            if selector_matches(selector, widget, child_index, sibling_count, siblings,
                root, hovered, active, focused, focus_within, interaction,) {
                ret true
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret false
}

fn has_selector_matches(value: str, widget: Widget, interaction: InteractionStyleState) -> bool {
    let open = find_character(value, "(", 0_usize)
    if open == value.char_len() || !ends_with(value, ")") {
        ret false
    }
    let selectors = value.slice(open + 1_usize, value.char_len() - open - 2_usize)
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut index = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() {
            selectors.slice(index, 1_usize)
        } else {
            ""
        }
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" && depth > 0_usize {
            depth = depth - 1_usize
        }
        if index == selectors.char_len() ||(current == "," && depth == 0_usize) {
            let selector = trim(selectors.slice(start, index - start))
            if relative_selector_matches(selector, widget, interaction) {
                ret true
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret false
}

fn relative_selector_matches(selector: str, widget: Widget, interaction: InteractionStyleState) -> bool {
    if selector == "" {
        ret false
    }
    let children = widget.children()
    let siblings = singleton_widget(widget)
    let sibling_interactions = singleton_interaction(interaction)
    let child_interactions = interaction.children
    let ancestors = append_ancestor(Vec[SelectorNode]::new(), widget, 0_usize,
        1_usize, siblings, interaction, sibling_interactions,)
    if starts_with(selector, ">") {
        let target = trim(selector.slice(1_usize, selector.char_len() - 1_usize))
        let mut index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    let child_interaction = interaction_at(child_interactions, index, child,)
                    if selector_tree_matches(target, child, ancestors, ancestors.len(), children, index,
                        children.len(), child_interaction.hovered_within,
                        child_interaction.active_within, child_interaction.focused,
                        child_interaction.focus_within, child_interaction, child_interactions,) {
                        ret true
                    }
                }
                Option[Widget]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
    ret descendant_selector_matches(selector, widget, interaction, Vec[SelectorNode]::new(),
        singleton_widget(widget), 0_usize, 1_usize, singleton_interaction(interaction),)
}

fn descendant_selector_matches(selector: str, widget: Widget, interaction: InteractionStyleState,
    ancestors: Vec[SelectorNode], siblings: Vec[Widget], child_index: usize, sibling_count: usize,
    sibling_interactions: Vec[InteractionStyleState],) -> bool {
    let children = widget.children()
    let child_interactions = interaction.children
    let child_ancestors = append_ancestor(ancestors, widget, child_index,
        sibling_count, siblings, interaction,
        sibling_interactions,)
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                let child_interaction = interaction_at(child_interactions, index, child,)
                if selector_tree_matches(selector, child, child_ancestors, child_ancestors.len(), children,
                    index, children.len(), child_interaction.hovered_within,
                    child_interaction.active_within, child_interaction.focused,
                    child_interaction.focus_within, child_interaction, child_interactions,) {
                    ret true
                }
                if descendant_selector_matches(selector, child, child_interaction,
                    child_ancestors, children, index, children.len(), child_interactions,) {
                    ret true
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn nth_child_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-child(") || !ends_with(pseudo, ")") {
        ret false
    }
    ret nth_expression_matches(trim(pseudo.slice(10_usize, pseudo.char_len() - 11_usize)), position)
}

fn nth_last_child_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-last-child(") || !ends_with(pseudo, ")") {
        ret false
    }
    ret nth_expression_matches(trim(pseudo.slice(15_usize, pseudo.char_len() - 16_usize)), position)
}

fn nth_of_type_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-of-type(") || !ends_with(pseudo, ")") {
        ret false
    }
    ret nth_expression_matches(trim(pseudo.slice(12_usize, pseudo.char_len() - 13_usize)), position)
}

fn nth_last_of_type_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-last-of-type(") || !ends_with(pseudo, ")") {
        ret false
    }
    ret nth_expression_matches(trim(pseudo.slice(17_usize, pseudo.char_len() - 18_usize)), position)
}

fn type_position(widget: Widget, siblings: Vec[Widget], child_index: usize, from_end: bool) -> usize
{
    let expected = widget_type(widget)
    let mut position = 0_usize
    if from_end {
        let mut index = siblings.len()
        while index > child_index {
            index = index - 1_usize
            match siblings.get(index) {
                Option[Widget]::Some(sibling) => {
                    if widget_type(sibling) == expected {
                        position = position + 1_usize
                    }
                }
                Option[Widget]::None => {
                }
            }
        }
    } else {
        let mut index = 0_usize
        while index <= child_index && index < siblings.len() {
            match siblings.get(index) {
                Option[Widget]::Some(sibling) => {
                    if widget_type(sibling) == expected {
                        position = position + 1_usize
                    }
                }
                Option[Widget]::None => {
                }
            }
            index = index + 1_usize
        }
    }
    ret position
}

fn type_sibling_count(widget: Widget, siblings: Vec[Widget]) -> usize {
    let expected = widget_type(widget)
    let mut count = 0_usize
    let mut index = 0_usize
    while index < siblings.len() {
        match siblings.get(index) {
            Option[Widget]::Some(sibling) => {
                if widget_type(sibling) == expected {
                    count = count + 1_usize
                }
            }
            Option[Widget]::None => {
            }
        }
        index = index + 1_usize
    }
    ret count
}

fn nth_expression_matches(expression: str, position: usize) -> bool {
    if expression == "odd" {
        ret position % 2_usize == 1_usize
    }
    if expression == "even" {
        ret position % 2_usize == 0_usize
    }
    let n = find_character(expression, "n", 0_usize)
    if n == expression.char_len() {
        ret css_number(expression) as usize == position
    }
    let coefficient = trim(expression.slice(0_usize, n))
    let a = if coefficient == "" || coefficient == "+" {
        1_i32
    } elif coefficient == "-" {
        - 1_i32
    } else {
        css_number(coefficient) as i32
    }
    let remainder = trim(expression.slice(n + 1_usize, expression.char_len() - n - 1_usize))
    let b = if remainder == "" {
        0_i32
    } elif starts_with(remainder, "+") {
        css_number(remainder.slice(1_usize, remainder.char_len() - 1_usize)) as i32
    } else {
        css_number(remainder) as i32
    }
    if a == 0_i32 {
        ret position as i32 == b
    }
    let delta = position as i32 - b
    ret delta % a == 0_i32 && delta / a >= 0_i32
}

fn interaction_at(states: Vec[InteractionStyleState], index: usize,
    widget: Widget,) -> InteractionStyleState {
    match states.get(index) {
        Option[InteractionStyleState]::Some(state) => {
            ret state
        }
        Option[InteractionStyleState]::None => {
            let focused = widget.focused()
            ret InteractionStyleState {
                1_usize, false, false, focused,
                widget_contains_focus(widget), focused, focused, static_interaction_state(widget).children,
            }
        }
    }
}

fn selector_tree_matches(selector: str, widget: Widget, ancestors: Vec[SelectorNode], count: usize,
    siblings: Vec[Widget], child_index: usize, sibling_count: usize,
    hovered: bool, active: bool, focused: bool, focus_within: bool,
    interaction: InteractionStyleState,
    sibling_interactions: Vec[InteractionStyleState],) -> bool {
    let input = trim(selector)
    let combinator = rightmost_combinator(input)
    if combinator.kind == 0_usize {
        ret selector_matches(input, widget, child_index, sibling_count, siblings, count == 0_usize, hovered,
            active, focused, focus_within, interaction,)
    }
    let left = trim(input.slice(0_usize, combinator.index))
    let right = trim(input.slice(combinator.index + 1_usize, input.char_len() - combinator.index - 1_usize))
    if !selector_matches(right, widget, child_index, sibling_count, siblings, count == 0_usize, hovered,
        active, focused, focus_within, interaction,) {
        ret false
    }
    if combinator.kind == 2_usize {
        if count == 0_usize {
            ret false
        }
        match ancestors.get(count - 1_usize) {
            Option[SelectorNode]::Some(parent) => {
                ret selector_tree_matches(left, parent.widget, ancestors,
                    count - 1_usize, parent.siblings, parent.index, parent.count,
                    parent.interaction.hovered_within, parent.interaction.active_within,
                    parent.interaction.focused, parent.interaction.focus_within,
                    parent.interaction, parent.sibling_interactions,)
            }
            Option[SelectorNode]::None => {
                ret false
            }
        }
    }
    if combinator.kind == 1_usize {
        let mut index = count
        while index > 0_usize {
            index = index - 1_usize
            match ancestors.get(index) {
                Option[SelectorNode]::Some(parent) => {
                    if selector_tree_matches(left, parent.widget, ancestors, index, parent.siblings,
                        parent.index, parent.count, parent.interaction.hovered_within,
                        parent.interaction.active_within, parent.interaction.focused,
                        parent.interaction.focus_within, parent.interaction,
                        parent.sibling_interactions,) {
                        ret true
                    }
                }
                Option[SelectorNode]::None => {
                }
            }
        }
        ret false
    }
    if combinator.kind == 3_usize {
        if child_index == 0_usize {
            ret false
        }
        match siblings.get(child_index - 1_usize) {
            Option[Widget]::Some(previous) => {
                let previous_interaction = interaction_at(sibling_interactions,
                    child_index - 1_usize, previous,)
                ret selector_tree_matches(left, previous, ancestors, count, siblings,
                    child_index - 1_usize, sibling_count,
                    previous_interaction.hovered_within,
                    previous_interaction.active_within, previous_interaction.focused,
                    previous_interaction.focus_within, previous_interaction,
                    sibling_interactions,)
            }
            Option[Widget]::None => {
                ret false
            }
        }
    }
    if combinator.kind == 4_usize {
        let mut index = child_index
        while index > 0_usize {
            index = index - 1_usize
            match siblings.get(index) {
                Option[Widget]::Some(previous) => {
                    let previous_interaction = interaction_at(sibling_interactions,
                        index, previous,)
                    if selector_tree_matches(left, previous, ancestors, count, siblings, index, sibling_count,
                        previous_interaction.hovered_within,
                        previous_interaction.active_within, previous_interaction.focused,
                        previous_interaction.focus_within, previous_interaction,
                        sibling_interactions,) {
                        ret true
                    }
                }
                Option[Widget]::None => {
                }
            }
        }
    }
    ret false
}

fn rightmost_combinator(value: str) -> SelectorCombinator {
    let mut index = value.char_len()
    let mut depth = 0_usize
    let mut brackets = 0_usize
    while index > 0_usize {
        index = index - 1_usize
        let current = value.slice(index, 1_usize)
        if current == ")" {
            depth = depth + 1_usize
        } elif current == "(" && depth > 0_usize {
            depth = depth - 1_usize
        } elif current == "]" {
            brackets = brackets + 1_usize
        } elif current == "[" && brackets > 0_usize {
            brackets = brackets - 1_usize
        } elif depth == 0_usize && brackets == 0_usize {
            if current == ">" {
                ret SelectorCombinator {
                    index, 2_usize
                }
            }
            if current == "+" {
                ret SelectorCombinator {
                    index, 3_usize
                }
            }
            if current == "~" {
                ret SelectorCombinator {
                    index, 4_usize
                }
            }
            if whitespace(current) {
                let before = trim(value.slice(0_usize, index))
                let after = trim(value.slice(index + 1_usize, value.char_len() - index - 1_usize))
                if before != "" && after != "" && !ends_in_combinator(before) && !starts_in_combinator(after)
                {
                    ret SelectorCombinator {
                        index, 1_usize
                    }
                }
            }
        }
    }
    ret SelectorCombinator {
        value.char_len(), 0_usize
    }
}

fn ends_in_combinator(value: str) -> bool {
    if value == "" {
        ret false
    }
    let last = value.slice(value.char_len() - 1_usize, 1_usize)
    ret last == ">" || last == "+" || last == "~"
}

fn starts_in_combinator(value: str) -> bool {
    if value == "" {
        ret false
    }
    let first = value.slice(0_usize, 1_usize)
    ret first == ">" || first == "+" || first == "~"
}

fn append_ancestor(ancestors: Vec[SelectorNode], widget: Widget, index_in_parent: usize,
    sibling_count: usize, siblings: Vec[Widget],
    interaction: InteractionStyleState,
    sibling_interactions: Vec[InteractionStyleState],) -> Vec[SelectorNode] {
    let mut result = Vec[SelectorNode]::new()
    let mut index = 0_usize
    while index < ancestors.len() {
        match ancestors.get(index) {
            Option[SelectorNode]::Some(ancestor) => {
                result.push(ancestor)
            }
            Option[SelectorNode]::None => {
            }
        }
        index = index + 1_usize
    }
    result.push(SelectorNode {
            widget, index_in_parent, sibling_count, siblings,
            interaction, sibling_interactions,
        }
        ,
    )
    ret result
}

fn static_interaction_state(widget: Widget) -> InteractionStyleState {
    let focused = widget.focused()
    let mut children = Vec[InteractionStyleState]::new()
    let mut subtree_size = 1_usize
    let mut focus_within = focused
    for child in widget.children() {
        let child_state = static_interaction_state(child)
        subtree_size += child_state.subtree_size
        focus_within = focus_within || child_state.focus_within
        children.push(child_state)
    }
    ret InteractionStyleState {
        subtree_size, false, false, focused, focus_within, focused, focused, children,
    }
}

fn singleton_widget(widget: Widget) -> Vec[Widget] {
    let mut result = Vec[Widget]::new()
    result.push(widget)
    ret result
}

fn singleton_interaction(interaction: InteractionStyleState) -> Vec[InteractionStyleState] {
    let mut result = Vec[InteractionStyleState]::new()
    result.push(interaction)
    ret result
}

fn selector_part_end(value: str, start: usize) -> usize {
    let mut index = start
    let mut depth = 0_usize
    let mut brackets = 0_usize
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" && depth > 0_usize {
            depth = depth - 1_usize
        } elif current == "[" {
            if depth == 0_usize && brackets == 0_usize {
                break
            }
            brackets = brackets + 1_usize
        } elif current == "]" && brackets > 0_usize {
            brackets = brackets - 1_usize
        } elif depth == 0_usize && brackets == 0_usize &&(current == "." || current == "#" || current
            == ":" || current == "[" ||
            current == ">" || current == "+" || current == "~" || whitespace(current)) {
            break
        }
        index = index + 1_usize
    }
    ret index
}

fn pseudo_name_end(value: str, start: usize) -> usize {
    let mut index = start
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "(" || current == "." || current == "#" || current == ":" ||
        current == ">" || current == "+" || current == "~" || whitespace(current) {
            break
        }
        index = index + 1_usize
    }
    ret index
}

fn attribute_selector_matches(expression: str, widget: Widget) -> bool {
    let input = trim(expression)
    let equals = find_character(input, "=", 0_usize)
    if equals == input.char_len() {
        ret widget_has_attribute(widget, input)
    }
    let marker = if equals > 0_usize {
        input.slice(equals - 1_usize, 1_usize)
    } else {
        ""
    }
    let compound = marker == "~" || marker == "|" || marker == "^" || marker == "$" || marker == "*"
    let name_end = if compound {
        equals - 1_usize
    } else {
        equals
    }
    let name = trim(input.slice(0_usize, name_end))
    if !widget_has_attribute(widget, name) {
        ret false
    }
    let actual = widget_attribute_value(widget, name)
    let expected = unquote_css_value(trim(input.slice(equals + 1_usize, input.char_len() - equals - 1_usize)))
    if !compound {
        ret actual == expected
    }
    if marker == "~" {
        ret has_class(actual, expected)
    }
    if marker == "|" {
        ret actual == expected || starts_with(actual, expected + "-")
    }
    if marker == "^" {
        ret starts_with(actual, expected)
    }
    if marker == "$" {
        ret ends_with(actual, expected)
    }
    ret string_contains(actual, expected)
}

fn widget_has_attribute(widget: Widget, name: str) -> bool {
    if name == "id" {
        ret widget.id() != ""
    }
    if name == "class" {
        ret widget.classes() != ""
    }
    if name == "disabled" {
        ret widget.disabled()
    }
    if name == "checked" {
        ret widget.checked()
    }
    match widget.attribute(name) {
        Option[str]::Some(value) => {
            ret true
        }
        Option[str]::None => {
            ret false
        }
    }
}

fn form_control(widget: Widget) -> bool {
    let kind = widget.kind()
    ret kind == widget_input() || kind == widget_textarea() || kind == widget_checkbox() ||
    kind == widget_radio() || kind == widget_select() || kind == widget_slider() ||
    kind == widget_range_slider() || kind == widget_color_picker()
}

fn read_write_control(widget: Widget) -> bool {
    let kind = widget.kind()
    ret(kind == widget_input() || kind == widget_textarea()) && !widget.disabled() && !widget_has_attribute(widget,
        "readonly",)
}

fn widget_attribute_value(widget: Widget, name: str) -> str {
    if name == "id" {
        ret widget.id()
    }
    if name == "class" {
        ret widget.classes()
    }
    if name == "disabled" {
        ret if widget.disabled() {
            "disabled"
        } else {
            ""
        }
    }
    if name == "checked" {
        ret if widget.checked() {
            "checked"
        } else {
            ""
        }
    }
    match widget.attribute(name) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            ret ""
        }
    }
}

fn unquote_css_value(value: str) -> str {
    if value.char_len() >= 2_usize {
        let first = value.slice(0_usize, 1_usize)
        let last = value.slice(value.char_len() - 1_usize, 1_usize)
        if (first == "\"" && last == "\"") ||(first == "'" && last == "'") {
            ret value.slice(1_usize, value.char_len() - 2_usize)
        }
    }
    ret value
}

fn string_contains(value: str, expected: str) -> bool {
    ret expected == "" || value.find_from(expected, 0_usize) < value.byte_len()
}

fn matching_bracket(value: str, open: usize) -> usize {
    let mut quote = ""
    let mut escaped = false
    let mut index = open + 1_usize
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped {
                escaped = false
            } elif current == "\\" {
                escaped = true
            } elif current == quote {
                quote = ""
            }
        } else {
            if current == "\"" || current == "'" {
                quote = current
            } elif current == "]" {
                ret index
            }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn matching_parenthesis(value: str, open: usize) -> usize {
    let mut depth = 0_usize
    let mut index = open
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "(" {
            depth = depth + 1_usize
        } elif current == ")" {
            if depth == 1_usize {
                ret index
            }
            if depth > 0_usize {
                depth = depth - 1_usize
            }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn has_class(classes: str, expected: str) -> bool {
    if expected == "" || !classes.contains(expected) {
        ret false
    }
    let mut start = 0_usize
    let mut index = 0_usize
    let length = classes.byte_len()
    while index <= length {
        let byte = classes.byte_at(index)
        if index == length || byte == 32_u8 || byte == 9_u8 || byte == 10_u8 || byte == 13_u8 {
            if index > start && classes.slice_bytes(start, index - start) == expected {
                ret true
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret false
}

fn widget_type(widget: Widget) -> str {
    if widget.tag() != "" && widget.tag() != "widget" {
        ret widget.tag()
    }
    let kind = widget.kind()
    if kind == widget_panel() {
        ret "div"
    }
    if kind == widget_label() {
        ret "label"
    }
    if kind == widget_button() {
        ret "button"
    }
    if kind == widget_spacer() {
        ret "spacer"
    }
    if kind == widget_input() {
        ret "input"
    }
    if kind == widget_textarea() {
        ret "textarea"
    }
    if kind == widget_checkbox() {
        ret "input"
    }
    if kind == widget_radio() {
        ret "input"
    }
    if kind == widget_switch() {
        ret "switch"
    }
    if kind == widget_select() {
        ret "select"
    }
    if kind == widget_slider() || kind == widget_range_slider() {
        ret "input"
    }
    if kind == widget_progress() {
        ret "progress"
    }
    if kind == widget_separator() {
        ret "hr"
    }
    if kind == widget_heading() {
        ret "h1"
    }
    if kind == widget_link() {
        ret "a"
    }
    if kind == widget_color_picker() {
        ret "input"
    }
    if kind == widget_color_swatch() {
        ret "swatch"
    }
    if kind == widget_icon() {
        ret "svg"
    }
    if kind == widget_image() {
        ret "img"
    }
    if kind == widget_icon_button() {
        ret "button"
    }
    if kind == widget_icon_card() {
        ret "button"
    }
    ret "widget"
}
