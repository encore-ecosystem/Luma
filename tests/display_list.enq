import core::option::Option
import luma::{Color, DisplayCommand, DisplayList, Rect, RetainedDisplayList}

fn main() -> u32 {
    let mut list = DisplayList::new()
    let bounds = Rect::new(2.0_f32, 3.0_f32, 40.0_f32, 20.0_f32)
    list.damage_rect(bounds)
    list.fill_rect(bounds, Color::rgb(10_u8, 20_u8, 30_u8))
    list.round_rect(bounds, 5.0_f32, Color::rgb(40_u8, 50_u8, 60_u8), false)
    list.text(4.0_f32, 8.0_f32, "Luma", Color::rgb(255_u8, 255_u8, 255_u8))
    if list.len() != 3_usize || list.damage().len() != 1_usize {
        ret 1_u32
    }
    match list.commands().get(0_usize) {
        Option::Some(command) => {
            match command {
                DisplayCommand::FillRect(value) => {
                    if value.bounds().width() != 40.0_f32 {
                        ret 2_u32
                    }
                }
                _ => {
                    ret 3_u32
                }
            }
        }
        Option::None => {
            ret 3_u32
        }
    }
    match list.commands().get(2_usize) {
        Option::Some(command) => {
            match command {
                DisplayCommand::Text(value) => {
                    if value.value() != "Luma" {
                        ret 4_u32
                    }
                }
                _ => {
                    ret 5_u32
                }
            }
        }
        Option::None => {
            ret 5_u32
        }
    }
    let mut first = DisplayList::new()
    first.fill_rect(bounds, Color::rgb(1_u8, 2_u8, 3_u8))
    let mut overlay = DisplayList::new()
    overlay.text(4.0_f32, 8.0_f32, "Overlay", Color::rgb(255_u8, 255_u8, 255_u8))
    let mut retained = RetainedDisplayList::new()
    retained.upsert("content", bounds, first.commands(), false)
    retained.upsert("tooltip", Rect::new(8.0_f32, 8.0_f32, 20.0_f32, 10.0_f32),
        overlay.commands(), true,)
    retained.clear_damage()
    let mut updated = DisplayList::new()
    updated.fill_rect(bounds, Color::rgb(4_u8, 5_u8, 6_u8))
    retained.upsert("content", bounds, updated.commands(), false)
    if retained.len() != 2_usize || retained.damage().len() != 1_usize ||
    retained.frame(false).len() != 1_usize ||
    retained.frame(true).len() != 2_usize {
        ret 6_u32
    }
    if retained.frame_for_damage(
        Rect::new(30.0_f32, 15.0_f32, 20.0_f32, 20.0_f32), false,).len() != 1_usize ||
    retained.frame_for_damage(
        Rect::new(100.0_f32, 100.0_f32, 10.0_f32, 10.0_f32), true,).len() != 0_usize {
        ret 9_u32
    }
    // The untouched overlay keeps its original generation.
    match retained.segment("tooltip") {
        Option::Some(tooltip) => {
            if tooltip.generation() != 2_usize {
                ret 7_u32
            }
        }
        Option::None => {
            ret 7_u32
        }
    }
    match retained.segment("content") {
        Option::Some(content) => {
            if content.generation() != 3_usize {
                ret 7_u32
            }
        }
        Option::None => {
            ret 7_u32
        }
    }
    if !retained.remove("content") || retained.len() != 1_usize ||
    retained.damage().len() != 1_usize {
        ret 8_u32
    }
    let mut gradient = DisplayList::new()
    gradient.gradient_line(10, 20, 80, 40, 1.25,
        Color::rgba(240, 243, 247, 0), Color::rgba(240, 243, 247, 242),)
    retained.upsert("gradient", bounds, gradient.commands(), true)
    match retained.overlay_frame().commands().get(1) {
        Option::Some(command) => {
            match command {
                DisplayCommand::GradientLine(line) => {
                    if line.x0() != 10 || line.y0() != 20 || line.x1() != 80 || line.y1() != 40 ||
                    line.width() != 1.25 || line.start_color().alpha() != 0 || line.end_color().alpha() != 242 {
                        ret 10
                    }
                }
                _ => {
                    ret 11
                }
            }
        }
        _ => {
            ret 11
        }
    }
    ret 0_u32
}
