import core::os::env
import luma::{RendererKind, Widget, Window}

fn main() -> u32 {
    let window = Window::create_with_renderer(
        "Luma direct Vulkan atomic startup", 96_u32, 64_u32,
        RendererKind::Auto,)
    if !window.available() {
        // Headless default test runs may skip production-backend coverage.
        // Release validation makes the Direct Vulkan backend mandatory.
        ret if env("LUMA_REQUIRE_DIRECT_VULKAN").is_some() {
            1_u32
        } else {
            0_u32
        }
    }
    let info = window.renderer_info()
    if info.backend() != "direct-vulkan" || !info.accelerated() {
        let _destroyed = window.destroy()
        ret 2_u32
    }
    let _ui = window.reactive(
        Widget::label("Complete Direct Vulkan first frame"),)
    if window.presented_frames() != 1_u64 {
        let _destroyed = window.destroy()
        ret 3_u32
    }
    ret if window.destroy() {
        0_u32
    } else {
        4_u32
    }
}
