//! Geometry remains accessible through both Luma's module and root exports.
import luma::Rect
import luma::geometry::{Insets, Point, Size}

fn main() -> u32 {
    let rect = Rect::new(10.0_f32, 20.0_f32, 100.0_f32, 80.0_f32)
    if !rect.contains(Point::new(10.0_f32, 20.0_f32)) {
        ret 1_u32
    }
    if rect.contains(Point::new(110.0_f32, 30.0_f32)) {
        ret 2_u32
    }
    if rect.contains(Point::new(20.0_f32, 100.0_f32)) {
        ret 3_u32
    }
    if rect.contains(Point::new(9.0_f32, 30.0_f32)) {
        ret 4_u32
    }
    let inner = rect.inset(Insets::symmetric(10.0_f32, 5.0_f32))
    if inner.x() != 15.0_f32 || inner.y() != 30.0_f32 {
        ret 5_u32
    }
    if inner.width() != 90.0_f32 || inner.height() != 60.0_f32 {
        ret 6_u32
    }
    let empty = rect.inset(Insets::all(100.0_f32))
    if empty.width() != 0.0_f32 || empty.height() != 0.0_f32 {
        ret 7_u32
    }
    let size = Size::new(20.0_f32, 30.0_f32)
    if size.width() != 20.0_f32 || size.height() != 30.0_f32 {
        ret 8_u32
    }
    if Size::zero().width() != 0.0_f32 || Size::zero().height() != 0.0_f32 {
        ret 9_u32
    }
    let edges = Insets::only(1.0_f32, 2.0_f32, 3.0_f32, 4.0_f32)
    if edges.top() != 1.0_f32 || edges.right() != 2.0_f32 ||
    edges.bottom() != 3.0_f32 || edges.left() != 4.0_f32 {
        ret 10_u32
    }
    ret 0_u32
}
