import luma::{Rect, Size, anchored_popup_bounds, property_row, property_section, Widget, StyleSheet, layout_widget, vertical}
fn main() -> u32 {
    let available = Rect::new(8, 8, 1264, 704)
    let popup = anchored_popup_bounds(Rect::new(1190, 650, 60, 24), Size::new(320, 384), available)
    if popup.x() != 952 || popup.y() != 262 || popup.right() > available.right() || popup.bottom() > available.bottom() {
        ret 1
    }
    let small = anchored_popup_bounds(Rect::new(0, 0, 10, 10), Size::new(320, 384), Rect::new(0, 0, 200, 150))
    if small.x() != 0 || small.y() != 0 || small.width() != 200 || small.height() != 150 {
        ret 2
    }
    let row = property_row("roughness", "Roughness", Widget::input("value", "0.5"))
    if row.find("value").is_none() {
        ret 3
    }
    if property_section("advanced", "Advanced", false, row).find("value").is_some() {
        ret 4
    }
    if property_section("advanced", "Advanced", true, row).find("value").is_none() {
        ret 5
    }
    let mut content = Widget::panel("content").with_direction(vertical())
    for id in vec!["x", "y", "z"] {
        content.push(property_row(id + "-row", id, Widget::input(id, "1")))
    }
    let view = Widget::panel("root").with_direction(vertical()).with_child(property_section("transform", "Transform", true, content))
    .with_child(property_section("advanced", "Advanced", false, Widget::panel("advanced-content")))
    let layout = layout_widget(StyleSheet::default().apply(view, "", "", ""), Rect::new(0, 0, 320, 400))
    let transform = layout.find_bounds("transform-section").unwrap_or(Rect::new(0, 0, 0, 0))
    let advanced = layout.find_bounds("advanced-section").unwrap_or(Rect::new(0, 0, 0, 0))
    if transform.height() != 106 || advanced.height() != 24 || advanced.y() < transform.bottom() {
        ret 6
    }
    let x = layout.find_bounds("x").unwrap_or(Rect::new(0, 0, 0, 0))
    if x.width() < 100 || x.height() != 24 {
        ret 7
    }
    ret 0
}
