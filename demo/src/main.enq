//! Small CSS-styled examples using Luma's event-driven runtime.
import core::option::Option
import core::result::Result
import core::vec::Vec
import luma::{AppEvent, Application, IconAsset, IconLoader, IconManager, Style, StyleSheet, SvgDocument, Widget, Window, run_reactive_application}
import luma::{ReactiveApplication, UiBindings, NodeId, Signal}
import luma::{VirtualGrid, TextEditor, TextEditIntent}
import refrain::forms::FormsPage
import refrain::snake::SnakePage
import refrain::table::TablePage
import std::io::{eprintln, println}

struct BrowserIcon {
    name: str
    document: SvgDocument
}

struct IconSearch {
    catalog: Vec[IconAsset]
    editor: TextEditor
    revision: usize
}

impl for IconSearch {
    fn new(catalog: Vec[IconAsset]) -> Self {
        ret Self {
            catalog, TextEditor::new(""), 0
        }
    }
}

// Bundled icon names are ASCII identifiers; compare without allocating
// lowercase copies of every name on every keystroke.
fn icon_name_matches(name: str, query: str) -> bool {
    if query.byte_len() > name.byte_len() {
        ret false
    }
    for start in 0.. =(name.byte_len() - query.byte_len()) {
        let mut matched = true
        for index in 0..query.byte_len() {
            let mut a = name.get_byte_at(start + index).unwrap_or(0)
            let mut b = query.get_byte_at(index).unwrap_or(0)
            if a >= 65 && a <= 90 {
                a += 32
            }
            if b >= 65 && b <= 90 {
                b += 32
            }
            if a != b {
                matched = false
                break
            }
        }
        if matched {
            ret true
        }
    }
    ret false
}

struct BrowserGrid {
    columns: usize
    maximum: usize
    minimum: f32
    gap: f32
    inset: f32
}

impl for BrowserGrid {
    fn resized(self: Self, width: f32) -> Self {
        ret Self {
            VirtualGrid::fitting_columns(width - self.inset, self.minimum,
                self.gap, self.maximum,), self.maximum, self.minimum, self.gap, self.inset
        }
    }
}

struct Counter {
    value: u32
    slider: f32
    icons: Vec[IconAsset]
    visible_icons: Vec[BrowserIcon]
    page: str
    first_row: usize
    scroll: f32
    viewport_height: f32
    loader: IconLoader
    grid: BrowserGrid
    search: IconSearch
    forms: FormsPage
    table: TablePage
    snake: SnakePage
}

impl Application for Counter {
    fn view(self: Self) -> Widget {
        let mut root = Widget::panel("root")
        let mut navigation = Widget::panel("navigation")
        for page in vec!["counter", "icons", "forms", "table", "snake"] {
            let label = match page {
                "counter" => "Counter"
                "icons" => f "Icons ({self.icons.len()})"
                "forms" => "Forms"
                "table" => "Table"
                _ => "Snake"
            }
            navigation.push(Widget::button("tab-" + page, label).with_classes("nav-button")
                .with_attribute("aria-selected", if self.page == page {
                        "true"
                    } else {
                        "false"
                    }
                    ,
                ))
        }
        root.push(navigation)
        match self.page {
            "forms" => {
                root = self.forms.configure_root(root)
                root.push(self.forms.view())
            }
            "table" => {
                root = self.table.configure_root(root)
                root.push(self.table.view())
            }
            "snake" => {
                root = self.snake.configure_root(root)
                root.push(self.snake.view())
            }
            "icons" => {
                let mut toolbar = Widget::panel("icon-toolbar")
                toolbar.push(Widget::input("icon-search", self.search.editor.value())
                    .with_attribute("placeholder", "Search icons…")
                    .with_attribute("aria-label", "Search icons by name")
                    .with_selection(if self.search.editor.cursor() == self.search.editor.selection_start() {
                            self.search.editor.selection_end()
                        } else {
                            self.search.editor.selection_start()
                        }
                        , self.search.editor.cursor(),))
                toolbar.push(Widget::label(f "{self.icons.len()} icons").with_id("icon-count"))
                root.push(toolbar)
                let rows =(self.visible_icons.len() + self.grid.columns - 1) / self.grid.columns
                let total_rows =(self.icons.len() + self.grid.columns - 1) / self.grid.columns
                let mut viewport = Widget::panel(f "icon-scroll-{self.search.revision}").with_classes("icon-scroll")
                .with_attribute("data-luma-scrollable", "true")
                viewport.push(icon_spacer("icons-before",(self.first_row as f32) * 122.0))
                let mut grid = Widget::panel("icon-grid").with_attribute("data-columns", f "{self.grid.columns}").with_computed_style(
                    Style::default().with_height((rows as f32) * 122.0)
                    .with_flex_basis((rows as f32) * 122.0))
                for icon in self.visible_icons {
                    grid.push(Widget::icon_card("icon-card-" + icon.name, icon.name,
                            icon.document,).with_classes("icon-tile"))
                }
                viewport.push(grid)
                viewport.push(icon_spacer("icons-after",
                        ((total_rows - self.first_row - rows) as f32) * 122.0,))
                if self.icons.len() == 0 {
                    viewport.push(Widget::label("No icons found").with_id("icon-empty"))
                }
                root.push(viewport)

            }
            _ => {
                let mut counter = Widget::panel("counter-page")
                counter.push(Widget::button("counter", f "Count: {self.value}"))
                counter.push(Widget::label(f "Value: {(self.slider * 100.0 + 0.5) as u32}%").with_id("slider-value"))
                counter.push(Widget::slider("slider", self.slider))
                root.push(counter)
            }
        }
        ret root
    }
    fn update(self: Self, event: AppEvent) -> Self {
        let mut next = self.snapshot()
        if event.is_action() {
            let page = match event.action() {
                "tab-counter" => "counter" "tab-icons" => "icons"
                "tab-forms" => "forms" "tab-table" => "table" "tab-snake" => "snake"
                _ => ""
            }
            if page != "" {
                if page == self.page {
                    ret self
                }
                next.page = page
                next.forms = self.forms.action("form-dismiss")
                next.snake = self.snake.pause()
                if page == "icons" {
                    ret next.load_visible(0.0)
                }
                next.loader = self.loader.request(Vec[IconAsset]::new())
                ret next
            }
        }
        if event.is_resize() {
            next.viewport_height = if event.y() > 156.0 {
                event.y() - 156.0
            } else {
                0.0_f32
            }
            next.grid = self.grid.resized(event.x())
            next.table = self.table.update(event)
            if self.page == "icons" {
                ret next.refresh_visible(self.scroll, next.grid.columns != self.grid.columns)
            }
            ret next
        }
        if event.is_tick() {
            next.forms = self.forms.update(event)
            if self.page == "snake" {
                next.snake = self.snake.update(event)
            }
            if self.page == "icons" {
                next.loader = self.loader.poll()
                ret next.refresh_visible(self.scroll, next.loader.revision() != self.loader.revision())
            }
            ret next
        }
        match self.page {
            "forms" => {
                next.forms = self.forms.update(event)
            }
            "table" => {
                next.table = self.table.update(event)
            }
            "snake" => {
                next.snake = self.snake.update(event)
            }
            "icons" => {
                if event.is_text_edit() && event.text_edit().target() == "icon-search" {
                    ret self.edit_search(event.text_edit())
                }
                if event.is_scroll() && event.scroll_viewport_height() > 0.0 {
                    next.viewport_height = event.scroll_viewport_height()
                    ret next.load_visible(event.scroll_offset())
                }
            }
            _ => {
                if event.is_action() && event.action() == "counter" {
                    next.value += 1
                }
                if event.is_control_change() && event.target() == "slider" {
                    next.slider = event.value()
                }
            }
        }
        ret next
    }
    fn can_close(self: Self) -> bool {
        ret true
    }
    fn background_interval_ms(self: Self) -> u32 {
        ret if (self.page == "icons" && self.loader.busy()) ||(self.page == "snake" && self.snake.running()) || self.forms.saving() {
            16
        } else {
            0
        }
    }
    fn background_revision(self: Self) -> u64 {
        ret self.loader.revision() + self.snake.revision() + self.forms.revision()
    }
}

fn main() -> u32 {
    match run_demo() {
        Result::Ok(code) => {
            ret code
        }
        Result::Err(error) => {
            eprintln("Unable to load app.css: " + error)
            ret 1
        }
    }
    ret 1
}

fn run_demo() -> Result[u32, str] {
    let sheet = StyleSheet::from_file("app.css")?
    ret Result[u32, str]::Ok(run_counter(sheet))
}

fn run_counter(sheet: StyleSheet) -> u32 {
    let window = Window::create("Luma — demo", 880, 640)
    .with_stylesheet(sheet)
    if !window.available() {
        ret 1
    }
    println("Luma renderer: " + window.renderer_name())
    let root_style = sheet.apply(Widget::panel("root"), "", "", "").style()
    window.set_minimum_size(root_style.layout().min_width() as u32, root_style.layout().min_height() as u32)
    let icons = IconManager::with_bundled("../assets/icons").icons()
    let model = Counter {
        0, 0.5, icons, Vec[BrowserIcon]::new(), "counter", 0, 0.0, 484.0, IconLoader::new(), browser_grid(sheet).resized(window.width() as f32), IconSearch::new(icons), FormsPage::new(), TablePage::new(), SnakePage::new()
    }
    let mut reactive = ReactiveDemo<H> {
        model, Option[NodeId]::None,
        Signal[u32]::new(0), Signal[f32]::new(0.5)
    }
    let _finished = run_reactive_application[ReactiveDemo](window, reactive)
    ret 0
}

struct ReactiveDemo {
    model: Counter
    root: Option[NodeId]
    count: Signal[u32]<H>
    slider: Signal[f32]<H>
}

impl ReactiveApplication for ReactiveDemo {
    fn mount(self: mut Self&, bindings: mut UiBindings&) -> NodeId {
        let context = bindings.context()
        self.count = context.signal[u32](self.model.value)
        self.slider = context.signal[f32](self.model.slider)
        let root = bindings.mount(self.model.view())
        self.root = Option[NodeId]::Some(root)
        self.bind_counter(bindings)
        ret root
    }
    fn update(self: mut Self&, bindings: mut UiBindings&, event: AppEvent) ->() {
        let previous = self.model
        self.model = self.model.update(event)
        if previous.value != self.model.value {
            self.count.set(self.model.value)
        }
        if previous.slider != self.model.slider {
            self.slider.set(self.model.slider)
        }
        if self.model.page == "counter" && previous.page == "counter" {
            ret()
        }
        // Idle loader polls and scrolling inside the same virtual window do
        // not remount an unchanged page. The runtime retains scroll geometry.
        if event.is_tick() && previous.background_revision() == self.model.background_revision() {
            ret()
        }
        if self.model.page == "icons" && previous.page == "icons" &&
        previous.first_row == self.model.first_row && previous.grid.columns == self.model.grid.columns &&
        previous.search.revision == self.model.search.revision && previous.loader.revision() == self.model.loader.revision() &&
        (event.is_scroll() || event.is_resize()) {
            ret()
        }
        match self.root {
            Some(root) => {
                let _replaced = bindings.reconcile(root, self.model.view())
                self.bind_counter(bindings)
            }
            None => {
            }
        }
        ret()
    }
    fn can_close(self: Self&) -> bool {
        ret true
    }
    fn background_interval_ms(self: Self&) -> u32 {
        ret self.model.background_interval_ms()
    }
    fn background_revision(self: Self&) -> u64 {
        ret self.model.background_revision()
    }
}

impl for ReactiveDemo {
    fn bind_counter(self: mut Self&, bindings: mut UiBindings&) ->() {
        if self.model.page != "counter" {
            ret()
        }
        let count = self.count
        let slider = self.slider
        match self.root {
            Some(root) => {
                let tree = bindings.tree()
                match tree.find(root, "counter") {
                    Some(node) => {
                        let _bound = bindings.bind_text(node, | cx | {
                                ret f "Count: {cx.read[u32](count)}"
                            }
                            ,
                        )
                    }
                    None => {
                    }
                }
                match tree.find(root, "slider-value") {
                    Some(node) => {
                        let _bound = bindings.bind_text(node, | cx | {
                                ret f "Value: {(cx.read[f32](slider) * 100.0 + 0.5) as u32}%"
                            }
                            ,)
                    }
                    None => {
                    }
                }
                match tree.find(root, "slider") {
                    Some(node) => {
                        let _bound = bindings.bind_value(node, | cx | {
                                ret cx.read[f32](slider)
                            }
                            ,
                        )
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
        ret()
    }
}

// Read sizing from the same CSS used to paint the grid; no second set of
// breakpoints or minimum tile widths in application code.
fn browser_grid(sheet: StyleSheet) -> BrowserGrid {
    let mut root = Widget::panel("root")
    let mut viewport = Widget::panel("icon-scroll")
    let mut grid = Widget::panel("icon-grid")
    grid.push(Widget::icon_card("tile", "", SvgDocument::empty()).with_classes("icon-tile"))
    viewport.push(grid)
    root.push(viewport)
    let styled = sheet.apply(root, "", "", "")
    let viewport_style = styled.find("icon-scroll").unwrap_or(Widget::spacer(0.0)).style()
    let grid_style = styled.find("icon-grid").unwrap_or(Widget::spacer(0.0)).style()
    let minimum = styled.find("tile").unwrap_or(Widget::spacer(0.0)).style().layout().min_width()
    let gap = if grid_style.layout().flex().column_gap() >= 0.0 {
        grid_style.layout().flex().column_gap()
    } else {
        grid_style.gap()
    }
    let inset = styled.style().padding().left() + styled.style().padding().right() +
    viewport_style.padding().left() + viewport_style.padding().right() +
    grid_style.padding().left() + grid_style.padding().right()
    let maximum = grid_style.layout().flex().columns()
    ret BrowserGrid {
        maximum, maximum, minimum, gap, inset
    }
}

fn fixture_grid() -> BrowserGrid {
    ret BrowserGrid {
        8, 8, 112.0, 10.0, 64.0
    }
}

#attr(test)
fn selected_tab_tracks_page_not_focus() -> bool {
    let sheet = match StyleSheet::from_file("app.css") {
        Result::Ok(value) => value
        Result::Err(_) => {
            ret false
        }
    }
    for page in vec!["counter", "icons", "forms", "table", "snake"] {
        let model = Counter {
            0, 0.5, Vec[IconAsset]::new(), Vec[BrowserIcon]::new(), page,
            0, 0.0, 484.0, IconLoader::new(), fixture_grid(), IconSearch::new(Vec[IconAsset]::new()), FormsPage::new(), TablePage::new(), SnakePage::new()
        }
        let selected = "tab-" + page
        let other = if page != "counter" {
            "tab-counter"
        } else {
            "tab-icons"
        }
        let root = sheet.apply_with_focus_visibility(model.view(), other, "", other, true)
        let active = root.find(selected).unwrap_or(Widget::spacer(0.0))
        let inactive = root.find(other).unwrap_or(Widget::spacer(0.0))
        if active.attribute("aria-selected").unwrap_or("") != "true" ||
        inactive.attribute("aria-selected").unwrap_or("") != "false" ||
        active.style().background().red() != 32 ||
        active.style().foreground().red() != 255 ||
        inactive.style().background().red() != 232 {
            ret false
        }
    }
    ret true
}

#attr(test)
fn slider_view_tracks_model() -> bool {
    let model = Counter {
        3, 0.75, Vec[IconAsset]::new(),
        Vec[BrowserIcon]::new(), "counter", 0, 0.0, 484.0, IconLoader::new(), fixture_grid(), IconSearch::new(Vec[IconAsset]::new()), FormsPage::new(), TablePage::new(), SnakePage::new()
    }
    let view = model.view()
    let label = view.find("slider-value").unwrap_or(Widget::spacer(0.0_f32))
    let slider = view.find("slider").unwrap_or(Widget::spacer(0.0_f32))
    let button = view.find("counter").unwrap_or(Widget::spacer(0.0_f32))
    ret label.text() == f "Value: {(0.75 * 100.0 + 0.5) as u32}%" &&
    slider.value() == 0.75 &&
    button.text() == f "Count: {3}"
}

#attr(test)
fn icon_browser_handles_empty_catalog() -> bool {
    let icons = Vec[IconAsset]::new()
    let model = Counter {
        3, 0.75, icons, Vec[BrowserIcon]::new(), "icons", 0, 0.0, 484.0, IconLoader::new(), fixture_grid(), IconSearch::new(Vec[IconAsset]::new()), FormsPage::new(), TablePage::new(), SnakePage::new()
    }
    let view = model.view()
    ret view.find("icons-previous").is_none() &&
    view.find("icons-next").is_none() &&
    view.find("icon-grid").unwrap_or(Widget::spacer(0.0)).children().len() == 0
}

impl for Counter {
    fn snapshot(self: Self) -> Self {
        ret Self {
            self.value, self.slider, self.icons, self.visible_icons, self.page,
            self.first_row, self.scroll, self.viewport_height, self.loader, self.grid,
            self.search, self.forms, self.table, self.snake
        }
    }
    fn edit_search(self: Self, edit: TextEditIntent) -> Self {
        let mut next = self.snapshot()
        next.search = IconSearch {
            self.search.catalog, edit.apply(self.search.editor), self.search.revision
        }
        if next.search.editor.value() == self.search.editor.value() {
            ret next
        }
        let mut filtered = Vec[IconAsset]::new()
        for icon in self.search.catalog {
            if icon_name_matches(icon.name(), next.search.editor.value()) {
                filtered.push(icon)
            }
        }
        next.icons = filtered
        next.search.revision += 1
        ret next.refresh_visible(0.0, true)
    }
    fn load_visible(self: Self, offset: f32) -> Self {
        ret self.refresh_visible(offset, false)
    }
    fn refresh_visible(self: Self, offset: f32, documents_changed: bool) -> Self {
        let visible = VirtualGrid::new(self.icons.len(), self.grid.columns, 122.0, 2).window(offset, self.viewport_height)
        let mut next = self.snapshot()
        next.first_row = visible.first_row()
        next.scroll = offset
        if !documents_changed && next.first_row == self.first_row && self.visible_icons.len() == visible.end() - visible.start() {
            ret next
        }
        let mut requested = Vec[IconAsset]::new()
        let start = visible.start()
        let end = visible.end()
        for index in start..end {
            match self.icons.get(index) {
                Some(icon) => requested.push(icon) None => {
                }
            }
        }
        next.loader = self.loader.request(requested)
        let mut loaded = Vec[BrowserIcon]::new()
        for icon in requested {
            loaded.push(BrowserIcon {
                    icon.name(), next.loader.document(icon.path()).unwrap_or(SvgDocument::empty())
                }
                ,
            )
        }
        next.visible_icons = loaded
        ret next
    }
}

fn icon_spacer(id: str, height: f32) -> Widget {
    ret Widget::spacer(0.0).with_id(id).with_classes("icon-spacer")
    .with_computed_style(Style::default().with_height(height).with_flex_basis(height))
}

#attr(test)
fn icon_browser_search() -> bool {
    let mut icons = Vec[IconAsset]::new()
    icons.push(IconAsset::new("arrow-left", "../assets/icons/check.svg"))
    icons.push(IconAsset::new("arrow-right", "../assets/icons/check.svg"))
    icons.push(IconAsset::new("circle", "../assets/icons/check.svg"))
    let mut model = Counter {
        0, 0.5, icons, Vec[BrowserIcon]::new(), "icons", 0, 1220.0, 484.0,
        IconLoader::new(), fixture_grid(), IconSearch::new(icons), FormsPage::new(), TablePage::new(), SnakePage::new()
    }
    model = model.edit_search(TextEditIntent::insert("icon-search", "ARROW"))
    if model.icons.len() != 2 || model.visible_icons.len() != 2 || model.scroll != 0.0 {
        ret false
    }
    model = model.edit_search(TextEditIntent::insert("icon-search", "-left"))
    let first = model.visible_icons.get(0).unwrap_or(BrowserIcon {
            "", SvgDocument::empty()
        }
        ,
    )
    if model.icons.len() != 1 || first.name != "arrow-left" {
        ret false
    }
    model = model.edit_search(TextEditIntent::select_all("icon-search"))
    let revision = model.search.revision
    model = model.edit_search(TextEditIntent::insert("icon-search", "missing"))
    if model.icons.len() != 0 || model.view().find("icon-empty").is_none() || model.search.revision != revision + 1 {
        ret false
    }
    model = model.edit_search(TextEditIntent::select_all("icon-search"))
    model = model.edit_search(TextEditIntent::backspace("icon-search"))
    ret model.icons.len() == 3 && model.visible_icons.len() == 3 &&
    model.search.editor.value() == "" && model.scroll == 0.0 &&
    icon_name_matches("arrow-left", "ROW-L") && !icon_name_matches("circle", "arrow")
}

#attr(test)
fn icon_browser_virtual_window() -> bool {
    let mut icons = Vec[IconAsset]::new()
    for index in 0_usize..1703_usize {
        icons.push(IconAsset::new(f "icon-{index}", "../assets/icons/check.svg"))
    }
    let mut model = Counter {
        0, 0.5, icons, Vec[BrowserIcon]::new(), "icons", 0, 0.0, 484.0, IconLoader::new(), fixture_grid(), IconSearch::new(icons), FormsPage::new(), TablePage::new(), SnakePage::new()
    }
    model = model.load_visible(0.0)
    if model.visible_icons.len() != 48 || model.first_row != 0 {
        ret false
    }
    model = model.load_visible(1220.0)
    let first_icon = model.visible_icons.get(0).unwrap_or(BrowserIcon {
            "", SvgDocument::parse("")
        }
        ,
    )
    if model.first_row != 8 || model.visible_icons.len() != 64 ||
    first_icon.name != "icon-64" {
        ret false
    }
    model = model.load_visible(25624.0)
    let last = model.visible_icons.get(model.visible_icons.len() - 1)
    .unwrap_or(BrowserIcon {
            "", SvgDocument::parse("")
        }
        ,
    )
    if last.name != "icon-1702" || model.visible_icons.len() > 64 {
        ret false
    }
    model = model.load_visible(0.0)
    if model.first_row != 0 || model.visible_icons.len() != 48 {
        ret false
    }
    let sheet = match StyleSheet::from_file("app.css") {
        Result::Ok(value) => value
        Result::Err(_) => {
            ret false
        }
    }
    let sizing = browser_grid(sheet)
    if sizing.minimum != 112.0 || sizing.maximum != 8 {
        ret false
    }
    let mut widths = Vec[f32]::new()
    widths.push(360.0)
    widths.push(880.0)
    widths.push(1200.0)
    widths.push(480.0)
    widths.push(1200.0)
    for width in widths {
        model = model.update(AppEvent::resized(width, 640.0))
        model = model.load_visible(1220.0)
        let columns = sizing.resized(width).columns
        let styled = sheet.apply(model.view(), "", "", "")
        let grid = styled.find("icon-grid").unwrap_or(Widget::spacer(0.0))
        let first = model.visible_icons.get(0).unwrap_or(BrowserIcon {
                "", SvgDocument::empty()
            }
            ,
        )
        if model.grid.columns != columns || grid.style().layout().flex().columns() != columns ||
        first.name != f "icon-{model.first_row * columns}" ||
        (width - sizing.inset -((columns - 1) as f32) * sizing.gap) /(columns as f32) < sizing.minimum {
            ret false
        }
    }
    ret true
}
